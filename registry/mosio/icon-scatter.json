   "content": "<!doctype html>\n<!--\n  Icon Scatter\n\n  A field of line icons draws itself over the outgoing scene, covers the swap, then scatters outward to reveal the incoming scene.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/icon-scatter/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"icon-scatter\"\n  data-composition-duration=\"1.3333\"\n  data-composition-variables='[\n  {\n    \"id\": \"count\",\n    \"type\": \"number\",\n    \"role\": \"style\",\n    \"label\": \"Icon count\",\n    \"description\": \"How many icons populate the field.\",\n    \"default\": 15,\n    \"min\": 4,\n    \"max\": 60,\n    \"step\": 1\n  },\n  {\n    \"id\": \"color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Icon color\",\n    \"description\": \"Stroke color of the icons.\",\n    \"default\": \"#fafafa\"\n  },\n  {\n    \"id\": \"cover_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Cover color\",\n    \"description\": \"Fill that hides the swap at the field’s peak.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"cover_opacity\",\n    \"type\": \"number\",\n    \"role\": \"style\",\n    \"label\": \"Cover opacity\",\n    \"description\": \"Peak opacity of the cover fill.\",\n    \"default\": 0.92,\n    \"min\": 0,\n    \"max\": 1,\n    \"step\": 0.02\n  },\n  {\n    \"id\": \"stroke_width\",\n    \"type\": \"number\",\n    \"role\": \"style\",\n    \"label\": \"Stroke width\",\n    \"description\": \"Icon stroke width in 24px icon units.\",\n    \"default\": 2,\n    \"min\": 0.5,\n    \"max\": 4,\n    \"step\": 0.1\n  },\n  {\n    \"id\": \"fly_distance\",\n    \"type\": \"number\",\n    \"role\": \"motion\",\n    \"label\": \"Fly distance\",\n    \"description\": \"How far icons fly when they scatter, in pixels.\",\n    \"default\": 260,\n    \"min\": 0,\n    \"max\": 800,\n    \"step\": 10,\n    \"unit\": \"px\"\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Icon Scatter</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          font-family: var(--font-display, Geist, system-ui, sans-serif);\n          pointer-events: none;\n        }\n\n        #root { background: #141318; }\n        .isc-stage { position: absolute; inset: 0; }\n        .isc-panel { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }\n        .isc-in { display: flex; flex-direction: column; align-items: center; gap: 2.4cqmin; }\n        .isc-in span { font-size: 9cqmin; font-weight: 600; letter-spacing: -0.03em; line-height: 1; color: #f2f2f2; white-space: nowrap; }\n        .isc-bar { display: block; width: 14cqmin; height: 0.8cqmin; border-radius: 1cqmin; background: rgba(242, 242, 242, 0.55); }\n        .isc-pa { background: #141318; }\n        .isc-pb { background: linear-gradient(135deg, #3b3699 0%, #1e2a6b 55%, #0f4c75 100%); }\n        .isc-pc { background: linear-gradient(135deg, #7a2f5f 0%, #3a2250 55%, #1c1b3f 100%); }\n\n        .isc-pa { z-index: 1; } .isc-pb { z-index: 2; }\n        .isc-cover { position: absolute; inset: 0; z-index: 3; opacity: 0; }\n        .isc-field { position: absolute; inset: 0; z-index: 4; }\n        .isc-icon { position: absolute; overflow: visible; opacity: 0; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"icon-scatter\" data-duration=\"1.3333\" data-fps=\"30\">\n        <div id=\"isc-clip\" class=\"isc-stage clip\" data-start=\"0\" data-duration=\"1.3333\" data-track-index=\"0\">\n          <div id=\"isc-a\" class=\"isc-panel isc-pa\"><div class=\"isc-in\"><span>Scene A</span><i class=\"isc-bar\"></i></div></div>\n          <div id=\"isc-b\" class=\"isc-panel isc-pb\"><div class=\"isc-in\"><span>Scene B</span><i class=\"isc-bar\"></i></div></div>\n          <div id=\"isc-cover\" class=\"isc-cover\"></div>\n          <div id=\"isc-field\" class=\"isc-field\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        \n        <script>\n          (function () {\n            \"use strict\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v.trim() : f; }\nfunction pick(v, list, f) { return list.indexOf(String(v)) >= 0 ? String(v) : f; }\nfunction clamp01(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction smooth(a, b, x) { var t = clamp01((x - a) / (b - a)); return t * t * (3 - 2 * t); }\n// cubic-bezier easing, solved by bisection (pure function of x)\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0;\n    if (x >= 1) return 1;\n    var lo = 0, hi = 1, t = x;\n    for (var i = 0; i < 28; i++) {\n      var cx = 3 * (1 - t) * (1 - t) * t * x1 + 3 * (1 - t) * t * t * x2 + t * t * t;\n      if (cx < x) lo = t; else hi = t;\n      t = (lo + hi) / 2;\n    }\n    return 3 * (1 - t) * (1 - t) * t * y1 + 3 * (1 - t) * t * t * y2 + t * t * t;\n  };\n}\nvar inOutEase = bez(0.42, 0, 0.58, 1);\nfunction inCubic(x) { return x * x * x; }\nfunction outCubic(x) { return 1 - Math.pow(1 - x, 3); }\nfunction inQuad(x) { return x * x; }\nfunction outQuad(x) { return 1 - (1 - x) * (1 - x); }\nfunction outBack(s) { return function (x) { return 1 + (s + 1) * Math.pow(x - 1, 3) + s * Math.pow(x - 1, 2); }; }\n// interpolate(p, inputs, outputs, ease): clamped, eased per segment (like a frame interpolate)\nfunction interp(p, xs, ys, ease) {\n  var n = xs.length;\n  if (p <= xs[0]) return ys[0];\n  if (p >= xs[n - 1]) return ys[n - 1];\n  for (var i = 1; i < n; i++) {\n    if (p <= xs[i]) {\n      var t = (p - xs[i - 1]) / (xs[i] - xs[i - 1]);\n      if (ease) t = ease(t);\n      return lerp(ys[i - 1], ys[i], t);\n    }\n  }\n  return ys[n - 1];\n}\nfunction mulberry32(a) {\n  return function () {\n    a |= 0; a = (a + 0x6d2b79f5) | 0;\n    var t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n// damped spring from 0 to 1 (zero initial velocity), t in seconds\nfunction spring(t, damping, stiffness, mass) {\n  if (t <= 0) return 0;\n  var w0 = Math.sqrt(stiffness / mass), z = damping / (2 * Math.sqrt(stiffness * mass));\n  if (Math.abs(z - 1) < 1e-4) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + (z * w0 / wd) * Math.sin(wd * t));\n  }\n  var s = Math.sqrt(z * z - 1), r1 = -w0 * (z - s), r2 = -w0 * (z + s);\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\nfunction stripIds(node) {\n  var all = node.querySelectorAll(\"[id]\");\n  for (var i = 0; i < all.length; i++) all[i].removeAttribute(\"id\");\n  node.removeAttribute(\"id\");\n  return node;\n}\nfunction drive(name, duration, frame) {\n  var st = { p: 0 };\n  frame(0);\n  var tl = gsap.timeline({ paused: true });\n  tl.to(st, { p: 1, duration: duration, ease: \"none\", onUpdate: function () { frame(st.p); } }, 0);\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[name] = tl;\n}\n\n            var D = 1.3333;\n\nvar ICONS = [\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\", \"M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5\", \"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\", \"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\", \"M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401\", \"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\", \"M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z\", \"M12 2 A10 10 0 0 1 22 12 A10 10 0 0 1 12 22 A10 10 0 0 1 2 12 A10 10 0 0 1 12 2\", \"M7 4h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3z\", \"M13.73 4a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\", \"M12 5v14 M5 12h14\"];\nvar count = Math.round(num(vars.count, 15, 4, 60)), color = str(vars.color, \"#fafafa\"), coverColor = str(vars.cover_color, \"#0a0a0a\");\nvar coverOpacity = num(vars.cover_opacity, 0.92, 0, 1), strokeWidth = num(vars.stroke_width, 2, 0.5, 4), fly = num(vars.fly_distance, 260, 0, 800);\nvar A = document.getElementById(\"isc-a\"), B = document.getElementById(\"isc-b\"), cover = document.getElementById(\"isc-cover\"), field = document.getElementById(\"isc-field\");\ncover.style.background = coverColor;\nvar W = root.clientWidth, H = root.clientHeight, unit = Math.min(W, H) / 1080;\nvar rnd = mulberry32(20240), cols = Math.max(1, Math.ceil(Math.sqrt(count * W / H))), rowsN = Math.ceil(count / cols);\nvar NS = \"http://www.w3.org/2000/svg\", icons = [];\nfor (var i = 0; i < count; i++) {\n  var col = i % cols, row = Math.floor(i / cols), cw = 100 / cols, chh = 100 / rowsN;\n  var ic = {\n    x: cw * (col + 0.5) + (rnd() - 0.5) * cw * 0.7, y: chh * (row + 0.5) + (rnd() - 0.5) * chh * 0.7,\n    size: (34 + rnd() * 40) * unit * 1.6, spin: (rnd() - 0.5) * 320, dir: (rnd() - 0.5) * 1.2,\n    so: 0.5 + rnd() * 0.5, start: rnd() * 0.16, out: 0.52 + rnd() * 0.16, d: ICONS[Math.floor(rnd() * ICONS.length)]\n  };\n  var svg = document.createElementNS(NS, \"svg\");\n  svg.setAttribute(\"viewBox\", \"0 0 24 24\"); svg.setAttribute(\"fill\", \"none\"); svg.setAttribute(\"stroke\", color);\n  svg.setAttribute(\"stroke-width\", strokeWidth); svg.setAttribute(\"stroke-linecap\", \"round\"); svg.setAttribute(\"stroke-linejoin\", \"round\");\n  svg.setAttribute(\"class\", \"isc-icon\"); svg.id = \"isc-icon-\" + i;\n  svg.style.width = ic.size + \"px\"; svg.style.height = ic.size + \"px\"; svg.style.left = ic.x + \"%\"; svg.style.top = ic.y + \"%\";\n  var path = document.createElementNS(NS, \"path\");\n  path.setAttribute(\"d\", ic.d); path.setAttribute(\"pathLength\", \"1\"); path.setAttribute(\"stroke-dasharray\", \"1\");\n  svg.appendChild(path); field.appendChild(svg);\n  ic.svg = svg; ic.path = path; icons.push(ic);\n}\nvar back = outBack(1.6);\nfunction frame(p) {\n  A.style.opacity = interp(p, [0.28, 0.5], [1, 0]);\n  A.style.scale = interp(p, [0, 0.5], [1, 0.94], inCubic);\n  A.style.filter = \"blur(\" + interp(p, [0.1, 0.45], [0, 10]) + \"px)\";\n  B.style.opacity = interp(p, [0.5, 0.68], [0, 1]);\n  B.style.scale = interp(p, [0.5, 1], [1.06, 1], outCubic);\n  B.style.filter = \"blur(\" + interp(p, [0.5, 0.72], [8, 0]) + \"px)\";\n  cover.style.opacity = interp(p, [0, 0.3, 0.62, 0.9], [0, 1, 1, 0]) * coverOpacity;\n  for (var i = 0; i < icons.length; i++) {\n    var ic = icons[i];\n    var draw = interp(p, [ic.start, ic.start + 0.34], [0, 1], outCubic);\n    var sIn = interp(p, [ic.start, ic.start + 0.3], [0.4, 1], back);\n    var outP = interp(p, [ic.out, 1], [0, 1], inCubic);\n    var ang = Math.atan2(ic.y - 50, ic.x - 50) + ic.dir, f = outP * fly * unit;\n    var spin = ic.spin * interp(p, [ic.start, 1], [0, 1]);\n    var op = Math.min(draw, 1 - outP) * ic.so;\n    ic.svg.style.opacity = op;\n    ic.svg.style.transform = \"translate(-50%, -50%) translate(\" + Math.cos(ang) * f + \"px, \" + Math.sin(ang) * f + \"px) scale(\" + sIn * (1 - outP * 0.3) + \") rotate(\" + spin + \"deg)\";\n    ic.path.setAttribute(\"stroke-dashoffset\", String(1 - draw));\n  }\n}\n\n            drive(\"icon-scatter\", D, frame);\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
