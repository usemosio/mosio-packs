   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Glass Notification Aurora\n\n  Two frosted-glass notification cards slide over a slowly moving aurora backdrop: one fills a progress bar and flips to done, the other types a reply.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/heygen-com/hyperframes/blob/bd6cff8157a1a0ed5075527e673cc4f321fe9123/registry/blocks/liquid-glass-notification/liquid-glass-notification.html\n\n  Copyright HeyGen, Inc. and the Hyperframes contributors. Licensed under the Apache License, Version\n  2.0 (the \"License\"); you may not use this file except in compliance with the License. You may obtain\n  a copy of the License at http://www.apache.org/licenses/LICENSE-2.0. Unless required by applicable\n  law or agreed to in writing, software distributed under the License is distributed on an \"AS IS\"\n  BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for\n  the specific language governing permissions and limitations under the License.\n\n  Changes by usemosio/blocks: adapted from a block that refracts its cards with a third-party glass library, three.js and an experimental HTML-in-canvas API: here the aurora is the same fragment shader in raw WebGL2 and the glass is CSS (backdrop blur, a bright edge and highlight, no refraction), the logo and messaging app are replaced by drawn generic icons and text, the status text swaps by crossfade instead of a timeline callback, and the cards fill the host frame (top right in a wide frame, centered near the top in a tall one).\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"glass-notification-aurora\"\n  data-composition-duration=\"8\"\n  data-composition-variables='[\n  {\n    \"id\": \"card1_title\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"First card title\",\n    \"description\": \"Title of the progress card.\",\n    \"default\": \"Export\"\n  },\n  {\n    \"id\": \"card1_status\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"First card status\",\n    \"description\": \"Status beside the title while it runs.\",\n    \"default\": \"rendering\"\n  },\n  {\n    \"id\": \"card1_status_done\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"First card done status\",\n    \"description\": \"Status once the bar has filled.\",\n    \"default\": \"complete\"\n  },\n  {\n    \"id\": \"card1_text\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"First card text\",\n    \"description\": \"Message while it runs.\",\n    \"default\": \"Your video preview is encoding.\"\n  },\n  {\n    \"id\": \"card1_text_done\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"First card done text\",\n    \"description\": \"Message once it is done.\",\n    \"default\": \"promo-final.mp4 is ready.\"\n  },\n  {\n    \"id\": \"card2_title\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Second card title\",\n    \"description\": \"Title of the message card (its first letter fills the avatar).\",\n    \"default\": \"Messages\"\n  },\n  {\n    \"id\": \"card2_text\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Second card text\",\n    \"description\": \"Message of the second card, followed by typing dots.\",\n    \"default\": \"Miguel: can it feel alive but still native?\"\n  },\n  {\n    \"id\": \"chip_1\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Action chip 1\",\n    \"description\": \"First action chip.\",\n    \"default\": \"Reply\"\n  },\n  {\n    \"id\": \"chip_2\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Action chip 2\",\n    \"description\": \"Second action chip.\",\n    \"default\": \"Mark Read\"\n  },\n  {\n    \"id\": \"resolution\",\n    \"type\": \"number\",\n    \"role\": \"quality\",\n    \"label\": \"Resolution\",\n    \"description\": \"Scale of the aurora canvas relative to the frame. The aurora is soft, so 0.5 looks the same.\",\n    \"default\": 0.5,\n    \"min\": 0.25,\n    \"max\": 1,\n    \"step\": 0.05\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Glass Notification Aurora</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&amp;display=block\" />\n      <style>\n        #root { position: absolute; inset: 0; overflow: hidden; container-type: size; background: #0a1230; font-family: \"Inter\", system-ui, sans-serif; color: #fff; pointer-events: none; }\n        #gn-clip { position: absolute; inset: 0; }\n        #gn-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n        .gn-card { position: absolute; left: 0; top: 0; display: flex; align-items: center; gap: 16px; opacity: 0; box-sizing: border-box; overflow: hidden;\n          background: linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.05));\n          -webkit-backdrop-filter: blur(22px) saturate(1.5); backdrop-filter: blur(22px) saturate(1.5);\n          border: 1px solid rgba(255, 255, 255, 0.28);\n          box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), inset 0 -1px 0 rgba(255, 255, 255, 0.08), 0 14px 40px rgba(0, 0, 0, 0.35); }\n        .gn-tile { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 10px 24px rgba(0, 0, 0, 0.24); }\n        .gn-tile svg { width: 56%; height: 56%; display: block; }\n        .gn-body { flex: 1; min-width: 0; position: relative; }\n        .gn-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 3px; }\n        .gn-name { font-weight: 700; }\n        .gn-time { font-weight: 500; color: rgba(255, 255, 255, 0.6); position: relative; display: inline-block; }\n        .gn-time span { display: inline-block; }\n        .gn-time .gn-b { position: absolute; left: 0; top: 0; opacity: 0; white-space: nowrap; }\n        .gn-text { font-weight: 500; color: rgba(255, 255, 255, 0.9); line-height: 1.32; position: relative; }\n        .gn-text .gn-b { position: absolute; left: 0; top: 0; opacity: 0; width: 100%; }\n        .gn-dot { border-radius: 50%; background: #06e3fa; box-shadow: 0 0 16px rgba(6, 227, 250, 0.65); }\n        .gn-progress { position: absolute; height: 3px; overflow: hidden; border-radius: 999px; background: rgba(255, 255, 255, 0.2); }\n        .gn-fill { width: 0%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #06e3fa, #4fdb5e); box-shadow: 0 0 16px rgba(79, 219, 94, 0.55); }\n        .gn-actions { position: absolute; display: flex; opacity: 0; }\n        .gn-chip { border-radius: 999px; background: rgba(255, 255, 255, 0.18); color: rgba(255, 255, 255, 0.95); font-weight: 700; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25); }\n        .gn-dots { display: inline-flex; margin-left: 5px; }\n        .gn-dots span { border-radius: 50%; background: rgba(255, 255, 255, 0.75); }\n      </style>\n      <div id=\"root\" data-composition-id=\"glass-notification-aurora\" data-duration=\"8\" data-fps=\"30\">\n        <div id=\"gn-clip\" class=\"clip\" data-start=\"0\" data-duration=\"8\" data-track-index=\"0\">\n          <canvas id=\"gn-canvas\"></canvas>\n          <div id=\"gn-c1\" class=\"gn-card\">\n            <div class=\"gn-tile\" id=\"gn-t1\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3\"/><path d=\"M10 9.5v5l4.5-2.5Z\" fill=\"#fff\"/></svg></div>\n            <div class=\"gn-body\">\n              <div class=\"gn-head\"><span class=\"gn-name\" id=\"gn-n1\"></span><span class=\"gn-dot\" id=\"gn-dot\"></span><span class=\"gn-time\"><span id=\"gn-s1a\"></span><span class=\"gn-b\" id=\"gn-s1b\"></span></span></div>\n              <div class=\"gn-text\"><span id=\"gn-x1a\"></span><span class=\"gn-b\" id=\"gn-x1b\"></span></div>\n            </div>\n            <div class=\"gn-progress\" id=\"gn-prog\"><div class=\"gn-fill\" id=\"gn-fill\"></div></div>\n          </div>\n          <div id=\"gn-c2\" class=\"gn-card\">\n            <div class=\"gn-tile\" id=\"gn-t2\" style=\"background:linear-gradient(135deg,#93c5fd,#2563eb)\"></div>\n            <div class=\"gn-body\">\n              <div class=\"gn-head\"><span class=\"gn-name\" id=\"gn-n2\"></span><span class=\"gn-time\" id=\"gn-time2\">now</span></div>\n              <div class=\"gn-text\"><span id=\"gn-x2\"></span><span class=\"gn-dots\" id=\"gn-dots\"><span></span><span></span><span></span></span></div>\n            </div>\n            <div class=\"gn-actions\" id=\"gn-actions\"><span class=\"gn-chip\" id=\"gn-chip1\"></span><span class=\"gn-chip\" id=\"gn-chip2\"></span></div>\n          </div>\n        </div>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\n            function str(x, f) { return typeof x === \"string\" && x.trim() ? x : f; }\n            function num(x, f, lo, hi) { var n = Number(x); return Number.isFinite(n) ? Math.min(hi, Math.max(lo, n)) : f; }\n            function $(id) { return document.getElementById(id); }\n            $(\"gn-n1\").textContent = str(vars.card1_title, \"Export\");\n            $(\"gn-s1a\").textContent = str(vars.card1_status, \"rendering\");\n            $(\"gn-s1b\").textContent = str(vars.card1_status_done, \"complete\");\n            $(\"gn-x1a\").textContent = str(vars.card1_text, \"Your video preview is encoding.\");\n            $(\"gn-x1b\").textContent = str(vars.card1_text_done, \"promo-final.mp4 is ready.\");\n            $(\"gn-n2\").textContent = str(vars.card2_title, \"Messages\");\n            var t2 = str(vars.card2_text, \"Miguel: can it feel alive but still native?\");\n            $(\"gn-x2\").textContent = t2;\n            $(\"gn-chip1\").textContent = str(vars.chip_1, \"Reply\");\n            $(\"gn-chip2\").textContent = str(vars.chip_2, \"Mark Read\");\n            $(\"gn-t2\").textContent = (Array.from(str(vars.card2_title, \"Messages\"))[0] || \"M\").toUpperCase();\n\n            // Sizes follow K: cards are 520 x 118 design pixels at a 1080-high frame, and stretch to the width in portrait.\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920;\n            var portrait = H > W;\n            var K = portrait ? Math.min(2.2, (W * 0.88) / 520) : H / 1080;\n            var cw = 520 * K, ch = 118 * K;\n            var left0 = portrait ? (W - cw) / 2 : W - 580 * K;\n            var top1 = portrait ? H * 0.08 : 60 * K, top2 = top1 + 136 * K;\n            var enterFrom = (portrait ? W : 640 * K) ;\n            [[\"gn-c1\", top1], [\"gn-c2\", top2]].forEach(function (p) {\n              var e = $(p[0]);\n              e.style.width = cw + \"px\"; e.style.height = ch + \"px\"; e.style.left = left0 + \"px\"; e.style.top = p[1] + \"px\";\n              e.style.padding = 18 * K + \"px \" + 24 * K + \"px\"; e.style.borderRadius = 36 * K + \"px\"; e.style.gap = 16 * K + \"px\";\n            });\n            [\"gn-t1\", \"gn-t2\"].forEach(function (id) { var e = $(id); e.style.width = e.style.height = 48 * K + \"px\"; e.style.borderRadius = (id === \"gn-t1\" ? 14 : 24) * K + \"px\"; e.style.fontSize = 19 * K + \"px\"; });\n            $(\"gn-t1\").style.background = \"linear-gradient(135deg, #1b2347, #0b1022)\";\n            document.querySelectorAll(\".gn-name\").forEach(function (e) { e.style.fontSize = 20 * K + \"px\"; });\n            document.querySelectorAll(\".gn-time\").forEach(function (e) { e.style.fontSize = 14 * K + \"px\"; });\n            document.querySelectorAll(\".gn-text\").forEach(function (e) { e.style.fontSize = 17 * K + \"px\"; });\n            var dot = $(\"gn-dot\"); dot.style.width = dot.style.height = 8 * K + \"px\";\n            var prog = $(\"gn-prog\"); prog.style.left = 168 * K + \"px\"; prog.style.right = 26 * K + \"px\"; prog.style.height = 3 * K + \"px\"; prog.style.bottom = 15 * K + \"px\";\n            var act = $(\"gn-actions\"); act.style.right = 22 * K + \"px\"; act.style.bottom = 13 * K + \"px\"; act.style.gap = 8 * K + \"px\";\n            document.querySelectorAll(\".gn-chip\").forEach(function (e) { e.style.padding = 5 * K + \"px \" + 11 * K + \"px\"; e.style.fontSize = 12 * K + \"px\"; });\n            var dots = document.querySelectorAll(\"#gn-dots span\");\n            dots.forEach(function (e) { e.style.width = e.style.height = 4 * K + \"px\"; e.style.marginLeft = (e === dots[0] ? 5 : 3) * K + \"px\"; });\n\n            // ---- aurora backdrop: raw WebGL2, time from the timeline ----\n            var FRAG = `#version 300 es\nprecision highp float;\nin vec2 vUv;\nout vec4 outColor;\nuniform float uTime;\nuniform float uAspect;\nvec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}\nvec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}\nvec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}\nfloat snoise(vec3 v){\n  const vec2 C=vec2(1.0/6.0,1.0/3.0);const vec4 D=vec4(0.0,0.5,1.0,2.0);\n  vec3 i=floor(v+dot(v,C.yyy));vec3 x0=v-i+dot(i,C.xxx);\n  vec3 g=step(x0.yzx,x0.xyz);vec3 l=1.0-g;\n  vec3 i1=min(g.xyz,l.zxy);vec3 i2=max(g.xyz,l.zxy);\n  vec3 x1=x0-i1+C.xxx;vec3 x2=x0-i2+C.yyy;vec3 x3=x0-D.yyy;\n  i=mod289(i);\n  vec4 p=permute(permute(permute(i.z+vec4(0.0,i1.z,i2.z,1.0))+i.y+vec4(0.0,i1.y,i2.y,1.0))+i.x+vec4(0.0,i1.x,i2.x,1.0));\n  float n_=0.142857142857;vec3 ns=n_*D.wyz-D.xzx;\n  vec4 j=p-49.0*floor(p*ns.z*ns.z);vec4 x_=floor(j*ns.z)