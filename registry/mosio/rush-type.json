   "content": "<!doctype html>\n<!--\n  Rush Type\n\n  White words blast into vertical RGB shutter trails generated entirely by motion: one forceful\n  word at a time, a sharp readable rest between blasts, a tube mask and glow while it moves.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/rush-type/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n\n  Changes by usemosio/blocks: the words are drawn with a Google Font (Geist) instead of Arial so every\n  render machine draws the same letters, and the phrase is limited to 8 words.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"rush-type\"\n  data-composition-duration=\"3.4667\"\n  data-composition-variables='[{\"id\": \"phrase\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Phrase\", \"description\": \"A short phrase; one whitespace-separated word is shown per cycle (up to 8 words).\", \"default\": \"gone before you look\"}, {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Resting size\", \"description\": \"Cap height of the resting word, in pixels of a 1280×720 frame; scales with the frame.\", \"default\": 68, \"min\": 32, \"max\": 140, \"step\": 2, \"unit\": \"px\"}, {\"id\": \"font_weight\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Font weight\", \"description\": \"Weight of the word.\", \"default\": \"400\", \"options\": [{\"value\": \"400\", \"label\": \"Regular\"}, {\"value\": \"500\", \"label\": \"Medium\"}, {\"value\": \"600\", \"label\": \"Semibold\"}, {\"value\": \"700\", \"label\": \"Bold\"}, {\"value\": \"800\", \"label\": \"Extra bold\"}]}, {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Text colour\", \"description\": \"Colour of the words.\", \"default\": \"#ffffff\"}, {\"id\": \"background_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Colour behind the words.\", \"default\": \"#000000\"}, {\"id\": \"vertical_stretch\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Vertical stretch\", \"description\": \"Authored vertical scale at the blast, before perspective.\", \"default\": 7, \"min\": 3, \"max\": 12, \"step\": 0.25}, {\"id\": \"chromatic_spread\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Chromatic spread\", \"description\": \"0 removes the red/green/blue separation, 1 is the reference look, 2 exaggerates it.\", \"default\": 1, \"min\": 0, \"max\": 2, \"step\": 0.05}, {\"id\": \"rest_duration\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Rest duration\", \"description\": \"Frames a word rests, readable (30 per second).\", \"default\": 12, \"min\": 6, \"max\": 30, \"step\": 1, \"unit\": \"frames\"}, {\"id\": \"peak_hold_duration\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Peak hold\", \"description\": \"Total frames the blast hangs near the point around the word swap.\", \"default\": 3, \"min\": 0, \"max\": 15, \"step\": 1, \"unit\": \"frames\"}, {\"id\": \"speed\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Speed\", \"description\": \"Playback multiplier for the whole motion.\", \"default\": 1, \"min\": 0.25, \"max\": 4, \"step\": 0.05}, {\"id\": \"resolution\", \"type\": \"number\", \"role\": \"quality\", \"label\": \"Resolution\", \"description\": \"Share of the frame size the shader is drawn at, then scaled up. Thin shutter trails and the tube mask look the same at 0.75 as at 1.\", \"default\": 0.75, \"min\": 0.25, \"max\": 1, \"step\": 0.05}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Rush Type</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          background: #000;\n          pointer-events: none;\n        }\n        .rsh-stage {\n          position: absolute;\n          inset: 0;\n        }\n        .rsh-canvas {\n          position: absolute;\n          inset: 0;\n          width: 100%;\n          height: 100%;\n          display: block;\n        }\n        .rsh-fallback {\n          position: absolute;\n          inset: 0;\n          display: none;\n          align-items: center;\n          justify-content: center;\n          color: #fff;\n          font-family: Geist, Arial, Helvetica, sans-serif;\n          font-size: 9cqh;\n        }\n        .rsh-off .rsh-canvas {\n          display: none;\n        }\n        .rsh-off .rsh-fallback {\n          display: flex;\n        }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"rush-type\" data-duration=\"3.4667\" data-fps=\"30\">\n        <div id=\"rsh-clip\" class=\"rsh-stage clip\" data-start=\"0\" data-duration=\"3.4667\" data-track-index=\"0\">\n          <canvas id=\"rsh-canvas\" class=\"rsh-canvas\"></canvas>\n          <div id=\"rsh-fallback\" class=\"rsh-fallback\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"rush-type\";\n            var root = document.getElementById(\"root\");\n            var stage = document.getElementById(\"rsh-clip\");\n            var canvas = document.getElementById(\"rsh-canvas\");\n            var fallback = document.getElementById(\"rsh-fallback\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function clampNum(value, fallbackValue, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallbackValue;\n            }\n            function hex(value, fallbackValue) {\n              var m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(String(value || \"\").trim());\n              if (!m) return fallbackValue;\n              var h = m[1].length === 3 ? m[1].replace(/./g, \"$&$&\") : m[1];\n              return \"#\" + h.toLowerCase();\n            }\n            function rgb(value) {\n              var h = hex(value, \"#ffffff\").slice(1);\n              return [parseInt(h.slice(0, 2), 16) / 255, parseInt(h.slice(2, 4), 16) / 255, parseInt(h.slice(4, 6), 16) / 255];\n            }\n            var DEFS = [{\"id\": \"phrase\", \"type\": \"string\", \"default\": \"gone before you look\"}, {\"id\": \"font_size\", \"type\": \"number\", \"default\": 68, \"min\": 32, \"max\": 140}, {\"id\": \"font_weight\", \"type\": \"enum\", \"default\": \"400\", \"options\": [\"400\", \"500\", \"600\", \"700\", \"800\"]}, {\"id\": \"color\", \"type\": \"color\", \"default\": \"#ffffff\"}, {\"id\": \"background_color\", \"type\": \"color\", \"default\": \"#000000\"}, {\"id\": \"vertical_stretch\", \"type\": \"number\", \"default\": 7, \"min\": 3, \"max\": 12}, {\"id\": \"chromatic_spread\", \"type\": \"number\", \"default\": 1, \"min\": 0, \"max\": 2}, {\"id\": \"rest_duration\", \"type\": \"number\", \"default\": 12, \"min\": 6, \"max\": 30}, {\"id\": \"peak_hold_duration\", \"type\": \"number\", \"default\": 3, \"min\": 0, \"max\": 15}, {\"id\": \"speed\", \"type\": \"number\", \"default\": 1, \"min\": 0.25, \"max\": 4}, {\"id\": \"resolution\", \"type\": \"number\", \"default\": 0.75, \"min\": 0.25, \"max\": 1}];\n            var V = {};\n            DEFS.forEach(function (d) {\n              var raw = vars[d.id];\n              if (d.type === \"number\") V[d.id] = clampNum(raw, d.default, d.min, d.max);\n              else if (d.type === \"color\") V[d.id] = hex(raw, d.default);\n              else if (d.type === \"enum\") V[d.id] = d.options.indexOf(String(raw)) >= 0 ? String(raw) : d.default;\n              else V[d.id] = typeof raw === \"string\" && raw.trim() ? raw.trim() : d.default;\n            });\n\n            // ---- The motion: remocn's timeline (arrive, rest, depart, hang), ported as plain functions of the frame.\n            var ARRIVE_FRAMES = 7, LEAVE_FRAMES = 4;\n            var SHUTTER_SECONDS = 0.04, SMEAR_GAIN = 1.6, SAMPLES = 28, SHUTTER_SHAPE = 0.85;\n            var ROLL_U = 0.38, LAG_U = 0.55, THIN = 0.55, BLOOM_GAIN = 0.5, BLOOM_SPREAD = 3.2, BLOOM_BIAS = 3.5;\n            var SPEED_GAIN = 0.95, EXPOSURE = 1.75, HORIZONTAL_STRETCH = 1.57, FOCAL = 1;\n            var ORBIT_DEPTH = 0.42, ORBIT_RISE = 0.16, ORBIT_YAW = 0.55, ORBIT_YAW_LAG = 0.6;\n            var ORBIT_PITCH = 0.26, ORBIT_PITCH_LAG = -0.9, ORBIT_HANG_ARC = 0.9, PIVOT_FRAC = 0.07;\n            var CRT_GAIN = 1, CRT_PITCH = 5, CRT_MASK = 0.16, CRT_SCAN_PITCH = 3, CRT_SCAN = 0.12, CRT_BEAM = 0.7;\n            var CRT_HUM = 0.035, CRT_HUM_SPEED = 0.14, GROUND_SPEED = 0.028;\n            var GLOW_SPREAD = 2.6, GLOW_MIN = 0.34, GLOW_MAX_Y = 1.2, SWAP_SPREAD = 0.35, SWAP_FLASH = 0.5;\n            var FALL = [1, 0.557, 0.121, 0.049, 0.014, 0];\n            var RISE = [0, 0.08, 0.8, 1];\n            var ORBIT_IN = [0, 0.5, 0.82, 0.95, 1, 1];\n            var ORBIT_OUT = [0, 0.05, 0.14, 0.38, 1];\n            var DRIFT_DIRECTION = [-1, 0.7, -0.45, 1];\n            var SWING_ARC = Math.PI - ORBIT_HANG_ARC;\n            function mod(value, modulus) { return ((value % modulus) + modulus) % modulus; }\n            function sampleTable(table, progress) {\n              var last = table.length - 1;\n              var x = Math.min(Math.max(progress, 0), 1) * last;\n              var index = Math.min(Math.floor(x), last - 1);\n              return table[index] + (table[index + 1] - table[index]) * (x - index);\n            }\n\n            var words = V.phrase.split(/\\s+/).filter(Boolean).slice(0, 8);\n            if (!words.length) words = \"gone before you look\".split(\" \");\n            var restFrames = Math.max(V.rest_duration, 1);\n            var holdFrames = Math.max(V.peak_hold_duration, 0);\n            var cycleLength = ARRIVE_FRAMES + LEAVE_FRAMES + restFrames + holdFrames;\n\n            function pose(frame) {\n              var halfHold = holdFrames / 2;\n              var arriveEnd = halfHold + ARRIVE_FRAMES;\n              var restEnd = arriveEnd + restFrames;\n              var leaveEnd = restEnd + LEAVE_FRAMES;\n              var startOffset = arriveEnd + restFrames / 2;\n              var shifted = frame + startOffset;\n              var cycle = Math.floor(shifted / cycleLength);\n              var tau = mod(shifted, cycleLength);\n              var wordIndex = mod(cycle, words.length);\n              var progress;\n              if (tau < halfHold) return { p: 1, psi: ORBIT_HANG_ARC * (tau / Math.max(halfHold, 1e-6)), cycle: cycle, wordIndex: wordIndex };\n              if (tau < arriveEnd) {\n                progress = (tau - halfHold) / ARRIVE_FRAMES;\n                return { p: sampleTable(FALL, progress), psi: ORBIT_HANG_ARC + SWING_ARC * sampleTable(ORBIT_IN, progress), cycle: cycle, wordIndex: wordIndex };\n              }\n              if (tau < restEnd) return { p: 0, psi: Math.PI, cycle: cycle, wordIndex: wordIndex };\n              if (tau < leaveEnd) {\n                progress = (tau - restEnd) / LEAVE_FRAMES;\n                return { p: sampleTable(RISE, progress), psi: Math.PI + SWING_ARC * sampleTable(ORBIT_OUT, progress), cycle: cycle, wordIndex: wordIndex };\n              }\n              progress = (tau - leaveEnd) / Math.max(halfHold, 1e-6);\n              return { p: 1, psi: 2 * Math.PI - ORBIT_HANG_ARC * (1 - progress), cycle: cycle, wordIndex: wordIndex };\n            }\n            function orbitTurn(psi, amplitude, lag) {\n              var pin = Math.sin(lag);\n              return (amplitude * (Math.sin(psi - lag) - pin)) / (1 + Math.abs(pin));\n            }\n            function compute(frame) {\n              var shutterFrames = SHUTTER_SECONDS * 30;\n              var halfShutter = shutterFrames / 2;\n              var before = pose(frame - halfShutter);\n              var here = pose(frame);\n              var after = pose(frame + halfShutter);\n              var halfHold = holdFrames / 2;\n              var arriveEnd = halfHold + ARRIVE_FRAMES;\n              var startOffset = arriveEnd + restFrames / 2;\n              var shifted = frame + startOffset;\n              var nearestBoundary = Math.round(shifted / cycleLength) * cycleLength;\n              var boundaryDistance = shifted - nearestBoundary;\n              var crossesSwap = words.length > 1 && after.cycle > before.cycle;\n              var swapU = crossesSwap ? (after.cycle * cycleLength - shifted) / shutterFrames : 2;\n              var swapAmount = words.length > 1 ? Math.max(0, 1 - Math.pow(2 * boundaryDistance, 2) / Math.pow(shutterFrames, 2)) : 0;\n              var spread = Math.max(V.chromatic_spread, 0);\n              return { before: before, here: here, after: after, swapU: swapU, swapAmount: swapAmount, k: [Math.pow(0.62, spread), 1, Math.pow(0.34, spread)] };\n            }\n\n            // ---- remocn's fragment shader (a perspective shutter-blur of a word atlas, with a tube mask).\n            var VERTEX = [\n              \"attribute vec2 aPos;\",\n              \"varying vec2 vUv;\",\n              \"void main() {\",\n              \"  vUv = aPos * 0.5 + 0.5;\",\n              \"  gl_Position = vec4(aPos, 0.0, 1.0);\",\n              \"}\"\n            ].join(\"\\n\");\n            var FRAGMENT = `\nprecision highp float;\nvarying vec2 vUv;\n\nuniform sampler2D uText;\nuniform vec2 uRes;\nuniform vec2 uHalfPx;\nuniform float uAtlasRows;\nuniform float uSx;\nuniform vec3 uSyQ;\nuniform float uCenterY;\nuniform float uSwapU;\nuniform float uHalfA;\nuniform float uHalfB;\nuniform vec3 uK;\nuniform vec2 uSwapScl;\nuniform float uShape;\nuniform float uRoll;\nuniform float uLag;\nuniform float uThin;\nuniform float uBloom;\nuniform float uGain;\nuniform float uExp;\nuniform float uFocal;\nuniform vec3 uPos;\nuniform vec4 uRot;\nuniform float uCrt;\nuniform float uTime;\nuniform vec4 uGlow;\nuniform float uGlowAmp;\nuniform vec3 uColor;\nuniform vec3 uBg;\n\n#define SAMPLES 28\n#define BLOOM_TAPS 4\n#define BLOOM_SPREAD 3.200\n#define BLOOM_BIAS 3.500\n#define TAU 6.2831853\n#define CRT_PITCH 5.000\n#define CRT_MASK 0.1600\n#define CRT_SCAN_PITCH 3.000\n#define CRT_SCAN 0.1200\n#define CRT_BEAM 0.7000\n#define CRT_HUM 0.0350\n#define CRT_HUM_SPEED 0.1400\n\nvec2 atlasUv(float sy, float halfIdx, vec2 wordPoint, out float inside) {\n  float sx = max(uSx, 1e-4);\n  float sv = max(abs(sy), 1e-4);\n  vec2 q = vec2(\n    (wordPoint.x / sx + uHalfPx.x * 0.5) / uHalfPx.x,\n    (wordPoint.y / sv + uHalfPx.y * 0.5) / uHalfPx.y\n  );\n  inside = step(0.0, q.x) * step(q.x, 1.0) * step(0.0, q.y) * step(q.y, 1.0);\n  return vec2(\n    clamp(q.x, 0.0, 1.0),\n    (clamp(q.y, 0.0, 1.0) + halfIdx) / uAtlasRows\n  );\n}\n\nfloat tap(float sy, float halfIdx, vec2 wordPoint, float front) {\n  float inside;\n  vec2 texturePoint = atlasUv(sy, halfIdx, wordPoint, inside);\n  float value = texture2D(uText, texturePoint).r * inside * front;\n  return value * mix(1.0, value, uThin);\n}\n\nfloat tapBlur(float sy, float halfIdx, vec2 wordPoint, float front) {\n  float inside;\n  vec2 texturePoint = atlasUv(sy, halfIdx, wordPoint, inside);\n  return texture2D(uText, texturePoint, BLOOM_BIAS).r * inside * front;\n}\n\nvoid main() {\n  vec2 pixel = vUv * uRes;\n  vec2 center = vec2(uRes.x * 0.5, uRes.y * uCenterY);\n  vec2 screenPoint = pixel - center;\n\n  float sinYaw = uRot.x;\n  float cosYaw = uRot.y;\n  float sinPitch = uRot.z;\n  float cosPitch = uRot.w;\n  float a1 = -(screenPoint.x * sinYaw + uFocal * cosYaw);\n  float b1 = sinPitch * (screenPoint.x * cosYaw - uFocal * sinYaw);\n  float c1 = uFocal * uPos.x - screenPoint.x * uPos.z;\n  float a2 = -screenPoint.y * sinYaw;\n  float b2 = screenPoint.y * sinPitch * cosYaw - uFocal * cosPitch;\n  float c2 = uFocal * uPos.y - screenPoint.y * uPos.z;\n  float determinant = a1 * b2 - a2 * b1;\n  float inverse = 1.0 / (abs(determinant) < 1e-4 ? 1e-4 : determinant);\n  float a = (c1 * b2 - c2 * b1) * inverse;\n  float b = (a1 * c2 - a2 * c1) * inverse;\n  float cameraZ = uPos.z - a * sinYaw + b * sinPitch * cosYaw;\n  vec2 wordPoint = vec2(a, b);\n  float front = step(uFocal * 0.05, cameraZ);\n  vec3 accumulated = vec3(0.0);\n\n  if (abs(uSyQ.y) + abs(uSyQ.z) < 1e-5) {\n    accumulated = vec3(tap(uSyQ.x, uHalfA, wordPoint, front));\n  } else {\n    float offset =\n      uLag * (wordPoint.x / uRes.x) - uRoll * (screenPoint.y / uRes.y);\n    float weightSum = 0.0;\n\n    for (int i = 0; i < SAMPLES; i++) {\n      float u = float(i) / float(SAMPLES - 1) - 0.5;\n      float weight = 1.0 - uShape * abs(u) * 2.0;\n      weightSum += weight;\n      float shiftedU = u + offset;\n      vec3 shutterU = shiftedU * uK;\n      vec3 sy = uSyQ.x + uSyQ.y * shutterU + uSyQ.z * shutterU * shutterU;\n      accumulated.r += weight * tap(\n        sy.r * (shutterU.r < uSwapU ? uSwapScl.x : uSwapScl.y),\n        shutterU.r < uSwapU ? uHalfA : uHalfB,\n        wordPoint,\n        front\n      );\n      accumulated.g += weight * tap(\n        sy.g * (shutterU.g < uSwapU ? uSwapScl.x : uSwapScl.y),\n        shutterU.g < uSwapU ? uHalfA : uHalfB,\n        wordPoint,\n        front\n      );\n      accumulated.b += weight * tap(\n        sy.b * (shutterU.b < uSwapU ? uSwapScl.x : uSwapScl.y),\n        shutterU.b < uSwapU ? uHalfA : uHalfB,\n        wordPoint,\n        front\n      );\n    }\n\n    accumulated /= max(weightSum, 1e-4);\n\n    vec3 halo = vec3(0.0);\n    for (int j = 0; j < BLOOM_TAPS; j++) {\n      float u =\n        (float(j) / float(BLOOM_TAPS - 1) - 0.5) * BLOOM_SPREAD + offset;\n      vec3 shutterU = u * uK;\n      vec3 sy = uSyQ.x + uSyQ.y * shutterU + uSyQ.z * shutterU * shutterU;\n      halo.r += tapBlur(\n        sy.r * (shutterU.r < uSwapU ? uSwapScl.x : uSwapScl.y),\n        shutterU.r < uSwapU ? uHalfA : uHalfB,\n        wordPoint,\n        front\n      );\n      halo.g += tapBlur(\n        sy.g * (shutterU.g < uSwapU ? uSwapScl.x : uSwapScl.y),\n        shutterU.g < uSwapU ? uHalfA : uHalfB,\n        wordPoint,\n        front\n      );\n      halo.b += tapBlur(\n        sy.b * (shutterU.b < uSwapU ? uSwapScl.x : uSwapScl.y),\n        shutterU.b < uSwapU ? uHalfA : uHalfB,\n        wordPoint,\n        front\n      );\n    }\n    accumulated += halo * (uBloom / float(BLOOM_TAPS));\n    accumulated *= uGain;\n  }\n\n  accumulated =\n    (1.0 - exp(-accumulated * uExp)) / (1.0 - exp(-uExp));\n\n  vec2 glowDistance =\n    (pixel - uGlow.xy) / max(uGlow.zw, vec2(1.0));\n  float ground =\n    uGlowAmp * (1.0 - smoothstep(0.0, 1.0, length(glowDistance)));\n  accumulated += ground * (1.0 - accumulated);\n\n  if (uCrt > 0.0) {\n    float luminance = max(max(accumulated.r, accumulated.g), accumulated.b);\n    vec3 maskWave = 0.5 + 0.5 * cos(\n      TAU * (pixel.x / CRT_PITCH - vec3(0.0, 0.33333, 0.66667))\n    );\n    vec3 mask = mix(vec3(1.0), maskWave * 2.0, CRT_MASK * uCrt);\n    float scanWave = 0.5 + 0.5 * cos(TAU * pixel.y / CRT_SCAN_PITCH);\n    float scan =\n      1.0 - CRT_SCAN * uCrt * (1.0 - CRT_BEAM * luminance) * (1.0 - scanWave);\n    float bar = 0.5 + 0.5 * cos(\n      TAU * (pixel.y / uRes.y - uTime * CRT_HUM_SPEED)\n    );\n    float hum = 1.0 + CRT_HUM * uCrt * (bar * 2.0 - 1.0);\n    accumulated *= mask * scan * hum;\n  }\n\n  gl_FragColor = vec4(uBg + (uColor - uBg) * accumulated, 1.0);\n}\n`;\n\n            var W = Math.max(2, root.clientWidth);\n            var H = Math.max(2, root.clientHeight);\n            var res = V.resolution;\n            var cw = Math.max(2, Math.round(W * res));\n            var ch = Math.max(2, Math.round(H * res));\n            canvas.width = cw;\n            canvas.height = ch;\n            root.style.background = V.background_color;\n            fallback.style.background = V.background_color;\n            fallback.style.color = V.color;\n            fallback.style.fontWeight = V.font_weight;\n            var FONT = \"Geist, Arial, Helvetica, sans-serif\";\n            var gl = canvas.getContext(\"webgl2\", { alpha: false, antialias: false, depth: false, stencil: false, preserveDrawingBuffer: true });\n            function compile(type, source) {\n              var shader = gl.createShader(type);\n              gl.shaderSource(shader, source);\n              gl.compileShader(shader);\n              if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader) || \"shader compile failed\");\n              return shader;\n            }\n            var paint = null;\n            var rasterize = function () {};\n            var ATLAS_W = 2048, HALF_H = ATLAS_W / 4,