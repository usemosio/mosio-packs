   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Flight Route Map\n\n  A plane flies a glowing route between two labelled pins over a drawn map, the camera drifts, the destination gets a hand-drawn circle and an arrival badge.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/heygen-com/hyperframes/blob/bd6cff8157a1a0ed5075527e673cc4f321fe9123/registry/blocks/nyc-paris-flight/nyc-paris-flight.html\n\n  Copyright HeyGen, Inc. and the Hyperframes contributors. Licensed under the Apache License,\n  Version 2.0 (the \"License\"); you may not use this file except in compliance with the License.\n  You may obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0. Unless\n  required by applicable law or agreed to in writing, software distributed under the License is\n  distributed on an \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express\n  or implied. See the License for the specific language governing permissions and limitations\n  under the License.\n\n  Changes by usemosio/blocks: fills the host frame (the route runs left to right in a wide frame and bottom to top in a tall one), renamed from nyc-paris-flight and made generic (origin, destination, codes, headline and badge are variables, no real cities, no distance), the OpenStreetMap map image is replaced by a drawn map (ocean, graticule, seeded landmasses), the sound effect file is dropped, the plane follows the path from the timeline instead of CSS offset-path, colours are variables.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"flight-route-map\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[\n    {\"id\": \"origin\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Origin\", \"description\": \"Name of the departure point, on its pin and in the headline.\", \"default\": \"Harbor City\", \"maxLength\": 24},\n    {\"id\": \"origin_code\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Origin code\", \"description\": \"Small line under the origin name.\", \"default\": \"HBR / NORTH\", \"maxLength\": 20},\n    {\"id\": \"destination\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Destination\", \"description\": \"Name of the arrival point, on its pin and in the headline.\", \"default\": \"Summit City\", \"maxLength\": 24},\n    {\"id\": \"destination_code\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Destination code\", \"description\": \"Small line under the destination name.\", \"default\": \"SMT / EAST\", \"maxLength\": 20},\n    {\"id\": \"eyebrow\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Eyebrow\", \"description\": \"Small line above the headline.\", \"default\": \"Six-second hop\", \"maxLength\": 40},\n    {\"id\": \"joiner\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Joiner\", \"description\": \"Accent word between the two names in the headline.\", \"default\": \"TO\", \"maxLength\": 10},\n    {\"id\": \"route_note\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Route note\", \"description\": \"Line under the headline.\", \"default\": \"A long way, compressed\", \"maxLength\": 40},\n    {\"id\": \"arrived\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Arrival badge\", \"description\": \"Badge that pops next to the destination.\", \"default\": \"ARRIVED\", \"maxLength\": 16},\n    {\"id\": \"accent\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Route colour\", \"description\": \"Colour of the route, pins and plane.\", \"default\": \"#2563eb\"},\n    {\"id\": \"doodle\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Circle colour\", \"description\": \"Colour of the hand-drawn circle and the badge.\", \"default\": \"#e5322d\"},\n    {\"id\": \"ink\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Text colour\", \"description\": \"Headline and label colour.\", \"default\": \"#1d1d1f\"},\n    {\"id\": \"ocean\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Ocean\", \"description\": \"Sea colour of the map.\", \"default\": \"#dfe7f1\"},\n    {\"id\": \"land\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Land\", \"description\": \"Colour of the landmasses.\", \"default\": \"#f6f6f2\"}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Flight Route Map</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800;900&amp;display=block\" />\n      <style>\n        #root { position: absolute; inset: 0; overflow: hidden; container-type: size; font-family: Inter, system-ui, sans-serif; color: var(--frm-ink, #1d1d1f); background: var(--frm-ocean, #dfe7f1); pointer-events: none; }\n        #frm-plane-map { position: absolute; inset: 0; transform-origin: 52% 48%; }\n        #frm-map, #frm-route, #frm-doodle { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }\n        #frm-route path, #frm-doodle path { fill: none; stroke-linecap: round; }\n        .frm-tick { position: absolute; border-radius: 999px; background: #fff; opacity: 0; }\n        .frm-pin { position: absolute; border-radius: 999px; background: #fff; transform: translate(-50%, -50%); }\n        .frm-label { position: absolute; background: rgba(255, 255, 255, 0.84); font-weight: 800; line-height: 1; white-space: nowrap; box-shadow: 0 18px 38px rgba(29, 29, 31, 0.16); }\n        .frm-label span { display: block; color: #6e6e73; font-weight: 700; }\n        #frm-plane { position: absolute; left: 0; top: 0; filter: drop-shadow(0 12px 12px rgba(0, 0, 0, 0.24)); }\n        #frm-plane svg { width: 100%; height: 100%; overflow: visible; display: block; }\n        #frm-pulse { position: absolute; border-radius: 999px; opacity: 0; }\n        #frm-badge { position: absolute; background: rgba(255, 255, 255, 0.92); font-weight: 900; line-height: 1; opacity: 0; transform-origin: center; white-space: nowrap; box-shadow: 0 20px 44px rgba(29, 29, 31, 0.14); }\n        #frm-title { position: absolute; background: rgba(255, 255, 255, 0.72); border: 1px solid rgba(255, 255, 255, 0.86); box-shadow: 0 28px 70px rgba(29, 29, 31, 0.12); backdrop-filter: blur(22px); }\n        #frm-eyebrow { color: #6e6e73; font-weight: 800; }\n        #frm-headline { font-weight: 900; line-height: 0.95; }\n        #frm-headline span { color: var(--frm-accent, #2563eb); }\n        #frm-meta { display: flex; align-items: center; color: #6e6e73; font-weight: 800; }\n        #frm-meta i { display: block; border-radius: 999px; background: var(--frm-accent, #2563eb); }\n        #frm-white { position: absolute; inset: 0; background: #fff; opacity: 0; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"flight-route-map\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"frm-clip\" class=\"clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\" style=\"position:absolute;inset:0\">\n          <div id=\"frm-plane-map\">\n            <svg id=\"frm-map\"></svg>\n            <svg id=\"frm-route\"><path id=\"frm-glow\"></path><path id=\"frm-path\"></path><path id=\"frm-thread\"></path></svg>\n            <div id=\"frm-ticks\"></div>\n            <div id=\"frm-pin-a\" class=\"frm-pin\"><div class=\"frm-label\" id=\"frm-label-a\"></div></div>\n            <div id=\"frm-pin-b\" class=\"frm-pin\"><div class=\"frm-label\" id=\"frm-label-b\"></div></div>\n            <div id=\"frm-plane\"><svg viewBox=\"-64 -64 128 128\"><path d=\"M 58 0 C 52 -10 37 -15 15 -16 L -18 -56 C -23 -62 -34 -58 -32 -49 L -21 -15 L -48 -12 C -56 -11 -60 -6 -60 0 C -60 6 -56 11 -48 12 L -21 15 L -32 49 C -34 58 -23 62 -18 56 L 15 16 C 37 15 52 10 58 0 Z\" fill=\"#fff\"></path><path id=\"frm-plane-fill\" d=\"M 54 0 C 46 -6 33 -9 14 -10 L -19 -50 C -21 -53 -25 -52 -25 -47 L -15 -10 L -49 -6 C -53 -5 -55 -2 -55 0 C -55 2 -53 5 -49 6 L -15 10 L -25 47 C -25 52 -21 53 -19 50 L 14 10 C 33 9 46 6 54 0 Z\"></path><circle cx=\"18\" cy=\"0\" r=\"6\" fill=\"#f5f5f7\" opacity=\"0.95\"></circle></svg></div>\n            <svg id=\"frm-doodle\"><path id=\"frm-doodle-a\"></path><path id=\"frm-doodle-b\"></path></svg>\n            <div id=\"frm-pulse\"></div>\n            <div id=\"frm-badge\"></div>\n          </div>\n          <div id=\"frm-title\"><div id=\"frm-eyebrow\"></div><div id=\"frm-headline\"></div><div id=\"frm-meta\"><i></i><p id=\"frm-note\"></p></div></div>\n          <div id=\"frm-white\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NS = \"http://www.w3.org/2000/svg\";\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\n            function str(v, f, max) { return typeof v === \"string\" && v.trim() ? v.trim().slice(0, max || 40) : f; }\n            function col(v, f) { return typeof v === \"string\" && v ? v : f; }\n            var origin = str(vars.origin, \"Harbor City\", 24), destination = str(vars.destination, \"Summit City\", 24);\n            var accent = col(vars.accent, \"#2563eb\"), doodleCol = col(vars.doodle, \"#e5322d\");\n            root.style.setProperty(\"--frm-ink\", col(vars.ink, \"#1d1d1f\"));\n            root.style.setProperty(\"--frm-accent\", accent);\n            root.style.setProperty(\"--frm-ocean\", col(vars.ocean, \"#dfe7f1\"));\n            var DUR = 6;\n            function $(id) { return document.getElementById(id); }\n            function px(el, props) { for (var p in props) el.style[p] = props[p] + \"px\"; }\n            function mulberry32(a) { return function () { a |= 0; a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n\n            var W = root.clientWidth || 1920, H = root.clientHeight || 1080;\n            var portrait = H > W;\n            var k = Math.min(W, H) / 1080;\n\n            /* Route: left-low to right-high in a wide frame, bottom to top in a tall one. */\n            var A = portrait ? { x: W * 0.27, y: H * 0.8 } : { x: W * 0.16, y: H * 0.54 };\n            var B = portrait ? { x: W * 0.74, y: H * 0.3 } : { x: W * 0.84, y: H * 0.36 };\n            var c1 = portrait ? { x: W * 0.05, y: H * 0.5 } : { x: W * 0.34, y: H * 0.48 };\n            var c2 = portrait ? { x: W * 0.9, y: H * 0.6 } : { x: W * 0.58, y: H * 0.23 };\n            var routeD = \"M \" + A.x + \" \" + A.y + \" C \" + c1.x + \" \" + c1.y + \" \" + c2.x + \" \" + c2.y + \" \" + B.x + \" \" + B.y;\n\n            /* The map: ocean, a graticule, two drawn landmasses and a few islands. */\n            var map = $(\"frm-map\");\n            map.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H);\n            function el(tag, attrs, parent) { var e = document.createElementNS(NS, tag); for (var a in attrs) e.setAttribute(a, attrs[a]); (parent || map).appendChild(e); return e; }\n            var defs = el(\"defs\", {});\n            var rg = el(\"radialGradient\", { id: \"frm-sea\", cx: \"50%\", cy: \"30%\", r: \"70%\" }, defs);\n            el(\"stop\", { offset: \"0\", \"stop-color\": \"#ffffff\", \"stop-opacity\": \"0.5\" }, rg);\n            el(\"stop\", { offset: \"1\", \"stop-color\": \"#ffffff\", \"stop-opacity\": \"0\" }, rg);\n            el(\"rect\", { x: 0, y: 0, width: W, height: H, fill: \"url(#frm-sea)\" });\n            var grid = 120 * k;\n            for (var gx = grid / 2; gx < W; gx += grid) el(\"line\", { x1: gx, y1: 0, x2: gx, y2: H, stroke: \"#fff\", \"stroke-opacity\": 0.55, \"stroke-width\": 1.5 * k });\n            for (var gy = grid / 2; gy < H; gy += grid) el(\"line\", { x1: 0, y1: gy, x2: W, y2: gy, stroke: \"#fff\", \"stroke-opacity\": 0.55, \"stroke-width\": 1.5 * k });\n            var landFill = col(vars.land, \"#f6f6f2\");\n            function blob(cx, cy, r, seed, n, squash) {\n              var rnd = mulberry32(seed), pts = [], i;\n              for (i = 0; i < n; i++) {\n                var a = (i / n) * Math.PI * 2, rr = r * (0.62 + rnd() * 0.55);\n                pts.push([cx + Math.cos(a) * rr, cy + Math.sin(a) * rr * (squash || 1)]);\n              }\n              var d = \"M \" + pts[0][0].toFixed(1) + \" \" + pts[0][1].toFixed(1);\n              for (i = 0; i < n; i++) {\n                var p0 = pts[(i - 1 + n) % n], p1 = pts[i], p2 = pts[(i + 1) % n], p3 = pts[(i + 2) % n];\n                d += \" C \" + (p1[0] + (p2[0] - p0[0]) / 6).toFixed(1) + \" \" + (p1[1] + (p2[1] - p0[1]) / 6).toFixed(1) + \" \" +\n                  (p2[0] - (p3[0] - p1[0]) / 6).toFixed(1) + \" \" + (p2[1] - (p3[1] - p1[1]) / 6).toFixed(1) + \" \" + p2[0].toFixed(1) + \" \" + p2[1].toFixed(1);\n              }\n              return d + \" Z\";\n            }\n            var R = Math.min(W, H);\n            [[A.x - R * 0.1, A.y - R * 0.04, R * 0.42, 11, 1.0], [A.x + R * 0.28, A.y + R * 0.3, R * 0.2, 12, 0.8], [B.x + R * 0.1, B.y - R * 0.02, R * 0.4, 5, 0.9], [B.x - R * 0.3, B.y - R * 0.34, R * 0.18, 6, 0.8],\n             [(A.x + B.x) / 2 + R * 0.05, (A.y + B.y) / 2 + R * 0.12, R * 0.07, 14, 0.8], [(A.x + B.x) / 2 - R * 0.18, (A.y + B.y) / 2 - R * 0.08, R * 0.05, 15, 0.9]].forEach(function (b) {\n              el(\"path\", { d: blob(b[0], b[1], b[2], b[3], 9, b[4]), fill: landFill, stroke: \"#c9d3df\", \"stroke-width\": 2 * k });\n            });\n\n            var route = $(\"frm-route\");\n            route.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H);\n            var glow = $(\"frm-glow\"), path = $(\"frm-path\"), thread = $(\"frm-thread\");\n            [glow, path, thread].forEach(function (p) { p.setAttribute(\"d\", routeD); });\n            glow.setAttribute(\"stroke\", accent); glow.setAttribute(\"stroke-opacity\", 0.23); glow.setAttribute(\"stroke-width\", 24 * k); glow.style.filter = \"blur(\" + 4 * k + \"px)\";\n            path.setAttribute(\"stroke\", accent); path.setAttribute(\"stroke-width\", 9 * k);\n            thread.setAttribute(\"stroke\", \"#fff\"); thread.setAttribute(\"stroke-opacity\", 0.86); thread.setAttribute(\"stroke-width\", 3 * k);\n            var LEN = path.getTotalLength();\n            [glow, path, thread].forEach(function (p) { p.style.strokeDasharray = LEN; p.style.strokeDashoffset = LEN; });\n\n            var ticks = [];\n            for (var t = 1; t <= 6; t++) {\n              var pt = path.getPointAtLength((LEN * t) / 7);\n              var tk = document.createElement(\"div\");\n              tk.className = \"frm-tick\";\n              tk.style.border = 3 * k + \"px solid \" + accent;\n              px(tk, { width: 14 * k, height: 14 * k, left: pt.x - 7 * k, top: pt.y - 7 * k });\n              tk.style.boxSizing = \"border-box\";\n              $(\"frm-ticks\").appendChild(tk);\n              ticks.push(tk);\n            }\n\n            function pin(id, labelId, P, name, code, side) {\n              var pe = $(id), lb = $(labelId);\n              px(pe, { left: P.x, top: P.y, width: 26 * k, height: 26 * k });\n              pe.style.border = 7 * k + \"px solid \" + accent;\n              pe.style.boxShadow = \"0 \" + 15 * k + \"px \" + 34 * k + \"px rgba(0,0,0,.18), 0 0 0 \" + 10 * k + \"px \" + accent + \"20\";\n              pe.style.boxSizing = \"border-box\";\n              lb.innerHTML = \"\";\n              lb.appendChild(document.createTextNode(name));\n              var sp = document.createElement(\"span\"); sp.textContent = code; lb.appendChild(sp);\n              lb.style.top = 32 * k + \"px\";\n              lb.style.minWidth = 142 * k + \"px\";\n              lb.style.padding = 12 * k + \"px \" + 16 * k + \"px \" + 13 * k + \"px\";\n              lb.style.borderRadius = 20 * k + \"px\";\n              lb.style.fontSize = 22 * k + \"px\";\n              lb.style.color = c