   "content": "<!doctype html>\n<!--\n  Orbit Lock\n\n  Moons ride tilted, shrinking orbits into a core that bursts into a ring flash, and the logo springs into place.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/orbit-lock/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"orbit-lock\"\n  data-composition-duration=\"2.6\"\n  data-composition-variables='[\n    {\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Wordmark\", \"description\": \"Placeholder lockup text shown after the impact.\", \"default\": \"studio\"},\n    {\"id\": \"moons\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Moons\", \"description\": \"Number of moons orbiting the core.\", \"default\": 3, \"min\": 1, \"max\": 8, \"step\": 1},\n    {\"id\": \"background_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Stage color.\", \"default\": \"#111111\"},\n    {\"id\": \"core_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Core\", \"description\": \"Core and lockup mark color.\", \"default\": \"#E5322D\"},\n    {\"id\": \"moon_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Moons\", \"description\": \"Moon, orbit and wordmark color.\", \"default\": \"#FFFFFF\"},\n    {\"id\": \"flash_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Flash\", \"description\": \"Ring flash released on impact.\", \"default\": \"#FFFFFF\"},\n    {\"id\": \"tilt\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Tilt\", \"description\": \"Orbit tilt in degrees: 0 is a flat circle, 80 is nearly edge-on.\", \"default\": 64, \"min\": 0, \"max\": 85, \"step\": 1, \"unit\": \"deg\"},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier.\", \"default\": 1, \"min\": 0.25, \"max\": 3, \"step\": 0.05}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Orbit Lock</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        .ol-lockup { display: flex; align-items: center; gap: 28px; }\n        .ol-mark { width: 120px; height: 120px; border-radius: 32px; display: flex; align-items: center; justify-content: center; background: var(--mark); }\n        .ol-dot { width: 36px; height: 36px; border-radius: 50%; background: var(--dot); }\n        .ol-word { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Helvetica, Arial, sans-serif; font-size: 104px; font-weight: 800; letter-spacing: -0.04em; color: var(--text); white-space: nowrap; }\n        #root { background: var(--bg); --mark: #E5322D; --dot: #111111; --text: #ffffff; }\n        .ol-stage { position: absolute; inset: 0; }\n        .ol-svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n        .ol-logo { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"orbit-lock\" data-duration=\"2.6\" data-fps=\"30\">\n        <div id=\"ol-clip\" class=\"ol-stage clip\" data-start=\"0\" data-duration=\"2.6\" data-track-index=\"0\">\n          <svg class=\"ol-svg\" id=\"ol-svg\"></svg>\n          <div class=\"ol-logo\" id=\"ol-logo\"><div class=\"ol-lockup\" id=\"ol-lockup\"><div class=\"ol-mark\"><div class=\"ol-dot\"></div></div><span class=\"ol-word\" id=\"ol-word\">studio</span></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"orbit-lock\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\nfunction col(v, f) { return typeof v === \"string\" && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v.trim()) ? v.trim() : f; }\nfunction bool(v, f) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : f; }\nvar FPS = 30;\nvar DUR = parseFloat(root.dataset.duration || \"2\");\nvar TOTAL = Math.round(DUR * FPS);\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction cl(x, a, b) { return Math.min(b, Math.max(a, x)); }\n// interpolate(x, [in...], [out...], easing): clamped on both sides, easing applied per segment.\nfunction interp(x, inp, out, easing) {\n  if (x <= inp[0]) return out[0];\n  if (x >= inp[inp.length - 1]) return out[out.length - 1];\n  var i = 0;\n  while (x > inp[i + 1]) i++;\n  var t = (x - inp[i]) / (inp[i + 1] - inp[i]);\n  if (easing) t = easing(t);\n  return out[i] + (out[i + 1] - out[i]) * t;\n}\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0; if (x >= 1) return 1;\n    var t = x;\n    for (var i = 0; i < 8; i++) {\n      var cx = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t - x;\n      var d = 3 * x1 * (1 - t) * (1 - t) - 6 * x1 * t * (1 - t) + 6 * x2 * t * (1 - t) - 3 * x2 * t * t + 3 * t * t;\n      if (Math.abs(cx) < 1e-6 || Math.abs(d) < 1e-6) break;\n      t -= cx / d;\n    }\n    t = cl(t, 0, 1);\n    return 3 * y1 * t * (1 - t) * (1 - t) + 3 * y2 * t * t * (1 - t) + t * t * t;\n  };\n}\nvar E = {\n  lin: function (t) { return t; },\n  quad: function (t) { return t * t; },\n  cubic: function (t) { return t * t * t; },\n  sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); }\n};\nfunction eOut(f) { return function (t) { return 1 - f(1 - t); }; }\nfunction eInOut(f) { return function (t) { return t < 0.5 ? f(2 * t) / 2 : 1 - f(2 - 2 * t) / 2; }; }\nvar outCubic = eOut(E.cubic), outQuad = eOut(E.quad), inCubic = E.cubic, inQuad = E.quad;\nvar inOutCubic = eInOut(E.cubic), inOutQuad = eInOut(E.quad), inOutSin = eInOut(E.sin), outSin = eOut(E.sin);\n// Damped spring from 0 to 1 (rest at 1, no initial velocity), frames at 30 fps.\nfunction spring(frame, cfg) {\n  if (frame <= 0) return 0;\n  var m = cfg.mass || 1, k = cfg.stiffness, c = cfg.damping;\n  var w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m)), t = frame / FPS;\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n  }\n  if (z === 1) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  var s = w0 * Math.sqrt(z * z - 1), r1 = -z * w0 + s, r2 = -z * w0 - s;\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\n// Seeded random: same string in, same number out.\nfunction rnd(seed) {\n  var sd = String(seed), h = 1779033703 ^ sd.length;\n  for (var i = 0; i < sd.length; i++) { h = Math.imul(h ^ sd.charCodeAt(i), 3432918353); h = (h << 13) | (h >>> 19); }\n  h = Math.imul(h ^ (h >>> 16), 2246822507); h = Math.imul(h ^ (h >>> 13), 3266489909); h ^= h >>> 16;\n  var a = (h >>> 0);\n  a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a);\n  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n}\nfunction rgb(h) {\n  h = h.replace(\"#\", \"\");\n  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];\n  return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];\n}\nfunction mixc(a, b, t) {\n  var x = rgb(a), y = rgb(b);\n  return \"rgb(\" + Math.round(lerp(x[0], y[0], t)) + \",\" + Math.round(lerp(x[1], y[1], t)) + \",\" + Math.round(lerp(x[2], y[2], t)) + \")\";\n}\nfunction rgba(h, a) { var x = rgb(h); return \"rgba(\" + x[0] + \",\" + x[1] + \",\" + x[2] + \",\" + a + \")\"; }\nvar SVGNS = \"http://www.w3.org/2000/svg\";\nfunction svgEl(tag, attrs, parent) {\n  var e = document.createElementNS(SVGNS, tag);\n  for (var k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\nfunction setA(e, attrs) { for (var k in attrs) e.setAttribute(k, attrs[k]); }\n// Drive draw(frame) from the timeline; frames run 0..frames over frames/30 seconds.\nfunction drive(draw, frames) {\n  var tl = gsap.timeline({ paused: true });\n  var clock = { frame: 0 };\n  tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n  draw(0);\n  return tl;\n}\nfunction finish(tl) {\n  if (tl.duration() < DUR) tl.to({}, { duration: DUR - tl.duration() });\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[NAME] = tl;\n}\n\n\nvar svg = document.getElementById(\"ol-svg\"), logo = document.getElementById(\"ol-logo\");\nvar moonsN = Math.round(num(vars.moons, 3, 1, 8));\nvar bg = col(vars.background_color, \"#111111\"), coreC = col(vars.core_color, \"#E5322D\"), moonC = col(vars.moon_color, \"#FFFFFF\"), flashC = col(vars.flash_color, \"#FFFFFF\");\nvar tilt = num(vars.tilt, 64, 0, 85), speed = num(vars.speed, 1, 0, 4);\nroot.style.setProperty(\"--bg\", bg); root.style.setProperty(\"--mark\", coreC); root.style.setProperty(\"--dot\", bg); root.style.setProperty(\"--text\", moonC);\ndocument.getElementById(\"ol-word\").textContent = str(vars.text, \"studio\");\nvar W = root.clientWidth, H = root.clientHeight;\nsvg.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H);\nvar IMPACT = 30, TURNS = 1.9, TRAIL = 10, TRAIL_STEP = 0.4;\nvar s = Math.min(W, H), cx = W / 2, cy = H / 2, tiltRad = (tilt * Math.PI) / 180;\nvar core = s * 0.055, outer = s * 0.36, moonR = s * 0.02;\nfunction moonAt(t, index, count) {\n  var p = cl(t / IMPACT, 0, 1);\n  var r = core + (outer - core) * (1 - inCubic(p));\n  var theta = (index / count) * Math.PI * 2 + Math.PI * 2 * TURNS * inQuad(p);\n  var plane = (index / count) * Math.PI + Math.PI / 9;\n  var lx = r * Math.cos(theta), ly = r * Math.sin(theta) * Math.cos(tiltRad);\n  return { x: lx * Math.cos(plane) - ly * Math.sin(plane), y: lx * Math.sin(plane) + ly * Math.cos(plane), z: r * Math.sin(theta) * Math.sin(tiltRad) };\n}\nvar defs = svgEl(\"defs\", {}, svg);\nvar orbits = [];\nfor (var i = 0; i < moonsN; i++) orbits.push(svgEl(\"ellipse\", { cx: cx, cy: cy, fill: \"none\", stroke: moonC, \"stroke-width\": 1.5, transform: \"rotate(\" + ((i / moonsN) * 180 + 20) + \" \" + cx + \" \" + cy + \")\" }, svg));\nvar back = svgEl(\"g\", {}, svg);\nvar coreEl = svgEl(\"circle\", { cx: cx, cy: cy }, svg);\nvar front = svgEl(\"g\", {}, svg);\nvar ringEl = svgEl(\"circle\", { cx: cx, cy: cy, fill: \"none\", stroke: flashC }, svg);\nvar bodies = [];\nfor (var m = 0; m < moonsN; m++) {\n  var g = svgEl(\"g\", {});\n  var grad = svgEl(\"linearGradient\", { id: \"ol-trail-\" + m, gradientUnits: \"userSpaceOnUse\" }, defs);\n  svgEl(\"stop\", { offset: 0, \"stop-color\": moonC, \"stop-opacity\": 0.6 }, grad);\n  svgEl(\"stop\", { offset: 1, \"stop-color\": moonC, \"stop-opacity\": 0 }, grad);\n  var poly = svgEl(\"polygon\", { fill: \"url(#ol-trail-\" + m + \")\" }, g);\n  var dot = svgEl(\"circle\", { fill: moonC }, g);\n  bodies.push({ g: g, grad: grad, poly: poly, dot: dot, parent: null });\n}\nfunction draw(frame) {\n  var t = frame * speed;\n  var p = cl(t / IMPACT, 0, 1);\n  var corePulse = 1 + 0.3 * Math.pow(p, 4);\n  var burst = interp(t, [IMPACT, IMPACT + 2, IMPACT + 6], [1, 1.6, 0], outCubic);\n  var coreScale = t < IMPACT ? corePulse : corePulse * burst;\n  var coreFill = t < IMPACT - 2 ? coreC : t > IMPACT + 1 ? flashC : mixc(coreC, flashC, (t - (IMPACT - 2)) / 3);\n  var ring = interp(t, [IMPACT, IMPACT + 16], [0, 1], outCubic);\n  var ringVisible = t >= IMPACT && ring < 1;\n  var orbitOpacity = interp(t, [0, 6, IMPACT - 4, IMPACT], [0, 0.16, 0.1, 0]);\n  var orbitR = core + (outer - core) * (1 - inCubic(p));\n  var pop = spring(t - IMPACT - 3, { damping: 11, stiffness: 170, mass: 0.7 });\n  var showMoons = t < IMPACT && t >= 0;\n  var appear = interp(t, [0, 5], [0, 1]);\n  orbits.forEach(function (o) { setA(o, { rx: orbitR, ry: Math.max(0.01, orbitR * Math.cos(tiltRad)), \"stroke-opacity\": orbitOpacity }); });\n  bodies.forEach(function (b, i) {\n    if (!showMoons) { if (b.parent) { b.parent.removeChild(b.g); b.parent = null; } return; }\n    var head = moonAt(t, i, moonsN);\n    var pts = [head];\n    for (var k = 0; k < TRAIL; k++) pts.push(moonAt(t - (k + 1) * TRAIL_STEP, i, moonsN));\n    var depth = 1 + (0.18 * head.z) / outer;\n    var left = [], right = [];\n    pts.forEach(function (pt, k) {\n      var pv = pts[Math.max(0, k - 1)], nx = pts[Math.min(pts.length - 1, k + 1)];\n      var dx = pv.x - nx.x, dy = pv.y - nx.y, len = Math.hypot(dx, dy) || 1;\n      var half = moonR * depth * 0.9 * (1 - k / pts.length);\n      var ox = (-dy / len) * half, oy = (dx / len) * half;\n      left.push((cx + pt.x + ox).toFixed(2) + \",\" + (cy + pt.y + oy).toFixed(2));\n      right.unshift((cx + pt.x - ox).toFixed(2) + \",\" + (cy + pt.y - oy).toFixed(2));\n    });\n    var tail = pts[pts.length - 1];\n    setA(b.grad, { x1: cx + head.x, y1: cy + head.y, x2: cx + tail.x, y2: cy + tail.y });\n    b.poly.setAttribute(\"points\", left.concat(right).join(\" \"));\n    setA(b.dot, { cx: cx + head.x, cy: cy + head.y, r: Math.max(0.1, moonR * depth) });\n    b.g.setAttribute(\"opacity\", appear);\n    var want = head.z < 0 ? back : front;\n    if (b.parent !== want) { want.appendChild(b.g); b.parent = want; }\n  });\n  setA(coreEl, { r: Math.max(0, core * coreScale * appear), fill: coreFill, opacity: coreScale > 0 ? 1 : 0 });\n  setA(ringEl, { r: core + ring * s * 0.62, \"stroke-width\": Math.max(1, s * 0.03 * (1 - ring)), opacity: ringVisible ? 1 - ring : 0 });\n  logo.style.opacity = interp(t, [IMPACT + 3, IMPACT + 6], [0, 1]);\n  logo.style.transform = \"scale(\" + (0.55 + 0.45 * pop) + \")\";\n}\nfinish(drive(draw, TOTAL));\n\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
