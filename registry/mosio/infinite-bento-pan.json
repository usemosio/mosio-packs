   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Infinite Bento Pan\n\n  A hypnotic diagonal camera glide over an oversized grid of bento cards (charts, counters, code, gradients) with a vignette. All figures are filler.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/infinite-bento-pan/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"infinite-bento-pan\"\n  data-composition-duration=\"10\"\n  data-composition-variables='[{\"id\":\"pan_speed\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Pan distance\",\"description\":\"Share of the grid the camera crosses (1 = the whole diagonal).\",\"default\":1,\"min\":0.25,\"max\":3,\"step\":0.05},{\"id\":\"accent_color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Accent\",\"description\":\"Colour of charts, bars and logo tiles.\",\"default\":\"#7c3aed\"},{\"id\":\"speed\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Speed\",\"description\":\"Playback speed multiplier.\",\"default\":1,\"min\":0.25,\"max\":4,\"step\":0.05,\"unit\":\"x\"}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Infinite Bento Pan</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: #050505; font-family: Geist, system-ui, sans-serif; }\n        .bp-stage { position: absolute; inset: 0; overflow: hidden; }\n        #bp-canvas { position: absolute; left: 0; top: 0; transform-origin: 0 0; }\n        .bp-card { position: absolute; border-radius: 18px; background: linear-gradient(180deg, #131313 0%, #0a0a0a 100%); border: 1px solid rgba(255,255,255,0.07); overflow: hidden; padding: 18px; color: #fff; display: flex; flex-direction: column; box-sizing: border-box; }\n        .bp-label { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.55); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 8px; }\n        #bp-vig { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at center, transparent 30%, rgba(0,0,0,0.85) 80%, #000 100%); }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"infinite-bento-pan\" data-duration=\"10\" data-fps=\"30\">\n        <div id=\"bp-clip\" class=\"bp-stage clip\" data-start=\"0\" data-duration=\"10\" data-track-index=\"0\">\n<div id=\"bp-canvas\"></div><div id=\"bp-vig\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n                        // Stop-motion helpers: poses are held for `step` frames.\n            var DEFAULT_STEP = 3;\n            function qf(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step) * step; }\n            function qstep(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step); }\n            function hash01(seed) { return random(seed); }\n            function hashRange(seed, lo, hi) { return lo + hash01(seed) * (hi - lo); }\n            function paperJitter(frame, seed, o) {\n              o = o || {};\n              var amp = o.amp != null ? o.amp : 1.4, rotAmp = o.rotAmp != null ? o.rotAmp : 0.35;\n              var s = qstep(frame, o.step);\n              return { x: hashRange(seed + \":x:\" + s, -amp, amp), y: hashRange(seed + \":y:\" + s, -amp, amp), rot: hashRange(seed + \":r:\" + s, -rotAmp, rotAmp) };\n            }\n            function steppedRamp(frame, from, to, o) {\n              o = o || {};\n              var f = qf(frame, o.step);\n              if (f <= from) return 0;\n              if (f >= to) return 1;\n              var ease = o.ease || function (t) { return t; };\n              return ease((f - from) / (to - from));\n            }\n\n\n            var accent = str(vars.accent_color, \"#7c3aed\"), panSpeed = num(vars.pan_speed, 1, 0.25, 3), speed = num(vars.speed, 1, 0.25, 4);\n            var SUPER_W = 3500, SUPER_H = 2500;\n            var W = root.clientWidth, H = root.clientHeight;\n            // Scale the oversized grid like the frame (bigger on a tall frame).\n            var s = Math.min(W / 1280, H / 720) * (H > W ? 1.5 : 1);\n            var canvas = document.getElementById(\"bp-canvas\");\n            canvas.style.width = SUPER_W + \"px\"; canvas.style.height = SUPER_H + \"px\";\n            var maxX = Math.max(0, SUPER_W * s - W), maxY = Math.max(0, SUPER_H * s - H);\n            // [x, y, w, h, kind, hue, label]\n            var CARDS = [[80,80,480,280,\"chart\",220,\"Revenue\"],[600,80,280,280,\"counter\",280,\"MRR\"],[920,80,360,180,\"gradient\",200,\"\"],[1320,80,480,280,\"code\",0,\"deploy.ts\"],[1840,80,280,280,\"logo\",320,\"\"],[2160,80,380,180,\"stat\",160,\"Uptime\"],[2580,80,360,280,\"bars\",40,\"Visits\"],[920,300,360,200,\"counter\",180,\"Users\"],[2160,300,380,200,\"chart\",100,\"Latency\"],[80,400,280,280,\"gradient\",340,\"\"],[400,400,480,280,\"code\",0,\"api.ts\"],[1320,420,280,280,\"stat\",60,\"P95\"],[1640,420,380,280,\"bars\",260,\"Builds\"],[2580,420,360,280,\"logo\",200,\"\"],[80,720,480,240,\"chart\",290,\"Errors\"],[600,720,280,240,\"stat\",20,\"RPS\"],[920,740,380,220,\"gradient\",240,\"\"],[1320,740,360,220,\"counter\",140,\"Active\"],[1720,740,480,240,\"code\",0,\"worker.ts\"],[2240,740,360,240,\"bars\",320,\"Queue\"],[80,1000,360,220,\"logo\",180,\"\"],[460,1000,380,220,\"stat\",80,\"Cache\"],[880,1000,480,220,\"chart\",200,\"CPU\"],[1400,1000,280,220,\"counter\",360,\"Jobs\"],[1720,1020,360,220,\"gradient\",120,\"\"],[2120,1020,380,220,\"code\",0,\"db.sql\"],[2540,1020,400,220,\"bars\",280,\"Tasks\"],[80,1280,480,260,\"code\",0,\"edge.ts\"],[600,1280,360,260,\"chart\",240,\"TTFB\"],[1000,1280,280,260,\"logo\",60,\"\"],[1320,1280,380,260,\"stat\",200,\"Hits\"],[1740,1280,360,260,\"counter\",300,\"Bytes\"],[2140,1280,380,260,\"gradient\",160,\"\"],[2560,1280,380,260,\"bars\",0,\"Errors\"],[80,1600,380,220,\"stat\",280,\"Saved\"],[500,1600,480,220,\"chart\",40,\"Net Out\"],[1020,1600,360,220,\"code\",0,\"auth.ts\"],[1420,1600,280,220,\"logo\",220,\"\"],[1740,1620,380,220,\"counter\",100,\"Hooks\"],[2160,1620,360,220,\"bars\",340,\"Runs\"],[2560,1620,380,220,\"gradient\",200,\"\"],[80,1880,480,240,\"bars\",180,\"Edges\"],[600,1880,380,240,\"gradient\",320,\"\"],[1020,1880,360,240,\"logo\",80,\"\"],[1420,1880,480,240,\"chart\",260,\"Tokens\"],[1940,1880,280,240,\"counter\",20,\"Calls\"],[2260,1880,380,240,\"stat\",140,\"Score\"],[2680,1880,260,240,\"code\",0,\"ws.ts\"]];\n            function noise(i, f) { return Math.sin(f / 30 + i) * 0.5 + 0.5; }\n            function commas(n) { return String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); }\n            var CODE_LINES = [[0, 60, \"#7dd3fc\"], [1, 80, \"rgba(255,255,255,0.8)\"], [1, 50, \"#f9a8d4\"], [2, 70, \"rgba(255,255,255,0.8)\"], [2, 40, \"#fde047\"], [1, 30, \"rgba(255,255,255,0.6)\"], [0, 20, \"rgba(255,255,255,0.6)\"]];\n            var items = CARDS.map(function (c, i) {\n              var kind = c[4], hue = c[5], label = c[6];\n              var el = document.createElement(\"div\");\n              el.id = \"bp-card-\" + i; el.className = \"bp-card\";\n              el.style.left = c[0] + \"px\"; el.style.top = c[1] + \"px\"; el.style.width = c[2] + \"px\"; el.style.height = c[3] + \"px\";\n              var it = { kind: kind };\n              if (kind === \"logo\" || kind === \"gradient\") el.style.padding = \"0\";\n              if (label) { var lb = document.createElement(\"div\"); lb.className = \"bp-label\"; lb.textContent = label; el.appendChild(lb); }\n              var fill = document.createElement(\"div\"); fill.style.flex = \"1\";\n              if (kind === \"chart\") {\n                fill.innerHTML = '<svg viewBox=\"0 0 100 60\" preserveAspectRatio=\"none\" style=\"width:100%;height:100%\"><polyline fill=\"none\" stroke=\"' + accent + '\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></polyline><polyline fill=\"' + accent + '22\" stroke=\"none\"></polyline></svg>';\n                it.l1 = fill.querySelectorAll(\"polyline\")[0]; it.l2 = fill.querySelectorAll(\"polyline\")[1];\n                el.appendChild(fill);\n              } else if (kind === \"bars\") {\n                fill.style.display = \"flex\"; fill.style.alignItems = \"flex-end\"; fill.style.gap = \"6px\"; it.bars = [];\n                for (var k = 0; k < 10; k++) { var b = document.createElement(\"div\"); b.style.flex = \"1\"; b.style.borderRadius = \"4px\"; b.style.background = \"linear-gradient(180deg, \" + accent + \" 0%, \" + accent + \"55 100%)\"; fill.appendChild(b); it.bars.push(b); }\n                el.appendChild(fill);\n              } else if (kind === \"counter\") {\n                fill.style.cssText += \";display:flex;align-items:center;font-size:56px;font-weight:700;letter-spacing:-0.04em\";\n                it.val = fill; el.appendChild(fill);\n                var d = document.createElement(\"div\"); d.style.cssText = \"font-size:12px;font-weight:600;color:\" + accent; it.delta = d; el.appendChild(d);\n              } else if (kind === \"stat\") {\n                fill.style.cssText += \";display:flex;align-items:center;font-size:48px;font-weight:700;letter-spacing:-0.03em\";\n                var v = document.createElement(\"span\"); var u = document.createElement(\"span\"); u.textContent = \"%\"; u.style.cssText = \"font-size:20px;color:rgba(255,255,255,0.5);margin-left:4px\";\n                fill.appendChild(v); fill.appendChild(u); it.val = v; el.appendChild(fill);\n              } else if (kind === \"code\") {\n                fill.style.cssText += \";display:flex;align-items:center\";\n                var col = document.createElement(\"div\"); col.style.cssText = \"width:100%;display:flex;flex-direction:column;gap:8px\";\n                CODE_LINES.forEach(function (l) { var r = document.createElement(\"div\"); r.style.cssText = \"margin-left:\" + l[0] * 14 + \"px;width:\" + l[1] + \"%;height:8px;border-radius:3px;opacity:0.7;background:\" + l[2]; col.appendChild(r); });\n                fill.appendChild(col); el.appendChild(fill);\n              } else if (kind === \"logo\") {\n                el.style.alignItems = \"center\"; el.style.justifyContent = \"center\";\n                var lg = document.createElement(\"div\"); lg.style.cssText = \"width:80px;height:80px;border-radius:20px;background:linear-gradient(135deg,\" + accent + \" 0%,hsl(\" + hue + \",70%,55%) 100%);box-shadow:0 10px 30px \" + accent + \"44\";\n                el.appendChild(lg);\n              } else {\n                el.style.background = \"radial-gradient(circle at 30% 30%, hsl(\" + hue + \",80%,60%) 0%, hsl(\" + ((hue + 60) % 360) + \",70%,40%) 50%, #0a0a0a 100%)\";\n              }\n              canvas.appendChild(el);\n              return it;\n            });\n            function draw(f0) {\n              var frame = f0 * speed;\n              var totalFrames = Math.round(parseFloat(root.dataset.duration || \"10\") * 30);\n              var t = Math.min(1, Math.max(0, frame / totalFrames));\n              canvas.style.transform = \"translate(\" + -(t * maxX * Math.min(1, panSpeed)) + \"px,\" + -(t * maxY * Math.min(1, panSpeed)) + \"px) scale(\" + s + \")\";\n              items.forEach(function (it, i) {\n                var tt = noise(i, frame) * 6.28;\n                if (it.kind === \"chart\") {\n                  var pts = [];\n                  for (var k = 0; k < 12; k++) pts.push((k / 11) * 100 + \",\" + (50 - (Math.sin(k * 0.7 + tt) * 18 + Math.cos(k * 0.4 + tt * 0.6) * 8)));\n                  it.l1.setAttribute(\"points\", pts.join(\" \")); it.l2.setAttribute(\"points\", pts.join(\" \") + \" 100,60 0,60\");\n                } else if (it.kind === \"bars\") {\n                  it.bars.forEach(function (b, k) { b.style.height = 25 + (Math.sin(k * 0.8 + tt) * 0.5 + 0.5) * 70 + \"%\"; });\n                } else if (it.kind === \"counter\") {\n                  it.val.textContent = commas(Math.floor(1200 + noise(i, frame) * 800));\n                  it.delta.textContent = \"+\" + (noise(i + 1, frame) * 12).toFixed(1) + \"%\";\n                } else if (it.kind === \"stat\") {\n                  it.val.textContent = (95 + noise(i, frame) * 5).toFixed(2);\n                }\n              });\n            }\n            var tl = gsap.timeline({ paused: true });\n            clockTween(tl, 300, draw);\n\n            var total = parseFloat(root.dataset.duration || \"10\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"infinite-bento-pan\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
