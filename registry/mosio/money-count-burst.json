 "files": [
  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Money Count Burst\n\nA big amount counts from zero up to a target, turns green with a flash, and bursts into bills and coins.\n\nCategory: motion-graphics. Length: 5 s. WebGL: no.\n\nUse when:\n- A revenue, savings or payout number should count up and end on a celebratory burst.\n- The scene is about money and a clean light look suits it.\n\nAvoid when:\n- The number should stay calm and readable with no celebration: use a count-up block.\n- You need the sound effect that upstream ships.\n\nVariables:\n- target (number, 1-999999999): Final amount, default 25000000\n- prefix (string): Currency symbol, default \"Rp\"\n- text_scale (number, 0.4-2): Text size, default 1\n- background (color): Background, default \"#ffffff\"\n- text_color (color): Number colour, default \"#0a0a0a\"\n- accent_color (color): Accent, default \"#2563eb\"\n\nSource: heygen-com/hyperframes. Licence: Apache-2.0. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Money Count Burst\n\n  A big amount counts from zero up to a target, turns green with a flash, and bursts into bills and coins.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/heygen-com/hyperframes/blob/bd6cff8157a1a0ed5075527e673cc4f321fe9123/registry/blocks/apple-money-count/apple-money-count.html\n\n  Copyright HeyGen, Inc. and the Hyperframes contributors. Licensed under the Apache License, Version\n  2.0 (the \"License\"); you may not use this file except in compliance with the License. You may obtain\n  a copy of the License at http://www.apache.org/licenses/LICENSE-2.0. Unless required by applicable\n  law or agreed to in writing, software distributed under the License is distributed on an \"AS IS\"\n  BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for\n  the specific language governing permissions and limitations under the License.\n\n  Changes by usemosio/blocks: adapted from a block named after a phone-maker's finance ad: generic name and sample; fills the host frame (burst radii stretch with the frame, sizes follow the short side); target, currency symbol, colours and text size are variables; the sound effect track is dropped; the system font stack became Inter from Google Fonts.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"money-count-burst\"\n  data-composition-duration=\"5\"\n  data-composition-variables='[\n  {\n    \"id\": \"target\",\n    \"type\": \"number\",\n    \"role\": \"content\",\n    \"label\": \"Final amount\",\n    \"description\": \"The number the counter counts up to.\",\n    \"default\": 25000000,\n    \"min\": 1,\n    \"max\": 999999999,\n    \"step\": 1\n  },\n  {\n    \"id\": \"prefix\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Currency symbol\",\n    \"description\": \"Text before the number (also the mark on the bills and coins).\",\n    \"default\": \"Rp\"\n  },\n  {\n    \"id\": \"text_scale\",\n    \"type\": \"number\",\n    \"role\": \"style\",\n    \"label\": \"Text size\",\n    \"description\": \"Multiplier on the number&#39;s size.\",\n    \"default\": 1,\n    \"min\": 0.4,\n    \"max\": 2,\n    \"step\": 0.05\n  },\n  {\n    \"id\": \"background\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Background\",\n    \"description\": \"Frame background.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"text_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Number colour\",\n    \"description\": \"Colour of the number while it counts.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"accent_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Accent\",\n    \"description\": \"Colour the number turns, the flash and the bills.\",\n    \"default\": \"#2563eb\"\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Money Count Burst</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root { position: absolute; inset: 0; overflow: hidden; container-type: size; background: var(--mcb-bg, #ffffff); color: var(--mcb-fg, #0a0a0a); font-family: \"Inter\", system-ui, -apple-system, \"Helvetica Neue\", Arial, sans-serif; }\n        #mcb-clip { position: absolute; inset: 0; }\n        .mcb-flash { position: absolute; inset: 0; z-index: 1; background: var(--mcb-accent, #2563eb); opacity: 0; }\n        .mcb-stage { position: absolute; inset: 0; z-index: 5; display: flex; align-items: center; justify-content: center; }\n        .mcb-amount { position: relative; font-weight: 900; line-height: 0.9; font-variant-numeric: tabular-nums; text-align: center; white-space: nowrap; will-change: transform, color, opacity; }\n        .mcb-burst { position: absolute; inset: 0; z-index: 8; pointer-events: none; }\n        .mcb-icon { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; opacity: 0; will-change: transform, opacity; }\n        .mcb-bill { background: var(--mcb-accent, #2563eb); box-shadow: inset 0 0 0 3px rgba(0, 0, 0, 0.2), inset 0 -10px 18px rgba(0, 0, 0, 0.1), 0 16px 26px rgba(0, 0, 0, 0.2); }\n        .mcb-bill::before { position: absolute; inset: 17% 17%; border: 2px solid rgba(0, 0, 0, 0.28); border-radius: 999px; content: \"\"; }\n        .mcb-coin { border-radius: 50%; background: radial-gradient(circle at 34% 30%, #fff7a6 0%, #ffd54f 40%, #d9a514 100%); box-shadow: inset 0 0 0 4px rgba(111, 76, 0, 0.12), inset 0 -8px 14px rgba(111, 76, 0, 0.1), 0 16px 30px rgba(111, 76, 0, 0.18); }\n        .mcb-mark { position: relative; z-index: 1; font-weight: 900; line-height: 1; color: #07541f; }\n        .mcb-coin .mcb-mark { color: #6f4c00; }\n      </style>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@900&amp;display=block\" />\n      <div id=\"root\" data-composition-id=\"money-count-burst\" data-duration=\"5\" data-fps=\"30\">\n        <div id=\"mcb-clip\" class=\"clip\" data-start=\"0\" data-duration=\"5\" data-track-index=\"0\">\n          <div id=\"mcb-flash\" class=\"mcb-flash\"></div>\n          <div class=\"mcb-stage\"><div id=\"mcb-amount\" class=\"mcb-amount\"></div></div>\n          <div id=\"mcb-burst\" class=\"mcb-burst\"></div>\n        </div>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\n            function num(x, f, lo, hi) { var n = Number(x); return Number.isFinite(n) ? Math.min(hi, Math.max(lo, n)) : f; }\n            function col(x, f) { return typeof x === \"string\" && x.trim() ? x.trim() : f; }\n            var target = Math.round(num(vars.target, 25000000, 1, 999999999));\n            var prefix = typeof vars.prefix === \"string\" ? vars.prefix : \"Rp\";\n            var bg = col(vars.background, \"#ffffff\"), fg = col(vars.text_color, \"#0a0a0a\"), accent = col(vars.accent_color, \"#2563eb\");\n            root.style.setProperty(\"--mcb-bg\", bg);\n            root.style.setProperty(\"--mcb-fg\", fg);\n            root.style.setProperty(\"--mcb-accent\", accent);\n            var amount = document.getElementById(\"mcb-amount\");\n            var burst = document.getElementById(\"mcb-burst\");\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920;\n            var landscape = W > H;\n            // Design: 1920x1080. Radii stretch with the frame, sizes follow the short side.\n            var sx = W / 1920, sy = H / 1080;\n            var u = landscape ? H / 1080 : (W / 1080) * 1.1;\n            var size = 190 * (landscape ? H / 1080 : (W / 1080) * 0.8) * num(vars.text_scale, 1, 0.4, 2);\n            amount.style.fontSize = size + \"px\";\n            amount.style.textShadow = \"0 \" + 3 * u + \"px 0 \" + bg + \", 0 \" + 18 * u + \"px \" + 36 * u + \"px rgba(17,19,21,0.14), 0 \" + 42 * u + \"px \" + 92 * u + \"px rgba(17,19,21,0.1)\";\n            function fmt(value) {\n              var r = Math.round(Math.max(0, Math.min(target, value)));\n              return prefix + String(r).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\");\n            }\n            amount.textContent = fmt(target);\n            if (amount.scrollWidth > W * 0.9) { size = size * (W * 0.9) / amount.scrollWidth; amount.style.fontSize = size + \"px\"; }\n            amount.textContent = fmt(0);\n\n            var COUNT = 62, icons = [], specs = [];\n            var limX = W * 0.45, limY = H * 0.43;\n            for (var i = 0; i < COUNT; i++) {\n              var coin = i % 3 === 0;\n              var el = document.createElement(\"div\");\n              el.className = \"mcb-icon \" + (coin ? \"mcb-coin\" : \"mcb-bill\");\n              el.style.width = (coin ? 64 : 96) * u + \"px\";\n              el.style.height = (coin ? 64 : 52) * u + \"px\";\n              if (!coin) el.style.borderRadius = 10 * u + \"px\";\n              var mark = document.createElement(\"span\");\n              mark.className = \"mcb-mark\";\n              mark.style.fontSize = (coin ? 28 : 30) * u + \"px\";\n              mark.textContent = prefix.trim().charAt(0) || \"$\";\n              el.appendChild(mark);\n              burst.appendChild(el);\n              icons.push(el);\n              var angle = i * 2.399963229728653, ring = i % 5;\n              var rx = (260 + ring * 145 + (i % 7) * 12) * sx;\n              var ry = (160 + ring * 78 + (i % 6) * 12) * sy;\n              var ox = ((i % 4) * 24 - 36) * sx, oy = ((i % 5) * 18 - 36) * sy;\n              specs.push({\n                x: Math.max(-limX, Math.min(limX, Math.cos(angle) * rx + ox)),\n                y: Math.max(-limY, Math.min(limY, Math.sin(angle * 1.13) * ry + oy)),\n                delay: (i % 8) * 0.025, duration: 0.74 + (i % 5) * 0.045, fadeDelay: (i % 5) * 0.05,\n                rotation: ((i * 43) % 160) - 80, scale: coin ? 0.72 + (i % 4) * 0.08 : 0.68 + (i % 5) * 0.07\n              });\n            }\n            gsap.set(icons, { x: 0, y: 0, xPercent: -50, yPercent: -50, opacity: 0, scale: 0.18, transformOrigin: \"50% 50%\" });\n\n            var tl = gsap.timeline({ paused: true, defaults: { ease: \"power3.out\" } });\n            var state = { value: 0 };\n            tl.from(amount, { y: 26 * u, opacity: 0, scale: 0.985, duration: 0.45, ease: \"power2.out\" }, 0);\n            tl.to(state, { value: target, duration: 3.16, ease: \"none\", onUpdate: function () { amount.textContent = fmt(state.value); } }, 0);\n            tl.to(amount, { color: accent, duration: 0.18 }, 3.16);\n            tl.to(amount, { scale: 1.06, duration: 0.16, ease: \"back.out(2.2)\" }, 3.16);\n            tl.to(amount, { scale: 1, duration: 0.23, ease: \"power2.out\" }, 3.33);\n            var flash = document.getElementById(\"mcb-flash\");\n            tl.to(flash, { opacity: 0.34, duration: 0.08, ease: \"none\" }, 3.16);\n            tl.to(flash, { opacity: 0.22, duration: 0.76, ease: \"none\" }, 3.24);\n            tl.to(flash, { opacity: 0, duration: 0.16, ease: \"power2.out\" }, 4);\n            icons.forEach(function (icon, i) {\n              var s = specs[i];\n              tl.to(icon, { x: s.x, y: s.y, rotation: s.rotation, scale: s.scale, opacity: 1, duration: s.duration, ease: \"power4.out\" }, 3.28 + s.delay);\n              tl.to(icon, { y: s.y + (s.y < 0 ? -58 : 58) * sy, scale: s.scale * 0.54, opacity: 0, duration: 0.38, ease: \"power2.in\" }, 4.18 + s.fadeDelay);\n            });\n            tl.to(amount, { opacity: 0, scale: 0.985, duration: 0.28, ease: \"power2.in\" }, 4.36);\n            if (tl.duration() < 5) tl.to({}, { duration: 5 - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"money-count-burst\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
 "sha256": "5eb856de885c97654f89e72cf312b240ce7bb579109bc8e58e7572eaf02345e5",
