  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Wave Reveal\n\nLetters (or words) drift into place from slightly above or below while a blur clears, each starting a beat after the last so a slow wave runs through the line.\n\nCategory: typography. Length: 3.5 s. WebGL: no.\n\nUse when:\n- A headline should come in as a long, soft wave with a blur that clears.\n- The same wave over words instead of letters, or rising instead of falling.\n\nAvoid when:\n- A crisp, tight stagger is wanted: use per-character-rise or bottom-up-letters.\n- A single scale-and-blur focus pull: use tracking-in or focus-blur-resolve.\n\nVariables:\n- text (string): Text, default \"Hello World\"\n- direction (enum): Direction, default \"down\"\n- mode (enum): Mode, default \"letter\"\n- font_size (number, 12-300): Font size, default 112\n- unit_duration (number, 0.2-6): Unit duration, default 2\n- delay (number, 0-3): Delay, default 0\n- blur (boolean): Blur, default true\n- blur_px (number, 0-24): Blur size, default 5\n- color (color): Color, default \"#171717\"\n- font_weight (enum): Font weight, default \"500\"\n\nSource: https://github.com/codse/animata. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Wave Reveal\n\n  Letters (or words) drift into place from slightly above or below while a blur clears, each starting a beat after the last so a slow wave runs through the line.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/codse/animata/blob/25c27e5a874c60a56dcc1609df3b2c4f5f8456f8/animata/text/wave-reveal.tsx\n  and animata/styles/globals.css (the reveal-up, reveal-down and content-blur keyframes)\n  MIT License\n\n  Copyright (c) Animata\n\n  Permission is hereby granted, free of charge, to any person obtaining\n  a copy of this software and associated documentation files (the\n  \"Software\"), to deal in the Software without restriction, including\n  without limitation the rights to use, copy, modify, merge, publish,\n  distribute, sublicense, and/or sell copies of the Software, and to\n  permit persons to whom the Software is furnished to do so, subject to\n  the following conditions:\n\n  The above copyright notice and this permission notice shall be\n  included in all copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n  EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\n  MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\n  NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\n  LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\n  OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\n  WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"wave-reveal\"\n  data-composition-duration=\"3.5\"\n  data-composition-variables='[\n    {\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Text\", \"description\": \"Headline that waves in.\", \"default\": \"Hello World\"},\n    {\"id\": \"direction\", \"type\": \"enum\", \"role\": \"motion\", \"label\": \"Direction\", \"description\": \"Units fall in from above or rise from below.\", \"default\": \"down\", \"options\": [{\"value\": \"down\", \"label\": \"Down\"}, {\"value\": \"up\", \"label\": \"Up\"}]},\n    {\"id\": \"mode\", \"type\": \"enum\", \"role\": \"motion\", \"label\": \"Mode\", \"description\": \"Animate letter by letter or word by word.\", \"default\": \"letter\", \"options\": [{\"value\": \"letter\", \"label\": \"Letter\"}, {\"value\": \"word\", \"label\": \"Word\"}]},\n    {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Maximum text size in pixels. Longer text shrinks to fit the frame.\", \"default\": 112, \"min\": 12, \"max\": 300, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"unit_duration\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Unit duration\", \"description\": \"Seconds each letter or word takes to settle.\", \"default\": 2, \"min\": 0.2, \"max\": 6, \"step\": 0.1, \"unit\": \"s\"},\n    {\"id\": \"delay\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Delay\", \"description\": \"Seconds before the first unit starts.\", \"default\": 0, \"min\": 0, \"max\": 3, \"step\": 0.1, \"unit\": \"s\"},\n    {\"id\": \"blur\", \"type\": \"boolean\", \"role\": \"style\", \"label\": \"Blur\", \"description\": \"Start each unit blurred, as in a keynote title.\", \"default\": true},\n    {\"id\": \"blur_px\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Blur size\", \"description\": \"Blur radius at the start, in pixels.\", \"default\": 5, \"min\": 0, \"max\": 24, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Color\", \"description\": \"Text color.\", \"default\": \"#171717\"},\n    {\"id\": \"font_weight\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Font weight\", \"description\": \"Weight of the text.\", \"default\": \"500\", \"options\": [{\"value\": \"300\", \"label\": \"Light\"}, {\"value\": \"400\", \"label\": \"Regular\"}, {\"value\": \"500\", \"label\": \"Medium\"}, {\"value\": \"600\", \"label\": \"Semibold\"}, {\"value\": \"700\", \"label\": \"Bold\"}, {\"value\": \"900\", \"label\": \"Black\"}]}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Wave Reveal</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;900&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          font-family: var(--font-display, Geist, system-ui, sans-serif);\n          pointer-events: none;\n        }\n        .wr-stage {\n          position: absolute;\n          inset: 0;\n          display: flex;\n          align-items: center;\n          justify-content: center;\n        }\n        .wr-line { width: 92%; text-align: center; line-height: 1.15; letter-spacing: -0.02em; }\n        .wr-unit { display: inline-block; opacity: 0; white-space: pre; }\n        .wr-word { display: inline-block; white-space: nowrap; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"wave-reveal\" data-duration=\"3.5\" data-fps=\"30\">\n        <div id=\"wr-clip\" class=\"wr-stage clip\" data-start=\"0\" data-duration=\"3.5\" data-track-index=\"0\">\n          <div id=\"wr-line\" class=\"wr-line\" role=\"img\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/CustomEase.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\n            function num(v, f, mn, mx) { var n = Number(v); return Number.isFinite(n) ? Math.min(mx, Math.max(mn, n)) : f; }\n            function str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\n            function col(v, f) { return typeof v === \"string\" && v ? v : f; }\n            function opt(v, list, f) { return list.indexOf(String(v)) >= 0 ? String(v) : f; }\n            function bool(v, f) { return typeof v === \"boolean\" ? v : v === \"true\" ? true : v === \"false\" ? false : f; }\n            function fit(el, size, frac) {\n              el.style.fontSize = size + \"px\";\n              var max = Math.max(1, root.clientWidth * frac);\n              if (el.scrollWidth > max) { size = Math.max(12, size * (max / el.scrollWidth)); el.style.fontSize = size + \"px\"; }\n              return size;\n            }\n            \n            var line = document.getElementById(\"wr-line\");\n            var text = str(vars.text, \"Hello World\");\n            var mode = opt(vars.mode, [\"letter\", \"word\"], \"letter\");\n            var dir = opt(vars.direction, [\"down\", \"up\"], \"down\") === \"up\" ? 1 : -1;\n            var dur = num(vars.unit_duration, 2, 0.2, 6), first = num(vars.delay, 0, 0, 3);\n            var useBlur = bool(vars.blur, true), blurPx = num(vars.blur_px, 5, 0, 24);\n            root.style.color = col(vars.color, \"#171717\");\n            root.style.fontWeight = opt(vars.font_weight, [\"300\",\"400\",\"500\",\"600\",\"700\",\"900\"], \"500\");\n            line.setAttribute(\"aria-label\", text);\n            line.style.fontSize = num(vars.font_size, 112, 12, 300) + \"px\";\n            var units = [], offset = 0;\n            text.trim().split(/\\s/).forEach(function (word, wi, all) {\n              if (mode === \"word\") {\n                var s = document.createElement(\"span\"); s.className = \"wr-unit\"; s.textContent = word;\n                units.push({ el: s, at: first + (wi + offset) * 0.05 }); line.appendChild(s); offset += 1;\n              } else {\n                var holder = document.createElement(\"span\"); holder.className = \"wr-word\"; line.appendChild(holder);\n                Array.from(word).forEach(function (ch, li) {\n                  var s = document.createElement(\"span\"); s.className = \"wr-unit\"; s.textContent = ch;\n                  units.push({ el: s, at: first + (li + offset) * 0.05 }); holder.appendChild(s);\n                });\n                offset += word.length + 1;\n              }\n              if (wi < all.length - 1) line.appendChild(document.createTextNode(\" \"));\n            });\n            gsap.registerPlugin(CustomEase);\n            var ease = CustomEase.create(\"wr-ease\", \"M0,0 C0.25,0.1 0.25,1 1,1\");\n            var tl = gsap.timeline({ paused: true });\n            units.forEach(function (u) {\n              var from = { opacity: 0, yPercent: dir * 80 };\n              var to = { opacity: 1, yPercent: 0, duration: dur, ease: ease, immediateRender: true };\n              if (useBlur) { from.filter = \"blur(\" + blurPx + \"px)\"; to.filter = \"blur(0px)\"; }\n              tl.fromTo(u.el, from, to, u.at);\n            });\n            var total = parseFloat(root.dataset.duration || \"3.5\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"wave-reveal\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
 "sha256": "f1982bba33973a2e0194c9f5b94c67fb6eba6b28763643ae6515fe89bd3a2c66",
