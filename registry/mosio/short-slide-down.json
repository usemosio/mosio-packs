   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Short Slide Down\n\nWords drop in from above and stack into a centered multi-line composition.\n\nCategory: typography. Length: 2 s. WebGL: no.\n\nUse when:\n- A multi-word headline should build its layout visibly, each word stacking into a composed block.\n- A fast entrance that still feels structured, with vertical motion and no outgoing text.\n\nAvoid when:\n- You are swapping between two text values: use shared-axis-y.\n- A single word or short phrase does not benefit from stacking: use scale-down-fade or soft-blur-in.\n\nVariables:\n- text (string): Text, default \"Build from above.\"\n- entry_offset (number, 8-80): Entry offset, default 28\n- font_size (number, 12-160): Font size, default 72\n- color (color): Color, default \"#171717\"\n- font_weight (enum): Font weight, default \"600\"\n\nSource: https://github.com/Remocn/remocn. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Short Slide Down\n\n  Words drop in from above and stack into a centered multi-line composition.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/short-slide-down/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"short-slide-down\"\n  data-composition-duration=\"2\"\n  data-composition-variables='[\n    { \"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Text\", \"description\": \"Headline whose words stack one per line.\", \"default\": \"Build from above.\" },\n    { \"id\": \"entry_offset\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Entry offset\", \"description\": \"How far above its row each new word starts.\", \"default\": 28, \"min\": 8, \"max\": 80, \"step\": 1, \"unit\": \"px\" },\n    { \"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Type size in pixels. Larger text shrinks so the stack fits the frame.\", \"default\": 72, \"min\": 12, \"max\": 160, \"step\": 1, \"unit\": \"px\" },\n    { \"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Color\", \"description\": \"Text color.\", \"default\": \"#171717\" },\n    { \"id\": \"font_weight\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Font weight\", \"description\": \"Weight of the text.\", \"default\": \"600\", \"options\": [{\"value\": \"400\", \"label\": \"Regular\"}, {\"value\": \"500\", \"label\": \"Medium\"}, {\"value\": \"600\", \"label\": \"Semibold\"}, {\"value\": \"700\", \"label\": \"Bold\"}] }\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Short Slide Down</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          color: var(--color, #171717);\n          font-family: var(--font-display, Geist, system-ui, sans-serif);\n          pointer-events: none;\n        }\n        .ssd-stage {\n          position: absolute;\n          inset: 0;\n          display: flex;\n          align-items: center;\n          justify-content: center;\n        }\n        .ssd-word { position: absolute; left: 50%; top: 50%; white-space: nowrap; letter-spacing: -0.03em; backface-visibility: hidden; opacity: 0; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"short-slide-down\" data-duration=\"2\" data-fps=\"30\">\n        <div id=\"ssd-clip\" class=\"ssd-stage clip\" data-start=\"0\" data-duration=\"2\" data-track-index=\"0\"></div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/CustomEase.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value.trim() ? value : fallback;\n            }\n            function pick(value, list, fallback) {\n              return list.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            gsap.registerPlugin(CustomEase);\n            function bz(id, a, b, c, d) {\n              return CustomEase.create(\"ssd-\" + id, \"M0,0 C\" + a + \",\" + b + \" \" + c + \",\" + d + \" 1,1\");\n            }\n            // interpolate(frame, [a, b], [from, to], { easing }) as a tween (frames at 30 fps).\n            function tw(tl, el, from, to, a, b, ease, keep) {\n              var t = Object.assign({}, to, { duration: (b - a) / 30, ease: ease || \"none\", immediateRender: !keep });\n              tl.fromTo(el, from, t, a / 30);\n            }\n            // Shrink an element's font size so it fits a fraction of the frame width.\n            function fit(el, size, frac) {\n              el.style.fontSize = size + \"px\";\n              var maxWidth = Math.max(1, root.clientWidth * frac);\n              if (el.scrollWidth > maxWidth) {\n                size = Math.max(12, size * (maxWidth / el.scrollWidth));\n                el.style.fontSize = size + \"px\";\n              }\n              return size;\n            }\n            var TOTAL = parseFloat(root.dataset.duration || \"2\");\n            function finish(tl) {\n              if (tl.duration() < TOTAL) tl.to({}, { duration: TOTAL - tl.duration() });\n              tl.seek(0);\n              window.__timelines = window.__timelines || {};\n              window.__timelines[\"short-slide-down\"] = tl;\n            }\n            var text = str(vars.text, \"Build from above.\");\n            var weight = pick(vars.font_weight, [\"400\", \"500\", \"600\", \"700\"], \"600\");\n            if (typeof vars.color === \"string\" && vars.color) root.style.setProperty(\"--color\", vars.color);\n            // interpolate() with clamping, easing given as a function of progress.\n            function ip(f, a, b, from, to, ease) {\n              var p = b === a ? 1 : Math.min(1, Math.max(0, (f - a) / (b - a)));\n              return from + (to - from) * (ease ? ease(p) : p);\n            }\n\n            var entryOffset = num(vars.entry_offset, 28, 8, 80);\n            var clip = document.getElementById(\"ssd-clip\");\n            var words = text.trim().split(/\\s+/).filter(Boolean);\n            var n = words.length;\n            var size = num(vars.font_size, 72, 12, 160);\n            // Shrink so the whole stack fits the frame height and its widest word the width.\n            var k = size / 72;\n            var stackH = (size * n + 12 * k * (n - 1)) * 1.1;\n            if (stackH > root.clientHeight * 0.85) size = size * root.clientHeight * 0.85 / stackH;\n            var els = words.map(function (w, j) {\n              var s = document.createElement(\"span\");\n              s.id = \"ssd-word-\" + j;\n              s.className = \"ssd-word\";\n              s.textContent = w;\n              s.style.fontWeight = weight;\n              s.style.fontSize = size + \"px\";\n              clip.appendChild(s);\n              return s;\n            });\n            var widest = 0;\n            els.forEach(function (s) { widest = Math.max(widest, s.scrollWidth); });\n            if (widest > root.clientWidth * 0.9) {\n              size = size * root.clientWidth * 0.9 / widest;\n              els.forEach(function (s) { s.style.fontSize = size + \"px\"; });\n            }\n            k = size / 72;\n            var lineGap = 12 * k, rowH = size;\n            var FIRST = 11, PUSH = 15, TRAVEL = 8, ENTRY_SCALE = 0.992, ENTRY_BLUR = 2.4 * k, REFLOW = 0.7 * k;\n            var ease = bz(\"ease\", 0.2, 0.8, 0.2, 1);\n            function rowY(count, j) {\n              var total = rowH * count + lineGap * (count - 1);\n              return -total / 2 + rowH / 2 + j * (rowH + lineGap);\n            }\n            var P = { f: 0 };\n            function apply() {\n              var f = P.f;\n              els.forEach(function (el, j) {\n                var es = j === 0 ? 0 : FIRST + (j - 1) * PUSH;\n                var ee = es + (j === 0 ? FIRST : PUSH);\n                var target = rowY(j + 1, j);\n                var yFrom = j === 0 ? -14 * k : target - entryOffset * k;\n                var y = target, opacity = 1, scale = 1, blur = 0;\n                if (f < es) {\n                  opacity = 0; y = yFrom; scale = ENTRY_SCALE; blur = ENTRY_BLUR;\n                } else if (f <= ee) {\n                  y = ip(f, es, Math.min(es + TRAVEL, ee), yFrom, target, ease);\n                  opacity = ip(f, es, ee, 0, 1, ease);\n                  scale = ip(f, es, ee, ENTRY_SCALE, 1, ease);\n                  blur = ip(f, es, ee, ENTRY_BLUR, 0, ease);\n                } else {\n                  for (var w = j + 1; w < n; w++) {\n                    var ps = FIRST + (w - 1) * PUSH, pe = ps + PUSH;\n                    var fromY = rowY(w, j), toY = rowY(w + 1, j);\n                    if (f >= pe) { y = toY; }\n                    else if (f >= ps) {\n                      y = ip(f, ps, Math.min(ps + TRAVEL, pe), fromY, toY, ease);\n                      var mid = (ps + pe) / 2;\n                      blur = f < mid ? ip(f, ps, mid, 0, REFLOW) : ip(f, mid, pe, REFLOW, 0);\n                      break;\n                    } else { y = fromY; break; }\n                  }\n                }\n                el.style.opacity = opacity;\n                el.style.filter = blur > 0.05 ? \"blur(\" + blur + \"px)\" : \"none\";\n                el.style.transform = \"translate(-50%, -50%) translate3d(0px, \" + y + \"px, 0) scale(\" + scale + \")\";\n              });\n            }\n            apply();\n            var tl = gsap.timeline({ paused: true });\n            tl.to(P, { f: TOTAL * 30, duration: TOTAL, ease: \"none\", onUpdate: apply }, 0);\n            finish(tl);\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
