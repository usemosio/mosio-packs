   "content": "<!doctype html>\n<!--\n  Hyperspace\n\n  A jump to lightspeed: stars stretch into streaks around the outgoing scene, which is pushed toward the camera, then a white flash cuts to the incoming scene while the last streaks fade.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/hyperspace/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"hyperspace\"\n  data-composition-duration=\"1.8667\"\n  data-composition-variables='[\n  {\n    \"id\": \"stars\",\n    \"type\": \"number\",\n    \"role\": \"style\",\n    \"label\": \"Stars\",\n    \"description\": \"Number of stars in the field.\",\n    \"default\": 260,\n    \"min\": 40,\n    \"max\": 600,\n    \"step\": 10\n  },\n  {\n    \"id\": \"streak_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Streak color\",\n    \"description\": \"Main streak color.\",\n    \"default\": \"#FFFFFF\"\n  },\n  {\n    \"id\": \"accent_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Accent color\",\n    \"description\": \"Color of the occasional tinted streak.\",\n    \"default\": \"#E5322D\"\n  },\n  {\n    \"id\": \"accent_ratio\",\n    \"type\": \"number\",\n    \"role\": \"style\",\n    \"label\": \"Accent ratio\",\n    \"description\": \"Share of stars drawn in the accent color, 0 to 1.\",\n    \"default\": 0.14,\n    \"min\": 0,\n    \"max\": 1,\n    \"step\": 0.02\n  },\n  {\n    \"id\": \"flash\",\n    \"type\": \"boolean\",\n    \"role\": \"style\",\n    \"label\": \"Flash\",\n    \"description\": \"White flash at the cut. Off gives a hard cut through the streaks.\",\n    \"default\": true\n  },\n  {\n    \"id\": \"flash_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Flash color\",\n    \"description\": \"Color of the flash.\",\n    \"default\": \"#FFFFFF\"\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Hyperspace</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          font-family: var(--font-display, Geist, system-ui, sans-serif);\n          pointer-events: none;\n        }\n\n        #root { background: #141318; }\n        .hsp-stage { position: absolute; inset: 0; }\n        .hsp-panel { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }\n        .hsp-in { display: flex; flex-direction: column; align-items: center; gap: 2.4cqmin; }\n        .hsp-in span { font-size: 9cqmin; font-weight: 600; letter-spacing: -0.03em; line-height: 1; color: #f2f2f2; white-space: nowrap; }\n        .hsp-bar { display: block; width: 14cqmin; height: 0.8cqmin; border-radius: 1cqmin; background: rgba(242, 242, 242, 0.55); }\n        .hsp-pa { background: #141318; }\n        .hsp-pb { background: linear-gradient(135deg, #3b3699 0%, #1e2a6b 55%, #0f4c75 100%); }\n        .hsp-pc { background: linear-gradient(135deg, #7a2f5f 0%, #3a2250 55%, #1c1b3f 100%); }\n\n        .hsp-stage { background: #000; }\n        .hsp-wrap { position: absolute; inset: 0; overflow: hidden; background: #000; }\n        .hsp-pa, .hsp-pb { z-index: 1; }\n        .hsp-stars { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; }\n        .hsp-white { position: absolute; inset: 0; z-index: 3; opacity: 0; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"hyperspace\" data-duration=\"1.8667\" data-fps=\"30\">\n        <div id=\"hsp-clip\" class=\"hsp-stage clip\" data-start=\"0\" data-duration=\"1.8667\" data-track-index=\"0\">\n          <div class=\"hsp-wrap\"><div id=\"hsp-a\" class=\"hsp-panel hsp-pa\"><div class=\"hsp-in\"><span>Scene A</span><i class=\"hsp-bar\"></i></div></div>\n          <div id=\"hsp-b\" class=\"hsp-panel hsp-pb\"><div class=\"hsp-in\"><span>Scene B</span><i class=\"hsp-bar\"></i></div></div>\n          <svg id=\"hsp-stars\" class=\"hsp-stars\"></svg><div id=\"hsp-white\" class=\"hsp-white\"></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        \n        <script>\n          (function () {\n            \"use strict\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v.trim() : f; }\nfunction pick(v, list, f) { return list.indexOf(String(v)) >= 0 ? String(v) : f; }\nfunction clamp01(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction smooth(a, b, x) { var t = clamp01((x - a) / (b - a)); return t * t * (3 - 2 * t); }\n// cubic-bezier easing, solved by bisection (pure function of x)\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0;\n    if (x >= 1) return 1;\n    var lo = 0, hi = 1, t = x;\n    for (var i = 0; i < 28; i++) {\n      var cx = 3 * (1 - t) * (1 - t) * t * x1 + 3 * (1 - t) * t * t * x2 + t * t * t;\n      if (cx < x) lo = t; else hi = t;\n      t = (lo + hi) / 2;\n    }\n    return 3 * (1 - t) * (1 - t) * t * y1 + 3 * (1 - t) * t * t * y2 + t * t * t;\n  };\n}\nvar inOutEase = bez(0.42, 0, 0.58, 1);\nfunction inCubic(x) { return x * x * x; }\nfunction outCubic(x) { return 1 - Math.pow(1 - x, 3); }\nfunction inQuad(x) { return x * x; }\nfunction outQuad(x) { return 1 - (1 - x) * (1 - x); }\nfunction outBack(s) { return function (x) { return 1 + (s + 1) * Math.pow(x - 1, 3) + s * Math.pow(x - 1, 2); }; }\n// interpolate(p, inputs, outputs, ease): clamped, eased per segment (like a frame interpolate)\nfunction interp(p, xs, ys, ease) {\n  var n = xs.length;\n  if (p <= xs[0]) return ys[0];\n  if (p >= xs[n - 1]) return ys[n - 1];\n  for (var i = 1; i < n; i++) {\n    if (p <= xs[i]) {\n      var t = (p - xs[i - 1]) / (xs[i] - xs[i - 1]);\n      if (ease) t = ease(t);\n      return lerp(ys[i - 1], ys[i], t);\n    }\n  }\n  return ys[n - 1];\n}\nfunction mulberry32(a) {\n  return function () {\n    a |= 0; a = (a + 0x6d2b79f5) | 0;\n    var t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n// damped spring from 0 to 1 (zero initial velocity), t in seconds\nfunction spring(t, damping, stiffness, mass) {\n  if (t <= 0) return 0;\n  var w0 = Math.sqrt(stiffness / mass), z = damping / (2 * Math.sqrt(stiffness * mass));\n  if (Math.abs(z - 1) < 1e-4) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + (z * w0 / wd) * Math.sin(wd * t));\n  }\n  var s = Math.sqrt(z * z - 1), r1 = -w0 * (z - s), r2 = -w0 * (z + s);\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\nfunction stripIds(node) {\n  var all = node.querySelectorAll(\"[id]\");\n  for (var i = 0; i < all.length; i++) all[i].removeAttribute(\"id\");\n  node.removeAttribute(\"id\");\n  return node;\n}\nfunction drive(name, duration, frame) {\n  var st = { p: 0 };\n  frame(0);\n  var tl = gsap.timeline({ paused: true });\n  tl.to(st, { p: 1, duration: duration, ease: \"none\", onUpdate: function () { frame(st.p); } }, 0);\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[name] = tl;\n}\n\n            var D = 1.8667;\n\nvar count = Math.round(num(vars.stars, 260, 40, 600)), streakColor = str(vars.streak_color, \"#FFFFFF\"), accentColor = str(vars.accent_color, \"#E5322D\");\nvar accentRatio = num(vars.accent_ratio, 0.14, 0, 1), flash = vars.flash === false || vars.flash === \"false\" ? false : true, flashColor = str(vars.flash_color, \"#FFFFFF\");\nvar A = document.getElementById(\"hsp-a\"), B = document.getElementById(\"hsp-b\"), svg = document.getElementById(\"hsp-stars\"), white = document.getElementById(\"hsp-white\");\nvar W = root.clientWidth, H = root.clientHeight, cx = W / 2, cy = H / 2, diag = Math.sqrt(W * W + H * H) / 2, unit = Math.min(W, H) / 720;\nvar JUMP = 3.2, COAST = 1.1, CUT = 0.62, SPOOL = 0.22, MAX_TAIL = 0.94, NS = \"http://www.w3.org/2000/svg\";\nsvg.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H);\nwhite.style.background = flashColor;\nvar rnd = mulberry32(31337), minLog = Math.log(Math.max(2, diag * 0.015)), maxLog = Math.log(diag), stars = [];\nfor (var i = 0; i < count; i++) {\n  var ang = rnd() * Math.PI * 2, lr = minLog + rnd() * (maxLog - minLog), acc = rnd() < accentRatio, wt = rnd();\n  var ln = document.createElementNS(NS, \"line\");\n  ln.setAttribute(\"stroke\", acc ? accentColor : streakColor); ln.setAttribute(\"stroke-linecap\", \"round\");\n  svg.appendChild(ln); stars.push({ a: ang, lr: lr, w: wt, el: ln, cos: Math.cos(ang), sin: Math.sin(ang) });\n}\nfunction travelAt(p) {\n  if (p <= CUT) { var t = p / CUT; return { travel: SPOOL * t + (JUMP - SPOOL) * Math.pow(t, 4), speed: Math.pow(t, 3) }; }\n  var q = (p - CUT) / (1 - CUT);\n  return { travel: JUMP + COAST * (1 - (1 - q) * (1 - q)), speed: 0.7 * (1 - q) };\n}\nfunction field(progress, opacity, stride) {\n  var tr = travelAt(progress), tail = Math.min(MAX_TAIL, 0.006 + MAX_TAIL * tr.speed * tr.speed);\n  for (var i = 0; i < stars.length; i++) {\n    var s = stars[i], el = s.el;\n    if (i % stride !== 0) { el.style.display = \"none\"; continue; }\n    var r = Math.exp(s.lr + tr.travel), r0 = r * (1 - tail);\n    if (r0 > diag * 1.05) { el.style.display = \"none\"; continue; }\n    var near = Math.min(1, r / (diag * 0.12));\n    el.style.display = \"block\";\n    el.setAttribute(\"x1\", cx + s.cos * r0); el.setAttribute(\"y1\", cy + s.sin * r0);\n    el.setAttribute(\"x2\", cx + s.cos * r); el.setAttribute(\"y2\", cy + s.sin * r);\n    el.setAttribute(\"stroke-opacity\", (0.25 + 0.75 * near) * opacity);\n    el.setAttribute(\"stroke-width\", (0.8 + s.w * 2.4 * near) * unit);\n  }\n}\nvar soft = bez(0.22, 1, 0.36, 1);\nfunction frame(p) {\n  if (p < CUT) {\n    var t = Math.min(1, p / CUT);\n    A.style.display = \"flex\"; B.style.display = \"none\";\n    A.style.transform = \"scale(\" + (1 + 0.42 * Math.pow(t, 4)) + \")\";\n    A.style.filter = \"brightness(\" + interp(t, [0, 1], [1, 0.45], inQuad) + \")\";\n    field(Math.min(p, CUT), interp(t, [0, 0.45], [0, 1], function (x) { return x < 0.5 ? 2 * x * x : 1 - 2 * (1 - x) * (1 - x); }), 1);\n    white.style.opacity = flash ? interp(t, [0.72, 1], [0, 1], inQuad) : 0;\n  } else {\n    var q = (p - CUT) / (1 - CUT);\n    A.style.display = \"none\"; B.style.display = \"flex\";\n    B.style.transform = \"scale(\" + interp(q, [0, 1], [1.06, 1], soft) + \")\";\n    var bl = interp(q, [0, 0.75], [Math.min(W, H) * 0.018, 0], soft);\n    B.style.filter = bl > 0.1 ? \"blur(\" + bl + \"px)\" : \"none\";\n    field(p, interp(q, [0, 0.45], [0.8, 0], outQuad), 5);\n    white.style.opacity = flash ? (q < 0.03 ? 1 : Math.pow(1 - (q - 0.03) / 0.97, 4)) : 0;\n  }\n}\n\n            drive(\"hyperspace\", D, frame);\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
