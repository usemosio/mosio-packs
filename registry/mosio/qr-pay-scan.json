 "files": [
  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# QR Pay Scan\n\nA generic QR card (a drawn pattern from a seeded generator, not a real code) is swept by a scan line, then a success check appears with the amount and \"Pembayaran berhasil\". Shop, amount, texts and the pattern seed are variables.\n\nCategory: commerce. Length: 5 s. WebGL: no.\n\nUse when:\n- Showing that paying a shop by scanning a QR code is quick and works.\n- A small shop's payment or checkout moment.\n\nAvoid when:\n- Listing which payment methods a shop accepts: use payment-methods-row.\n- A full receipt of what was bought: use receipt-print.\n- The code must be scannable: this pattern is decorative only.\n\nVariables:\n- shop (string): Shop name, default \"Kopi Senja\"\n- hint (string): Hint, default \"Pindai untuk membayar\"\n- amount (string): Amount, default \"Rp45.000\"\n- success (string): Success text, default \"Pembayaran berhasil\"\n- seed (number, 1-999): Pattern seed, default 7\n- scan_at (number, 0.5-3): Scan start, default 1.0\n- bg_color (color): Background, default \"#ffffff\"\n- text_color (color): Text colour, default \"#0a0a0a\"\n- muted_color (color): Muted colour, default \"#737373\"\n- main_color (color): Accent, default \"#2563eb\"\n- font_family (string): Font, default \"Geist\"\n- transparent (boolean): Transparent, default false\n\nSource: Mosio original. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  QR Pay Scan\n\n  A generic QR card (a drawn pattern from a seeded generator, not a real code) is swept by a scan line, then a success check appears with the amount and \"Pembayaran berhasil\". Shop, amount, texts and the pattern seed are variables.\n\n  An original usemosio/blocks block (MIT, see LICENSE).\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"qr-pay-scan\"\n  data-composition-duration=\"5\"\n  data-composition-variables='[\n  {\n    \"id\": \"shop\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Shop name\",\n    \"description\": \"Shop shown next to the card.\",\n    \"default\": \"Kopi Senja\"\n  },\n  {\n    \"id\": \"hint\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Hint\",\n    \"description\": \"Line shown while the card waits to be scanned.\",\n    \"default\": \"Pindai untuk membayar\"\n  },\n  {\n    \"id\": \"amount\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Amount\",\n    \"description\": \"Amount shown on success. Digits count up with dots as thousands separators; a prefix such as Rp is kept.\",\n    \"default\": \"Rp45.000\"\n  },\n  {\n    \"id\": \"success\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Success text\",\n    \"description\": \"Line under the amount.\",\n    \"default\": \"Pembayaran berhasil\"\n  },\n  {\n    \"id\": \"seed\",\n    \"type\": \"number\",\n    \"role\": \"content\",\n    \"label\": \"Pattern seed\",\n    \"description\": \"Changes the drawn QR-like pattern.\",\n    \"default\": 7,\n    \"min\": 1,\n    \"max\": 999,\n    \"step\": 1\n  },\n  {\n    \"id\": \"scan_at\",\n    \"type\": \"number\",\n    \"role\": \"motion\",\n    \"label\": \"Scan start\",\n    \"description\": \"Second the scan line starts to sweep.\",\n    \"default\": 1.0,\n    \"min\": 0.5,\n    \"max\": 3,\n    \"step\": 0.1\n  },\n  {\n    \"id\": \"bg_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Background\",\n    \"description\": \"Background.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"text_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Text colour\",\n    \"description\": \"Main text and outlines.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"muted_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Muted colour\",\n    \"description\": \"Secondary text and hairlines.\",\n    \"default\": \"#737373\"\n  },\n  {\n    \"id\": \"main_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Accent\",\n    \"description\": \"Scan line and success check: the one accent.\",\n    \"default\": \"#2563eb\"\n  },\n  {\n    \"id\": \"font_family\",\n    \"type\": \"string\",\n    \"role\": \"style\",\n    \"label\": \"Font\",\n    \"description\": \"Font family name. Geist is loaded by default; another family must be loaded by the host.\",\n    \"default\": \"Geist\"\n  },\n  {\n    \"id\": \"transparent\",\n    \"type\": \"boolean\",\n    \"role\": \"style\",\n    \"label\": \"Transparent\",\n    \"description\": \"Leave the background clear so the block sits over your own scene.\",\n    \"default\": false\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>QR Pay Scan</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute; inset: 0; overflow: hidden; container-type: size; pointer-events: none;\n          -webkit-font-smoothing: antialiased;\n          color: var(--qp-text); font-family: var(--FAM, Geist), system-ui, sans-serif; background: var(--qp-bg);\n        }\n        #root * { box-sizing: border-box; }\n        .qp-stage { position: absolute; inset: 0; --u: calc(100cqmin / 1080); }\n\n        .qp-wrap { position: absolute; left: 50%; top: 50%; display: flex; align-items: center; transform-origin: 50% 50%; }\n        .qp-card { position: relative; flex: none; width: calc(var(--u) * 700); height: calc(var(--u) * 700); padding: calc(var(--u) * 56); border-radius: calc(var(--u) * 48); background: #fff; border: calc(var(--u) * 2) solid rgba(10,10,10,0.1); box-shadow: 0 calc(var(--u) * 14) calc(var(--u) * 34) rgba(0,0,0,0.08); }\n        .qp-qr { position: relative; width: 100%; height: 100%; }\n        .qp-qr > svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n        .qp-scan { position: absolute; left: calc(var(--u) * -14); right: calc(var(--u) * -14); top: 0; height: calc(var(--u) * 6); background: var(--qp-main); border-radius: calc(var(--u) * 3); z-index: 2; }\n        .qp-scan::before { content: \"\"; position: absolute; left: 0; right: 0; bottom: 100%; height: calc(var(--u) * 150); background: linear-gradient(to bottom, rgba(0,0,0,0), color-mix(in srgb, var(--qp-main) 16%, transparent)); }\n        .qp-br { position: absolute; width: calc(var(--u) * 56); height: calc(var(--u) * 56); border: solid var(--qp-text); border-width: 0; z-index: 1; }\n        .qp-ok { position: absolute; left: 50%; top: 50%; width: calc(var(--u) * 250); height: calc(var(--u) * 250); margin: calc(var(--u) * -125) 0 0 calc(var(--u) * -125); border-radius: 50%; background: var(--qp-main); z-index: 3; }\n        .qp-ok svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n        .qp-info { position: relative; flex: none; display: flex; flex-direction: column; justify-content: center; }\n        .qp-shop { font-size: calc(var(--u) * 46); font-weight: 700; letter-spacing: -0.03em; }\n        .qp-swap { position: relative; align-self: stretch; margin-top: calc(var(--u) * 14); height: calc(var(--u) * 190); }\n        .qp-swap > div { position: absolute; left: 0; right: 0; top: 0; display: flex; flex-direction: column; }\n        .qp-hint { font-size: calc(var(--u) * 40); font-weight: 500; color: var(--qp-muted); }\n        .qp-amt { font-size: calc(var(--u) * 128); font-weight: 700; letter-spacing: -0.05em; line-height: 1.05; font-variant-numeric: tabular-nums; white-space: nowrap; }\n        .qp-done { font-size: calc(var(--u) * 42); font-weight: 600; color: var(--qp-main); margin-top: calc(var(--u) * 6); }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"qr-pay-scan\" data-duration=\"5\" data-fps=\"30\">\n        <div id=\"qp-clip\" class=\"qp-stage clip\" data-start=\"0\" data-duration=\"5\" data-track-index=\"0\">\n\n          <div class=\"qp-wrap\" id=\"qp-wrap\">\n            <div class=\"qp-card\" id=\"qp-card\"><div class=\"qp-qr\" id=\"qp-qr\"><div class=\"qp-scan\" id=\"qp-scan\"></div></div><div class=\"qp-ok\" id=\"qp-ok\"></div></div>\n            <div class=\"qp-info\" id=\"qp-info\">\n              <div class=\"qp-shop\" id=\"qp-shop\"></div>\n              <div class=\"qp-swap\"><div id=\"qp-hintbox\"><span class=\"qp-hint\" id=\"qp-hint\"></span></div><div id=\"qp-res\"><span class=\"qp-amt\" id=\"qp-amt\"></span><span class=\"qp-done\" id=\"qp-done\"></span></div></div>\n            </div>\n          </div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() || {} : {};\n            function num(v, d, a, b) { var n = Number(v); return Number.isFinite(n) ? Math.min(b, Math.max(a, n)) : d; }\n            function str(v, d) { return typeof v === \"string\" && v.trim() ? v : d; }\n            function colr(v, d) { return typeof v === \"string\" && v.trim() && window.CSS && CSS.supports(\"color\", v.trim()) ? v.trim() : d; }\n            function bool(v, d) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : d; }\n            function el(tag, cls, parent, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; if (parent) parent.appendChild(e); return e; }\n            function svg(tag, attrs, parent) { var e = document.createElementNS(\"http://www.w3.org/2000/svg\", tag); for (var k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; }\n            function esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\"); }\n            function dots(n) { return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"); }\n            function rp(n) { return \"Rp\" + dots(n); }\n            function money(s) { var d = String(s).replace(/[^\\d]/g, \"\"); return d ? parseInt(d, 10) : 0; }\n            function list(s, d) { var a = String(str(s, d)).split(\";\").map(function (x) { return x.trim(); }).filter(Boolean); return a.length ? a : String(d).split(\";\").map(function (x) { return x.trim(); }); }\n            function mulberry(seed) { var a = seed >>> 0; return function () { a = (a + 0x6D2B79F5) >>> 0; var t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n            function setColors(p, c) { for (var k in c) root.style.setProperty(\"--\" + p + \"-\" + k, colr(vars[k + \"_color\"], c[k])); }\n            var fam = str(vars.font_family, \"Geist\");\n            root.style.setProperty(\"--FAM\", /^[\\w\\s-]+$/.test(fam) ? '\"' + fam + '\"' : \"Geist\");\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920, U = Math.min(W, H) / 1080, PORTRAIT = H > W;\n            if (bool(vars.transparent, false)) root.style.background = \"transparent\";\n\n            setColors(\"qp\", { bg: \"#ffffff\", text: \"#0a0a0a\", muted: \"#737373\", main: \"#2563eb\" });\n\n\n            var u = U;\n            var shop = str(vars.shop, \"Kopi Senja\"), hint = str(vars.hint, \"Pindai untuk membayar\");\n            var amount = str(vars.amount, \"Rp45.000\"), success = str(vars.success, \"Pembayaran berhasil\");\n            var seed = Math.round(num(vars.seed, 7, 1, 999)), scanAt = num(vars.scan_at, 1.0, 0.5, 3);\n            document.getElementById(\"qp-shop\").textContent = shop;\n            document.getElementById(\"qp-hint\").textContent = hint;\n            document.getElementById(\"qp-done\").textContent = success;\n            var amt = document.getElementById(\"qp-amt\");\n\n            // A QR-like pattern: finder squares in three corners, a small alignment square, seeded noise elsewhere.\n            var N = 25, rnd = mulberry(seed * 7919 + 13), grid = [];\n            for (var y = 0; y < N; y++) { grid.push([]); for (var x = 0; x < N; x++) grid[y].push(rnd() < 0.5 ? 1 : 0); }\n            function finder(ox, oy) {\n              for (var y = -1; y <= 7; y++) for (var x = -1; x <= 7; x++) {\n                var gx = ox + x, gy = oy + y; if (gx < 0 || gy < 0 || gx >= N || gy >= N) continue;\n                var edge = x === -1 || y === -1 || x === 7 || y === 7;\n                var ring = x === 0 || y === 0 || x === 6 || y === 6;\n                var core = x >= 2 && x <= 4 && y >= 2 && y <= 4;\n                grid[gy][gx] = edge ? 0 : (ring || core) ? 1 : 0;\n              }\n            }\n            finder(0, 0); finder(N - 7, 0); finder(0, N - 7);\n            for (var a = -2; a <= 2; a++) for (var b = -2; b <= 2; b++) grid[N - 7 + b][N - 7 + a] = (Math.max(Math.abs(a), Math.abs(b)) !== 1) ? 1 : 0;\n            for (var t = 8; t < N - 8; t++) { grid[6][t] = t % 2 === 0 ? 1 : 0; grid[t][6] = t % 2 === 0 ? 1 : 0; }\n            var d = \"\";\n            for (var yy = 0; yy < N; yy++) for (var xx = 0; xx < N; xx++) if (grid[yy][xx]) d += \"M\" + xx + \" \" + yy + \"h1v1h-1z\";\n            var qr = document.getElementById(\"qp-qr\");\n            var qsvg = svg(\"svg\", { viewBox: \"0 0 \" + N + \" \" + N, \"shape-rendering\": \"crispEdges\" }, qr);\n            qr.insertBefore(qsvg, qr.firstChild);\n            var qg = svg(\"g\", {}, qsvg);\n            svg(\"path\", { d: d, fill: colr(vars.text_color, \"#0a0a0a\") }, qg);\n            // Corner brackets around the code.\n            var bw = 7 * u;\n            [[\"top\", \"left\"], [\"top\", \"right\"], [\"bottom\", \"left\"], [\"bottom\", \"right\"]].forEach(function (c) {\n              var e = el(\"div\", \"qp-br\", document.getElementById(\"qp-card\"));\n              var o = -24 * u; e.style[c[0]] = 32 * u + \"px\"; e.style[c[1]] = 32 * u + \"px\";\n              e.style[\"border\" + c[0].charAt(0).toUpperCase() + c[0].slice(1) + \"Width\"] = bw + \"px\";\n              e.style[\"border\" + c[1].charAt(0).toUpperCase() + c[1].slice(1) + \"Width\"] = bw + \"px\";\n              e.style[\"border\" + c[0].charAt(0).toUpperCase() + c[0].slice(1) + c[1].charAt(0).toUpperCase() + c[1].slice(1) + \"Radius\"] = 16 * u + \"px\";\n            });\n            // Success check.\n            var ok = document.getElementById(\"qp-ok\");\n            var osv = svg(\"svg\", { viewBox: \"0 0 100 100\" }, ok);\n            var chk = svg(\"path\", { d: \"M29 52 L44 67 L72 35\", fill: \"none\", stroke: \"#fff\", \"stroke-width\": 9, \"stroke-linecap\": \"round\", \"stroke-linejoin\": \"round\", pathLength: 1 }, osv);\n            chk.style.strokeDasharray = \"1\"; chk.style.strokeDashoffset = \"1\";\n\n            // Layout: card then info, column in portrait, row in landscape.\n            var wrap = document.getElementById(\"qp-wrap\"), info = document.getElementById(\"qp-info\");\n            var gw, gh;\n            if (PORTRAIT) {\n              wrap.style.flexDirection = \"column\"; wrap.style.gap = 56 * u + \"px\"; info.style.alignItems = \"center\"; info.style.textAlign = \"center\"; info.style.width = 760 * u + \"px\";\n              document.getElementById(\"qp-hintbox\").style.alignItems = \"center\"; document.getElementById(\"qp-res\").style.alignItems = \"center\";\n              gw = 760 * u; gh = 700 * u + 56 * u + 270 * u;\n            } else {\n              wrap.style.gap = 80 * u + \"px\"; info.style.width = 700 * u + \"px\";\n              gw = 700 * u + 80 * u + 700 * u; gh = 700 * u;\n            }\n            wrap.style.width = gw + \"px\"; wrap.style.height = gh + \"px\";\n            var S = Math.min(1.4, (H * 0.88) / gh, (W * 0.92) / gw);\n            gsap.set(wrap, { xPercent: -50, yPercent: -50, scale: S });\n            var cardH = 700 * u - 112 * u;\n\n            var tl = gsap.timeline({ paused: true });\n            tl.fromTo(\"#qp-card\", { y: 50 * u, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: \"power3.out\" }, 0.1);\n            tl.fromTo([\"#qp-shop\", \"#qp-hint\"], { y: 24 * u, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: \"power3.out\", stagger: 0.1 }, 0.3);\n            tl.fromTo(\".qp-br\", { opacity: 0, scale: 1.25 }, { opacity: 1, scale: 1, duration: 0.45, ease: \"power3.out\" }, 0.45);\n            // Two sweeps: down, then back up.\n            tl.fromTo(\"#qp-scan\", { y: 0, opacity: 0 }, { opacity: 1, duration: 0.15 }, scanAt - 0.1);\n            tl.fromTo(\"#qp-scan\", { y: 0 }, { y: cardH, duration: 0.9, ease: \"power1.inOut\" }, scanAt);\n            tl.to(\"#qp-scan\", { y: 0, duration: 0.7, ease: \"power1.inOut\" }, scanAt + 0.9);\n            tl.to(\"#qp-scan\", { opacity: 0, duration: 0.15 }, scanAt + 1.6);\n            var ts = scanAt + 1.75;\n            tl.to(qg, { opacity: 0.1, duration: 0.35, ease: \"power2.out\" }, ts);\n            tl.fromTo(\"#qp-ok\", { scale: 0.3, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.45, ease: \"back.out(1.6)\" }, ts + 0.05);\n            tl.fromTo(chk, { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.35, ease: \"power2.out\" }, ts + 0.3);\n            tl.to(\"#qp-hintbox\", { opacity: 0, y: -20 * u, duration: 0.25, ease: \"power2.in\" }, ts);\n            tl.fromTo(\"#qp-res\", { opacity: 0, y: 30 * u }, { opacity: 1, y: 0, duration: 0.5, ease: \"power3.out\" }, ts + 0.25);\n            tl.fromTo(\"#qp-done\", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: \"power2.out\" }, ts + 0.7);\n            var m = /^(\\D*)(\\d[\\d.,]*)(.*)$/.exec(amount), value = m ? parseInt(m[2].replace(/[.,]/g, \"\"), 10) : NaN;\n            var step = value >= 10000 ? 1000 : value >= 1000 ? 100 : 1, ctr = { v: 0 };\n            function show(v) { amt.textContent = !m || v >= value ? amount : m[1] + dots(Math.round(v / step) * step) + m[3]; }\n            if (m && value) tl.fromTo(ctr, { v: 0 }, { v: value, duration: 0.8, ease: \"power2.out\", onUpdate: function () { show(ctr.v); } }, ts + 0.3);\n            show(0);\n            tl.set(\"#qp-res\", { opacity: 0 }, 0);\n\n            var total = parseFloat(root.dataset.duration || \"5\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"qr-pay-scan\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
