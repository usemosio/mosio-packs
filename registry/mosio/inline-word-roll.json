 "files": [
  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Inline Word Roll\n\nSwitch words beside a fixed prefix with an accelerating vertical roll; the whole line recenters as word lengths change.\n\nCategory: typography. Length: 3.5 s. WebGL: no.\n\nUse when:\n- A headline keeps its opening phrase while cycling through audiences, benefits or outcomes.\n- Different word lengths should smoothly recenter the whole line during each switch.\n\nAvoid when:\n- Every new word should remain in the sentence: use word-push.\n- Entire phrases should transform letter by letter: use kinetic-morph-text.\n\nVariables:\n- prefix (string): Fixed text, default \"Looking for\"\n- text (string): Words, default \"leads | customers | subscribers | appointments | demos | quotes | registrants | trials | conversions\"\n- suffix (string): Word suffix, default \"?\"\n- font_size (number, 16-260): Font size, default 60\n- font_weight (enum): Font weight, default \"400\"\n- interval (number, 6-60): Initial frames per word, default 12\n- acceleration (number, 0.5-1): Interval multiplier, default 0.9\n- transition_frames (number, 1-20): Roll duration, default 6\n- color (color): Color, default \"#f5f5f5\"\n\nSource: https://github.com/Remocn/remocn. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Inline Word Roll\n\n  Switch words beside a fixed prefix with an accelerating vertical roll; the whole line recenters as word lengths change.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/inline-word-roll/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"inline-word-roll\"\n  data-composition-duration=\"3.5\"\n  data-composition-variables='[\n    {\"id\": \"prefix\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Fixed text\", \"description\": \"Text that stays in place before the rolling word.\", \"default\": \"Looking for\"},\n    {\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Words\", \"description\": \"Words or phrases separated by |.\", \"default\": \"leads | customers | subscribers | appointments | demos | quotes | registrants | trials | conversions\"},\n    {\"id\": \"suffix\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Word suffix\", \"description\": \"Text attached to every word.\", \"default\": \"?\"},\n    {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Text size in pixels at full size. Wide lines scale down to fit.\", \"default\": 60, \"min\": 16, \"max\": 260, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"font_weight\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Font weight\", \"description\": \"Weight of the text.\", \"default\": \"400\", \"options\": [{\"value\": \"400\", \"label\": \"Regular\"}, {\"value\": \"700\", \"label\": \"Bold\"}]},\n    {\"id\": \"interval\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Initial frames per word\", \"description\": \"Frames the first word holds (30 fps).\", \"default\": 12, \"min\": 6, \"max\": 60, \"step\": 1, \"unit\": \"frames\"},\n    {\"id\": \"acceleration\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Interval multiplier\", \"description\": \"Each following hold is multiplied by this; 1 keeps a steady pace.\", \"default\": 0.9, \"min\": 0.5, \"max\": 1, \"step\": 0.01},\n    {\"id\": \"transition_frames\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Roll duration\", \"description\": \"Frames each roll takes (30 fps).\", \"default\": 6, \"min\": 1, \"max\": 20, \"step\": 1, \"unit\": \"frames\"},\n    {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Color\", \"description\": \"Text color.\", \"default\": \"#f5f5f5\"}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Inline Word Roll</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Arimo:wght@400;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n        .iwr-stage { position: absolute; inset: 0; overflow: hidden; font-family: Arimo, Arial, Helvetica, sans-serif; letter-spacing: -0.035em; line-height: 1.2; white-space: pre; }\n        .iwr-measure { position: absolute; visibility: hidden; left: 0; top: 0; white-space: pre; }\n        .iwr-measure span { display: inline-block; }\n        .iwr-anchor { position: absolute; left: 50%; top: 50%; }\n        .iwr-row { position: absolute; }\n        .iwr-prefix { position: absolute; left: 0; top: 0; }\n        .iwr-slot { position: absolute; top: 0; overflow: hidden; -webkit-mask-image: linear-gradient(to bottom, transparent, black 12%, black 88%, transparent); mask-image: linear-gradient(to bottom, transparent, black 12%, black 88%, transparent); }\n        .iwr-word { position: absolute; left: 0; top: 0; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"inline-word-roll\" data-duration=\"3.5\" data-fps=\"30\">\n        <div id=\"iwr-clip\" class=\"iwr-stage clip\" data-start=\"0\" data-duration=\"3.5\" data-track-index=\"0\">\n          <div id=\"iwr-measure\" class=\"iwr-measure\"></div>\n          <div id=\"iwr-anchor\" class=\"iwr-anchor\">\n            <div id=\"iwr-row\" class=\"iwr-row\">\n              <span id=\"iwr-prefix\" class=\"iwr-prefix\"></span>\n              <div id=\"iwr-slot\" class=\"iwr-slot\"><span id=\"iwr-from\" class=\"iwr-word\"></span><span id=\"iwr-to\" class=\"iwr-word\"></span></div>\n            </div>\n          </div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/CustomEase.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value.trim() ? value : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            function col(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              if (typeof value === \"boolean\") return value;\n              if (value === \"true\") return true;\n              if (value === \"false\") return false;\n              return fallback;\n            }\n            function fit(el, maxPx, size, ratio) {\n              // Shrink el's font size until its scrollWidth fits ratio of the frame width.\n              el.style.fontSize = size + \"px\";\n              var max = Math.max(1, root.clientWidth * (ratio || 0.9));\n              if (el.scrollWidth > max) { size = Math.max(10, size * (max / el.scrollWidth)); el.style.fontSize = size + \"px\"; }\n              return size;\n            }\n            gsap.registerPlugin(CustomEase);\n            function ease(name, a, b, c, d) { return CustomEase.create(name, \"M0,0 C\" + a + \",\" + b + \" \" + c + \",\" + d + \" 1,1\"); }\n            function mulberry32(a) { return function () { a |= 0; a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n            var tl = gsap.timeline({ paused: true });\n            var TOTAL = parseFloat(root.dataset.duration || \"3.5\");\n            function ip(t, a, b, from, to, e) {\n              var p = b === a ? 1 : (t - a) / (b - a);\n              p = Math.min(1, Math.max(0, p));\n              if (e) p = e(p);\n              return from + (to - from) * p;\n            }\n            function hash01(seed) {\n              var h = 2166136261;\n              for (var i = 0; i < seed.length; i++) { h ^= seed.charCodeAt(i); h = Math.imul(h, 16777619); }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              return ((h ^ (h >>> 16)) >>> 0) / 4294967296;\n            }\n            function hashRange(seed, lo, hi) { return lo + hash01(seed) * (hi - lo); }\n            // Snap a frame number down to a stop-motion pose.\n            function qf(frame, step) { return Math.floor(frame / step + 1e-6) * step; }\n            function kf(t, keys, vals, e) {\n              if (t <= keys[0]) return vals[0];\n              for (var i = 0; i < keys.length - 1; i++) if (t <= keys[i + 1]) return ip(t, keys[i], keys[i + 1], vals[i], vals[i + 1], e);\n              return vals[vals.length - 1];\n            }\n            // Per-frame drawing: a pure function of the timeline time, run from a tween's onUpdate.\n            function tick(draw) {\n              tl.to({}, { duration: TOTAL, ease: \"none\", onUpdate: function () { draw(tl.time()); } }, 0);\n              draw(0);\n            }\n            var cubOut = ease(\"cub-out\", 0.215, 0.61, 0.355, 1);\n            var cubIn = ease(\"cub-in\", 0.55, 0.055, 0.675, 0.19);\n            var cubInOut = ease(\"cub-io\", 0.645, 0.045, 0.355, 1);\n\n            var stage = document.getElementById(\"iwr-clip\");\n            var prefix = typeof vars.prefix === \"string\" ? vars.prefix : \"Looking for\";\n            var suffix = typeof vars.suffix === \"string\" ? vars.suffix : \"?\";\n            var words = str(vars.text, \"leads | customers | subscribers | appointments | demos | quotes | registrants | trials | conversions\").split(/[|\\n\\r]+/).map(function (w) { return w.trim(); }).filter(Boolean);\n            if (!words.length) words = [\"leads\"];\n            var size = num(vars.font_size, 60, 16, 260);\n            var interval = num(vars.interval, 12, 6, 60), accel = num(vars.acceleration, 0.9, 0.5, 1), trans = num(vars.transition_frames, 6, 1, 20);\n            stage.style.color = col(vars.color, \"#f5f5f5\");\n            stage.style.fontSize = size + \"px\";\n            stage.style.fontWeight = pick(vars.font_weight, [\"400\", \"700\"], \"400\");\n            var meas = document.getElementById(\"iwr-measure\");\n            var mp = document.createElement(\"span\"); mp.textContent = prefix; meas.appendChild(mp);\n            var mw = words.map(function (w) { var s = document.createElement(\"span\"); s.textContent = w + suffix; meas.appendChild(s); return s; });\n            var prefixW = mp.getBoundingClientRect().width;\n            var widths = mw.map(function (s) { return s.getBoundingClientRect().width; });\n            var rowH = size * 1.2, gap = prefix ? size * 0.23 : 0;\n            var widest = prefixW + gap + Math.max.apply(null, widths);\n            var fitS = Math.min(1, (root.clientWidth * 0.84) / Math.max(1, widest), (root.clientHeight * 0.5) / rowH);\n            var anchor = document.getElementById(\"iwr-anchor\"), row = document.getElementById(\"iwr-row\"), slot = document.getElementById(\"iwr-slot\");\n            var elPrefix = document.getElementById(\"iwr-prefix\"), elFrom = document.getElementById(\"iwr-from\"), elTo = document.getElementById(\"iwr-to\");\n            anchor.style.transform = \"scale(\" + fitS + \")\";\n            row.style.height = rowH + \"px\"; row.style.top = -rowH / 2 + \"px\";\n            elPrefix.textContent = prefix;\n            slot.style.height = rowH + \"px\"; slot.style.left = prefixW + gap + \"px\";\n            var rollEase = ease(\"iwr-roll\", 0.22, 0.75, 0.25, 1);\n            var pace = Math.max(trans, interval), rate = accel;\n            function stateAt(f) {\n              var start = 0;\n              for (var index = 1; index < words.length; index++) {\n                start += Math.max(trans, pace * Math.pow(rate, index - 1));\n                if (f < start) return { from: index - 1, to: index - 1, p: 1 };\n                if (f < start + trans) return { from: index - 1, to: index, p: Math.min(1, Math.max(0, (f - start) / trans)) };\n              }\n              var last = words.length - 1;\n              return { from: last, to: last, p: 1 };\n            }\n            tick(function (t) {\n              var st = stateAt(t * 30), moving = st.from !== st.to, p = rollEase(st.p);\n              var fw = widths[st.from], tw = widths[st.to], slotW = fw + (tw - fw) * p;\n              var total = prefixW + gap + slotW;\n              row.style.left = -total / 2 + \"px\";\n              slot.style.width = Math.max(fw, tw) + size * 0.12 + \"px\";\n              elFrom.textContent = words[st.from] + suffix;\n              elFrom.style.transform = \"translateY(\" + (moving ? -p * rowH : 0) + \"px)\";\n              elFrom.style.opacity = moving ? 1 - Math.min(1, p * 1.2) : 1;\n              elTo.style.display = moving ? \"block\" : \"none\";\n              if (moving) {\n                elTo.textContent = words[st.to] + suffix;\n                elTo.style.transform = \"translateY(\" + (1 - p) * rowH + \"px)\";\n                elTo.style.opacity = Math.min(1, p * 1.6);\n              }\n            });\n            var total = parseFloat(root.dataset.duration || \"3.5\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"inline-word-roll\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
 "sha256": "99bc47c7907513adf4e340049255d31df399e4c579d9a61e8ae3042a9ad08266",
