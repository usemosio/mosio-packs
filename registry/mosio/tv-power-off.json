   "content": "<!doctype html>\n<!--\n  TV Power Off\n\n  A scene ended the way a tube ends: the picture collapses into a glowing line, pinches to a\n  phosphor dot and the frame is left dead black. The scene here is a render queue.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/tv-power-off/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n\n  remocn captures its React children with the HTML-in-Canvas API, which a render machine does\n  not have. This block draws remocn's preview scene (a render queue) (text and colours from the variables) on a\n  2D canvas and runs remocn's fragment shader over it, so it applies the look to its own content,\n  not to the host video behind it.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"tv-power-off\"\n  data-composition-duration=\"2.0667\"\n  data-composition-variables='[{\"id\": \"title\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Title\", \"description\": \"Small heading above the list in the sample scene.\", \"default\": \"Render queue\"}, {\"id\": \"items\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Rows\", \"description\": \"Rows of the list as name | status, separated by semicolons (up to 5).\", \"default\": \"intro-scene.mp4 | Done; feature-tour.mp4 | Rendering; pricing-outro.mp4 | Queued\"}, {\"id\": \"background\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Background of the list scene.\", \"default\": \"#101828\"}, {\"id\": \"delay\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Delay\", \"description\": \"Frames of untouched picture before the power-off starts (30 per second).\", \"default\": 25, \"min\": 0, \"max\": 60, \"step\": 1, \"unit\": \"frames\"}, {\"id\": \"length\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Length\", \"description\": \"Frames the collapse takes.\", \"default\": 18, \"min\": 8, \"max\": 30, \"step\": 1, \"unit\": \"frames\"}, {\"id\": \"gain\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Gain\", \"description\": \"How much the squashed picture brightens as it collapses.\", \"default\": 1, \"min\": 0, \"max\": 2, \"step\": 0.05}, {\"id\": \"afterglow\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Afterglow\", \"description\": \"Size of the glowing line and dot.\", \"default\": 1, \"min\": 0, \"max\": 2, \"step\": 0.05}, {\"id\": \"phosphor\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Phosphor\", \"description\": \"Colour of the glow.\", \"default\": \"#d8ecff\"}, {\"id\": \"resolution\", \"type\": \"number\", \"role\": \"quality\", \"label\": \"Resolution\", \"description\": \"Share of the frame size the shader is drawn at, then scaled up. The collapsed line is a pixel thin at the end; lower renders faster but softens it.\", \"default\": 1, \"min\": 0.25, \"max\": 1, \"step\": 0.05}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>TV Power Off</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Geist+Mono:wght@400&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          background: #000;\n          pointer-events: none;\n        }\n        .tvo-stage {\n          position: absolute;\n          inset: 0;\n        }\n        .tvo-canvas,\n        .tvo-scene {\n          position: absolute;\n          inset: 0;\n          width: 100%;\n          height: 100%;\n          display: block;\n        }\n        .tvo-scene {\n          display: none;\n        }\n        .tvo-off .tvo-canvas {\n          display: none;\n        }\n        .tvo-off .tvo-fb {\n          display: block;\n        }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"tv-power-off\" data-duration=\"2.0667\" data-fps=\"30\">\n        <div id=\"tvo-clip\" class=\"tvo-stage clip\" data-start=\"0\" data-duration=\"2.0667\" data-track-index=\"0\">\n          <canvas id=\"tvo-scene0\" class=\"tvo-scene tvo-fb\"></canvas>\n          <canvas id=\"tvo-canvas\" class=\"tvo-canvas\"></canvas>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"tv-power-off\";\n            var root = document.getElementById(\"root\");\n            var stage = document.getElementById(\"tvo-clip\");\n            var canvas = document.getElementById(\"tvo-canvas\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function clampNum(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function hex(value, fallback) {\n              var m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(String(value || \"\").trim());\n              if (!m) return fallback;\n              var h = m[1].length === 3 ? m[1].replace(/./g, \"$&$&\") : m[1];\n              return \"#\" + h.toLowerCase();\n            }\n            function rgb(value) {\n              var h = hex(value, \"#ffffff\").slice(1);\n              return [parseInt(h.slice(0, 2), 16) / 255, parseInt(h.slice(2, 4), 16) / 255, parseInt(h.slice(4, 6), 16) / 255];\n            }\n            var DEFS = [{\"id\": \"title\", \"type\": \"string\", \"default\": \"Render queue\"}, {\"id\": \"items\", \"type\": \"string\", \"default\": \"intro-scene.mp4 | Done; feature-tour.mp4 | Rendering; pricing-outro.mp4 | Queued\"}, {\"id\": \"background\", \"type\": \"color\", \"default\": \"#101828\"}, {\"id\": \"delay\", \"type\": \"number\", \"default\": 25, \"min\": 0, \"max\": 60}, {\"id\": \"length\", \"type\": \"number\", \"default\": 18, \"min\": 8, \"max\": 30}, {\"id\": \"gain\", \"type\": \"number\", \"default\": 1, \"min\": 0, \"max\": 2}, {\"id\": \"afterglow\", \"type\": \"number\", \"default\": 1, \"min\": 0, \"max\": 2}, {\"id\": \"phosphor\", \"type\": \"color\", \"default\": \"#d8ecff\"}, {\"id\": \"resolution\", \"type\": \"number\", \"default\": 1, \"min\": 0.25, \"max\": 1}];\n            var V = {};\n            DEFS.forEach(function (d) {\n              var raw = vars[d.id];\n              if (d.type === \"number\") V[d.id] = clampNum(raw, d.default, d.min, d.max);\n              else if (d.type === \"color\") V[d.id] = hex(raw, d.default);\n              else if (d.type === \"boolean\") V[d.id] = typeof raw === \"boolean\" ? raw : raw === \"true\" ? true : raw === \"false\" ? false : d.default;\n              else if (d.type === \"enum\") V[d.id] = d.options.indexOf(raw) >= 0 ? raw : d.default;\n              else V[d.id] = typeof raw === \"string\" && raw.trim() ? raw.trim() : d.default;\n            });\n\n            var W = Math.max(2, root.clientWidth);\n            var H = Math.max(2, root.clientHeight);\n            var res = V.resolution;\n            var cw = Math.max(2, Math.round(W * res));\n            var ch = Math.max(2, Math.round(H * res));\n            var sceneCanvases = [\"tvo-scene0\"].map(function (id) {\n              var el = document.getElementById(id);\n              el.width = cw;\n              el.height = ch;\n              return el;\n            });\n\n            var SANS = \"Geist, -apple-system, BlinkMacSystemFont, sans-serif\";\n            var MONO = \"'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace\";\n            var INK = \"#f2f2f2\";\n            var MUTED = \"#8b8f9a\";\n            var TONES = [\"#a1eebd\", \"#ffb38e\", \"#d4b3ff\"];\n            var S = Math.min(W / 940, H / 720);\n            function setFont(ctx, weight, size, family) { ctx.font = weight + \" \" + size + \"px \" + family; }\n            function fitFont(ctx, text, maxWidth, weight, size, family) {\n              setFont(ctx, weight, size, family);\n              var w = ctx.measureText(text).width;\n              if (w > maxWidth) { size *= maxWidth / w; setFont(ctx, weight, size, family); }\n              return size;\n            }\n            function setSpacing(ctx, px) { if (\"letterSpacing\" in ctx) ctx.letterSpacing = px + \"px\"; }\n            function wrapLines(ctx, text, maxWidth) {\n              var words = String(text).split(/\\s+/).filter(Boolean);\n              var lines = [];\n              var line = \"\";\n              words.forEach(function (word) {\n                var next = line ? line + \" \" + word : word;\n                if (line && ctx.measureText(next).width > maxWidth) { lines.push(line); line = word; }\n                else line = next;\n              });\n              if (line) lines.push(line);\n              return lines;\n            }\n            function pairs(text, max) {\n              return String(text).split(\";\")\n                .map(function (row) { return row.split(\"|\").map(function (part) { return part.trim(); }); })\n                .filter(function (row) { return row[0]; })\n                .slice(0, max);\n            }\n            function begin(ctx, cw, ch, fill) {\n              ctx.setTransform(cw / W, 0, 0, ch / H, 0, 0);\n              ctx.fillStyle = fill;\n              ctx.fillRect(0, 0, W, H);\n              ctx.textBaseline = \"middle\";\n              ctx.textAlign = \"left\";\n              setSpacing(ctx, 0);\n            }\n\n\n            // Sample scene \"B\": a render queue (remocn's CanvasSceneB), laid out for any frame size.\n            var rows = pairs(V.items, 5);\n            function drawB(canvas) {\n              var ctx = canvas.getContext(\"2d\");\n              begin(ctx, canvas.width, canvas.height, V.background);\n              var s = S, pad = 96 * s, inner = W - pad * 2;\n              var titleH = 41 * s, rowH = 120 * s, line = Math.max(1, s);\n              var total = titleH + 34 * s + rows.length * (rowH + line);\n              var y = (H - total) / 2;\n              ctx.fillStyle = MUTED;\n              fitFont(ctx, V.title, inner, 400, 34 * s, SANS);\n              ctx.fillText(V.title, pad, y + titleH / 2);\n              y += titleH + 34 * s;\n              rows.forEach(function (row, i) {\n                ctx.fillStyle = \"#23304a\";\n                ctx.fillRect(pad, y, inner, line);\n                var mid = y + line + rowH / 2;\n                var label = row[1] || \"\";\n                var pillW = 0;\n                if (label) {\n                  var labelSize = fitFont(ctx, label, inner * 0.4, 500, 30 * s, SANS);\n                  pillW = ctx.measureText(label).width + 52 * s;\n                  var pillH = labelSize * 1.2 + 24 * s;\n                  var px = pad + inner - pillW;\n                  ctx.fillStyle = TONES[i % TONES.length];\n                  ctx.beginPath();\n                  ctx.roundRect(px, mid - pillH / 2, pillW, pillH, pillH / 2);\n                  ctx.fill();\n                  ctx.fillStyle = V.background;\n                  ctx.textAlign = \"center\";\n                  ctx.fillText(label, px + pillW / 2, mid);\n                  ctx.textAlign = \"left\";\n                }\n                ctx.fillStyle = INK;\n                fitFont(ctx, row[0], inner - pillW - 24 * s, 400, 44 * s, MONO);\n                ctx.fillText(row[0], pad, mid);\n                y += rowH + line;\n              });\n            }\n\n            function drawScenes() {\n              drawB(sceneCanvases[0]);\n            }\n\n            var VERTEX = [\n              \"#version 300 es\",\n              \"in vec2 a_pos;\",\n              \"out vec2 v_uv;\",\n              \"void main() {\",\n              \"  v_uv = vec2(a_pos.x * 0.5 + 0.5, 0.5 - a_pos.y * 0.5);\",\n              \"  gl_Position = vec4(a_pos, 0.0, 1.0);\",\n              \"}\"\n            ].join(\"\\n\");\n            var FRAGMENT = `#version 300 es\nprecision highp float;\n\nuniform sampler2D u_scene;\nuniform vec2 u_resolution;\nuniform float u_aspect;\nuniform float u_progress;\nuniform float u_gain;\nuniform float u_afterglow;\nuniform vec3 u_phosphor;\n\nin vec2 v_uv;\nout vec4 outColor;\n\nconst int TAPS = 32;\nconst int COLUMN_TAPS = 8;\nconst float GOLDEN = 0.6180339887;\nconst float COLLAPSE_END = 0.6000;\nconst float PINCH_END = 0.8200;\nconst float MIN_SQUASH = 0.00550;\nconst float MIN_PINCH = 0.00400;\nconst float CONCENTRATION = 0.3000;\nconst float DECAY_CURVE = 2.6000;\nconst float BLACKOUT_IN = 0.0600;\n\nvoid main() {\n  float p = u_progress;\n\n  if (p <= 0.0) {\n    outColor = texture(u_scene, v_uv);\n    return;\n  }\n  if (p >= 1.0) {\n    outColor = vec4(0.0, 0.0, 0.0, 1.0);\n    return;\n  }\n\n  float collapse = clamp(p / COLLAPSE_END, 0.0, 1.0);\n  float pinch = clamp((p - COLLAPSE_END) / (PINCH_END - COLLAPSE_END), 0.0, 1.0);\n  float decayed = clamp((p - PINCH_END) / (1.0 - PINCH_END), 0.0, 1.0);\n\n  vec2 scale = vec2(pow(MIN_PINCH, pinch), pow(MIN_SQUASH, collapse));\n  vec2 centered = (v_uv - 0.5) / scale + 0.5;\n  vec2 span = 1.0 / (scale * u_resolution);\n\n  vec3 sum = vec3(0.0);\n  for (int i = 0; i < TAPS; i++) {\n    float fi = float(i);\n    vec2 at = centered + vec2(\n      (fract(fi * GOLDEN + 0.5) - 0.5) * span.x,\n      ((fi + 0.5) / float(TAPS) - 0.5) * span.y\n    );\n    vec2 inside = step(vec2(0.0), at) * step(at, vec2(1.0));\n    sum += texture(u_scene, at).rgb * inside.x * inside.y;\n  }\n\n  float concentrate = pow(1.0 / (scale.x * scale.y), CONCENTRATION);\n  vec3 light =\n    (sum / float(TAPS)) * (1.0 + (concentrate - 1.0) * max(u_gain, 0.0));\n\n  float glow = max(u_afterglow, 0.0);\n  float bleed = smoothstep(0.2, 0.8, collapse) * (1.0 - pinch) * glow;\n\n  if (bleed > 0.0) {\n    vec3 column = vec3(0.0);\n    float cx = clamp(centered.x, 0.0, 1.0);\n    for (int i = 0; i < COLUMN_TAPS; i++) {\n      column +=\n        texture(u_scene, vec2(cx, (float(i) + 0.5) / float(COLUMN_TAPS))).rgb;\n    }\n    column /= float(COLUMN_TAPS);\n\n    float dy = v_uv.y - 0.5;\n    float reach = 0.02 + 0.03 * collapse;\n    light +=\n      column *\n      mix(vec3(1.0), u_phosphor, 0.65) *\n      exp(-(dy * dy) / (reach * reach)) *\n      bleed *\n      0.9;\n  }\n\n  if (pinch > 0.0) {\n    vec2 d = (v_uv - 0.5) * vec2(u_aspect, 1.0);\n    float radius = max(0.045 * glow, 0.0005);\n    light +=\n      u_phosphor *\n      exp(-dot(d, d) / (radius * radius)) *\n      smoothstep(0.0, 0.5, pinch) *\n      1.15;\n  }\n\n  light *= pow(max(1.0 - decayed, 0.0001), DECAY_CURVE);\n\n  float blackout = smoothstep(0.0, BLACKOUT_IN, p);\n  outColor = vec4(\n    clamp(light, 0.0, 1.0),\n    mix(texture(u_scene, v_uv).a, 1.0, blackout)\n  );\n}`;\n\n            canvas.width = cw;\n            canvas.height = ch;\n            var gl = canvas.getContext(\"webgl2\", { antialias: false, depth: false, stencil: false, preserveDrawingBuffer: true });\n            function compile(type, source) {\n              var shader = gl.createShader(type);\n              gl.shaderSource(shader, source);\n              gl.compileShader(shader);\n              if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader) || \"shader compile failed\");\n              return shader;\n            }\n            var paint = null;\n            var upload = function () {};\n            var extraUpload = function () {};\n            var frameFn = function () {};\n            var texUnits = [];\n            try {\n              if (!gl) throw new Error(\"WebGL2 is not available\");\n              var program = gl.createProgram();\n              gl.attachShader(program, compile(gl.VERTEX_SHADER, VERTEX));\n              gl.attachShader(program, compile(gl.FRAGMENT_SHADER, FRAGMENT));\n              gl.linkProgram(program);\n              if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program) || \"link failed\");\n              gl.useProgram(program);\n              var buffer = gl.createBuffer();\n              gl.bindBuffer(gl.ARRAY_BUFFER, buffer);\n              gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);\n              var aPos = gl.getAttribLocation(program, \"a_pos\");\n              gl.enableVertexAttribArray(aPos);\n              gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);\n              function makeTexture(unit) {\n                var texture = gl.createTexture();\n                gl.activeTexture(gl.TEXTURE0 + unit);\n                gl.bindTexture(gl.TEXTURE_2D, texture);\n                gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n                gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\n                gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\n                gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\n                return texture;\n              }\n              gl.viewport(0, 0, cw, ch);\n              function u(name) { return gl.getUniformLocation(program, name); }\n              [\"u_scene\"].forEach(function (name, unit) {\n                makeTexture(unit);\n                gl.uniform1i(u(name), unit);\n              });\n              gl.uniform1f(u(\"u_aspect\"), W / H);\n              var frameLoc = u(\"u_frame\");\n              var timeLoc = u(\"u_time\");\n              upload = function () {\n                sceneCanvases.forEach(function (el, unit) {\n                  gl.activeTexture(gl.TEXTURE0 + unit);\n                  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, el);\n                });\n                extraUpload();\n              };\n\n              gl.uniform2f(u(\"u_resolution\"), cw, ch);\n              gl.uniform1f(u(\"u_gain\"), V.gain);\n              gl.uniform1f(u(\"u_afterglow\"), V.afterglow);\n              var glowColor = rgb(V.phosphor);\n              gl.uniform3f(u(\"u_phosphor\"), glowColor[0], glowColor[1], glowColor[2]);\n              var progressLoc = u(\"u_progress\");\n              frameFn = function (frame) {\n                gl.uniform1f(progressLoc, Math.min(1, Math.max(0, (frame - V.delay) / Math.max(1, V.length))));\n              };\n\n              paint = function (frame) {\n                gl.uniform1f(frameLoc, frame);\n                gl.uniform1f(timeLoc, frame / 30);\n                frameFn(frame, frame / 30);\n                gl.clearColor(0, 0, 0, 0);\n                gl.clear(gl.COLOR_BUFFER_BIT);\n                gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);\n              };\n            } catch (err) {\n              stage.classList.add(\"tvo-off\");\n              if (window.console) console.warn(NAME + \":\", err.message);\n            }\n\n            // The scenes are redrawn whenever a web font finishes loading, so no frame keeps a fallback face.\n            var fontEpoch = 0;\n            var sceneEpoch = -1;\n            var lastFrame = 0;\n            function render(frame) {\n              lastFrame = frame;\n              if (sceneEpoch !== fontEpoch) {\n                sceneEpoch = fontEpoch;\n                drawScenes();\n                upload();\n              }\n              if (paint) paint(frame);\n            }\n            if (document.fonts && document.fonts.load) {\n              [\"400 34px Geist\", \"500 30px Geist\", \"600 44px Geist\", \"400 44px 'Geist Mono'\"].forEach(function (face) {\n                document.fonts.load(face).then(function () { fontEpoch++; render(lastFrame); }, function () {});\n              });\n            }\n\n            var total = parseFloat(root.dataset.duration || \"2.0667\");\n            var totalFrames = Math.round(total * 30);\n            var clock = { frame: 0 };\n            var tl = gsap.timeline({ paused: true });\n            tl.to(clock, {\n              frame: totalFrames,\n              duration: total,\n              ease: \"none\",\n              onUpdate: function () { render(Math.round(clock.frame)); }\n            }, 0);\n            render(0);\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[NAME] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
