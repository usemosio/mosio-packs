   "content": "<!doctype html>\n<!--\n  Radial Burst\n\n  A dot launches rounded ribbons that curl into a ring, spin shut and sweep out of frame in a bold geometric burst.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/radial-burst/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"radial-burst\"\n  data-composition-duration=\"4\"\n  data-composition-variables='[{\"id\":\"segments\",\"type\":\"number\",\"role\":\"layout\",\"label\":\"Segments\",\"description\":\"Number of rounded segments.\",\"default\":8,\"min\":4,\"max\":16,\"step\":1},{\"id\":\"radius\",\"type\":\"number\",\"role\":\"layout\",\"label\":\"Burst radius\",\"description\":\"Burst radius at a 720 px reference size.\",\"default\":210,\"min\":100,\"max\":280,\"step\":5,\"unit\":\"px\"},{\"id\":\"thickness\",\"type\":\"number\",\"role\":\"layout\",\"label\":\"Thickness\",\"description\":\"Segment thickness at a 720 px reference size.\",\"default\":30,\"min\":8,\"max\":60,\"step\":1,\"unit\":\"px\"},{\"id\":\"rotation\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Rotation\",\"description\":\"Rotation during assembly, in degrees; negative reverses it.\",\"default\":135,\"min\":-360,\"max\":360,\"step\":15,\"unit\":\"deg\"},{\"id\":\"intensity\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Intensity\",\"description\":\"Sculptural stretch and tilt, from 0 (classic) to 1.5.\",\"default\":1,\"min\":0,\"max\":1.5,\"step\":0.1},{\"id\":\"twist\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Ribbon twist\",\"description\":\"Curvature of the flying ribbons in degrees.\",\"default\":110,\"min\":-180,\"max\":180,\"step\":10,\"unit\":\"deg\"},{\"id\":\"echoes\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Contour echoes\",\"description\":\"Number of fading outline echoes trailing the burst.\",\"default\":3,\"min\":0,\"max\":5,\"step\":1},{\"id\":\"color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Shape color\",\"description\":\"Main shape color.\",\"default\":\"#ffffff\"},{\"id\":\"accent_color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Accent color\",\"description\":\"Accent color mixed into every third ribbon.\",\"default\":\"#f4e4a7\"},{\"id\":\"background_color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Background\",\"description\":\"Backdrop color.\",\"default\":\"#a800b7\"},{\"id\":\"speed\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Speed\",\"description\":\"Playback speed multiplier.\",\"default\":1,\"min\":0.25,\"max\":3,\"step\":0.05,\"unit\":\"x\"},{\"id\":\"loop\",\"type\":\"boolean\",\"role\":\"motion\",\"label\":\"Loop\",\"description\":\"Repeat the burst continuously.\",\"default\":false}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Radial Burst</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n\n        }\n        .rbu-stage { position: absolute; inset: 0; }\n        .rbu-svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"radial-burst\" data-duration=\"4\" data-fps=\"30\">\n        <div id=\"rbu-clip\" class=\"rbu-stage clip\" data-start=\"0\" data-duration=\"4\" data-track-index=\"0\">\n          <svg id=\"rbu-svg\" class=\"rbu-svg\" role=\"img\" aria-label=\"Geometric radial burst\"><g id=\"rbu-origin\"><g id=\"rbu-echoes\"></g><g id=\"rbu-main\"></g></g></svg>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n            \n\n                                   \n                                                  \n                    \n                                                \n                  \n                                                     \n                     \n                                                                    \n                    \n                                                              \n                     \n                                                    \n                 \n                                               \n                  \n                 \n                       \n                           \n                 \n                 \n                     \n \n\n/** The ring has completely left the composition by this frame at 30 fps. */\nconst radialBurstLength = 114;\nconst CYCLE = 120;\nconst finite = (value        , fallback        ) =>\n  Number.isFinite(value) ? value : fallback;\nconst clamp = (value        ) => Math.min(1, Math.max(0, value));\nconst mix = (from        , to        , progress        ) =>\n  from + (to - from) * progress;\nconst easeInOut = Easing.bezier(0.65, 0, 0.25, 1);\nconst easeOut = Easing.bezier(0.16, 1, 0.3, 1);\nconst progress = (frame        , start        , end        ) =>\n  clamp((frame - start) / (end - start));\n\n/** Includes the clean tail, in frames at 30 fps. */\nfunction getRadialBurstDuration({\n  speed = 1,\n}                                  = {}) {\n  const rate = finite(speed, 1);\n  return rate <= 0 ? 1 : Math.max(1, Math.ceil(CYCLE / rate));\n}\n\nfunction getRadialBurstState(\n  frame        ,\n  {\n    segments = 8,\n    radius = 210,\n    thickness = 30,\n    rotation = 135,\n    intensity = 1,\n    loop = false,\n    width = 1280,\n    height = 720,\n  }       \n                     \n                                                                       \n       \n                   \n                    \n    = {},\n) {\n  const w = Math.max(1, finite(width, 1280));\n  const h = Math.max(1, finite(height, 720));\n  const unit = Math.min(w, h) / 720;\n  const time = Math.max(0, finite(frame, 0));\n  const local = loop ? time % CYCLE : time;\n  const count = Math.round(Math.min(16, Math.max(4, finite(segments, 8))));\n  const burstRadius = Math.min(280, Math.max(100, finite(radius, 210))) * unit;\n  const stroke = Math.min(60, Math.max(8, finite(thickness, 30))) * unit;\n  const ringRadius = burstRadius * 0.68;\n  const assemble = easeInOut(progress(local, 44, 76));\n  const curl = easeInOut(progress(local, 48, 78));\n  const close = easeInOut(progress(local, 72, 84));\n  const anticipate = easeInOut(progress(local, 86, 96));\n  const exit = progress(local, 96, radialBurstLength) ** 2.6;\n  const launch = spring({\n    frame: Math.max(0, local - 18),\n    fps: 30,\n    durationInFrames: 26,\n    config: { damping: 13, stiffness: 170, mass: 0.8 },\n  });\n  const pop = spring({\n    frame: Math.max(0, local - 2),\n    fps: 30,\n    durationInFrames: 16,\n    config: { damping: 11, stiffness: 180, mass: 0.65 },\n  });\n  const ringStroke = mix(stroke * 0.8, stroke * 1.1, anticipate);\n  const exitStroke = mix(ringStroke, stroke * 2.2, exit);\n  // The inner edge, not just the centerline, must pass every corner.\n  const clearRadius = Math.hypot(w, h) / 2 + stroke * 2.2 + 2;\n  const orbitRadius = mix(\n    mix(28 * unit, burstRadius, launch),\n    ringRadius,\n    assemble,\n  );\n  const finalRadius = mix(ringRadius, ringRadius * 0.84, anticipate);\n  const strength = Math.min(1.5, Math.max(0, finite(intensity, 1)));\n  const energy = Math.sin(Math.PI * progress(local, 18, 84));\n  const tilt =\n    easeOut(progress(local, 18, 48)) *\n    (1 - easeInOut(progress(local, 96, 114)));\n\n  return {\n    frame: local,\n    count,\n    unit,\n    strength,\n    energy: Math.max(0, energy) * strength,\n    planeScale: 1 - tilt * 0.46 * Math.min(1.5, strength),\n    planeAngle:\n      Math.sin(progress(local, 18, 114) * Math.PI * 1.6) * 32 * strength,\n    offsetX:\n      Math.sin(Math.PI * progress(local, 18, 114)) * 65 * unit * strength,\n    offsetY:\n      -Math.sin(Math.PI * progress(local, 18, 114)) * 32 * unit * strength,\n    dotRadius: 37 * unit * pop * (1 - easeOut(progress(local, 18, 26))),\n    dotSquash: 1 - Math.sin(Math.PI * progress(local, 2, 18)) * 0.16,\n    showSegments: local >= 18 && local < 84,\n    showRing: local >= 84 && local < radialBurstLength,\n    segmentOpacity: easeOut(progress(local, 18, 23)),\n    radius: local < 84 ? orbitRadius : mix(finalRadius, clearRadius, exit),\n    strokeWidth: local < 84 ? mix(stroke, stroke * 0.8, assemble) : exitStroke,\n    segmentLength: mix(\n      12 * unit,\n      Math.min(82 * unit, burstRadius * 0.42),\n      easeOut(progress(local, 18, 36)),\n    ),\n    curl,\n    // Gaps close with a tiny overlap to prevent raster seams at the weld.\n    arcAngle: ((Math.PI * 2) / count) * mix(0.62, 1.002, close),\n    rotation: finite(rotation, 135) * easeInOut(progress(local, 34, 84)),\n  };\n}\n\n/** A straight rounded spoke curls continuously into a circular arc. */\nfunction getSegmentPoints({\n  radius,\n  segmentLength,\n  arcAngle,\n  curl,\n}       \n                                         \n                                                  \n ) {\n  const half = arcAngle / 2;\n  const x = radius * Math.cos(half);\n  const y = radius * Math.sin(half);\n  const tangent = (4 / 3) * Math.tan(arcAngle / 4) * radius;\n  const arc = [\n    [x, -y],\n    [x + tangent * Math.sin(half), -y + tangent * Math.cos(half)],\n    [x + tangent * Math.sin(half), y - tangent * Math.cos(half)],\n    [x, y],\n  ];\n  const angle = (curl * Math.PI) / 2;\n  return [-0.5, -1 / 6, 1 / 6, 0.5].map((offset, index) => {\n    const px = radius + segmentLength * offset * Math.cos(angle);\n    const py = segmentLength * offset * Math.sin(angle);\n    return [mix(px, arc[index][0], curl), mix(py, arc[index][1], curl)];\n  });\n}\n\nfunction getRadialBurstSegmentPath(\n  state                                        ,\n) {\n  const points = getSegmentPoints(state).map((point) =>\n    point.map((value) => value.toFixed(3)).join(\" \"),\n  );\n  return `M ${points[0]} C ${points[1]} ${points[2]} ${points[3]}`;\n}\n\n/** Sample a bent centerline and its normals to make a tapered, filled ribbon. */\nfunction getRadialBurstRibbonPath(\n  state                                        ,\n  index        ,\n  twist = 110,\n) {\n  const energy = state.energy;\n  const points = getSegmentPoints({\n    ...state,\n    radius: state.radius * (1 + Math.sin(index * 2.4) * energy * 0.15),\n    segmentLength: state.segmentLength * (1 + energy * 2.8),\n  });\n  const bend =\n    (Math.min(180, Math.max(-180, finite(twist, 110))) / 110) *\n    energy *\n    145 *\n    state.unit;\n  points[1][1] += bend * 0.55;\n  points[2][1] += bend;\n  // Carry the tip with the bend so the centerline does not double back into\n  // a hairpin while the ribbon transitions from a spoke to an arc.\n  points[3][1] += bend * 1.25;\n  points[2][0] += energy * 38 * state.unit;\n  const upper           = [];\n  const lower           = [];\n  const format = (x        , y        ) => `${x.toFixed(3)} ${y.toFixed(3)}`;\n  let firstWidth = 0;\n  let lastWidth = 0;\n  for (let sample = 0; sample <= 36; sample++) {\n    const t = sample / 36;\n    const q = 1 - t;\n    const x =\n      q ** 3 * points[0][0] +\n      3 * q * q * t * points[1][0] +\n      3 * q * t * t * points[2][0] +\n      t ** 3 * points[3][0];\n    const y =\n      q ** 3 * points[0][1] +\n      3 * q * q * t * points[1][1] +\n      3 * q * t * t * points[2][1] +\n      t ** 3 * points[3][1];\n    const dx =\n      3 * q * q * (points[1][0] - points[0][0]) +\n      6 * q * t * (points[2][0] - points[1][0]) +\n      3 * t * t * (points[3][0] - points[2][0]);\n    const dy =\n      3 * q * q * (points[1][1] - points[0][1]) +\n      6 * q * t * (points[2][1] - points[1][1]) +\n      3 * t * t * (points[3][1] - points[2][1]);\n    const length = Math.max(0.001, Math.hypot(dx, dy));\n    const ddx =\n      6 * q * (points[2][0] - 2 * points[1][0] + points[0][0]) +\n      6 * t * (points[3][0] - 2 * points[2][0] + points[1][0]);\n    const ddy =\n      6 * q * (points[2][1] - 2 * points[1][1] + points[0][1]) +\n      6 * t * (points[3][1] - 2 * points[2][1] + points[1][1]);\n    const curvature = Math.abs(dx * ddy - dy * ddx) / length ** 3;\n    const swell = Math.sin(Math.PI * t) ** 1.4;\n    // Offset curves fold back on themselves when their width exceeds the\n    // bend radius. Limit the width locally to keep tight curls smooth.\n    const halfWidth = Math.min(\n      (state.strokeWidth / 2) * (1 + energy * (2.4 * swell - 0.65 * t)),\n      0.72 / Math.max(curvature, 0.00001),\n    );\n    if (sample === 0) firstWidth = halfWidth;\n    if (sample === 36) lastWidth = halfWidth;\n    upper.push(\n      format(x - (dy / length) * halfWidth, y + (dx / length) * halfWidth),\n    );\n    lower.push(\n      format(x + (dy / length) * halfWidth, y - (dx / length) * halfWidth),\n    );\n  }\n  return `M ${upper.join(\" L \")} A ${lastWidth} ${lastWidth} 0 0 0 ${lower[36]} L ${lower.slice(0, -1).reverse().join(\" L \")} A ${firstWidth} ${firstWidth} 0 0 0 ${upper[0]} Z`;\n}\n\n\n            var P = {\n              segments: num(vars.segments, 8, 4, 16), radius: num(vars.radius, 210, 100, 280), thickness: num(vars.thickness, 30, 8, 60),\n              rotation: num(vars.rotation, 135, -360, 360), intensity: num(vars.intensity, 1, 0, 1.5), twist: num(vars.twist, 110, -180, 180),\n              echoes: num(vars.echoes, 3, 0, 5), color: str(vars.color, \"#ffffff\"), accent: str(vars.accent_color, \"#f4e4a7\"),\n              speed: num(vars.speed, 1, 0.25, 3), loop: bool(vars.loop, false)\n            };\n            var color = P.color, accentColor = P.accent, twist = P.twist;\n            root.style.background = str(vars.background_color, \"#a800b7\");\n            var width = root.clientWidth, height = root.clientHeight;\n            var svg = document.getElementById(\"rbu-svg\");\n            svg.setAttribute(\"viewBox\", \"0 0 \" + width + \" \" + height);\n            document.getElementById(\"rbu-origin\").setAttribute(\"transform\", \"translate(\" + width / 2 + \" \" + height / 2 + \")\");\n            var echoesG = document.getElementById(\"rbu-echoes\"), mainG = document.getElementById(\"rbu-main\");\n            var options = { segments: P.segments, radius: P.radius, thickness: P.thickness, rotation: P.rotation, intensity: P.intensity, loop: P.loop, width: width, height: height };\n            function plane(pose) {\n              return \"translate(\" + pose.offsetX + \" \" + pose.offsetY + \") rotate(\" + pose.planeAngle + \") scale(1 \" + pose.planeScale + \")\";\n            }\n            function ribbons(pose, outline) {\n              var out = \"\";\n              for (var index = 0; index < pose.count; index++) {\n                var fill = outline ? \"none\" : index % 3 === 0 ? interpolateColors(clamp(pose.energy), [0, 1], [color, accentColor]) : color;\n                var rot = (index * 360) / pose.count + pose.rotation - 90 + Math.sin(index * 1.7) * pose.energy * 16;\n                out += '<path d=\"' + getRadialBurstRibbonPath(pose, index, twist) + '\" transform=\"rotate(' + rot + ')\" fill=\"' + fill + '\" stroke=\"' + (outline ? color : \"none\") + '\" stroke-width=\"' + 1.5 * pose.unit + '\"/>';\n              }\n              return out;\n            }\n            function draw(frame) {\n              var time = frame * P.speed;\n              var state = getRadialBurstS