   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Particle Dissolve\n\n  The frame ground into drifting grey dust, with the next scene coalescing back out of\n  it.\n  The block plays the cut between two built-in panels: a stat and a bar chart, then a render queue.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/particle-dissolve/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n\n  remocn captures its React children with the HTML-in-Canvas API, which a render machine does\n  not have. This block draws remocn's preview scene (a stat and a bar chart and then a render queue) (text and colours from the variables) on a\n  2D canvas and runs remocn's fragment shader over it, so it applies the look to its own content,\n  not to the host video behind it.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"particle-dissolve\"\n  data-composition-duration=\"5.2\"\n  data-composition-variables='[{\"id\": \"label\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Label\", \"description\": \"Small caption above the number in the sample scene.\", \"default\": \"Deploys this week\"}, {\"id\": \"value\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Value\", \"description\": \"The big number in the sample scene.\", \"default\": \"2,481\"}, {\"id\": \"bars\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Bars\", \"description\": \"Bar heights as percentages, separated by commas (up to 12); the last bar is highlighted.\", \"default\": \"32,51,43,68,57,86,64,100\"}, {\"id\": \"accent\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Highlight\", \"description\": \"Colour of the last bar.\", \"default\": \"#a1eebd\"}, {\"id\": \"title\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Title\", \"description\": \"Small heading above the list in the sample scene.\", \"default\": \"Render queue\"}, {\"id\": \"items\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Rows\", \"description\": \"Rows of the list as name | status, separated by semicolons (up to 5).\", \"default\": \"intro-scene.mp4 | Done; feature-tour.mp4 | Rendering; pricing-outro.mp4 | Queued\"}, {\"id\": \"background\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Background of the list scene.\", \"default\": \"#101828\"}, {\"id\": \"particle_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Particle size\", \"description\": \"Size of one speck. Pixel sizes are for a 1280×720 frame and scale with the frame.\", \"default\": 4, \"min\": 1, \"max\": 16, \"step\": 1, \"unit\": \"px\"}, {\"id\": \"scatter\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Scatter\", \"description\": \"How far the dust drifts.\", \"default\": 0.08, \"min\": 0.01, \"max\": 0.4, \"step\": 0.01}, {\"id\": \"shimmer\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Shimmer\", \"description\": \"Brightness of the twinkling specks.\", \"default\": 0.6, \"min\": 0, \"max\": 1.5, \"step\": 0.05}, {\"id\": \"aberration\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Aberration\", \"description\": \"Colour fringing on the drifting picture.\", \"default\": 0.5, \"min\": 0, \"max\": 1.5, \"step\": 0.05}, {\"id\": \"direction\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Direction\", \"description\": \"Where the dissolve starts: from the centre, or sweeping one way.\", \"default\": \"reveal\", \"options\": [{\"value\": \"reveal\", \"label\": \"Reveal\"}, {\"value\": \"up\", \"label\": \"Up\"}, {\"value\": \"down\", \"label\": \"Down\"}, {\"value\": \"left\", \"label\": \"Left\"}, {\"value\": \"right\", \"label\": \"Right\"}]}, {\"id\": \"stagger\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Stagger\", \"description\": \"How much the break-up is spread over the transition.\", \"default\": 0.55, \"min\": 0, \"max\": 0.9, \"step\": 0.05}, {\"id\": \"resolution\", \"type\": \"number\", \"role\": \"quality\", \"label\": \"Resolution\", \"description\": \"Share of the frame size the shader is drawn at, then scaled up. Specks are a few pixels; 0.75 is the floor for them.\", \"default\": 0.75, \"min\": 0.25, \"max\": 1, \"step\": 0.05}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Particle Dissolve</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Geist+Mono:wght@400&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          background: #000;\n          pointer-events: none;\n        }\n        .pdv-stage {\n          position: absolute;\n          inset: 0;\n        }\n        .pdv-canvas,\n        .pdv-scene {\n          position: absolute;\n          inset: 0;\n          width: 100%;\n          height: 100%;\n          display: block;\n        }\n        .pdv-scene {\n          display: none;\n        }\n        .pdv-off .pdv-canvas {\n          display: none;\n        }\n        .pdv-off .pdv-fb {\n          display: block;\n        }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"particle-dissolve\" data-duration=\"5.2\" data-fps=\"30\">\n        <div id=\"pdv-clip\" class=\"pdv-stage clip\" data-start=\"0\" data-duration=\"5.2\" data-track-index=\"0\">\n          <canvas id=\"pdv-scene0\" class=\"pdv-scene\"></canvas>\n          <canvas id=\"pdv-scene1\" class=\"pdv-scene pdv-fb\"></canvas>\n          <canvas id=\"pdv-canvas\" class=\"pdv-canvas\"></canvas>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"particle-dissolve\";\n            var root = document.getElementById(\"root\");\n            var stage = document.getElementById(\"pdv-clip\");\n            var canvas = document.getElementById(\"pdv-canvas\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function clampNum(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function hex(value, fallback) {\n              var m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(String(value || \"\").trim());\n              if (!m) return fallback;\n              var h = m[1].length === 3 ? m[1].replace(/./g, \"$&$&\") : m[1];\n              return \"#\" + h.toLowerCase();\n            }\n            function rgb(value) {\n              var h = hex(value, \"#ffffff\").slice(1);\n              return [parseInt(h.slice(0, 2), 16) / 255, parseInt(h.slice(2, 4), 16) / 255, parseInt(h.slice(4, 6), 16) / 255];\n            }\n            var DEFS = [{\"id\": \"label\", \"type\": \"string\", \"default\": \"Deploys this week\"}, {\"id\": \"value\", \"type\": \"string\", \"default\": \"2,481\"}, {\"id\": \"bars\", \"type\": \"string\", \"default\": \"32,51,43,68,57,86,64,100\"}, {\"id\": \"accent\", \"type\": \"color\", \"default\": \"#a1eebd\"}, {\"id\": \"title\", \"type\": \"string\", \"default\": \"Render queue\"}, {\"id\": \"items\", \"type\": \"string\", \"default\": \"intro-scene.mp4 | Done; feature-tour.mp4 | Rendering; pricing-outro.mp4 | Queued\"}, {\"id\": \"background\", \"type\": \"color\", \"default\": \"#101828\"}, {\"id\": \"particle_size\", \"type\": \"number\", \"default\": 4, \"min\": 1, \"max\": 16}, {\"id\": \"scatter\", \"type\": \"number\", \"default\": 0.08, \"min\": 0.01, \"max\": 0.4}, {\"id\": \"shimmer\", \"type\": \"number\", \"default\": 0.6, \"min\": 0, \"max\": 1.5}, {\"id\": \"aberration\", \"type\": \"number\", \"default\": 0.5, \"min\": 0, \"max\": 1.5}, {\"id\": \"direction\", \"type\": \"enum\", \"default\": \"reveal\", \"options\": [\"reveal\", \"up\", \"down\", \"left\", \"right\"]}, {\"id\": \"stagger\", \"type\": \"number\", \"default\": 0.55, \"min\": 0, \"max\": 0.9}, {\"id\": \"resolution\", \"type\": \"number\", \"default\": 0.75, \"min\": 0.25, \"max\": 1}];\n            var V = {};\n            DEFS.forEach(function (d) {\n              var raw = vars[d.id];\n              if (d.type === \"number\") V[d.id] = clampNum(raw, d.default, d.min, d.max);\n              else if (d.type === \"color\") V[d.id] = hex(raw, d.default);\n              else if (d.type === \"boolean\") V[d.id] = typeof raw === \"boolean\" ? raw : raw === \"true\" ? true : raw === \"false\" ? false : d.default;\n              else if (d.type === \"enum\") V[d.id] = d.options.indexOf(raw) >= 0 ? raw : d.default;\n              else V[d.id] = typeof raw === \"string\" && raw.trim() ? raw.trim() : d.default;\n            });\n\n            var W = Math.max(2, root.clientWidth);\n            var H = Math.max(2, root.clientHeight);\n            var res = V.resolution;\n            var cw = Math.max(2, Math.round(W * res));\n            var ch = Math.max(2, Math.round(H * res));\n            var sceneCanvases = [\"pdv-scene0\", \"pdv-scene1\"].map(function (id) {\n              var el = document.getElementById(id);\n              el.width = cw;\n              el.height = ch;\n              return el;\n            });\n\n            var SANS = \"Geist, -apple-system, BlinkMacSystemFont, sans-serif\";\n            var MONO = \"'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace\";\n            var INK = \"#f2f2f2\";\n            var MUTED = \"#8b8f9a\";\n            var TONES = [\"#a1eebd\", \"#ffb38e\", \"#d4b3ff\"];\n            var S = Math.min(W / 940, H / 720);\n            function setFont(ctx, weight, size, family) { ctx.font = weight + \" \" + size + \"px \" + family; }\n            function fitFont(ctx, text, maxWidth, weight, size, family) {\n              setFont(ctx, weight, size, family);\n              var w = ctx.measureText(text).width;\n              if (w > maxWidth) { size *= maxWidth / w; setFont(ctx, weight, size, family); }\n              return size;\n            }\n            function setSpacing(ctx, px) { if (\"letterSpacing\" in ctx) ctx.letterSpacing = px + \"px\"; }\n            function wrapLines(ctx, text, maxWidth) {\n              var words = String(text).split(/\\s+/).filter(Boolean);\n              var lines = [];\n              var line = \"\";\n              words.forEach(function (word) {\n                var next = line ? line + \" \" + word : word;\n                if (line && ctx.measureText(next).width > maxWidth) { lines.push(line); line = word; }\n                else line = next;\n              });\n              if (line) lines.push(line);\n              return lines;\n            }\n            function pairs(text, max) {\n              return String(text).split(\";\")\n                .map(function (row) { return row.split(\"|\").map(function (part) { return part.trim(); }); })\n                .filter(function (row) { return row[0]; })\n                .slice(0, max);\n            }\n            function begin(ctx, cw, ch, fill) {\n              ctx.setTransform(cw / W, 0, 0, ch / H, 0, 0);\n              ctx.fillStyle = fill;\n              ctx.fillRect(0, 0, W, H);\n              ctx.textBaseline = \"middle\";\n              ctx.textAlign = \"left\";\n              setSpacing(ctx, 0);\n            }\n\n\n            // Sample scene \"A\": a stat and a bar chart (remocn's CanvasSceneA), laid out for any frame size.\n            var barValues = String(V.bars).split(\",\").map(function (n) { return Math.min(100, Math.max(4, Number(n) || 0)); }).slice(0, 12);\n            if (!barValues.length) barValues = [32, 51, 43, 68, 57, 86, 64, 100];\n            function drawA(canvas) {\n              var ctx = canvas.getContext(\"2d\");\n              begin(ctx, canvas.width, canvas.height, \"#0a0a0a\");\n              var s = S, pad = 96 * s, inner = W - pad * 2;\n              var labelH = 41 * s, valueSize = 152 * s, barsH = 190 * s;\n              var total = labelH + 6 * s + valueSize + 52 * s + barsH;\n              var y = (H - total) / 2;\n              ctx.fillStyle = MUTED;\n              fitFont(ctx, V.label, inner, 400, 34 * s, SANS);\n              ctx.fillText(V.label, pad, y + labelH / 2);\n              y += labelH + 6 * s;\n              ctx.fillStyle = INK;\n              setSpacing(ctx, -0.04 * valueSize);\n              fitFont(ctx, V.value, inner, 600, valueSize, SANS);\n              ctx.fillText(V.value, pad, y + valueSize / 2);\n              setSpacing(ctx, 0);\n              y += valueSize + 52 * s;\n              var n = barValues.length;\n              var bs = Math.min(1, inner / ((n * 74 + (n - 1) * 16) * s));\n              var bw = 74 * s * bs, gap = 16 * s * bs, base = y + barsH;\n              barValues.forEach(function (v, i) {\n                var h = barsH * v / 100;\n                ctx.fillStyle = i === n - 1 ? V.accent : \"#23262e\";\n                ctx.beginPath();\n                ctx.roundRect(pad + i * (bw + gap), base - h, bw, h, 10 * s * bs);\n                ctx.fill();\n              });\n            }\n\n\n            // Sample scene \"B\": a render queue (remocn's CanvasSceneB), laid out for any frame size.\n            var rows = pairs(V.items, 5);\n            function drawB(canvas) {\n              var ctx = canvas.getContext(\"2d\");\n              begin(ctx, canvas.width, canvas.height, V.background);\n              var s = S, pad = 96 * s, inner = W - pad * 2;\n              var titleH = 41 * s, rowH = 120 * s, line = Math.max(1, s);\n              var total = titleH + 34 * s + rows.length * (rowH + line);\n              var y = (H - total) / 2;\n              ctx.fillStyle = MUTED;\n              fitFont(ctx, V.title, inner, 400, 34 * s, SANS);\n              ctx.fillText(V.title, pad, y + titleH / 2);\n              y += titleH + 34 * s;\n              rows.forEach(function (row, i) {\n                ctx.fillStyle = \"#23304a\";\n                ctx.fillRect(pad, y, inner, line);\n                var mid = y + line + rowH / 2;\n                var label = row[1] || \"\";\n                var pillW = 0;\n                if (label) {\n                  var labelSize = fitFont(ctx, label, inner * 0.4, 500, 30 * s, SANS);\n                  pillW = ctx.measureText(label).width + 52 * s;\n                  var pillH = labelSize * 1.2 + 24 * s;\n                  var px = pad + inner - pillW;\n                  ctx.fillStyle = TONES[i % TONES.length];\n                  ctx.beginPath();\n                  ctx.roundRect(px, mid - pillH / 2, pillW, pillH, pillH / 2);\n                  ctx.fill();\n                  ctx.fillStyle = V.background;\n                  ctx.textAlign = \"center\";\n                  ctx.fillText(label, px + pillW / 2, mid);\n                  ctx.textAlign = \"left\";\n                }\n                ctx.fillStyle = INK;\n                fitFont(ctx, row[0], inner - pillW - 24 * s, 400, 44 * s, MONO);\n                ctx.fillText(row[0], pad, mid);\n                y += rowH + line;\n              });\n            }\n\n            function drawScenes() {\n              drawA(sceneCanvases[0]);\n              drawB(sceneCanvases[1]);\n            }\n\n            var VERTEX = [\n              \"#version 300 es\",\n              \"in vec2 a_pos;\",\n              \"out vec2 v_uv;\",\n              \"void main() {\",\n              \"  v_uv = vec2(a_pos.x * 0.5 + 0.5, 0.5 - a_pos.y * 0.5);\",\n              \"  gl_Position = vec4(a_pos, 0.0, 1.0);\",\n              \"}\"\n            ].join(\"\\n\");\n            var FRAGMENT = `#version 300 es\nprecision highp float;\n\nuniform sampler2D u_from;\nuniform sampler2D u_to;\nuniform float u_progress;\nuniform float u_aspect;\nuniform float u_cells;\nuniform float u_scatter;\nuniform float u_shimmer;\nuniform float u_aberration;\nuniform float u_stagger;\nuniform vec2 u_dir;\nuniform float u_radial;\n\nin vec2 v_uv;\nout vec4 outColor;\n\nconst float PI = 3.141592653589793;\n\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n}\n\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  vec2 u = f * f * (3.0 - 2.0 * f);\n  return mix(\n    mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),\n    mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),\n    u.y\n  );\n}\n\nfloat fbm(vec2 p) {\n  float sum = 0.0;\n  float amp = 0.5;\n  for (int i = 0; i < 4; i++) {\n    sum += noise(p) * amp;\n    p *= 2.03;\n    amp *= 0.5;\n  }\n  return sum * 1.0667;\n}\n\nfloat luma(vec3 c) {\n  return dot(c, vec3(0.2126, 0.7152, 0.0722));\n}\n\nvec4 grab(sampler2D tex, vec2 uv, vec2 dir, float amount) {\n  vec4 centre = texture(tex, uv);\n  float r = texture(tex, uv + dir * amount).r;\n  float b = texture(tex, uv - dir * amount).b;\n  return vec4(r, centre.g, b, centre.a);\n}\n\nvoid main() {\n  vec2 grid = vec2(u_cells * u_aspect, u_cells);\n  vec2 skewed = vec2(v_uv.x * u_aspect, v_uv.y);\n  vec2 centred = skewed - vec2(0.5 * u_aspect, 0.5);\n\n  float spatial = u_radial > 0.5\n    ? clamp(length(centred) / 0.62, 0.0, 1.0)\n    : clamp(dot(v_uv - 0.5, u_dir) + 0.5, 0.0, 1.0);\n  float blob = fbm(skewed * 2.2);\n  float order = mix(blob, spatial, 0.55) * u_stagger;\n  float span = max(1.0 - u_stagger, 0.08);\n  float phase = clamp((u_progress - order) / span, 0.0, 1.0);\n  float dust = sin(phase * PI);\n\n  vec2 flow = vec2(\n    fbm(skewed * 3.0 + vec2(0.0, u_progress * 0.8)),\n    fbm(skewed * 3.0 + vec2(5.3, 2.7 - u_progress * 0.7))\n  ) - 0.5;\n  vec2 aim =\n    flow * 2.0 + normalize(centred + 0.0001) * 0.7 * u_radial + u_dir;\n  vec2 heading = aim / max(length(aim), 0.0001);\n\n  float bright = luma(texture(u_from, v_uv).rgb);\n  float travel = u_scatter * dust * (0.18 + bright * 1.25);\n  vec2 drift = vec2(heading.x / u_aspect, heading.y) * travel;\n\n  float split = u_aberration * dust * 0.35;\n  vec4 leaving = grab(u_from, v_uv - drift, drift, split);\n  vec4 arriving = grab(u_to, v_uv + drift, -drift, split);\n\n  vec4 base = mix(leaving, arriving, smoothstep(0.25, 0.75, phase));\n  base.rgb = mix(base.rgb, vec3(luma(base.rgb)), dust);\n  base.rgb *= 1.0 - dust * 0.25;\n\n  vec2 g = (v_uv - drift) * grid;\n  vec2 origin = floor(g);\n  float cover = 0.0;\n  float light = 0.0;\n  for (int oy = -1; oy <= 1; oy++) {\n    for (int ox = -1; ox <= 1; ox++) {\n      vec2 cell = origin + vec2(float(ox), float(oy));\n      vec2 jitter = vec2(hash(cell + 3.1), hash(cell + 8.7));\n      float mote = hash(cell + 13.7);\n      float twinkle =\n        0.5 + 0.5 * sin(u_progress * (12.0 + mote * 30.0) + mote * 6.2831);\n      float radius =\n        (0.36 + 0.46 * hash(cell + 21.3)) * (0.65 + 0.6 * twinkle);\n      float reach = length(g - (cell + jitter));\n      float hit = 1.0 - smoothstep(radius * 0.45, radius, reach);\n      cover = max(cover, hit);\n      light = max(light, hit * mote * twinkle);\n    }\n  }\n  cover = mix(1.0, cover, dust);\n  light *= dust;\n\n  vec4 speck = vec4(\n    base.rgb + vec3(0.36 * light * u_shimmer) * base.a,\n    base.a\n  );\n  vec4 gap = vec4(base.rgb * (1.0 - dust * 0.6), base.a);\n  outColor = mix(gap, speck, cover);\n}`;\n\n            canvas.width = cw;\n            canvas.height = ch;\n            var gl = canvas.getContext(\"webgl2\", { antialias: false, depth: false, stencil: false, preserveDrawingBuffer: true });\n            function compile(type, source) {\n              var shader = gl.createShader(type);\n              gl.shaderSource(shader, source);\n              gl.compileShader(shader);\n              if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader) || \"shader compile failed\");\n              return shader;\n            }\n            var paint = null;\n            var upload = function () {};\n            var extraUpload = function () {};\n            var frameFn = function () {};\n            var texUnits = [];\n            try {\n              if (!gl) throw new Error(\"WebGL2 is not available\");\n              var program = gl.createProgram();\n              gl.attachShader(program, compile(gl.VERTEX_SHADER, VERTEX));\n              gl.attachShader(program, compile(gl.FRAGMENT_SHADER, FRAGMENT));\n              gl.linkProgram(program);\n              if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program) || \"link failed\");\n              gl.useProgram(program);\n              var buffer = gl.createBuffer();\n              gl.bindBuffer(gl.ARRAY_BUFFER, buffer);\n              gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, 