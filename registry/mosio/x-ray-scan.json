   "content": "<!doctype html>\n<!--\n  X-Ray Scan\n\n  A glowing scanner bar sweeps across a device and reveals its white-line internals, with one part marked in the accent color. A built-in phone back and its internals stand in for the product: a host swaps in its own pictures by replacing the contents of the .xr-outside layer (the exterior, ahead of the bar) and the .xr-inside layers (the interior, behind the bar; both layers hold the same picture).\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/x-ray-scan/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"x-ray-scan\"\n  data-composition-duration=\"2.17\"\n  data-composition-variables='[\n    {\"id\": \"direction\", \"type\": \"enum\", \"role\": \"motion\", \"label\": \"Direction\", \"description\": \"Horizontal sweeps left to right, vertical sweeps top to bottom.\", \"default\": \"horizontal\", \"options\": [{\"value\": \"horizontal\", \"label\": \"Horizontal\"}, {\"value\": \"vertical\", \"label\": \"Vertical\"}]},\n    {\"id\": \"shell\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Shell\", \"description\": \"Color of the built-in phone shell.\", \"default\": \"#E5322D\"},\n    {\"id\": \"accent\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent part\", \"description\": \"Color of the highlighted internal part.\", \"default\": \"#E5322D\"},\n    {\"id\": \"line\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Scan line\", \"description\": \"Scan bar and interior line art color.\", \"default\": \"#FFFFFF\"},\n    {\"id\": \"background\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Background color.\", \"default\": \"#111111\"},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed.\", \"default\": 1, \"min\": 0.1, \"max\": 4, \"step\": 0.1}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>X-Ray Scan</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n        #root { background: #111111; }\n        .xr-stage { position: absolute; inset: 0; overflow: hidden; }\n        .xr-layer { position: absolute; inset: 0; }\n        .xr-layer svg { display: block; width: 100%; height: 100%; }\n        .xr-trail { position: absolute; inset: 0; opacity: 0; }\n        .xr-bar { position: absolute; opacity: 0; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"x-ray-scan\" data-duration=\"2.17\" data-fps=\"30\">\n        <div id=\"xr-clip\" class=\"xr-stage clip\" data-start=\"0\" data-duration=\"2.17\" data-track-index=\"0\">\n          <svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs id=\"xr-defs\"></defs></svg>\n          <div id=\"xr-outside\" class=\"xr-layer xr-outside\"></div>\n          <div id=\"xr-inside\" class=\"xr-layer xr-inside\"></div>\n          <div id=\"xr-hot\" class=\"xr-layer xr-inside\"></div>\n          <div id=\"xr-trail\" class=\"xr-trail\"></div>\n          <div id=\"xr-bar\" class=\"xr-bar\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value.trim() ? value : fallback;\n            }\n            function bool(value, fallback) {\n              if (typeof value === \"boolean\") return value;\n              if (value === \"true\") return true;\n              if (value === \"false\") return false;\n              return fallback;\n            }\n            var FPS = 30;\n            var W = root.clientWidth || 1080;\n            var H = root.clientHeight || 1920;\n\n            // Piecewise-linear map of x from inR to outR, optionally eased per segment and clamped.\n            function interp(x, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var i = 0;\n              if (x >= inR[n - 1]) i = n - 2;\n              else if (x > inR[0]) { while (x > inR[i + 1]) i++; }\n              var t = (x - inR[i]) / (inR[i + 1] - inR[i]);\n              if (o.clamp !== false) t = Math.min(1, Math.max(0, t));\n              if (o.easing) t = o.easing(t);\n              return outR[i] + (outR[i + 1] - outR[i]) * t;\n            }\n            function clamp01(t) { return Math.min(1, Math.max(0, t)); }\n\n            // Easings with the usual names; every one maps 0..1 to 0..1.\n            var E = {\n              linear: function (t) { return t; },\n              quad: function (t) { return t * t; },\n              cubic: function (t) { return t * t * t; },\n              sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n              back: function (s) { return function (t) { return t * t * ((s + 1) * t - s); }; },\n              out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n              inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; },\n              bezier: function (x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var k = 0; k < 24; k++) {\n                    var mt = 1 - t;\n                    var bx = 3 * mt * mt * t * x1 + 3 * mt * t * t * x2 + t * t * t;\n                    if (bx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var m = 1 - t;\n                  return 3 * m * m * t * y1 + 3 * m * t * t * y2 + t * t * t;\n                };\n              }\n            };\n\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function el(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n            var tl = gsap.timeline({ paused: true });\n            // Runs draw(frame) from the timeline so seeking to a time always draws the same picture.\n            function drive(frames, draw) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n              draw(0);\n            }\n\n            var vertical = str(vars.direction, \"horizontal\") === \"vertical\";\n            var c = { shell: str(vars.shell, \"#E5322D\"), accent: str(vars.accent, \"#E5322D\"), line: str(vars.line, \"#FFFFFF\"), detail: \"#111111\", xray: \"#07080A\" };\n            root.style.background = str(vars.background, \"#111111\");\n            var speed = num(vars.speed, 1, 0.1, 4);\n\n            var MONO = \"ui-monospace, 'SF Mono', Menlo, Consolas, monospace\";\n            var u = Math.min(W, H) / 720;\n            function rgba(hex, a) {\n              var h = String(hex).replace(\"#\", \"\");\n              if (h.length === 3) h = h.split(\"\").map(function (ch) { return ch + ch; }).join(\"\");\n              var n = parseInt(h.slice(0, 6), 16);\n              if (Number.isNaN(n)) n = 0xffffff;\n              return \"rgba(\" + ((n >> 16) & 255) + \",\" + ((n >> 8) & 255) + \",\" + (n & 255) + \",\" + a + \")\";\n            }\n            var dh = 0.8 * H, dw = dh * 0.49;\n            var d = { x: (W - dw) / 2, y: (H - dh) / 2, w: dw, h: dh, r: dw * 0.17 };\n            var LENSES = [[0.17, 0.17], [0.37, 0.17], [0.17, 0.37]];\n            function box(parent) { return el(\"svg\", { viewBox: \"0 0 \" + W + \" \" + H, \"aria-hidden\": \"true\" }, parent); }\n\n            function buildOutside(parent) {\n              var svg = box(parent);\n              var lens = d.w * 0.085;\n              var defs = el(\"defs\", {}, svg);\n              var lg = el(\"linearGradient\", { id: \"xr-gloss\", x1: 0, y1: 0, x2: 1, y2: 1 }, defs);\n              [[\"0\", \"#FFFFFF\", 0.22], [\"0.45\", \"#FFFFFF\", 0], [\"1\", \"#000000\", 0.18]].forEach(function (s) { el(\"stop\", { offset: s[0], \"stop-color\": s[1], \"stop-opacity\": s[2] }, lg); });\n              el(\"rect\", { x: d.x, y: d.y, width: d.w, height: d.h, rx: d.r, fill: c.shell }, svg);\n              el(\"rect\", { x: d.x, y: d.y, width: d.w, height: d.h, rx: d.r, fill: \"url(#xr-gloss)\" }, svg);\n              el(\"rect\", { x: d.x + d.w * 0.07, y: d.y + d.w * 0.07, width: d.w * 0.4, height: d.w * 0.4, rx: d.w * 0.1, fill: c.detail, opacity: 0.92 }, svg);\n              LENSES.forEach(function (p) {\n                el(\"circle\", { cx: d.x + d.w * p[0], cy: d.y + d.w * p[1], r: lens, fill: \"#000\", stroke: \"#2A2A2A\", \"stroke-width\": lens * 0.25 }, svg);\n                el(\"circle\", { cx: d.x + d.w * p[0] - lens * 0.3, cy: d.y + d.w * p[1] - lens * 0.3, r: lens * 0.18, fill: \"#FFFFFF\", opacity: 0.6 }, svg);\n              });\n              el(\"circle\", { cx: d.x + d.w / 2, cy: d.y + d.h * 0.5, r: d.w * 0.07, fill: c.detail, opacity: 0.85 }, svg);\n            }\n            function buildInside(parent) {\n              var svg = box(parent);\n              function X(f) { return d.x + d.w * f; }\n              function Y(f) { return d.y + d.h * f; }\n              function pins(x, y, w, h, n) {\n                var out = \"\";\n                for (var i = 0; i < n; i++) { var px = x + ((i + 0.5) / n) * w; out += \"M \" + px + \" \" + (y - 4 * u) + \" V \" + y + \" M \" + px + \" \" + (y + h) + \" V \" + (y + h + 4 * u) + \" \"; }\n                return out;\n              }\n              el(\"rect\", { x: d.x, y: d.y, width: d.w, height: d.h, rx: d.r, fill: c.xray }, svg);\n              var g = el(\"g\", { fill: \"none\", stroke: c.line, \"stroke-width\": 2 * u, \"stroke-linejoin\": \"round\" }, svg);\n              el(\"rect\", { x: d.x, y: d.y, width: d.w, height: d.h, rx: d.r }, g);\n              el(\"rect\", { x: X(0.04), y: Y(0.02), width: d.w * 0.92, height: d.h * 0.96, rx: d.r * 0.82, \"stroke-opacity\": 0.4 }, g);\n              LENSES.forEach(function (p) {\n                el(\"circle\", { cx: X(p[0]), cy: d.y + d.w * p[1], r: d.w * 0.085 }, g);\n                el(\"circle\", { cx: X(p[0]), cy: d.y + d.w * p[1], r: d.w * 0.045, \"stroke-opacity\": 0.6 }, g);\n              });\n              // Logic board.\n              el(\"path\", { d: \"M \" + X(0.52) + \" \" + Y(0.05) + \" H \" + X(0.9) + \" V \" + Y(0.36) + \" H \" + X(0.1) + \" V \" + Y(0.27) + \" H \" + X(0.52) + \" Z\" }, g);\n              el(\"rect\", { x: X(0.6), y: Y(0.08), width: d.w * 0.22, height: d.h * 0.07, rx: 2 * u }, g);\n              el(\"path\", { d: pins(X(0.6), Y(0.08), d.w * 0.22, d.h * 0.07, 6), \"stroke-opacity\": 0.6, \"stroke-width\": 1.3 * u }, g);\n              el(\"rect\", { x: X(0.16), y: Y(0.295), width: d.w * 0.16, height: d.h * 0.04, rx: 2 * u, \"stroke-opacity\": 0.8 }, g);\n              el(\"rect\", { x: X(0.38), y: Y(0.295), width: d.w * 0.12, height: d.h * 0.04, rx: 2 * u, \"stroke-opacity\": 0.8 }, g);\n              // Battery with wireless coil.\n              el(\"rect\", { x: X(0.12), y: Y(0.4), width: d.w * 0.76, height: d.h * 0.44, rx: 6 * u }, g);\n              el(\"path\", { d: \"M \" + X(0.42) + \" \" + Y(0.4) + \" V \" + Y(0.385) + \" H \" + X(0.58) + \" V \" + Y(0.4) }, g);\n              [0.26, 0.2, 0.14].forEach(function (f) { el(\"circle\", { cx: X(0.5), cy: Y(0.62), r: d.w * f, \"stroke-opacity\": 0.45 }, g); });\n              el(\"path\", { d: \"M \" + X(0.5) + \" \" + Y(0.47) + \" V \" + Y(0.5) + \" M \" + X(0.485) + \" \" + Y(0.485) + \" H \" + X(0.515) }, g);\n              // Flex cable, speaker and port.\n              el(\"path\", { d: \"M \" + X(0.86) + \" \" + Y(0.36) + \" V \" + Y(0.38) + \" H \" + X(0.92) + \" V \" + Y(0.89) + \" H \" + X(0.66), \"stroke-opacity\": 0.6 }, g);\n              el(\"rect\", { x: X(0.38), y: Y(0.935), width: d.w * 0.24, height: d.h * 0.025, rx: d.h * 0.0125 }, g);\n              for (var i = 0; i < 6; i++) el(\"circle\", { cx: X(0.14 + i * 0.035), cy: Y(0.947), r: 1.8 * u }, g);\n              // The one part in the accent color: the chip.\n              var a = el(\"g\", { stroke: c.accent, \"stroke-width\": 2.4 * u, fill: \"none\" }, svg);\n              el(\"rect\", { x: X(0.6), y: Y(0.17), width: d.w * 0.22, height: d.w * 0.22, rx: 3 * u, fill: c.accent, \"fill-opacity\": 0.22 }, a);\n              el(\"path\", { d: pins(X(0.6), Y(0.17), d.w * 0.22, d.w * 0.22, 5), \"stroke-width\": 1.4 * u }, a);\n              var tx = el(\"text\", { x: X(0.5), y: Y(0.79), \"text-anchor\": \"middle\", \"font-family\": MONO, \"font-size\": 12 * u, \"letter-spacing\": 2 * u, fill: c.line, opacity: 0.7 }, svg);\n              tx.textContent = \"Li-ion 4500 mAh\";\n            }\n            var outside = document.getElementById(\"xr-outside\"), inside = document.getElementById(\"xr-inside\"), hot = document.getElementById(\"xr-hot\");\n            buildOutside(outside); buildInside(inside); buildInside(hot);\n\n            var f = el(\"filter\", { id: \"xr-glow\", x: \"-10%\", y: \"-10%\", width: \"120%\", height: \"120%\" }, document.getElementById(\"xr-defs\"));\n            el(\"feGaussianBlur\", { stdDeviation: 3 * u, result: \"blur\" }, f);\n            var mg = el(\"feMerge\", {}, f);\n            el(\"feMergeNode\", { in: \"blur\" }, mg); el(\"feMergeNode\", { in: \"blur\" }, mg); el(\"feMergeNode\", { in: \"SourceGraphic\" }, mg);\n            hot.style.filter = \"url(#xr-glow)\";\n\n            var span = vertical ? H : W;\n            var start = vertical ? d.y - 0.1 * H : d.x - 0.12 * W;\n            var end = vertical ? d.y + d.h + 0.1 * H : d.x + d.w + 0.12 * W;\n            var band = 0.12 * span;\n            var trail = document.getElementById(\"xr-trail\"), bar = document.getElementById(\"xr-bar\");\n            trail.style.background = \"linear-gradient(\" + (vertical ? \"to top\" : \"to left\") + \", \" + rgba(c.line, 0.18) + \" 0px, transparent \" + band + \"px)\";\n            trail.style.backgroundRepeat = \"no-repeat\";\n            bar.style.left = vertical ? \"0\" : \"auto\"; bar.style.top = vertical ? \"auto\" : \"0\";\n            bar.style.width = (vertical ? W : 3 * u) + \"px\"; bar.style.height = (vertical ? 3 * u : H) + \"px\";\n            bar.style.backgroundColor = c.line;\n            bar.style.boxShadow = \"0 0 \" + 16 * u + \"px \" + 4 * u + \"px \" + rgba(c.line, 0.67) + \", 0 0 \" + 60 * u + \"px \" + 12 * u + \"px \" + rgba(c.line, 0.2);\n            var sinInOut = E.inOut(E.sin);\n\n            function draw(frame) {\n              var t = frame * speed;\n              var pos = interp(t, [5, 32], [start, end], { easing: sinInOut });\n              var scanning = t > 5 && t < 32;\n              var behind = vertical ? \"inset(0 0 \" + (H - pos) + \"px 0)\" : \"inset(0 \" + (W - pos) + \"px 0 0)\";\n              var ahead = vertical ? \"inset(\" + pos + \"px 0 0 0)\" : \"inset(0 0 0 \" + pos + \"px)\";\n              var hotClip = vertical ? \"inset(\" + Math.max(0, pos - band) + \"px 0 \" + (H - pos) + \"px 0)\" : \"inset(0 \" + (W - pos) + \"px 0 \" + Math.max(0, pos - band) + \"px)\";\n              outside.style.clipPath = ahead;\n              inside.style.clipPath = behind;\n              hot.style.clipPath = hotClip; hot.style.opacity = scanning ? 0.9 : 0;\n              trail.style.clipPath = behind; trail.style.opacity = scanning ? 1 : 0;\n              trail.style.backgroundPosition = vertical ? \"0 \" + (pos - H) + \"px\" : (pos - W) + \"px 0\";\n              if (vertical) bar.style.top = pos - 1.5 * u + \"px\"; else bar.style.left = pos - 1.5 * u + \"px\";\n              bar.style.opacity = scanning ? 1 : 0;\n            }\n            drive(Math.round(parseFloat(root.dataset.duration || \"2.17\") * FPS), draw);\n\n            var total = parseFloat(root.dataset.duration || \"2.17\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"x-ray-scan\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
