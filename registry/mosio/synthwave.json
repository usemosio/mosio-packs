   "content": "<!doctype html>\n<!--\n  Synthwave\n\n  A retro neon horizon with a scrolling perspective grid, a rising striped sun and mountain ranges that slide in. The grid keeps scrolling for as long as the clip lasts.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/synthwave/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"synthwave\"\n  data-composition-duration=\"4\"\n  data-composition-variables='[\n    {\"id\": \"sky_top\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Sky top\", \"description\": \"Top of the sky gradient.\", \"default\": \"#08080B\"},\n    {\"id\": \"sky_horizon\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Sky horizon\", \"description\": \"Sky glow at the horizon.\", \"default\": \"#3B0C10\"},\n    {\"id\": \"sun_top\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Sun top\", \"description\": \"Top of the sun gradient.\", \"default\": \"#FFC46B\"},\n    {\"id\": \"sun_bottom\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Sun bottom\", \"description\": \"Bottom of the sun gradient.\", \"default\": \"#E5322D\"},\n    {\"id\": \"grid_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Grid\", \"description\": \"Grid line color.\", \"default\": \"#E5322D\"},\n    {\"id\": \"floor_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Floor\", \"description\": \"Floor color.\", \"default\": \"#0A0A0C\"},\n    {\"id\": \"mountains_back\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Back mountains\", \"description\": \"Back mountain range color.\", \"default\": \"#2A0A0E\"},\n    {\"id\": \"mountains_front\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Front mountains\", \"description\": \"Front mountain range color.\", \"default\": \"#111111\"},\n    {\"id\": \"grid_speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Grid speed\", \"description\": \"Grid rows that pass the viewer per second.\", \"default\": 2, \"min\": 0, \"max\": 8, \"step\": 0.1},\n    {\"id\": \"horizon\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Horizon\", \"description\": \"Horizon height as a fraction of the frame.\", \"default\": 0.6, \"min\": 0.3, \"max\": 0.8, \"step\": 0.01},\n    {\"id\": \"sun_stripes\", \"type\": \"boolean\", \"role\": \"style\", \"label\": \"Sun stripes\", \"description\": \"Scroll the sun stripes downward.\", \"default\": true},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier.\", \"default\": 1, \"min\": 0.25, \"max\": 3, \"step\": 0.05}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Synthwave</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: var(--floor); }\n        .sw-stage { position: absolute; inset: 0; overflow: hidden; }\n        .sw-svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"synthwave\" data-duration=\"4\" data-fps=\"30\">\n        <div id=\"sw-clip\" class=\"sw-stage clip\" data-start=\"0\" data-duration=\"4\" data-track-index=\"0\">\n          <svg class=\"sw-svg\" id=\"sw-svg\"></svg>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"synthwave\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\nfunction col(v, f) { return typeof v === \"string\" && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v.trim()) ? v.trim() : f; }\nfunction bool(v, f) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : f; }\nvar FPS = 30;\nvar DUR = parseFloat(root.dataset.duration || \"2\");\nvar TOTAL = Math.round(DUR * FPS);\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction cl(x, a, b) { return Math.min(b, Math.max(a, x)); }\n// interpolate(x, [in...], [out...], easing): clamped on both sides, easing applied per segment.\nfunction interp(x, inp, out, easing) {\n  if (x <= inp[0]) return out[0];\n  if (x >= inp[inp.length - 1]) return out[out.length - 1];\n  var i = 0;\n  while (x > inp[i + 1]) i++;\n  var t = (x - inp[i]) / (inp[i + 1] - inp[i]);\n  if (easing) t = easing(t);\n  return out[i] + (out[i + 1] - out[i]) * t;\n}\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0; if (x >= 1) return 1;\n    var t = x;\n    for (var i = 0; i < 8; i++) {\n      var cx = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t - x;\n      var d = 3 * x1 * (1 - t) * (1 - t) - 6 * x1 * t * (1 - t) + 6 * x2 * t * (1 - t) - 3 * x2 * t * t + 3 * t * t;\n      if (Math.abs(cx) < 1e-6 || Math.abs(d) < 1e-6) break;\n      t -= cx / d;\n    }\n    t = cl(t, 0, 1);\n    return 3 * y1 * t * (1 - t) * (1 - t) + 3 * y2 * t * t * (1 - t) + t * t * t;\n  };\n}\nvar E = {\n  lin: function (t) { return t; },\n  quad: function (t) { return t * t; },\n  cubic: function (t) { return t * t * t; },\n  sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); }\n};\nfunction eOut(f) { return function (t) { return 1 - f(1 - t); }; }\nfunction eInOut(f) { return function (t) { return t < 0.5 ? f(2 * t) / 2 : 1 - f(2 - 2 * t) / 2; }; }\nvar outCubic = eOut(E.cubic), outQuad = eOut(E.quad), inCubic = E.cubic, inQuad = E.quad;\nvar inOutCubic = eInOut(E.cubic), inOutQuad = eInOut(E.quad), inOutSin = eInOut(E.sin), outSin = eOut(E.sin);\n// Damped spring from 0 to 1 (rest at 1, no initial velocity), frames at 30 fps.\nfunction spring(frame, cfg) {\n  if (frame <= 0) return 0;\n  var m = cfg.mass || 1, k = cfg.stiffness, c = cfg.damping;\n  var w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m)), t = frame / FPS;\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n  }\n  if (z === 1) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  var s = w0 * Math.sqrt(z * z - 1), r1 = -z * w0 + s, r2 = -z * w0 - s;\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\n// Seeded random: same string in, same number out.\nfunction rnd(seed) {\n  var sd = String(seed), h = 1779033703 ^ sd.length;\n  for (var i = 0; i < sd.length; i++) { h = Math.imul(h ^ sd.charCodeAt(i), 3432918353); h = (h << 13) | (h >>> 19); }\n  h = Math.imul(h ^ (h >>> 16), 2246822507); h = Math.imul(h ^ (h >>> 13), 3266489909); h ^= h >>> 16;\n  var a = (h >>> 0);\n  a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a);\n  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n}\nfunction rgb(h) {\n  h = h.replace(\"#\", \"\");\n  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];\n  return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];\n}\nfunction mixc(a, b, t) {\n  var x = rgb(a), y = rgb(b);\n  return \"rgb(\" + Math.round(lerp(x[0], y[0], t)) + \",\" + Math.round(lerp(x[1], y[1], t)) + \",\" + Math.round(lerp(x[2], y[2], t)) + \")\";\n}\nfunction rgba(h, a) { var x = rgb(h); return \"rgba(\" + x[0] + \",\" + x[1] + \",\" + x[2] + \",\" + a + \")\"; }\nvar SVGNS = \"http://www.w3.org/2000/svg\";\nfunction svgEl(tag, attrs, parent) {\n  var e = document.createElementNS(SVGNS, tag);\n  for (var k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\nfunction setA(e, attrs) { for (var k in attrs) e.setAttribute(k, attrs[k]); }\n// Drive draw(frame) from the timeline; frames run 0..frames over frames/30 seconds.\nfunction drive(draw, frames) {\n  var tl = gsap.timeline({ paused: true });\n  var clock = { frame: 0 };\n  tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n  draw(0);\n  return tl;\n}\nfunction finish(tl) {\n  if (tl.duration() < DUR) tl.to({}, { duration: DUR - tl.duration() });\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[NAME] = tl;\n}\n\n\nvar svg = document.getElementById(\"sw-svg\");\nvar gridSpeed = num(vars.grid_speed, 2, 0, 8), horizon = num(vars.horizon, 0.6, 0.3, 0.8), stripesOn = bool(vars.sun_stripes, true), speed = num(vars.speed, 1, 0, 4);\nvar c = { skyTop: col(vars.sky_top, \"#08080B\"), skyHorizon: col(vars.sky_horizon, \"#3B0C10\"), sunTop: col(vars.sun_top, \"#FFC46B\"), sunBottom: col(vars.sun_bottom, \"#E5322D\"), grid: col(vars.grid_color, \"#E5322D\"), floor: col(vars.floor_color, \"#0A0A0C\"), back: col(vars.mountains_back, \"#2A0A0E\"), front: col(vars.mountains_front, \"#111111\") };\nroot.style.setProperty(\"--floor\", c.floor);\nvar W = root.clientWidth, H = root.clientHeight;\nsvg.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H);\nvar u = Math.min(W, H) / 720, cx = W / 2, yh = horizon * H, floorDepth = H - yh;\nvar R = 0.27 * H, rowGap = 0.5, colSpread = W * 0.16, nearZ = 0.35;\nfunction ridge(seed, base, peak, count) {\n  var pts = [-0.4 * W + \",\" + base];\n  for (var i = 0; i <= count; i++) {\n    var x = -0.4 * W + (i / count) * 1.8 * W, center = Math.min(1, Math.abs(x - W / 2) / (0.45 * W));\n    var valley = 0.18 + 0.82 * center * center, jag = 0.45 + 0.55 * rnd(seed + \"-\" + i);\n    pts.push(x + \",\" + (base - peak * valley * (i % 2 === 0 ? jag : jag * 0.45)));\n  }\n  pts.push(1.4 * W + \",\" + base);\n  return pts.join(\" \");\n}\nfunction grad(defs, id, stops) {\n  var g = svgEl(\"linearGradient\", { id: id, x1: 0, y1: 0, x2: 0, y2: 1 }, defs);\n  stops.forEach(function (s) { svgEl(\"stop\", { offset: s[0], \"stop-color\": s[1] }, g); });\n}\nvar defs = svgEl(\"defs\", {}, svg);\ngrad(defs, \"sw-sky\", [[0, c.skyTop], [0.55, c.skyTop], [1, c.skyHorizon]]);\ngrad(defs, \"sw-sun\", [[0.1, c.sunTop], [0.85, c.sunBottom]]);\ngrad(defs, \"sw-floorg\", [[0, c.skyHorizon], [0.25, c.floor]]);\nvar mask = svgEl(\"mask\", { id: \"sw-stripes\" }, defs);\nsvgEl(\"rect\", { width: W, height: H, fill: \"#fff\" }, mask);\nvar stripeEls = []; for (var i = 0; i < 7; i++) stripeEls.push(svgEl(\"rect\", { x: 0, width: W, fill: \"#000\" }, mask));\nvar cp = svgEl(\"clipPath\", { id: \"sw-above\" }, defs); svgEl(\"rect\", { width: W, height: yh }, cp);\nvar glow = svgEl(\"filter\", { id: \"sw-glow\", x: \"-20%\", y: \"-20%\", width: \"140%\", height: \"140%\" }, defs);\nsvgEl(\"feGaussianBlur\", { stdDeviation: 4 * u, result: \"blur\" }, glow);\nvar fm = svgEl(\"feMerge\", {}, glow);\n[\"blur\", \"blur\", \"SourceGraphic\"].forEach(function (n) { svgEl(\"feMergeNode\", { in: n }, fm); });\nvar haze = svgEl(\"filter\", { id: \"sw-haze\", x: \"-50%\", y: \"-50%\", width: \"200%\", height: \"200%\" }, defs);\nsvgEl(\"feGaussianBlur\", { stdDeviation: 30 * u }, haze);\nsvgEl(\"rect\", { width: W, height: yh, fill: \"url(#sw-sky)\" }, svg);\nvar starG = svgEl(\"g\", { fill: \"#FFFFFF\" }, svg), stars = [];\nfor (i = 0; i < 70; i++) stars.push({ ph: rnd(\"synthwave-sp-\" + i) * 9, el: svgEl(\"circle\", { cx: rnd(\"synthwave-sx-\" + i) * W, cy: rnd(\"synthwave-sy-\" + i) * yh * 0.8, r: (0.6 + rnd(\"synthwave-sr-\" + i) * 1.4) * u }, starG) });\nvar above = svgEl(\"g\", { \"clip-path\": \"url(#sw-above)\" }, svg);\nvar haloEl = svgEl(\"circle\", { cx: cx, r: R * 1.15, fill: c.sunBottom, opacity: 0.45, filter: \"url(#sw-haze)\" }, above);\nvar sunEl = svgEl(\"circle\", { cx: cx, r: R, fill: \"url(#sw-sun)\", mask: \"url(#sw-stripes)\" }, above);\nvar backEl = svgEl(\"polygon\", { points: ridge(\"synthwave-back\", yh, 0.26 * H, 27), fill: c.back }, above);\nvar frontG = svgEl(\"g\", {}, above);\nvar fpts = ridge(\"synthwave-front\", yh, 0.15 * H, 39);\nsvgEl(\"polygon\", { points: fpts, fill: c.front }, frontG);\nsvgEl(\"polyline\", { points: fpts, fill: \"none\", stroke: c.grid, \"stroke-width\": 1.5 * u, \"stroke-opacity\": 0.55, \"stroke-linejoin\": \"round\" }, frontG);\nsvgEl(\"rect\", { y: yh, width: W, height: H - yh, fill: \"url(#sw-floorg)\" }, svg);\nvar gridG = svgEl(\"g\", { stroke: c.grid, \"stroke-width\": 2.2 * u, filter: \"url(#sw-glow)\", fill: \"none\" }, svg);\nfor (var j = -11; j <= 11; j++) svgEl(\"line\", { x1: cx, y1: yh, x2: cx + (j * colSpread) / nearZ, y2: yh + floorDepth / nearZ }, gridG);\nvar rowEls = []; for (i = 0; i < 70; i++) rowEls.push(svgEl(\"line\", { x1: 0, x2: W }, gridG));\nsvgEl(\"line\", { x1: 0, y1: yh, x2: W, y2: yh, \"stroke-width\": 3 * u }, gridG);\nsvgEl(\"rect\", { y: yh - 6 * u, width: W, height: 0.12 * H, fill: c.skyHorizon, opacity: 0.5, filter: \"url(#sw-haze)\" }, svg);\nfunction draw(frame) {\n  var t = frame * speed;\n  var phase = ((((t / 30) * gridSpeed) % 1) + 1) % 1;\n  rowEls.forEach(function (ln, k) {\n    var z = 0.7 + (k + 1 - phase) * rowGap, y = yh + floorDepth / z;\n    if (y > H + 4 * u) { ln.setAttribute(\"opacity\", 0); return; }\n    setA(ln, { y1: y, y2: y, opacity: 1, \"stroke-opacity\": interp(z, [1, 14, 30], [1, 0.35, 0]) });\n  });\n  var rise = interp(t, [0, 40], [0, 1], outCubic);\n  var sunY = lerp(yh + R * 1.05, yh - R * 0.42, rise);\n  var stripePhase = stripesOn ? (((t / 36) % 1) + 1) % 1 : 0;\n  stripeEls.forEach(function (s, i) {\n    var p = (i + stripePhase) / 7, y = sunY + R * (-0.05 + p * 1.05), h = R * (0.012 + 0.09 * p);\n    setA(s, { y: y - h / 2, height: stripesOn ? h : 0 });\n  });\n  setA(haloEl, { cy: sunY }); setA(sunEl, { cy: sunY });\n  var slideBack = interp(t, [4, 34], [1, 0], outCubic), slideFront = interp(t, [8, 38], [1, 0], outCubic);\n  backEl.setAttribute(\"transform\", \"translate(\" + -0.25 * W * slideBack + \" \" + 0.3 * H * slideBack + \")\");\n  frontG.setAttribute(\"transform\", \"translate(\" + 0.25 * W * slideFront + \" \" + 0.2 * H * slideFront + \")\");\n  stars.forEach(function (s) { s.el.setAttribute(\"opacity\", 0.25 + 0.5 * (0.5 + 0.5 * Math.sin(t * 0.15 + s.ph))); });\n}\nfinish(drive(draw, TOTAL));\n\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
