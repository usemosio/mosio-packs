   "role": "source",
   "content": "<!doctype html>\n<!--\n  Magnetic Cursor\n\n  A page drawn through a WebGL shader that warps every pixel toward a moving cursor, with a Gaussian falloff and a little chromatic aberration, plus a repel pulse. Four captions explain what is happening.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/heygen-com/hyperframes/blob/bd6cff8157a1a0ed5075527e673cc4f321fe9123/registry/blocks/vfx-magnetic/vfx-magnetic.html\n\n  Copyright HeyGen, Inc. and the Hyperframes contributors. Licensed under the Apache License, Version\n  2.0 (the \"License\"); you may not use this file except in compliance with the License. You may obtain\n  a copy of the License at http://www.apache.org/licenses/LICENSE-2.0. Unless required by applicable\n  law or agreed to in writing, software distributed under the License is distributed on an \"AS IS\"\n  BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for\n  the specific language governing permissions and limitations under the License.\n\n  Changes by usemosio/blocks: fills the host frame instead of a fixed 1920×1080 page; the page the shader bends (heading, paragraphs, hint, cards) is drawn on a 2D canvas from variables instead of being captured from live DOM with the experimental HTML-in-Canvas API, which render machines do not have; the captions no longer mention that API; the shader is unchanged apart from its fragment output name; the canvas is drawn at the `resolution` variable and the cursor path is driven by the timeline; without WebGL the canvas is hidden.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"vfx-magnetic\"\n  data-composition-duration=\"15\"\n  data-composition-variables='[{\"id\": \"heading\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Heading\", \"description\": \"Headline of the page. Words wrapped in [square brackets] get the accent colour.\", \"default\": \"Pixels bend toward your [cursor]\"},\n    {\"id\": \"body1\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Paragraph 1\", \"default\": \"Move your mouse across this page. Every pixel is drawn through a WebGL shader that warps space toward your cursor position, like a magnet pulling iron filings beneath a thin rubber sheet.\"},\n    {\"id\": \"body2\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Paragraph 2\", \"default\": \"The distortion follows a Gaussian falloff: strong at close range, tapering smoothly to nothing. The text remains readable even under deformation.\"},\n    {\"id\": \"hint\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Hint line\", \"description\": \"Small monospace line above the cards.\", \"default\": \"WebGL2 shader distortion over a live page\"},\n    {\"id\": \"cards\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Cards\", \"description\": \"Up to 3 cards as \\\"Title | description\\\", separated by semicolons.\", \"default\": \"Real-time | 60fps distortion over the whole page in one shader pass; Crisp type | The page is drawn at full fidelity before it is bent; GPU shaders | Gaussian warp plus chromatic aberration in one fragment shader\"},\n    {\"id\": \"captions\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Captions\", \"description\": \"Four lines shown one after another at the bottom, separated by semicolons.\", \"default\": \"The whole page is drawn through a WebGL shader; A magnetic shader warps every pixel toward the cursor; Chromatic aberration splits RGB channels at the distortion site; A repel pulse pushes the page away again\"},\n    {\"id\": \"background\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Page background\", \"default\": \"#0c0c0c\"},\n    {\"id\": \"ink\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Heading colour\", \"default\": \"#f0f0f0\"},\n    {\"id\": \"accent\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent\", \"description\": \"Accent words, card icons and the cursor dot.\", \"default\": \"#70c7ed\"},\n    {\"id\": \"strength\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Pull strength\", \"default\": 1, \"min\": 0, \"max\": 3, \"step\": 0.05},\n    {\"id\": \"resolution\", \"type\": \"number\", \"role\": \"quality\", \"label\": \"Resolution\", \"description\": \"Share of the frame size the shader is drawn at, then scaled up. Text edges need 0.75.\", \"default\": 0.75, \"min\": 0.25, \"max\": 1, \"step\": 0.05}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Magnetic Cursor</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          background: #000;\n          pointer-events: none;\n        }\n        .mgn-stage {\n          position: absolute;\n          inset: 0;\n        }\n        .mgn-canvas {\n          position: absolute;\n          inset: 0;\n          width: 100%;\n          height: 100%;\n          display: block;\n        }\n        .mgn-dot {\n          position: absolute;\n          width: 20px;\n          height: 20px;\n          margin: -10px 0 0 -10px;\n          border-radius: 50%;\n          background: var(--mgn-accent, #70c7ed);\n          box-shadow: 0 0 20px var(--mgn-accent, #70c7ed), 0 0 40px var(--mgn-accent, #70c7ed);\n          opacity: 0;\n        }\n        .mgn-subs {\n          position: absolute;\n          left: 0;\n          right: 0;\n          bottom: 5cqh;\n          display: flex;\n          justify-content: center;\n        }\n        .mgn-sub {\n          position: absolute;\n          bottom: 0;\n          max-width: 86cqw;\n          padding: 0.9em 1.8em;\n          border-radius: 8px;\n          background: rgba(0, 0, 0, 0.7);\n          color: #fff;\n          font: 500 max(20px, 1.9cqmin) / 1.35 system-ui, -apple-system, \"Segoe UI\", sans-serif;\n          text-align: center;\n          opacity: 0;\n        }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"vfx-magnetic\" data-duration=\"15\" data-fps=\"30\">\n        <div id=\"mgn-clip\" class=\"mgn-stage clip\" data-start=\"0\" data-duration=\"15\" data-track-index=\"0\">\n          <canvas id=\"mgn-canvas\" class=\"mgn-canvas\"></canvas>\n          <div class=\"mgn-dot\" id=\"mgn-dot\"></div>\n          <div class=\"mgn-subs\" id=\"mgn-subs\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"vfx-magnetic\";\n            var DUR = 15;\n            var root = document.getElementById(\"root\");\n            var canvas = document.getElementById(\"mgn-canvas\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function clampNum(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function hex(value, fallback) {\n              var m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(String(value || \"\").trim());\n              if (!m) return fallback;\n              var h = m[1].length === 3 ? m[1].replace(/./g, \"$&$&\") : m[1];\n              return \"#\" + h.toLowerCase();\n            }\n            function rgb(value) {\n              var h = hex(value, \"#000000\").slice(1);\n              return [parseInt(h.slice(0, 2), 16) / 255, parseInt(h.slice(2, 4), 16) / 255, parseInt(h.slice(4, 6), 16) / 255];\n            }\n            var DEFS = [{\"id\": \"heading\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Heading\", \"description\": \"Headline of the page. Words wrapped in [square brackets] get the accent colour.\", \"default\": \"Pixels bend toward your [cursor]\"}, {\"id\": \"body1\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Paragraph 1\", \"default\": \"Move your mouse across this page. Every pixel is drawn through a WebGL shader that warps space toward your cursor position, like a magnet pulling iron filings beneath a thin rubber sheet.\"}, {\"id\": \"body2\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Paragraph 2\", \"default\": \"The distortion follows a Gaussian falloff: strong at close range, tapering smoothly to nothing. The text remains readable even under deformation.\"}, {\"id\": \"hint\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Hint line\", \"description\": \"Small monospace line above the cards.\", \"default\": \"WebGL2 shader distortion over a live page\"}, {\"id\": \"cards\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Cards\", \"description\": \"Up to 3 cards as \\\"Title | description\\\", separated by semicolons.\", \"default\": \"Real-time | 60fps distortion over the whole page in one shader pass; Crisp type | The page is drawn at full fidelity before it is bent; GPU shaders | Gaussian warp plus chromatic aberration in one fragment shader\"}, {\"id\": \"captions\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Captions\", \"description\": \"Four lines shown one after another at the bottom, separated by semicolons.\", \"default\": \"The whole page is drawn through a WebGL shader; A magnetic shader warps every pixel toward the cursor; Chromatic aberration splits RGB channels at the distortion site; A repel pulse pushes the page away again\"}, {\"id\": \"background\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Page background\", \"default\": \"#0c0c0c\"}, {\"id\": \"ink\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Heading colour\", \"default\": \"#f0f0f0\"}, {\"id\": \"accent\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent\", \"description\": \"Accent words, card icons and the cursor dot.\", \"default\": \"#70c7ed\"}, {\"id\": \"strength\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Pull strength\", \"default\": 1, \"min\": 0, \"max\": 3, \"step\": 0.05}, {\"id\": \"resolution\", \"type\": \"number\", \"role\": \"quality\", \"label\": \"Resolution\", \"description\": \"Share of the frame size the shader is drawn at, then scaled up. Text edges need 0.75.\", \"default\": 0.75, \"min\": 0.25, \"max\": 1, \"step\": 0.05}];\n            var V = {};\n            DEFS.forEach(function (d) {\n              var raw = vars[d.id];\n              if (d.type === \"number\") V[d.id] = clampNum(raw, d.default, d.min, d.max);\n              else if (d.type === \"color\") V[d.id] = hex(raw, d.default);\n              else if (d.type === \"boolean\") V[d.id] = typeof raw === \"boolean\" ? raw : raw === \"true\" ? true : raw === \"false\" ? false : d.default;\n              else V[d.id] = typeof raw === \"string\" ? raw.trim() : d.default;\n            });\n\n            var W = Math.max(2, root.clientWidth);\n            var H = Math.max(2, root.clientHeight);\n            var cw = Math.max(2, Math.round(W * V.resolution));\n            var ch = Math.max(2, Math.round(H * V.resolution));\n            root.style.background = V.background;\n            canvas.width = cw;\n            canvas.height = ch;\n            var SANS = \"system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif\";\n            var MONO = \"ui-monospace, 'SF Mono', Menlo, Consolas, monospace\";\n            root.style.setProperty(\"--mgn-accent\", V.accent);\n            var content = document.createElement(\"canvas\");\n            content.width = cw;\n            content.height = ch;\n            var U = W >= H ? Math.min(W / 1920, H / 1080) : W / 1080 * 1.2;\n            function wrap(ctx, text, maxW) {\n              var words = String(text).split(/\\s+/).filter(Boolean), lines = [], line = \"\";\n              words.forEach(function (w) {\n                var next = line ? line + \" \" + w : w;\n                if (line && ctx.measureText(next).width > maxW) { lines.push(line); line = w; } else line = next;\n              });\n              if (line) lines.push(line);\n              return lines;\n            }\n            function rrect(ctx, x, y, w, h, r) { ctx.beginPath(); ctx.roundRect(x, y, w, h, r); }\n            // The page the shader bends: heading, two paragraphs, a hint and three cards.\n            function drawContent() {\n              var ctx = content.getContext(\"2d\");\n              ctx.setTransform(cw / W, 0, 0, ch / H, 0, 0);\n              ctx.fillStyle = V.background;\n              ctx.fillRect(0, 0, W, H);\n              ctx.textBaseline = \"alphabetic\";\n              ctx.textAlign = \"left\";\n              var colW = Math.min(W * 0.94, 900 * U + 96 * U);\n              var inner = colW - 96 * U;\n              var x0 = (W - inner) / 2;\n              var items = [];\n              var hs = 64 * U, bs = 22 * U, hts = 15 * U;\n              ctx.font = \"700 \" + hs + \"px \" + SANS;\n              // heading with [accent] words, wrapped\n              var tokens = [];\n              String(V.heading).replace(/\\[([^\\]]*)\\]|([^\\[]+)/g, function (m, a, b) {\n                (a !== undefined ? [a] : b.split(/(\\s+)/)).forEach(function (w) { if (w !== \"\") tokens.push({ t: w, accent: a !== undefined }); });\n              });\n              var lines = [[]], lw = 0;\n              tokens.forEach(function (tk) {\n                var w = ctx.measureText(tk.t).width;\n                if (lw + w > inner && lines[lines.length - 1].length && tk.t.trim()) { lines.push([]); lw = 0; }\n                if (!lines[lines.length - 1].length && !tk.t.trim()) return;\n                lines[lines.length - 1].push(tk); lw += w;\n              });\n              var headH = lines.length * hs * 1.15;\n              ctx.font = \"400 \" + bs + \"px \" + SANS;\n              var p1 = wrap(ctx, V.body1, inner), p2 = wrap(ctx, V.body2, inner);\n              var bodyH = (p1.length + p2.length) * bs * 1.7 + 24 * U;\n              var cards = String(V.cards).split(\";\").map(function (c) { return c.split(\"|\").map(function (p) { return p.trim(); }); }).filter(function (c) { return c[0]; }).slice(0, 3);\n              var cardW = (inner - 20 * U * (cards.length - 1)) / Math.max(1, cards.length);\n              ctx.font = \"400 \" + (14 * U) + \"px \" + SANS;\n              var cardLines = cards.map(function (c) { return wrap(ctx, c[1] || \"\", cardW - 48 * U); });\n              var cardH = 24 * U * 2 + 40 * U + 14 * U + 16 * U + Math.max.apply(null, cardLines.map(function (l) { return l.length; }).concat([1])) * 14 * U * 1.5;\n              var total = headH + 32 * U + bodyH + 24 * U + hts + 48 * U + (cards.length ? cardH : 0);\n              var y = Math.max(24 * U, (H - total) / 2);\n              ctx.font = \"700 \" + hs + \"px \" + SANS;\n              lines.forEach(function (ln) {\n                var x = x0;\n                y += hs * 0.95;\n                ln.forEach(function (tk) {\n                  ctx.fillStyle = tk.accent ? V.accent : V.ink;\n                  ctx.fillText(tk.t, x, y);\n                  x += ctx.measureText(tk.t).width;\n                });\n                y += hs * 0.2;\n              });\n              y += 32 * U - hs * 0.0;\n              ctx.font = \"400 \" + bs + \"px \" + SANS;\n              ctx.fillStyle = \"rgba(255,255,255,0.6)\";\n              p1.forEach(function (l) { y += bs * 1.7; ctx.fillText(l, x0, y - bs * 0.45); });\n              y += 24 * U;\n              p2.forEach(function (l) { y += bs * 1.7; ctx.fillText(l, x0, y - bs * 0.45); });\n              y += 24 * U;\n              ctx.font = \"400 \" + hts + \"px \" + MONO;\n              ctx.fillStyle = \"rgba(255,255,255,0.3)\";\n              ctx.fillText(V.hint, x0, y + hts);\n              y += hts + 48 * U;\n              cards.forEach(function (c, i) {\n                var cx = x0 + i * (cardW + 20 * U);\n                ctx.fillStyle = \"rgba(255,255,255,0.04)\";\n                rrect(ctx, cx, y, cardW, cardH, 14 * U); ctx.fill();\n                ctx.strokeStyle = \"rgba(255,255,255,0.08)\";\n                ctx.lineWidth = Math.max(1, U);\n                rrect(ctx, cx, y, cardW, cardH, 14 * U); ctx.stroke();\n                ctx.fillStyle = V.accent;\n                ctx.globalAlpha = 0.14;\n                rrect(ctx, cx + 24 * U, y + 24 * U, 40 * U, 40 * U, 10 * U); ctx.fill();\n                ctx.globalAlpha = 1;\n                ctx.fillStyle = V.accent;\n                ctx.beginPath(); ctx.arc(cx + 44 * U, y + 44 * U, 7 * U, 0, Math.PI * 2); ctx.fill();\n                ctx.font = \"600 \" + (16 * U) + \"px \" + SANS;\n                ctx.fillStyle = \"rgba(255,255,255,0.85)\";\n                ctx.fillText(c[0], cx + 24 * U, y + 24 * U + 40 * U + 14 * U + 12 * U);\n                ctx.font = \"400 \" + (14 * U) + \"px \" + SANS;\n                ctx.fillStyle = \"rgba(255,255,255,0.4)\";\n                cardLines[i].forEach(function (l, k) { ctx.fillText(l, cx + 24 * U, y + 24 * U + 40 * U + 14 * U + 12 * U + 14 * U * 1.6 + k * 14 * U * 1.5); });\n              });\n            }\n            drawContent();\n            var S = { x: 0.5, y: 0.5, repel: 0, strength: 0 };\n            var dot = document.getElementById(\"mgn-dot\");\n            var subsBox = document.getElementById(\"mgn-subs\");\n            var subs = String(V.captions).split(\";\").map(function (s) { return s.trim(); }).filter(Boolean).slice(0, 4).map(function (t) {\n              var el = document.createElement(\"div\");\n              el.className = \"mgn-sub\";\n              el.textContent = t;\n              subsBox.appendChild(el);\n              return el;\n            });\n\n            var VERTEX = [\n              \"#version 300 es\",\n              \"in vec2 aPos;\",\n              \"out vec2 v_uv;\",\n              \"void main() { v_uv = vec2(aPos.x * 0.5 + 0.5, 0.5 - aPos.y * 0.5); gl_Position = vec4(aPos, 0.0, 1.0); }\"\n            ].join(\"\\n\");\n            var FRAGMENT = `#version 300 es\nprecision highp float;\nout vec4 outColor;\nin vec2 v_uv;\nuniform sampler2D u_content;\nuniform vec2 u_mouse;\nuniform vec2 u_resolution;\nuniform float u_repel;\nuniform float u_strength;\n\nvoid main() {\n  vec2 uv = v_uv;\n  float aspect = u_resolution.x / u_resolution.y;\n  vec2 delta = u_mouse - uv;\n  vec2 aspectDelta = delta * vec2(aspect, 1.0);\n  float dist = length(aspectDelta);\n  float strength = exp(-dist * dist * 20.0) * 0.04 * u_strength;\n  float direction = mix(1.0, -1.0, u_repel);\n  vec2 displaced = uv + delta * strength * direction;\n  displaced = clamp(displaced, vec2(0.0), vec2(1.0));\n  float aberration = strength * 0.6;\n  vec2 aberDir = normalize(delta + 0.0001) * aberration;\n  float r = texture(u_content, displaced + aberDir * 0.3).r;\n  float g = texture(u_content, displaced).g;\n  float b = texture(u_content, displaced - aberDir * 0.3).b;\n  outColor = vec4(r, g, b, 1.0);\n}\n`;\n\n            var gl = canvas.getContext(\"webgl2\", { alpha: false, antialias: false, depth: false, stencil: false, preserveDrawingBuffer: true });\n            function compile(type, source) {\n              var shader = gl.createShader(type);\n              gl.shaderSource(shader, source);\n              gl.compileShader(shader);\n              if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader) || \"shader compile failed\");\n              return shader;\n            }\n            var paint = null;\n            try {\n              if (!gl) throw new Error(\"WebGL2 is not available\");\n              var prog = gl.createProgram();\n              gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERTEX));\n              gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAGMENT));\n              gl.bindAttribLocation(prog, 0, \"aPos\");\n              gl.linkProgram(prog);\n              if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog) || \"link failed\");\n              gl.useProgram(prog);\n              var buffer = gl.createBuffer();\n              gl.bindBuffer(gl.ARRAY_BUFFER, buffer);\n              gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);\n              gl.enableVertexAttribArray(0);\n              gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);\n              gl.viewport(0, 0, cw, ch);\n              function u(name) { return gl.getUniformLocation(prog, name); }\n              var tex = gl.createTexture();\n              gl.activeTexture(gl.TEXTURE0);\n              gl.bindTexture(gl.TEXTURE_2D, tex);\n              gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n              gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\n              gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\n              gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\n              gl.uniform1i(u(\"u_content\"), 0);\n              gl.uniform2f(u(\"u_resolution\"), cw, ch);\n              var uploaded = false;\n              var mouseLoc = u(\"u_mouse\"), repelLoc = u(\"u_repel\"), strengthLoc = u(\"u_strength\");\n              paint = function (t) {\n                if (!uploaded) { gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, content); uploaded = true; }\n                gl.uniform2f(mouseLoc, S.x, S.y);\n                gl.uniform1f(repelLoc, S.repel);\n                gl.uniform1f(strengthLoc, S.strength * V.strength);\n                dot.style.left = S.x * 100 + \"%\";\n                dot.style.top = S.y * 100 + \"%\";\n                gl.clearColor(0, 0, 0, 0);\n                gl.clear(gl.COLOR_BUFFER_BIT);\n                gl.drawArrays(gl.TRIANGLES, 0, 3);\n              };\n            } catch (err) {\n              canvas.style.display 