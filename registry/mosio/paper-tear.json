   "content": "<!doctype html>\n<!--\n  Paper Tear\n\n  The outgoing scene is printed on paper that strains, rips down the middle with a jolt of the camera and a flash, and is flung apart in two torn halves with flying scraps, revealing the next scene.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/paper-tear/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"paper-tear\"\n  data-composition-duration=\"1.2\"\n  data-composition-variables='[\n  {\n    \"id\": \"impact\",\n    \"type\": \"number\",\n    \"role\": \"motion\",\n    \"label\": \"Impact\",\n    \"description\": \"Strength of the shake, flash and debris. 0 turns them off.\",\n    \"default\": 1,\n    \"min\": 0,\n    \"max\": 2,\n    \"step\": 0.1\n  },\n  {\n    \"id\": \"roughness\",\n    \"type\": \"number\",\n    \"role\": \"style\",\n    \"label\": \"Roughness\",\n    \"description\": \"How jagged the rip is, 0 to 1.\",\n    \"default\": 0.5,\n    \"min\": 0,\n    \"max\": 1,\n    \"step\": 0.05\n  },\n  {\n    \"id\": \"seed\",\n    \"type\": \"number\",\n    \"role\": \"style\",\n    \"label\": \"Seed\",\n    \"description\": \"Seed for the shape of the rip.\",\n    \"default\": 7,\n    \"min\": 0,\n    \"max\": 9999,\n    \"step\": 1\n  },\n  {\n    \"id\": \"edge_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Edge color\",\n    \"description\": \"Color of the fibrous torn edge.\",\n    \"default\": \"#FFFFFF\"\n  },\n  {\n    \"id\": \"shadow_color\",\n    \"type\": \"string\",\n    \"role\": \"style\",\n    \"label\": \"Shadow color\",\n    \"description\": \"CSS color of the shadow the torn halves cast.\",\n    \"default\": \"rgba(0, 0, 0, 0.45)\"\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Paper Tear</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          font-family: var(--font-display, Geist, system-ui, sans-serif);\n          pointer-events: none;\n        }\n\n        #root { background: #141318; }\n        .ptr-stage { position: absolute; inset: 0; }\n        .ptr-panel { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }\n        .ptr-in { display: flex; flex-direction: column; align-items: center; gap: 2.4cqmin; }\n        .ptr-in span { font-size: 9cqmin; font-weight: 600; letter-spacing: -0.03em; line-height: 1; color: #f2f2f2; white-space: nowrap; }\n        .ptr-bar { display: block; width: 14cqmin; height: 0.8cqmin; border-radius: 1cqmin; background: rgba(242, 242, 242, 0.55); }\n        .ptr-pa { background: #141318; }\n        .ptr-pb { background: linear-gradient(135deg, #3b3699 0%, #1e2a6b 55%, #0f4c75 100%); }\n        .ptr-pc { background: linear-gradient(135deg, #7a2f5f 0%, #3a2250 55%, #1c1b3f 100%); }\n\n        .ptr-pb { z-index: 1; }\n        .ptr-shell { position: absolute; inset: 0; z-index: 2; }\n        .ptr-half, .ptr-fill { position: absolute; inset: 0; }\n        .ptr-shard { position: absolute; display: none; }\n        .ptr-flash { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"paper-tear\" data-duration=\"1.2\" data-fps=\"30\">\n        <div id=\"ptr-clip\" class=\"ptr-stage clip\" data-start=\"0\" data-duration=\"1.2\" data-track-index=\"0\">\n          <div id=\"ptr-src\" style=\"display:none\"><div id=\"ptr-a\" class=\"ptr-panel ptr-pa\"><div class=\"ptr-in\"><span>Scene A</span><i class=\"ptr-bar\"></i></div></div></div>\n          <div id=\"ptr-b\" class=\"ptr-panel ptr-pb\"><div class=\"ptr-in\"><span>Scene B</span><i class=\"ptr-bar\"></i></div></div>\n          <div id=\"ptr-shell\" class=\"ptr-shell\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        \n        <script>\n          (function () {\n            \"use strict\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v.trim() : f; }\nfunction pick(v, list, f) { return list.indexOf(String(v)) >= 0 ? String(v) : f; }\nfunction clamp01(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction smooth(a, b, x) { var t = clamp01((x - a) / (b - a)); return t * t * (3 - 2 * t); }\n// cubic-bezier easing, solved by bisection (pure function of x)\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0;\n    if (x >= 1) return 1;\n    var lo = 0, hi = 1, t = x;\n    for (var i = 0; i < 28; i++) {\n      var cx = 3 * (1 - t) * (1 - t) * t * x1 + 3 * (1 - t) * t * t * x2 + t * t * t;\n      if (cx < x) lo = t; else hi = t;\n      t = (lo + hi) / 2;\n    }\n    return 3 * (1 - t) * (1 - t) * t * y1 + 3 * (1 - t) * t * t * y2 + t * t * t;\n  };\n}\nvar inOutEase = bez(0.42, 0, 0.58, 1);\nfunction inCubic(x) { return x * x * x; }\nfunction outCubic(x) { return 1 - Math.pow(1 - x, 3); }\nfunction inQuad(x) { return x * x; }\nfunction outQuad(x) { return 1 - (1 - x) * (1 - x); }\nfunction outBack(s) { return function (x) { return 1 + (s + 1) * Math.pow(x - 1, 3) + s * Math.pow(x - 1, 2); }; }\n// interpolate(p, inputs, outputs, ease): clamped, eased per segment (like a frame interpolate)\nfunction interp(p, xs, ys, ease) {\n  var n = xs.length;\n  if (p <= xs[0]) return ys[0];\n  if (p >= xs[n - 1]) return ys[n - 1];\n  for (var i = 1; i < n; i++) {\n    if (p <= xs[i]) {\n      var t = (p - xs[i - 1]) / (xs[i] - xs[i - 1]);\n      if (ease) t = ease(t);\n      return lerp(ys[i - 1], ys[i], t);\n    }\n  }\n  return ys[n - 1];\n}\nfunction mulberry32(a) {\n  return function () {\n    a |= 0; a = (a + 0x6d2b79f5) | 0;\n    var t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n// damped spring from 0 to 1 (zero initial velocity), t in seconds\nfunction spring(t, damping, stiffness, mass) {\n  if (t <= 0) return 0;\n  var w0 = Math.sqrt(stiffness / mass), z = damping / (2 * Math.sqrt(stiffness * mass));\n  if (Math.abs(z - 1) < 1e-4) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + (z * w0 / wd) * Math.sin(wd * t));\n  }\n  var s = Math.sqrt(z * z - 1), r1 = -w0 * (z - s), r2 = -w0 * (z + s);\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\nfunction stripIds(node) {\n  var all = node.querySelectorAll(\"[id]\");\n  for (var i = 0; i < all.length; i++) all[i].removeAttribute(\"id\");\n  node.removeAttribute(\"id\");\n  return node;\n}\nfunction drive(name, duration, frame) {\n  var st = { p: 0 };\n  frame(0);\n  var tl = gsap.timeline({ paused: true });\n  tl.to(st, { p: 1, duration: duration, ease: \"none\", onUpdate: function () { frame(st.p); } }, 0);\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[name] = tl;\n}\n\n            var D = 1.2;\n\nvar impact = num(vars.impact, 1, 0, 2), roughness = num(vars.roughness, 0.5, 0, 1), seed = Math.round(num(vars.seed, 7, 0, 9999));\nvar edgeColor = str(vars.edge_color, \"#FFFFFF\"), shadowColor = str(vars.shadow_color, \"rgba(0, 0, 0, 0.45)\");\nif (!/^[#a-z0-9(),.% ]+$/i.test(shadowColor)) shadowColor = \"rgba(0, 0, 0, 0.45)\";\nvar src = document.getElementById(\"ptr-a\"), B = document.getElementById(\"ptr-b\"), shell = document.getElementById(\"ptr-shell\");\nvar W = root.clientWidth, H = root.clientHeight, unit = Math.min(W, H), pad = unit;\nvar STRAIN = 0.2, IMPACT = 0.28, SEGMENTS = 44, DEBRIS = 28, NS = \"http://www.w3.org/2000/svg\";\nvar rnd = mulberry32(seed * 7919 + 13), r = roughness;\nvar tilt = (rnd() - 0.5) * W * 0.08, pa = rnd() * Math.PI * 2, pb = rnd() * Math.PI * 2, fiber = unit * (0.008 + r * 0.012), tear = [];\nfor (var i = 0; i <= SEGMENTS; i++) {\n  var t = i / SEGMENTS, wander = Math.sin(t * Math.PI * 2.2 + pa) * W * 0.025 + Math.sin(t * Math.PI * 5.3 + pb) * W * 0.012;\n  var zig = (i % 2 === 0 ? 1 : -1) * rnd();\n  tear.push({ x: W / 2 + tilt * (t - 0.5) + wander * (0.4 + r) + zig * unit * 0.022 * r, y: -unit * 0.05 + t * (H + unit * 0.1),\n    left: fiber * (0.35 + rnd() * 1.3), right: fiber * (0.2 + rnd() * 0.9) });\n}\nvar minX = Infinity, maxX = -Infinity;\ntear.forEach(function (q) { minX = Math.min(minX, q.x); maxX = Math.max(maxX, q.x); });\nfunction mk(cls, parent) { var d = document.createElement(\"div\"); d.className = cls; parent.appendChild(d); return d; }\nfunction clone() { var c = stripIds(src.cloneNode(true)); c.style.position = \"absolute\"; c.style.inset = \"0\"; return c; }\nvar whole = mk(\"ptr-fill\", shell); whole.appendChild(clone()); whole.style.zIndex = 1;\nfunction half(origin) {\n  var h = mk(\"ptr-half\", shell); h.style.transformOrigin = origin;\n  var paper = mk(\"ptr-fill\", h); paper.style.background = edgeColor;\n  var print = mk(\"ptr-fill\", h); print.appendChild(clone());\n  return { h: h, paper: paper, print: print };\n}\nvar L = half(\"0% 50%\"), R = half(\"100% 50%\");\nvar svg = document.createElementNS(NS, \"svg\"); svg.setAttribute(\"class\", \"ptr-flash\"); svg.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H);\nvar seam = tear.map(function (q) { return q.x + \",\" + q.y; }).join(\" \");\nfunction line() { var l = document.createElementNS(NS, \"polyline\"); l.setAttribute(\"points\", seam); l.setAttribute(\"fill\", \"none\"); l.setAttribute(\"stroke\", edgeColor); l.setAttribute(\"stroke-linejoin\", \"round\"); svg.appendChild(l); return l; }\nvar glow = line(), core = line(); shell.appendChild(svg);\nvar shards = [];\nfor (var s = 0; s < DEBRIS; s++) {\n  var at = tear[Math.floor(rnd() * tear.length)], side = rnd() < 0.5 ? -1 : 1, pts = [];\n  var vx = side * unit * (0.25 + rnd() * 0.9), vy = -unit * (0.1 + rnd() * 0.55), spin = (rnd() - 0.5) * 1440, size = unit * (0.008 + Math.pow(rnd(), 2) * 0.026);\n  for (var k = 0; k < 4; k++) { var ang = k / 4 * Math.PI * 2 + rnd() * 1.2, dd = 0.55 + rnd() * 0.45; pts.push(Math.round(50 + Math.cos(ang) * 50 * dd) + \"% \" + Math.round(50 + Math.sin(ang) * 50 * dd) + \"%\"); }\n  var el = mk(\"ptr-shard\", shell); el.style.background = edgeColor; el.style.clipPath = \"polygon(\" + pts.join(\",\") + \")\";\n  shards.push({ el: el, x: at.x, y: at.y, vx: vx, vy: vy, spin: spin, size: size });\n}\nvar ripEase = inQuad, peelFrames = 30;\nfunction poly(a) { return \"polygon(\" + a.join(\",\") + \")\"; }\nfunction px(x, y) { return x + \"px \" + y + \"px\"; }\nfunction frame(p) {\n  var tt = p - IMPACT, shk = { x: 0, y: 0, amp: 0 };\n  if (tt >= 0 && impact > 0) { var amp = unit * 0.03 * impact * Math.exp(-tt * 11); shk = { x: Math.sin(tt * 95) * amp, y: Math.cos(tt * 120 + 0.6) * amp * 0.7, amp: amp }; }\n  B.style.transform = \"translate(\" + shk.x + \"px, \" + shk.y + \"px) scale(\" + interp(p, [IMPACT, 1], [1 + 0.1 * impact, 1], outCubic) + \")\";\n  var strain = interp(p, [0, STRAIN, IMPACT], [0, 1, 1], inCubic);\n  var tremble = p < IMPACT ? Math.sin(p * 260) * unit * 0.004 * strain * impact : 0, lean = 1 + 0.025 * strain * (p < IMPACT ? 1 : 0);\n  var front = -unit * 0.1 + ripEase(interp(p, [STRAIN, IMPACT], [0, 1])) * (H + unit * 0.25);\n  shell.style.transform = \"translate(\" + (shk.x + tremble) + \"px, \" + shk.y + \"px) scale(\" + (lean + 2.2 * shk.amp / unit) + \")\";\n  function open(y) { return interp(front - y, [0, unit * 0.12], [0, 1]); }\n  var edge = tear.map(function (q) { return px(q.x, q.y); });\n  var lInk = tear.map(function (q) { return px(q.x - q.left * open(q.y), q.y); });\n  var rInk = tear.map(function (q) { return px(q.x + q.right * open(q.y), q.y); });\n  var lOut = [px(-pad, H + pad), px(-pad, -pad)], rOut = [px(W + pad, H + pad), px(W + pad, -pad)];\n  L.paper.style.clipPath = poly(edge.concat(lOut)); L.print.style.clipPath = poly(lInk.concat(lOut));\n  R.paper.style.clipPath = poly(edge.concat(rOut)); R.print.style.clipPath = poly(rInk.concat(rOut));\n  if (front < H + unit * 0.05) {\n    whole.style.display = \"block\";\n    whole.style.clipPath = poly([px(-pad, front), px(W + pad, front), px(W + pad, H + pad), px(-pad, H + pad)]);\n  } else whole.style.display = \"none\";\n  var peel = spring(Math.max(0, (p - IMPACT) / (1 - IMPACT)) * peelFrames / 30, 15, 150, 0.8);\n  var lt = (maxX + unit * 0.12) * 1.3, rt = (W - minX + unit * 0.12) * 1.3, curl = peel * 24, lens = \"perspective(\" + unit * 2.6 + \"px)\";\n  var cast = interp(p, [IMPACT, IMPACT + 0.1], [0, 1]);\n  var sh = cast > 0 ? \"drop-shadow(0 \" + unit * 0.012 * cast + \"px \" + unit * 0.04 * cast + \"px \" + shadowColor + \")\" : \"none\";\n  L.h.style.transform = lens + \" translateX(\" + -peel * lt + \"px) rotateY(\" + -curl + \"deg)\"; L.h.style.filter = sh;\n  R.h.style.transform = lens + \" translateX(\" + peel * rt + \"px) rotateY(\" + curl + \"deg)\"; R.h.style.filter = sh;\n  var flash = impact > 0 ? interp(p, [IMPACT - 0.03, IMPACT, IMPACT + 0.14], [0, 1, 0]) * Math.min(1, impact) : 0;\n  svg.style.display = flash > 0.01 ? \"block\" : \"none\";\n  glow.setAttribute(\"stroke-opacity\", flash * 0.35); glow.setAttribute(\"stroke-width\", unit * 0.06 * flash);\n  core.setAttribute(\"stroke-opacity\", flash); core.setAttribute(\"stroke-width\", unit * 0.012);\n  var age = p - IMPACT, dt = age * 1.1, grav = unit * 2.6;\n  for (var i = 0; i < shards.length; i++) {\n    var sd = shards[i], fade = interp(age, [0.35, 0.6], [1, 0]);\n    if (impact <= 0 || age <= 0 || fade <= 0) { sd.el.style.display = \"none\"; continue; }\n    var sz = sd.size * (0.5 + 0.5 * Math.min(1, impact)), x = sd.x + sd.vx * dt * impact, y = sd.y + sd.vy * dt * impact + 0.5 * grav * dt * dt;\n    sd.el.style.display = \"block\"; sd.el.style.left = x - sz / 2 + \"px\"; sd.el.style.top = y - sz / 2 + \"px\";\n    sd.el.style.width = sz + \"px\"; sd.el.style.height = sz + \"px\"; sd.el.style.opacity = fade; sd.el.style.transform = \"rotate(\" + sd.spin * dt + \"deg)\";\n  }\n}\n\n            drive(\"paper-tear\", D, frame);\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
