   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Displacement\n\n  The frame sheared into a grid of offset, colour-fringed tiles under film grain that\n  settle back on the next scene.\n  The block plays the cut between two built-in panels: a stat and a bar chart, then a render queue.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/displacement/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n\n  remocn captures its React children with the HTML-in-Canvas API, which a render machine does\n  not have. This block draws remocn's preview scene (a stat and a bar chart and then a render queue) (text and colours from the variables) on a\n  2D canvas and runs remocn's fragment shader over it, so it applies the look to its own content,\n  not to the host video behind it.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"displacement\"\n  data-composition-duration=\"3.6\"\n  data-composition-variables='[{\"id\": \"label\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Label\", \"description\": \"Small caption above the number in the sample scene.\", \"default\": \"Deploys this week\"}, {\"id\": \"value\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Value\", \"description\": \"The big number in the sample scene.\", \"default\": \"2,481\"}, {\"id\": \"bars\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Bars\", \"description\": \"Bar heights as percentages, separated by commas (up to 12); the last bar is highlighted.\", \"default\": \"32,51,43,68,57,86,64,100\"}, {\"id\": \"accent\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Highlight\", \"description\": \"Colour of the last bar.\", \"default\": \"#a1eebd\"}, {\"id\": \"title\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Title\", \"description\": \"Small heading above the list in the sample scene.\", \"default\": \"Render queue\"}, {\"id\": \"items\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Rows\", \"description\": \"Rows of the list as name | status, separated by semicolons (up to 5).\", \"default\": \"intro-scene.mp4 | Done; feature-tour.mp4 | Rendering; pricing-outro.mp4 | Queued\"}, {\"id\": \"background\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Background of the list scene.\", \"default\": \"#101828\"}, {\"id\": \"grid\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Grid\", \"description\": \"Tiles across the frame.\", \"default\": 60, \"min\": 4, \"max\": 100, \"step\": 2}, {\"id\": \"cell_aspect\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Cell aspect\", \"description\": \"Height of a tile relative to its width.\", \"default\": 1, \"min\": 0.25, \"max\": 4, \"step\": 0.25}, {\"id\": \"shift\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Shift\", \"description\": \"How far tiles slide.\", \"default\": 1, \"min\": 0, \"max\": 4, \"step\": 0.1}, {\"id\": \"aberration\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Aberration\", \"description\": \"Red/blue fringing on the sliding tiles.\", \"default\": 1, \"min\": 0, \"max\": 3, \"step\": 0.1}, {\"id\": \"grain\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Grain\", \"description\": \"Film grain during the shear.\", \"default\": 0.5, \"min\": 0, \"max\": 1, \"step\": 0.05}, {\"id\": \"stagger\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Stagger\", \"description\": \"How much tiles start at different moments.\", \"default\": 0.45, \"min\": 0, \"max\": 0.85, \"step\": 0.05}, {\"id\": \"resolution\", \"type\": \"number\", \"role\": \"quality\", \"label\": \"Resolution\", \"description\": \"Share of the frame size the shader is drawn at, then scaled up. Tiles and grain are coarse; 0.75 matches 1 in the stills.\", \"default\": 0.75, \"min\": 0.25, \"max\": 1, \"step\": 0.05}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Displacement</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Geist+Mono:wght@400&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          background: #000;\n          pointer-events: none;\n        }\n        .dsp-stage {\n          position: absolute;\n          inset: 0;\n        }\n        .dsp-canvas,\n        .dsp-scene {\n          position: absolute;\n          inset: 0;\n          width: 100%;\n          height: 100%;\n          display: block;\n        }\n        .dsp-scene {\n          display: none;\n        }\n        .dsp-off .dsp-canvas {\n          display: none;\n        }\n        .dsp-off .dsp-fb {\n          display: block;\n        }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"displacement\" data-duration=\"3.6\" data-fps=\"30\">\n        <div id=\"dsp-clip\" class=\"dsp-stage clip\" data-start=\"0\" data-duration=\"3.6\" data-track-index=\"0\">\n          <canvas id=\"dsp-scene0\" class=\"dsp-scene\"></canvas>\n          <canvas id=\"dsp-scene1\" class=\"dsp-scene dsp-fb\"></canvas>\n          <canvas id=\"dsp-canvas\" class=\"dsp-canvas\"></canvas>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"displacement\";\n            var root = document.getElementById(\"root\");\n            var stage = document.getElementById(\"dsp-clip\");\n            var canvas = document.getElementById(\"dsp-canvas\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function clampNum(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function hex(value, fallback) {\n              var m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(String(value || \"\").trim());\n              if (!m) return fallback;\n              var h = m[1].length === 3 ? m[1].replace(/./g, \"$&$&\") : m[1];\n              return \"#\" + h.toLowerCase();\n            }\n            function rgb(value) {\n              var h = hex(value, \"#ffffff\").slice(1);\n              return [parseInt(h.slice(0, 2), 16) / 255, parseInt(h.slice(2, 4), 16) / 255, parseInt(h.slice(4, 6), 16) / 255];\n            }\n            var DEFS = [{\"id\": \"label\", \"type\": \"string\", \"default\": \"Deploys this week\"}, {\"id\": \"value\", \"type\": \"string\", \"default\": \"2,481\"}, {\"id\": \"bars\", \"type\": \"string\", \"default\": \"32,51,43,68,57,86,64,100\"}, {\"id\": \"accent\", \"type\": \"color\", \"default\": \"#a1eebd\"}, {\"id\": \"title\", \"type\": \"string\", \"default\": \"Render queue\"}, {\"id\": \"items\", \"type\": \"string\", \"default\": \"intro-scene.mp4 | Done; feature-tour.mp4 | Rendering; pricing-outro.mp4 | Queued\"}, {\"id\": \"background\", \"type\": \"color\", \"default\": \"#101828\"}, {\"id\": \"grid\", \"type\": \"number\", \"default\": 60, \"min\": 4, \"max\": 100}, {\"id\": \"cell_aspect\", \"type\": \"number\", \"default\": 1, \"min\": 0.25, \"max\": 4}, {\"id\": \"shift\", \"type\": \"number\", \"default\": 1, \"min\": 0, \"max\": 4}, {\"id\": \"aberration\", \"type\": \"number\", \"default\": 1, \"min\": 0, \"max\": 3}, {\"id\": \"grain\", \"type\": \"number\", \"default\": 0.5, \"min\": 0, \"max\": 1}, {\"id\": \"stagger\", \"type\": \"number\", \"default\": 0.45, \"min\": 0, \"max\": 0.85}, {\"id\": \"resolution\", \"type\": \"number\", \"default\": 0.75, \"min\": 0.25, \"max\": 1}];\n            var V = {};\n            DEFS.forEach(function (d) {\n              var raw = vars[d.id];\n              if (d.type === \"number\") V[d.id] = clampNum(raw, d.default, d.min, d.max);\n              else if (d.type === \"color\") V[d.id] = hex(raw, d.default);\n              else if (d.type === \"boolean\") V[d.id] = typeof raw === \"boolean\" ? raw : raw === \"true\" ? true : raw === \"false\" ? false : d.default;\n              else if (d.type === \"enum\") V[d.id] = d.options.indexOf(raw) >= 0 ? raw : d.default;\n              else V[d.id] = typeof raw === \"string\" && raw.trim() ? raw.trim() : d.default;\n            });\n\n            var W = Math.max(2, root.clientWidth);\n            var H = Math.max(2, root.clientHeight);\n            var res = V.resolution;\n            var cw = Math.max(2, Math.round(W * res));\n            var ch = Math.max(2, Math.round(H * res));\n            var sceneCanvases = [\"dsp-scene0\", \"dsp-scene1\"].map(function (id) {\n              var el = document.getElementById(id);\n              el.width = cw;\n              el.height = ch;\n              return el;\n            });\n\n            var SANS = \"Geist, -apple-system, BlinkMacSystemFont, sans-serif\";\n            var MONO = \"'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace\";\n            var INK = \"#f2f2f2\";\n            var MUTED = \"#8b8f9a\";\n            var TONES = [\"#a1eebd\", \"#ffb38e\", \"#d4b3ff\"];\n            var S = Math.min(W / 940, H / 720);\n            function setFont(ctx, weight, size, family) { ctx.font = weight + \" \" + size + \"px \" + family; }\n            function fitFont(ctx, text, maxWidth, weight, size, family) {\n              setFont(ctx, weight, size, family);\n              var w = ctx.measureText(text).width;\n              if (w > maxWidth) { size *= maxWidth / w; setFont(ctx, weight, size, family); }\n              return size;\n            }\n            function setSpacing(ctx, px) { if (\"letterSpacing\" in ctx) ctx.letterSpacing = px + \"px\"; }\n            function wrapLines(ctx, text, maxWidth) {\n              var words = String(text).split(/\\s+/).filter(Boolean);\n              var lines = [];\n              var line = \"\";\n              words.forEach(function (word) {\n                var next = line ? line + \" \" + word : word;\n                if (line && ctx.measureText(next).width > maxWidth) { lines.push(line); line = word; }\n                else line = next;\n              });\n              if (line) lines.push(line);\n              return lines;\n            }\n            function pairs(text, max) {\n              return String(text).split(\";\")\n                .map(function (row) { return row.split(\"|\").map(function (part) { return part.trim(); }); })\n                .filter(function (row) { return row[0]; })\n                .slice(0, max);\n            }\n            function begin(ctx, cw, ch, fill) {\n              ctx.setTransform(cw / W, 0, 0, ch / H, 0, 0);\n              ctx.fillStyle = fill;\n              ctx.fillRect(0, 0, W, H);\n              ctx.textBaseline = \"middle\";\n              ctx.textAlign = \"left\";\n              setSpacing(ctx, 0);\n            }\n\n\n            // Sample scene \"A\": a stat and a bar chart (remocn's CanvasSceneA), laid out for any frame size.\n            var barValues = String(V.bars).split(\",\").map(function (n) { return Math.min(100, Math.max(4, Number(n) || 0)); }).slice(0, 12);\n            if (!barValues.length) barValues = [32, 51, 43, 68, 57, 86, 64, 100];\n            function drawA(canvas) {\n              var ctx = canvas.getContext(\"2d\");\n              begin(ctx, canvas.width, canvas.height, \"#0a0a0a\");\n              var s = S, pad = 96 * s, inner = W - pad * 2;\n              var labelH = 41 * s, valueSize = 152 * s, barsH = 190 * s;\n              var total = labelH + 6 * s + valueSize + 52 * s + barsH;\n              var y = (H - total) / 2;\n              ctx.fillStyle = MUTED;\n              fitFont(ctx, V.label, inner, 400, 34 * s, SANS);\n              ctx.fillText(V.label, pad, y + labelH / 2);\n              y += labelH + 6 * s;\n              ctx.fillStyle = INK;\n              setSpacing(ctx, -0.04 * valueSize);\n              fitFont(ctx, V.value, inner, 600, valueSize, SANS);\n              ctx.fillText(V.value, pad, y + valueSize / 2);\n              setSpacing(ctx, 0);\n              y += valueSize + 52 * s;\n              var n = barValues.length;\n              var bs = Math.min(1, inner / ((n * 74 + (n - 1) * 16) * s));\n              var bw = 74 * s * bs, gap = 16 * s * bs, base = y + barsH;\n              barValues.forEach(function (v, i) {\n                var h = barsH * v / 100;\n                ctx.fillStyle = i === n - 1 ? V.accent : \"#23262e\";\n                ctx.beginPath();\n                ctx.roundRect(pad + i * (bw + gap), base - h, bw, h, 10 * s * bs);\n                ctx.fill();\n              });\n            }\n\n\n            // Sample scene \"B\": a render queue (remocn's CanvasSceneB), laid out for any frame size.\n            var rows = pairs(V.items, 5);\n            function drawB(canvas) {\n              var ctx = canvas.getContext(\"2d\");\n              begin(ctx, canvas.width, canvas.height, V.background);\n              var s = S, pad = 96 * s, inner = W - pad * 2;\n              var titleH = 41 * s, rowH = 120 * s, line = Math.max(1, s);\n              var total = titleH + 34 * s + rows.length * (rowH + line);\n              var y = (H - total) / 2;\n              ctx.fillStyle = MUTED;\n              fitFont(ctx, V.title, inner, 400, 34 * s, SANS);\n              ctx.fillText(V.title, pad, y + titleH / 2);\n              y += titleH + 34 * s;\n              rows.forEach(function (row, i) {\n                ctx.fillStyle = \"#23304a\";\n                ctx.fillRect(pad, y, inner, line);\n                var mid = y + line + rowH / 2;\n                var label = row[1] || \"\";\n                var pillW = 0;\n                if (label) {\n                  var labelSize = fitFont(ctx, label, inner * 0.4, 500, 30 * s, SANS);\n                  pillW = ctx.measureText(label).width + 52 * s;\n                  var pillH = labelSize * 1.2 + 24 * s;\n                  var px = pad + inner - pillW;\n                  ctx.fillStyle = TONES[i % TONES.length];\n                  ctx.beginPath();\n                  ctx.roundRect(px, mid - pillH / 2, pillW, pillH, pillH / 2);\n                  ctx.fill();\n                  ctx.fillStyle = V.background;\n                  ctx.textAlign = \"center\";\n                  ctx.fillText(label, px + pillW / 2, mid);\n                  ctx.textAlign = \"left\";\n                }\n                ctx.fillStyle = INK;\n                fitFont(ctx, row[0], inner - pillW - 24 * s, 400, 44 * s, MONO);\n                ctx.fillText(row[0], pad, mid);\n                y += rowH + line;\n              });\n            }\n\n            function drawScenes() {\n              drawA(sceneCanvases[0]);\n              drawB(sceneCanvases[1]);\n            }\n\n            var VERTEX = [\n              \"#version 300 es\",\n              \"in vec2 a_pos;\",\n              \"out vec2 v_uv;\",\n              \"void main() {\",\n              \"  v_uv = vec2(a_pos.x * 0.5 + 0.5, 0.5 - a_pos.y * 0.5);\",\n              \"  gl_Position = vec4(a_pos, 0.0, 1.0);\",\n              \"}\"\n            ].join(\"\\n\");\n            var FRAGMENT = `#version 300 es\nprecision highp float;\n\nuniform sampler2D u_from;\nuniform sampler2D u_to;\nuniform float u_progress;\nuniform float u_aspect;\nuniform vec2 u_cells;\nuniform float u_shift;\nuniform float u_aberration;\nuniform float u_grain;\nuniform float u_stagger;\n\nin vec2 v_uv;\nout vec4 outColor;\n\nconst float PI = 3.141592653589793;\n\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n}\n\nvoid main() {\n  vec2 cell = floor(v_uv * u_cells);\n  float h1 = hash(cell);\n  float h2 = hash(cell + 7.3);\n  float h3 = hash(cell + 13.1);\n\n  float delay = h3 * u_stagger;\n  float phase =\n    clamp((u_progress - delay) / max(1.0 - u_stagger, 0.1), 0.0, 1.0);\n  float shear = sin(phase * PI);\n\n  vec2 aim = vec2((h1 - 0.5) * 2.0, (h2 - 0.5) * 0.7);\n  vec2 dir = aim / max(length(aim), 0.0001);\n  vec2 slide = dir * shear * u_shift * 1.4;\n  vec2 off = slide / u_cells;\n  vec2 fringe = off * u_aberration * 0.35;\n\n  float swap = smoothstep(0.34, 0.66, phase);\n\n  vec4 mid = mix(\n    texture(u_from, v_uv - off),\n    texture(u_to, v_uv - off),\n    swap\n  );\n  float red = mix(\n    texture(u_from, v_uv - off - fringe).r,\n    texture(u_to, v_uv - off - fringe).r,\n    swap\n  );\n  float blue = mix(\n    texture(u_from, v_uv - off + fringe).b,\n    texture(u_to, v_uv - off + fringe).b,\n    swap\n  );\n\n  vec4 col = vec4(red, mid.g, blue, mid.a);\n\n  float tick = floor(u_progress * 30.0);\n  float speck =\n    hash(floor(v_uv * vec2(u_aspect, 1.0) * 460.0) + tick * 1.7) - 0.5;\n  col.rgb += vec3(speck * u_grain * shear * 0.5) * col.a;\n  col.rgb *= 1.0 - 0.12 * shear;\n\n  outColor = col;\n}`;\n\n            canvas.width = cw;\n            canvas.height = ch;\n            var gl = canvas.getContext(\"webgl2\", { antialias: false, depth: false, stencil: false, preserveDrawingBuffer: true });\n            function compile(type, source) {\n              var shader = gl.createShader(type);\n              gl.shaderSource(shader, source);\n              gl.compileShader(shader);\n              if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader) || \"shader compile failed\");\n              return shader;\n            }\n            var paint = null;\n            var upload = function () {};\n            var extraUpload = function () {};\n            var frameFn = function () {};\n            var texUnits = [];\n            try {\n              if (!gl) throw new Error(\"WebGL2 is not available\");\n              var program = gl.createProgram();\n              gl.attachShader(program, compile(gl.VERTEX_SHADER, VERTEX));\n              gl.attachShader(program, compile(gl.FRAGMENT_SHADER, FRAGMENT));\n              gl.linkProgram(program);\n              if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program) || \"link failed\");\n              gl.useProgram(program);\n              var buffer = gl.createBuffer();\n              gl.bindBuffer(gl.ARRAY_BUFFER, buffer);\n              gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);\n              var aPos = gl.getAttribLocation(program, \"a_pos\");\n              gl.enableVertexAttribArray(aPos);\n              gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);\n              function makeTexture(unit) {\n                var texture = gl.createTexture();\n                gl.activeTexture(gl.TEXTURE0 + unit);\n                gl.bindTexture(gl.TEXTURE_2D, texture);\n                gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n                gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\n                gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\n                gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\n                return texture;\n              }\n              gl.viewport(0, 0, cw, ch);\n              function u(name) { return gl.getUniformLocation(program, name); }\n              [\"u_from\", \"u_to\"].forEach(function (name, unit) {\n                makeTexture(unit);\n                gl.uniform1i(u(name), unit);\n              });\n              gl.uniform1f(u(\"u_aspect\"), W / H);\n              var frameLoc = u(\"u_frame\");\n              var timeLoc = u(\"u_time\");\n              upload = function () {\n                sceneCanvases.forEach(function (el, unit) {\n                  gl.activeTexture(gl.TEXTURE0 + unit);\n                  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, el);\n                });\n                extraUpload();\n              };\n\n              var HOLD = 45, LEN = 18;\n              var progressLoc = u(\"u_progress\");\n              frameFn = function (frame) {\n                gl.uniform1f(progressLoc, Math.min(1, Math.max(0, (frame - HOLD) / LEN)));\n              };\n\n              var across = Math.max(V.grid, 4);\n              var ratio = Math.max(V.cell_aspect, 0.25);\n              gl.uniform2f(u(\"u_cells\"), across, Math.max((across * ratio * H) / W, 2));\n              gl.uniform1f(u(\"u_shift\"), V.shift);\n              gl.uniform1f(u(\"u_aberration\"), V.aberration);\n              gl.uniform1f(u(\"u_grain\"), V.grain);\n              gl.uniform1f(u(\"u_stagger\"), Math.min(Math.max(V.stagger, 0), 0.85));\n\n              paint = function (frame)