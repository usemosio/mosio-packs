   "content": "<!doctype html>\n<!--\n  Glass Code Block\n\n  A frosted-glass code editor window with a small regex colouring (plain spans, no highlighter library) and a line-by-line stagger reveal. Transparent, so it composites over any background.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/glass-code-block/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"glass-code-block\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[{\"id\":\"code\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Code\",\"description\":\"Source text, one line per row.\",\"default\":\"import { motion } from \\\"./motion\\\";\\n\\n// Generate a hero scene\\nexport function Hero() {\\n  const frame = useCurrentFrame();\\n  const opacity = frame / 30;\\n  return <h1 style={{ opacity }}>Hello</h1>;\\n}\"},{\"id\":\"title\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Title\",\"description\":\"Window title.\",\"default\":\"hero.tsx\"},{\"id\":\"width\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Width\",\"description\":\"Window width in pixels on a 1280x720 frame.\",\"default\":760,\"min\":300,\"max\":1100,\"step\":10,\"unit\":\"px\"},{\"id\":\"height\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Height\",\"description\":\"Window height in pixels on a 1280x720 frame.\",\"default\":460,\"min\":200,\"max\":700,\"step\":10,\"unit\":\"px\"},{\"id\":\"font_size\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Font size\",\"description\":\"Code font size in pixels.\",\"default\":16,\"min\":10,\"max\":28,\"step\":1,\"unit\":\"px\"},{\"id\":\"stagger_frames\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Stagger\",\"description\":\"Frames between one line and the next (30 fps).\",\"default\":4,\"min\":1,\"max\":30,\"step\":1,\"unit\":\"frames\"},{\"id\":\"speed\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Speed\",\"description\":\"Playback speed multiplier.\",\"default\":1,\"min\":0.25,\"max\":4,\"step\":0.05,\"unit\":\"x\"},{\"id\":\"glass_color\",\"type\":\"string\",\"role\":\"style\",\"label\":\"Glass colour\",\"description\":\"CSS colour of the glass panel.\",\"default\":\"rgba(10, 10, 10, 0.6)\"},{\"id\":\"traffic_lights\",\"type\":\"boolean\",\"role\":\"style\",\"label\":\"Traffic lights\",\"description\":\"Show the three window dots.\",\"default\":true},{\"id\":\"aura\",\"type\":\"boolean\",\"role\":\"style\",\"label\":\"Aura\",\"description\":\"Draw a slow colour glow behind the glass so the blur has something to refract.\",\"default\":false}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Glass Code Block</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: #0b0c10; font-family: \"Geist Mono\", ui-monospace, SFMono-Regular, monospace; }\n        .gb-stage { position: absolute; inset: 0; }\n        #gb-world { transform-origin: 0 0; }\n        #gb-aura { position: absolute; inset: 0; pointer-events: none; }\n        #gb-ring { position: absolute; padding: 1px; border-radius: 16px; box-sizing: border-box; background: linear-gradient(180deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 100%); box-shadow: 0 50px 120px rgba(0,0,0,0.55); }\n        #gb-glass { width: 100%; height: 100%; border-radius: 15px; backdrop-filter: blur(16px); box-shadow: inset 0 1px 0 rgba(255,255,255,0.06); display: flex; flex-direction: column; overflow: hidden; }\n        #gb-chrome { height: 40px; flex: none; box-sizing: border-box; display: flex; align-items: center; gap: 8px; padding: 0 16px; border-bottom: 1px solid rgba(255,255,255,0.06); }\n        .gb-light { width: 12px; height: 12px; border-radius: 50%; opacity: 0.6; }\n        #gb-title { flex: 1; text-align: center; color: #a1a1aa; font-size: 12px; letter-spacing: 0.02em; }\n        #gb-body { flex: 1; padding: 20px 24px; display: flex; flex-direction: column; gap: 4px; line-height: 1.55; overflow: hidden; }\n        .gb-line { white-space: pre; display: flex; color: #e4e4e7; }\n        .gb-num { width: 28px; color: #3f3f46; flex: none; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"glass-code-block\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"gb-clip\" class=\"gb-stage clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\">\n<div id=\"gb-world\"><div id=\"gb-aura\"></div><div id=\"gb-ring\"><div id=\"gb-glass\"><div id=\"gb-chrome\"><span id=\"gb-lights\" style=\"display:flex;gap:8px\"><span class=\"gb-light\" style=\"background:#ff5f57\"></span><span class=\"gb-light\" style=\"background:#febc2e\"></span><span class=\"gb-light\" style=\"background:#28c840\"></span></span><div id=\"gb-title\"></div></div><div id=\"gb-body\"></div></div></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n                        // Stop-motion helpers: poses are held for `step` frames.\n            var DEFAULT_STEP = 3;\n            function qf(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step) * step; }\n            function qstep(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step); }\n            function hash01(seed) { return random(seed); }\n            function hashRange(seed, lo, hi) { return lo + hash01(seed) * (hi - lo); }\n            function paperJitter(frame, seed, o) {\n              o = o || {};\n              var amp = o.amp != null ? o.amp : 1.4, rotAmp = o.rotAmp != null ? o.rotAmp : 0.35;\n              var s = qstep(frame, o.step);\n              return { x: hashRange(seed + \":x:\" + s, -amp, amp), y: hashRange(seed + \":y:\" + s, -amp, amp), rot: hashRange(seed + \":r:\" + s, -rotAmp, rotAmp) };\n            }\n            function steppedRamp(frame, from, to, o) {\n              o = o || {};\n              var f = qf(frame, o.step);\n              if (f <= from) return 0;\n              if (f >= to) return 1;\n              var ease = o.ease || function (t) { return t; };\n              return ease((f - from) / (to - from));\n            }\n\n\n            function scaledStage(el, boost) {\n              var W = root.clientWidth, H = root.clientHeight;\n              var s = Math.min(W / 1280, H / 720) * (H > W ? (boost || 1.4) : 1);\n              el.style.position = \"absolute\"; el.style.left = \"0\"; el.style.top = \"0\";\n              el.style.width = W / s + \"px\"; el.style.height = H / s + \"px\";\n              el.style.transformOrigin = \"0 0\"; el.style.transform = \"scale(\" + s + \")\";\n              return s;\n            }\n\n            var KEYWORDS = [\"import\", \"from\", \"export\", \"function\", \"const\", \"let\", \"var\", \"return\", \"if\", \"else\", \"for\", \"while\", \"new\", \"class\", \"extends\", \"default\", \"true\", \"false\", \"null\", \"undefined\"];\n            var TOKEN_COLORS = { code: \"#e4e4e7\", comment: \"#52525b\", string: \"#86efac\", keyword: \"#c4b5fd\", number: \"#fcd34d\" };\n            // Minimal tokenizer, not a real highlighter: comments, strings, keywords, numbers.\n            function tokenizeLine(line) {\n              if (line.replace(/^\\s+/, \"\").indexOf(\"//\") === 0) return [{ text: line, kind: \"comment\" }];\n              var out = [], re = /(\"[^\"]*\"|'[^']*'|`[^`]*`|\\b\\d+\\b|\\b[A-Za-z_$][\\w$]*\\b|[^\\w\"']+)/g, m;\n              while ((m = re.exec(line)) !== null) {\n                var t = m[0], c = t.charAt(0), kind = \"code\";\n                if (c === '\"' || c === \"'\" || c === \"`\") kind = \"string\";\n                else if (/^\\d+$/.test(t)) kind = \"number\";\n                else if (/^[A-Za-z_$][\\w$]*$/.test(t) && KEYWORDS.indexOf(t) >= 0) kind = \"keyword\";\n                out.push({ text: t, kind: kind });\n              }\n              return out;\n            }\n            function buildLines(host, lines, fontSize) {\n              return lines.map(function (line, i) {\n                var el = document.createElement(\"div\");\n                el.className = \"gb-line\"; el.id = \"gb-line-\" + i;\n                var toks = tokenizeLine(line);\n                if (toks.length === 0) { el.style.height = fontSize * 0.8 + \"px\"; }\n                else {\n                  var n = document.createElement(\"span\"); n.className = \"gb-num\"; n.textContent = String(i + 1).padStart(2, \" \"); el.appendChild(n);\n                  var body = document.createElement(\"span\");\n                  toks.forEach(function (t) { var s = document.createElement(\"span\"); s.style.color = TOKEN_COLORS[t.kind]; s.textContent = t.text; body.appendChild(s); });\n                  el.appendChild(body);\n                }\n                el.style.opacity = \"0\";\n                host.appendChild(el);\n                return el;\n              });\n            }\n\n            var world = document.getElementById(\"gb-world\");\n            var sc = scaledStage(world, 1.3);\n            var SW = root.clientWidth / sc, SH = root.clientHeight / sc;\n            var code = typeof vars.code === \"string\" && vars.code.trim() ? vars.code : \"import { motion } from \\\"./motion\\\";\\n\\n// Generate a hero scene\\nexport function Hero() {\\n  const frame = useCurrentFrame();\\n  const opacity = frame / 30;\\n  return <h1 style={{ opacity }}>Hello</h1>;\\n}\";\n            var title = str(vars.title, \"hero.tsx\");\n            var width = num(vars.width, 760, 300, 1100), height = num(vars.height, 460, 200, 700), fontSize = num(vars.font_size, 16, 10, 28);\n            var stagger = num(vars.stagger_frames, 4, 1, 30), speed = num(vars.speed, 1, 0.25, 4);\n            var aura = bool(vars.aura, false), lights = bool(vars.traffic_lights, true);\n            var glassColor = str(vars.glass_color, \"rgba(10, 10, 10, 0.6)\");\n            document.getElementById(\"gb-title\").textContent = title;\n            document.getElementById(\"gb-lights\").style.display = lights ? \"flex\" : \"none\";\n            document.getElementById(\"gb-glass\").style.background = glassColor;\n            var ring = document.getElementById(\"gb-ring\"), body = document.getElementById(\"gb-body\");\n            ring.style.width = width + \"px\"; ring.style.height = height + \"px\";\n            ring.style.left = (SW - width) / 2 + \"px\"; ring.style.top = (SH - height) / 2 + \"px\";\n            body.style.fontSize = fontSize + \"px\";\n            var aur = document.getElementById(\"gb-aura\"); if (!aura) aur.style.display = \"none\";\n            var lines = code.split(\"\\n\"), els = buildLines(body, lines, fontSize);\n\n            function draw(frame) {\n              els.forEach(function (el, i) {\n                var f = frame - Math.round((i * stagger) / speed);\n                el.style.opacity = interpolate(f, [0, 8], [0, 1], { extrapolateLeft: \"clamp\", extrapolateRight: \"clamp\" });\n                el.style.transform = \"translateY(\" + interpolate(f, [0, 8], [4, 0], { extrapolateLeft: \"clamp\", extrapolateRight: \"clamp\" }) + \"px)\";\n              });\n              if (aura) {\n                var t = frame / 60, x = 50 + Math.sin(t) * 20, y = 50 + Math.cos(t * 0.7) * 15;\n                aur.style.background = \"radial-gradient(circle at \" + x + \"% \" + y + \"%, rgba(56,189,248,0.22), transparent 50%), radial-gradient(circle at \" + (100 - x) + \"% \" + (100 - y) + \"%, rgba(168,85,247,0.18), transparent 55%)\";\n              }\n            }\n            var tl = gsap.timeline({ paused: true });\n            clockTween(tl, 180, draw);\n\n            var total = parseFloat(root.dataset.duration || \"6\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"glass-code-block\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
