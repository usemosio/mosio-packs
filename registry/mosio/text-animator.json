   "content": "<!doctype html>\n<!--\n  Text Animator\n\n  a motion editor text animator: a range selector drives per-character, per-word or per-line properties.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/riaz37/remotion-ui/blob/0aecaca2b61a167992e1205d10e4da16d8a71331/apps/web/registry/bases/default/primitives/text-animator.tsx\n\n  MIT License\n\n  Copyright (c) 2026 RemotionUI\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"text-animator\"\n  data-composition-duration=\"4\"\n  data-composition-variables='[\n    [\n      {\n        \"id\": \"text\",\n        \"type\": \"string\",\n        \"role\": \"content\",\n        \"label\": \"Text\",\n        \"description\": \"The text. A line break starts a new line.\",\n        \"default\": \"Animate every letter.\"\n      },\n      {\n        \"id\": \"font_size\",\n        \"type\": \"number\",\n        \"role\": \"style\",\n        \"label\": \"Font size\",\n        \"description\": \"Text size in pixels.\",\n        \"default\": 84,\n        \"min\": 24,\n        \"max\": 260,\n        \"step\": 1,\n        \"unit\": \"px\"\n      },\n      {\n        \"id\": \"color\",\n        \"type\": \"color\",\n        \"role\": \"style\",\n        \"label\": \"Color\",\n        \"description\": \"Text color.\",\n        \"default\": \"#f4f4f5\"\n      },\n      {\n        \"id\": \"font_weight\",\n        \"type\": \"number\",\n        \"role\": \"style\",\n        \"label\": \"Font weight\",\n        \"description\": \"Weight of the text.\",\n        \"default\": 700,\n        \"min\": 100,\n        \"max\": 900,\n        \"step\": 100\n      },\n      {\n        \"id\": \"font\",\n        \"type\": \"enum\",\n        \"role\": \"style\",\n        \"label\": \"Font\",\n        \"description\": \"Typeface.\",\n        \"default\": \"geist\",\n        \"options\": [\n          {\n            \"value\": \"geist\",\n            \"label\": \"Geist\"\n          },\n          {\n            \"value\": \"poppins\",\n            \"label\": \"Poppins\"\n          },\n          {\n            \"value\": \"playfair\",\n            \"label\": \"Playfair Display\"\n          },\n          {\n            \"value\": \"grotesk\",\n            \"label\": \"Space Grotesk\"\n          }\n        ]\n      },\n      {\n        \"id\": \"based_on\",\n        \"type\": \"enum\",\n        \"role\": \"motion\",\n        \"label\": \"Based on\",\n        \"description\": \"What the selector counts: characters, words or lines.\",\n        \"default\": \"characters\",\n        \"options\": [\n          {\n            \"value\": \"characters\",\n            \"label\": \"Characters\"\n          },\n          {\n            \"value\": \"words\",\n            \"label\": \"Words\"\n          },\n          {\n            \"value\": \"lines\",\n            \"label\": \"Lines\"\n          }\n        ]\n      },\n      {\n        \"id\": \"position_x\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Position X\",\n        \"description\": \"Horizontal offset of a selected unit, in em.\",\n        \"default\": 0,\n        \"min\": -3,\n        \"max\": 3,\n        \"step\": 0.05,\n        \"unit\": \"em\"\n      },\n      {\n        \"id\": \"position_y\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Position Y\",\n        \"description\": \"Vertical offset of a selected unit, in em.\",\n        \"default\": 0.5,\n        \"min\": -3,\n        \"max\": 3,\n        \"step\": 0.05,\n        \"unit\": \"em\"\n      },\n      {\n        \"id\": \"scale\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Scale\",\n        \"description\": \"Scale of a selected unit (1 is unchanged).\",\n        \"default\": 0.8,\n        \"min\": 0,\n        \"max\": 3,\n        \"step\": 0.05\n      },\n      {\n        \"id\": \"rotation\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Rotation\",\n        \"description\": \"Rotation of a selected unit in degrees.\",\n        \"default\": 0,\n        \"min\": -360,\n        \"max\": 360,\n        \"step\": 1,\n        \"unit\": \"deg\"\n      },\n      {\n        \"id\": \"skew\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Skew\",\n        \"description\": \"Horizontal skew of a selected unit in degrees.\",\n        \"default\": 0,\n        \"min\": -60,\n        \"max\": 60,\n        \"step\": 1,\n        \"unit\": \"deg\"\n      },\n      {\n        \"id\": \"opacity\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Opacity\",\n        \"description\": \"Opacity of a selected unit (0 to 1).\",\n        \"default\": 0,\n        \"min\": 0,\n        \"max\": 1,\n        \"step\": 0.05\n      },\n      {\n        \"id\": \"blur\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Blur\",\n        \"description\": \"Blur of a selected unit in pixels.\",\n        \"default\": 10,\n        \"min\": 0,\n        \"max\": 60,\n        \"step\": 1,\n        \"unit\": \"px\"\n      },\n      {\n        \"id\": \"tracking\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Tracking\",\n        \"description\": \"Extra spacing after a selected unit, in em.\",\n        \"default\": 0,\n        \"min\": -1,\n        \"max\": 3,\n        \"step\": 0.02,\n        \"unit\": \"em\"\n      },\n      {\n        \"id\": \"fill_color\",\n        \"type\": \"color\",\n        \"role\": \"style\",\n        \"label\": \"Fill color\",\n        \"description\": \"Colour a selected unit takes while the selector covers it.\",\n        \"default\": \"#7dd3fc\"\n      },\n      {\n        \"id\": \"use_fill\",\n        \"type\": \"boolean\",\n        \"role\": \"style\",\n        \"label\": \"Use fill color\",\n        \"description\": \"Tint selected units with the fill colour.\",\n        \"default\": true\n      },\n      {\n        \"id\": \"shape\",\n        \"type\": \"enum\",\n        \"role\": \"motion\",\n        \"label\": \"Selector shape\",\n        \"description\": \"Shape of the selector window.\",\n        \"default\": \"square\",\n        \"options\": [\n          {\n            \"value\": \"square\",\n            \"label\": \"Square\"\n          },\n          {\n            \"value\": \"ramp-up\",\n            \"label\": \"Ramp up\"\n          },\n          {\n            \"value\": \"ramp-down\",\n            \"label\": \"Ramp down\"\n          },\n          {\n            \"value\": \"triangle\",\n            \"label\": \"Triangle\"\n          },\n          {\n            \"value\": \"round\",\n            \"label\": \"Round\"\n          },\n          {\n            \"value\": \"smooth\",\n            \"label\": \"Smooth\"\n          }\n        ]\n      },\n      {\n        \"id\": \"smoothness\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Smoothness\",\n        \"description\": \"Square shape only: 1 fades units across their slot, 0 switches them on and off hard.\",\n        \"default\": 1,\n        \"min\": 0,\n        \"max\": 1,\n        \"step\": 0.05\n      },\n      {\n        \"id\": \"start\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Start\",\n        \"description\": \"Start of the selector window, in percent of the text.\",\n        \"default\": 0,\n        \"min\": -100,\n        \"max\": 200,\n        \"step\": 1,\n        \"unit\": \"%\"\n      },\n      {\n        \"id\": \"end\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"End\",\n        \"description\": \"End of the selector window, in percent of the text.\",\n        \"default\": 100,\n        \"min\": -100,\n        \"max\": 200,\n        \"step\": 1,\n        \"unit\": \"%\"\n      },\n      {\n        \"id\": \"offset_from\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Offset from\",\n        \"description\": \"Where the window sits when the sweep starts, as a percent shift.\",\n        \"default\": 0,\n        \"min\": -200,\n        \"max\": 200,\n        \"step\": 1,\n        \"unit\": \"%\"\n      },\n      {\n        \"id\": \"offset_to\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Offset to\",\n        \"description\": \"Where the window sits when the sweep ends.\",\n        \"default\": 100,\n        \"min\": -200,\n        \"max\": 200,\n        \"step\": 1,\n        \"unit\": \"%\"\n      },\n      {\n        \"id\": \"random_order\",\n        \"type\": \"boolean\",\n        \"role\": \"motion\",\n        \"label\": \"Random order\",\n        \"description\": \"Shuffle which unit sits where in the selector.\",\n        \"default\": false\n      },\n      {\n        \"id\": \"seed\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Seed\",\n        \"description\": \"Seed of the shuffle.\",\n        \"default\": 1,\n        \"min\": 0,\n        \"max\": 999,\n        \"step\": 1\n      },\n      {\n        \"id\": \"delay_frames\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Delay\",\n        \"description\": \"Frames (30 per second) before the sweep starts.\",\n        \"default\": 8,\n        \"min\": 0,\n        \"max\": 300,\n        \"step\": 1,\n        \"unit\": \"frames\"\n      },\n      {\n        \"id\": \"sweep_frames\",\n        \"type\": \"number\",\n        \"role\": \"motion\",\n        \"label\": \"Sweep\",\n        \"description\": \"Frames the window takes to travel from Offset from to Offset to.\",\n        \"default\": 60,\n        \"min\": 4,\n        \"max\": 300,\n        \"step\": 1,\n        \"unit\": \"frames\"\n      }\n    ]\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Text Animator</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@100..900&amp;family=Poppins:wght@400;600;800&amp;family=Playfair+Display:wght@400..900&amp;family=Space+Grotesk:wght@300..700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n        #root { color: #f4f4f5; }\n        .tan-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }\n        .tan-text { display: inline-flex; flex-direction: column; align-items: center; text-align: center; max-width: 90%; line-height: 1.12; letter-spacing: -0.02em; }\n        .tan-line { display: block; white-space: normal; }\n        .tan-word { display: inline-block; white-space: nowrap; }\n        .tan-unit { display: inline-block; white-space: pre; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"text-animator\" data-duration=\"4\" data-fps=\"30\">\n        <div id=\"tan-clip\" class=\"tan-stage clip\" data-start=\"0\" data-duration=\"4\" data-track-index=\"0\">\n          <span id=\"tan-text\" class=\"tan-text\" role=\"img\"></span>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\n            function num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) && v !== \"\" && v !== null ? Math.min(max, Math.max(min, n)) : f; }\n            function str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\n            function bool(v, f) { if (v === undefined || v === null || v === \"\") return f; return !(v === false || v === \"false\" || v === 0 || v === \"0\"); }\n            function pick(v, list, f) { v = String(v); return list.indexOf(v) >= 0 ? v : f; }\n            function clamp01(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }\n            function lerp(a, b, t) { return a + (b - a) * t; }\n            function ramp(v, a, b, from, to, ease) { var p = b === a ? 1 : clamp01((v - a) / (b - a)); if (ease) p = ease(p); return from + (to - from) * p; }\n            function bez(x1, y1, x2, y2) {\n              return function (x) {\n                if (x <= 0) return 0;\n                if (x >= 1) return 1;\n                var lo = 0, hi = 1, t = x;\n                for (var i = 0; i < 30; i++) {\n                  var cx = 3 * (1 - t) * (1 - t) * t * x1 + 3 * (1 - t) * t * t * x2 + t * t * t;\n                  if (cx < x) lo = t; else hi = t;\n                  t = (lo + hi) / 2;\n                }\n                return 3 * (1 - t) * (1 - t) * t * y1 + 3 * (1 - t) * t * t * y2 + t * t * t;\n              };\n            }\n            function mulberry32(a) { return function () { a |= 0; a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n            function mk(tag, parent, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined) e.textContent = text; if (parent) parent.appendChild(e); return e; }\n            var TOTAL = parseFloat(root.dataset.duration || \"4\");\n            // Every frame is drawn from the frame number alone, so seeking anywhere draws the same frame.\n            function drive(name, frameFn) {\n              var clock = { f: 0 };\n              var tl = gsap.timeline({ paused: true });\n              tl.to(clock, { f: TOTAL * 30, duration: TOTAL, ease: \"none\", onUpdate: function () { frameFn(clock.f); } }, 0);\n              frameFn(0);\n              tl.seek(0);\n              window.__timelines = window.__timelines || {};\n              window.__timelines[name] = tl;\n            }\n\n            // ---- Split text into lines, words and units (characters, words or lines), staggered like the source library's useSplitText ----\n            var ENTER = bez(0.16, 1, 0.3, 1);\n            function EXIT(t) { return t * t * t; }\n            function splitText(text, mode) {\n              var lines = [], units = [];\n              String(text).split(/\\r?\\n/).forEach(function (raw) {\n                var words = [];\n                var rawWords = mode === \"lines\" ? [raw.trim()].filter(Boolean) : raw.split(/\\s+/).filter(Boolean);\n                rawWords.forEach(function (w) {\n                  var pieces = mode === \"chars\" ? Array.from(w) : [w];\n                  var us = pieces.map(function (p) { var u = { text: p, index: units.length }; units.push(u); return u; });\n                  words.push({ units: us });\n                });\n                lines.push({ words: words });\n              });\n              return { lines: lines, units: units };\n            }\n            function staggerRanks(total, order, seed) {\n              var idx = [], i, mid = (total - 1) / 2;\n              for (i = 0; i < total; i++) idx.push(i);\n              if (order === \"end\") return idx.map(function (k) { return total - 1 - k; });\n              if (order === \"center\") return idx.map(function (k) { return Math.round(Math.abs(k - mid)); });\n              if (order === \"edges\") return idx.map(function (k) { return Math.round(mid - Math.abs(k - mid)); });\n              if (order === \"random\") {\n                var rng = mulberry32(seed || 1), keys = idx.map(function () { return rng(); });\n                var sorted = idx.slice().sort(function (a, b) { return keys[a] - keys[b]; });\n                var out = new Array(total);\n                sorted.forEach(function (orig, rank) { out[orig] = rank; });\n                return out;\n              }\n              return idx;\n            }\n            // o: stagger, duration, delay (frames), order, seed, exit (bool), exitFrames\n            function makeTiming(split, o) {\n              var rk = staggerRanks(split.units.length, o.order, o.seed);\n              var maxRank = rk.length ? Math.max.apply(null, rk) : 0;\n              var lastEnter = o.delay + maxRank * o.stagger + o.duration;\n              var exitFrames = Math.max(1, Math.round(o.exitFrames || Math.max(6, Math.round(o.duration * 0.7))));\n              var exitStart = null;\n              if (o.exit) exitStart = Math.max(TOTAL * 30 - exitFrames - maxRank * o.stagger, lastEnter);\n              return { ranks: rk, o: o, exitFrames: exitFrames, exitStart: exitStart, lastEnter: lastEnter };\n            }\n            function unitState(frame, T, u) {\n              var rank = T.ranks[u.index], o = T.o;\n              var start = o.delay + rank * o.stagger;\n              var et = clamp01((frame - start) / o.duration);\n              var enter = ENTER(et), eo = clamp01(et / 0.55);\n              if (T.exitStart === null) return { enter: enter, exit: 0, displace: 1 - enter, opacity: eo, value: enter };\n              var us = T.exitStart + rank * o.stagger;\n              var xt = clamp01((frame - us) / T.exitFrames);\n              var ex = EXIT(xt), xo = 1 - clamp01(xt / 0.7);\n              return { enter: enter, exit: ex, displace: ex > 0 ? ex : 1 - enter, opacity: eo * xo, value: enter * (1 - ex) };\n            }\n            // Builds lines > words > unit spans into parent. fill(unitEl, u) fills each unit.\n            function buildSplit(parent, split, pre, wordGap, fill) {\n              split.lines.forEach(function (line) {\n                var lineEl = mk(\"span\", parent, pre + \"-line\");\n                line.words.forEach(function (word, wi) {\n                  var wordEl = mk(\"span\", lineEl, pre + \"-word\");\n                  if (wi < line.words.length - 1) wordEl.style.marginRight = wordGap + \"em\";\n                  word.units.forEach(function (u) {\n                    u.el = mk(\"span\", wordEl, pre + \"-unit\");\n                    fill(u.el, u);\n                  });\n                });\n              });\n            }\n            function splitCss(pre) {\n              return \".\" + pre + \"-text { display: inline-flex; flex-direction: column; align-items: center; text-align: center; max-width: 90%; line-height: 1.15; }\\n\" +\n                \".\" + pre + \"-line { display: block; white-space: normal; }\\n\" +\n                \".\" + pre + \"-word { display: inline-block; }\\n\" +\n                \".\" + pre + \"-unit { display: inline-block; white-space: pre; }\\n\";\n            }\n\n            var FONTS = { geist: \"Geist, system-ui, sans-serif\", poppins: \"Poppins, system-ui, sans-serif\", playfair: '\"Playfair Display\", Georgia, serif', grotesk: '\"Space Grotesk\", system-ui, sans-serif' };\n            var fontKey = pick(vars.font, [\"geist\", \"poppins\", \"playfair\", \"grotesk\"], \"geist\");\n            root.style.fontFamily = FONTS[fontKey];\n            var text = str(vars.text, \"Animate every letter.\");\n            var basis = pick(vars.based_on, [\"characters\", \"words\", \"lines\"], \"characters\");\n            var el = document.getElementById(\"tan-text\");\n            el.style.fontSize = num(vars.font_size, 84, 24, 260) + \"px\";\n            el.style.fontWeight = String(num(vars.font_weight, 700, 100, 900));\n            var baseColor = str(vars.color, \"#f4f4f5\");\n            el.style.color = baseColor;\n            el.setAttribute(\"aria-label\", text);\n            var P = { x: num(vars.position_x, 0, -3, 3), y: num(vars.position_y, 0.5, -3, 3), scale: num(vars.scale, 0.8, 0, 3), rot: num(vars.rotation, 0, -360, 360), skew: num(vars.skew, 0, -60, 60),\n              opacity: num(vars.opacity, 0, 0, 1), blur: num(vars.blur, 10, 0, 60), tracking: num(vars.tracking, 0, -1, 3) };\n            var fill = bool(vars.use_fill, true) ? str(vars.fill_color, \"#7dd3fc\") : null;\n            var shape = pick(vars.shape, [\"square\", \"ramp-up\", \"ramp-down\", \"triangle\", \"round\", \"smooth\"], \"square\");\n            var smooth = num(vars.smoothness, 1, 0, 1), start0 = num(vars.start, 0, -100, 200) / 100, end0 = num(vars.end, 100, -100, 200) / 100;\n            var offFrom = num(vars.offset_from, 0, -200, 200) / 100, offTo = num(vars.offset_to, 100, -200, 200) / 100;\n            var delay = num(vars.delay_frames, 8, 0, 300), sweep = num(vars.sweep_frames, 60, 4, 300);\n            var sweepEase = bez(0.4, 0, 0.2, 1);\n            function mixColor(a, b, t) { return \"color-mix(in srgb, \" + b + \" \" + (Math.round(clamp01(t) * 10000) / 100) + \"%, \" + a + \")\"; }\n            // ---- Layout: lines > words > characters; the selector acts on the chosen group.\n            var lines = [], words = [], chars = [], charCount = 0;\n            text.split(/\\r?\\n/).forEach(function (raw, li) {\n              var lineEl = mk(\"span\", el, \"tan-line\"), lw = [];\n              raw.split(/\\s+/).filter(Boolean).forEach(function (w, wi) {\n                var wordEl = mk(\"span\", lineEl, \"tan-word\");\n                if (wi > 0) wordEl.style.marginLeft = \"0.26em\";\n                var wobj = { el: wordEl };\n                words.push(wobj); lw.push(wobj);\n                if (wi > 0) charCount += 1; // a space counts as a character in the selector\n                Array.from(w).forEach(function (ch) {\n                  var c = mk(\"span\", wordEl, \"tan-unit\", ch);\n                  chars.push({ el: c, index: charCount }); charCount += 1;\n                });\n              });\n              lines.push({ el: lineEl });\n              charCount += 1; // a line break counts too\n            });\n            var groups = basis === \"words\" ? words : basis === \"lines\" ? lines : chars;\n            var total = basis === \"characters\" ? Math.max(1, charCount - 1) : groups.length;\n            groups.forEach(function (g, i) { if (basis !== \"characters\") g.index = i; });\n            if (basis !== \"characters\") { groups.forEach(function (g) { g.el.style.display = \"inline-block\"; }); }\n            var ranks = null;\n            if (bool(vars.random_order, false)) {\n              var rng = mulberry32(num(vars.seed, 1, 0, 999)), keys = groups.map(function () { return rng(); });\n              var sorted = groups.map(function (g, i) { return i; }).sort(function (a, b) { return keys[a] - keys[b]; });\n              ranks = new Array(groups.length); sorted.forEach(function (orig, rank) { ranks[orig] = rank; });\n            }\n            function shapeValue(t) {\n              if (shape === \"ramp-up\") return clamp01(t);\n              if (shape === \"ramp-down\") return clamp