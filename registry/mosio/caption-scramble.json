   "content": "<!doctype html>\n<!--\n  Caption Scramble\n\n  Each word arrives as random glyphs at the moment it is spoken and decodes left to right into the real letters.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/caption-scramble/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"caption-scramble\"\n  data-composition-duration=\"9.3\"\n  data-composition-variables='[\n    {\"id\": \"captions\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Captions\", \"description\": \"Word timings as JSON: [{\\\"text\\\",\\\"startMs\\\",\\\"endMs\\\"}] in milliseconds, or [{\\\"text\\\",\\\"start\\\",\\\"end\\\"}] in seconds. A transcript from Mosio works as is.\", \"default\": \"[{\\\"text\\\":\\\" So\\\",\\\"startMs\\\":300,\\\"endMs\\\":460},{\\\"text\\\":\\\" here&#39;s\\\",\\\"startMs\\\":460,\\\"endMs\\\":700},{\\\"text\\\":\\\" the\\\",\\\"startMs\\\":700,\\\"endMs\\\":820},{\\\"text\\\":\\\" thing.\\\",\\\"startMs\\\":820,\\\"endMs\\\":1240},{\\\"text\\\":\\\" Most\\\",\\\"startMs\\\":1700,\\\"endMs\\\":1960},{\\\"text\\\":\\\" demo\\\",\\\"startMs\\\":1960,\\\"endMs\\\":2240},{\\\"text\\\":\\\" videos\\\",\\\"startMs\\\":2240,\\\"endMs\\\":2680},{\\\"text\\\":\\\" lose\\\",\\\"startMs\\\":2680,\\\"endMs\\\":2960},{\\\"text\\\":\\\" people\\\",\\\"startMs\\\":2960,\\\"endMs\\\":3320},{\\\"text\\\":\\\" in\\\",\\\"startMs\\\":3320,\\\"endMs\\\":3420},{\\\"text\\\":\\\" the\\\",\\\"startMs\\\":3420,\\\"endMs\\\":3520},{\\\"text\\\":\\\" first\\\",\\\"startMs\\\":3520,\\\"endMs\\\":3820},{\\\"text\\\":\\\" three\\\",\\\"startMs\\\":3820,\\\"endMs\\\":4100},{\\\"text\\\":\\\" seconds.\\\",\\\"startMs\\\":4100,\\\"endMs\\\":4780},{\\\"text\\\":\\\" Captions\\\",\\\"startMs\\\":5400,\\\"endMs\\\":5920},{\\\"text\\\":\\\" keep\\\",\\\"startMs\\\":5920,\\\"endMs\\\":6140},{\\\"text\\\":\\\" them\\\",\\\"startMs\\\":6140,\\\"endMs\\\":6300},{\\\"text\\\":\\\" watching,\\\",\\\"startMs\\\":6300,\\\"endMs\\\":6860},{\\\"text\\\":\\\" even\\\",\\\"startMs\\\":6960,\\\"endMs\\\":7180},{\\\"text\\\":\\\" with\\\",\\\"startMs\\\":7180,\\\"endMs\\\":7320},{\\\"text\\\":\\\" the\\\",\\\"startMs\\\":7320,\\\"endMs\\\":7420},{\\\"text\\\":\\\" sound\\\",\\\"startMs\\\":7420,\\\"endMs\\\":7760},{\\\"text\\\":\\\" off.\\\",\\\"startMs\\\":7760,\\\"endMs\\\":8300}]\"},\n    {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Caption text size in pixels (at 1080 px on the short side).\", \"default\": 64, \"min\": 24, \"max\": 140, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"font_weight\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font weight\", \"description\": \"Weight of the caption text.\", \"default\": 800, \"min\": 400, \"max\": 900, \"step\": 100},\n    {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Text color\", \"description\": \"Caption text color.\", \"default\": \"#ffffff\"},\n    {\"id\": \"combine_tokens_within_milliseconds\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Page window\", \"description\": \"Words that start within this window share one page of captions. A sentence end always starts a new page.\", \"default\": 1200, \"min\": 0, \"max\": 3000, \"step\": 100, \"unit\": \"ms\"},\n    {\"id\": \"hold_ms\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Hold\", \"description\": \"How long the last page stays after its final word.\", \"default\": 600, \"min\": 0, \"max\": 2000, \"step\": 50, \"unit\": \"ms\"},\n    {\"id\": \"shadow\", \"type\": \"boolean\", \"role\": \"style\", \"label\": \"Shadow\", \"description\": \"Soft shadow behind the text for legibility on footage.\", \"default\": true},\n    {\"id\": \"glyph_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Glyph color\", \"description\": \"Color of the scrambled characters.\", \"default\": \"#a3a3a3\"}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Caption Scramble</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@100..900&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          color: #ffffff;\n          font-family: Geist, system-ui, sans-serif;\n          pointer-events: none;\n        }\n        .cscr-stage {\n          position: absolute;\n          left: 6%;\n          right: 6%;\n          bottom: 14%;\n          display: flex;\n          justify-content: center;\n        }\n        .cscr-line {\n          width: 100%;\n          text-align: center;\n          line-height: 1.2;\n          text-wrap: pretty;\n        }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"caption-scramble\" data-duration=\"9.3\" data-fps=\"30\">\n        <div id=\"cscr-clip\" class=\"cscr-stage clip\" data-start=\"0\" data-duration=\"9.3\" data-track-index=\"0\">\n          <div id=\"cscr-line\" class=\"cscr-line\" role=\"img\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var line = document.getElementById(\"cscr-line\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(v, f, min, max) {\n              var n = Number(v);\n              return Number.isFinite(n) && v !== \"\" && v !== null ? Math.min(max, Math.max(min, n)) : f;\n            }\n            function bool(v, f) {\n              if (v === undefined || v === null || v === \"\") return f;\n              return !(v === false || v === \"false\" || v === 0 || v === \"0\");\n            }\n            function str(v, f) {\n              return typeof v === \"string\" && v ? v : f;\n            }\n            function jsonObject(v) {\n              if (v && typeof v === \"object\" && !Array.isArray(v)) return v;\n              try {\n                var o = JSON.parse(v);\n                return o && typeof o === \"object\" && !Array.isArray(o) ? o : {};\n              } catch (e) {\n                return {};\n              }\n            }\n\n            // ---- Captions: parse, page, and look up the page for a time (shared by every caption block) ----\n            var DEFAULT_CAPTIONS = \"[{\\\"text\\\":\\\" So\\\",\\\"startMs\\\":300,\\\"endMs\\\":460},{\\\"text\\\":\\\" here's\\\",\\\"startMs\\\":460,\\\"endMs\\\":700},{\\\"text\\\":\\\" the\\\",\\\"startMs\\\":700,\\\"endMs\\\":820},{\\\"text\\\":\\\" thing.\\\",\\\"startMs\\\":820,\\\"endMs\\\":1240},{\\\"text\\\":\\\" Most\\\",\\\"startMs\\\":1700,\\\"endMs\\\":1960},{\\\"text\\\":\\\" demo\\\",\\\"startMs\\\":1960,\\\"endMs\\\":2240},{\\\"text\\\":\\\" videos\\\",\\\"startMs\\\":2240,\\\"endMs\\\":2680},{\\\"text\\\":\\\" lose\\\",\\\"startMs\\\":2680,\\\"endMs\\\":2960},{\\\"text\\\":\\\" people\\\",\\\"startMs\\\":2960,\\\"endMs\\\":3320},{\\\"text\\\":\\\" in\\\",\\\"startMs\\\":3320,\\\"endMs\\\":3420},{\\\"text\\\":\\\" the\\\",\\\"startMs\\\":3420,\\\"endMs\\\":3520},{\\\"text\\\":\\\" first\\\",\\\"startMs\\\":3520,\\\"endMs\\\":3820},{\\\"text\\\":\\\" three\\\",\\\"startMs\\\":3820,\\\"endMs\\\":4100},{\\\"text\\\":\\\" seconds.\\\",\\\"startMs\\\":4100,\\\"endMs\\\":4780},{\\\"text\\\":\\\" Captions\\\",\\\"startMs\\\":5400,\\\"endMs\\\":5920},{\\\"text\\\":\\\" keep\\\",\\\"startMs\\\":5920,\\\"endMs\\\":6140},{\\\"text\\\":\\\" them\\\",\\\"startMs\\\":6140,\\\"endMs\\\":6300},{\\\"text\\\":\\\" watching,\\\",\\\"startMs\\\":6300,\\\"endMs\\\":6860},{\\\"text\\\":\\\" even\\\",\\\"startMs\\\":6960,\\\"endMs\\\":7180},{\\\"text\\\":\\\" with\\\",\\\"startMs\\\":7180,\\\"endMs\\\":7320},{\\\"text\\\":\\\" the\\\",\\\"startMs\\\":7320,\\\"endMs\\\":7420},{\\\"text\\\":\\\" sound\\\",\\\"startMs\\\":7420,\\\"endMs\\\":7760},{\\\"text\\\":\\\" off.\\\",\\\"startMs\\\":7760,\\\"endMs\\\":8300}]\";\n            var SENTENCE_END = /[.!?…][\"')\\]]*$/;\n            function parseCaptions(raw) {\n              var data = raw;\n              if (typeof raw === \"string\") {\n                try { data = JSON.parse(raw); } catch (e) { data = null; }\n              }\n              if (!Array.isArray(data)) return null;\n              var out = [];\n              data.forEach(function (c) {\n                if (!c || typeof c.text !== \"string\") return;\n                var s = c.startMs !== undefined ? Number(c.startMs) : Number(c.start) * 1000;\n                var e = c.endMs !== undefined ? Number(c.endMs) : Number(c.end) * 1000;\n                if (!Number.isFinite(s) || !Number.isFinite(e)) return;\n                out.push({ text: c.text, startMs: s, endMs: Math.max(s, e), speaker: typeof c.speaker === \"string\" ? c.speaker : undefined });\n              });\n              if (!out.length) return null;\n              out.sort(function (a, b) { return a.startMs - b.startMs; });\n              // Words given without leading spaces ({text, start, end} transcripts) become separate words.\n              var spaced = out.some(function (c, i) { return i > 0 && /^\\s/.test(c.text); });\n              if (!spaced) out.forEach(function (c, i) { if (i > 0) c.text = \" \" + c.text; });\n              return out;\n            }\n            function buildWindows(list, combine, hold) {\n              var pages = [], cur = null, prev = null;\n              var silenceBreak = Math.max(hold, 300);\n              list.forEach(function (c, i) {\n                if (cur && /^\\s/.test(c.text)) {\n                  if (prev.breakAfter || c.startMs - cur.startMs >= combine || c.startMs - prev.endMs >= silenceBreak) {\n                    pages.push(cur);\n                    cur = null;\n                  }\n                }\n                if (!cur) cur = { startMs: c.startMs, tokens: [], speaker: c.speaker };\n                cur.tokens.push({ text: c.text, fromMs: c.startMs, toMs: c.endMs });\n                var next = list[i + 1];\n                c.breakAfter = SENTENCE_END.test(c.text.trim()) || (next !== undefined && next.speaker !== c.speaker);\n                prev = c;\n              });\n              if (cur) pages.push(cur);\n              return pages.map(function (p, i) {\n                var speechEnd = p.tokens[p.tokens.length - 1].toMs;\n                var held = speechEnd + Math.max(0, hold);\n                var next = pages[i + 1];\n                var silent = !next || next.startMs > held;\n                return {\n                  tokens: p.tokens, index: i, speaker: p.speaker, startMs: p.startMs, speechEndMs: speechEnd,\n                  endMs: silent ? held : Math.max(p.startMs, next.startMs), endsInSilence: silent\n                };\n              });\n            }\n            function tokenStates(tokens, t) {\n              var active = -1;\n              tokens.forEach(function (k, i) { if (k.fromMs <= t) active = i; });\n              return {\n                activeIndex: active,\n                tokens: tokens.map(function (k, i) {\n                  var p = t < k.fromMs ? 0 : k.toMs <= k.fromMs ? 1 : Math.min(1, (t - k.fromMs) / (k.toMs - k.fromMs));\n                  return {\n                    text: k.text.trim(), spaceBefore: i > 0 && /^\\s/.test(k.text), fromMs: k.fromMs, toMs: k.toMs,\n                    progress: p, status: i < active ? \"spoken\" : i === active ? \"active\" : \"upcoming\"\n                  };\n                })\n              };\n            }\n            function stateAt(windows, t) {\n              var lo = 0, hi = windows.length - 1, found = -1;\n              while (lo <= hi) {\n                var mid = (lo + hi) >> 1;\n                if (windows[mid].startMs <= t) { found = mid; lo = mid + 1; } else hi = mid - 1;\n              }\n              if (found < 0 || t >= windows[found].endMs) return null;\n              var w = windows[found];\n              var ts = tokenStates(w.tokens, t);\n              var before = found > 0 ? windows[found - 1] : null;\n              return {\n                pageIndex: w.index, speaker: w.speaker, timeMs: t, activeIndex: ts.activeIndex, tokens: ts.tokens,\n                sinceStartMs: t - w.startMs, untilEndMs: w.endMs - t, holdRoomMs: w.endMs - w.speechEndMs,\n                endsInSilence: w.endsInSilence,\n                previous: before && !before.endsInSilence\n                  ? { pageIndex: before.index, tokens: tokenStates(before.tokens, before.endMs).tokens }\n                  : null\n              };\n            }\n            function groupWords(tokens) {\n              var words = [];\n              tokens.forEach(function (token, index) {\n                var cur = words[words.length - 1];\n                if (!cur || token.spaceBefore) words.push([{ index: index, token: token }]);\n                else cur.push({ index: index, token: token });\n              });\n              return words;\n            }\n            function normWord(text) {\n              return text.toLowerCase().replace(/[‘’]/g, \"'\").replace(/[^\\p{L}\\p{N}']/gu, \"\");\n            }\n\n            // ---- Easing, springs, colour ----\n            function bezier(x1, y1, x2, y2) {\n              return function (x) {\n                if (x <= 0) return 0;\n                if (x >= 1) return 1;\n                var lo = 0, hi = 1, t = x;\n                for (var i = 0; i < 30; i++) {\n                  var cx = 3 * (1 - t) * (1 - t) * t * x1 + 3 * (1 - t) * t * t * x2 + t * t * t;\n                  if (cx < x) lo = t; else hi = t;\n                  t = (lo + hi) / 2;\n                }\n                return 3 * (1 - t) * (1 - t) * t * y1 + 3 * (1 - t) * t * t * y2 + t * t * t;\n              };\n            }\n            // Clamped linear map of v from [a, b] to [from, to], optionally eased.\n            function ramp(v, a, b, from, to, ease) {\n              var p = b === a ? 1 : (v - a) / (b - a);\n              p = Math.min(1, Math.max(0, p));\n              if (ease) p = ease(p);\n              return from + (to - from) * p;\n            }\n            // Damped spring from 0 to 1 (zero start velocity), sampled at tSec seconds.\n            function spring(tSec, mass, stiffness, damping) {\n              if (tSec <= 0) return 0;\n              var w0 = Math.sqrt(stiffness / mass);\n              var z = damping / (2 * Math.sqrt(stiffness * mass));\n              if (z < 1) {\n                var wd = w0 * Math.sqrt(1 - z * z);\n                return 1 - Math.exp(-z * w0 * tSec) * (Math.cos(wd * tSec) + ((z * w0) / wd) * Math.sin(wd * tSec));\n              }\n              if (z === 1) return 1 - Math.exp(-w0 * tSec) * (1 + w0 * tSec);\n              var q = Math.sqrt(z * z - 1);\n              var r1 = -w0 * (z - q), r2 = -w0 * (z + q);\n              return 1 - (r2 * Math.exp(r1 * tSec) - r1 * Math.exp(r2 * tSec)) / (r2 - r1);\n            }\n            function mixColor(a, b, t) {\n              var pct = Math.round(Math.min(1, Math.max(0, t)) * 10000) / 100;\n              return \"color-mix(in srgb, \" + b + \" \" + pct + \"%, \" + a + \")\";\n            }\n            var SHADOW = \"0 2px 3px rgba(0, 0, 0, 0.5), 0 4px 16px rgba(0, 0, 0, 0.35)\";\n            var enterEase = bezier(0.2, 0.8, 0.2, 1);\n            function mk(tag, parent, css, text) {\n              var e = document.createElement(tag);\n              if (css) e.style.cssText = css;\n              if (text !== undefined) e.textContent = text;\n              parent.appendChild(e);\n              return e;\n            }\n            function exitFactor(s, exitMs) {\n              return s.endsInSilence ? ramp(s.untilEndMs, 0, Math.max(1, Math.min(exitMs, s.holdRoomMs)), 0, 1) : 1;\n            }\n            // The usual fade + small rise on page change, and fade out in the pause after the last word.\n            function stdLine(s, enterMs, exitMs, riseEm) {\n              var enter = ramp(s.previous ? enterMs : s.sinceStartMs, 0, enterMs, 0, 1, enterEase);\n              line.style.opacity = String(Math.min(enter, exitFactor(s, exitMs)));\n              line.style.transform = \"translateY(\" + (1 - enter) * riseEm + \"em)\";\n            }\n            var builtKey = null, refs = null;\n            function ensure(s, build) {\n              var key = s.pageIndex + \":\" + (s.previous ? s.previous.pageIndex : \"-\");\n              if (key !== builtKey) {\n                builtKey = key;\n                line.textC