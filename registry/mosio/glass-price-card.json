  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Glass Price Card\n\nA frosted-glass card rises over a soft neutral backdrop: blur and a thin light border, no neon. The price counts up and settles, then a small badge lands on the corner.\n\nCategory: commerce. Length: 5 s. WebGL: no.\n\nUse when:\n- A package, a bundle or a class fee with one price and a short description.\n- An offer that should feel calm and premium rather than loud.\n\nAvoid when:\n- A sale with an old and a new price: use price-drop.\n- Several priced items: use menu-price-board.\n\nVariables:\n- eyebrow (string): Eyebrow, default \"Paket hemat\"\n- product (string): Product, default \"Nasi Box Ayam Bakar\"\n- detail (string): Detail, default \"Min. 10 box \\u00b7 gratis antar\"\n- price (string): Price, default \"Rp28.000\"\n- unit (string): Unit, default \"/ box\"\n- badge (string): Badge, default \"Hemat 20%\"\n- bg_color (color): Background start, default \"#f5f5f5\"\n- bg2_color (color): Background end, default \"#e5e5e5\"\n- shape_color (color): Shape colour, default \"#ffffff\"\n- glass_color (color): Glass tint, default \"#ffffff\"\n- glass_opacity (number, 0.15-0.9): Glass opacity, default 0.42\n- main_color (color): Main colour, default \"#2563eb\"\n- text_color (color): Text colour, default \"#0a0a0a\"\n- muted_color (color): Muted colour, default \"#52525b\"\n- font_family (string): Font, default \"Geist\"\n- transparent (boolean): Transparent, default false\n\nSource: Mosio original. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Glass Price Card\n\n  A frosted-glass card rises over a soft neutral backdrop: blur and a thin light border, no neon. The price counts up and settles, then a small badge lands on the corner.\n\n  An original usemosio/blocks block (MIT, see LICENSE).\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"glass-price-card\"\n  data-composition-duration=\"5\"\n  data-composition-variables='[\n  {\n    \"id\": \"eyebrow\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Eyebrow\",\n    \"description\": \"Small line above the name.\",\n    \"default\": \"Paket hemat\"\n  },\n  {\n    \"id\": \"product\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Product\",\n    \"description\": \"Name, one or two lines.\",\n    \"default\": \"Nasi Box Ayam Bakar\"\n  },\n  {\n    \"id\": \"detail\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Detail\",\n    \"description\": \"Short muted line under the name.\",\n    \"default\": \"Min. 10 box · gratis antar\"\n  },\n  {\n    \"id\": \"price\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Price\",\n    \"description\": \"Counts up. A prefix such as Rp and dot thousands are kept.\",\n    \"default\": \"Rp28.000\"\n  },\n  {\n    \"id\": \"unit\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Unit\",\n    \"description\": \"Small text after the price. Empty hides it.\",\n    \"default\": \"/ box\"\n  },\n  {\n    \"id\": \"badge\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Badge\",\n    \"description\": \"Pill that lands on the card corner. Empty hides it.\",\n    \"default\": \"Hemat 20%\"\n  },\n  {\n    \"id\": \"bg_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Background start\",\n    \"description\": \"Top of the backdrop gradient.\",\n    \"default\": \"#f5f5f5\"\n  },\n  {\n    \"id\": \"bg2_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Background end\",\n    \"description\": \"Bottom of the backdrop gradient.\",\n    \"default\": \"#e5e5e5\"\n  },\n  {\n    \"id\": \"shape_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Shape colour\",\n    \"description\": \"The solid shapes the glass blurs.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"glass_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Glass tint\",\n    \"description\": \"Card tint (shown at the glass opacity).\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"glass_opacity\",\n    \"type\": \"number\",\n    \"role\": \"style\",\n    \"label\": \"Glass opacity\",\n    \"description\": \"How much of the tint shows over the blur.\",\n    \"default\": 0.42,\n    \"min\": 0.15,\n    \"max\": 0.9,\n    \"step\": 0.01\n  },\n  {\n    \"id\": \"main_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Main colour\",\n    \"description\": \"Badge and price: the one accent.\",\n    \"default\": \"#2563eb\"\n  },\n  {\n    \"id\": \"text_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Text colour\",\n    \"description\": \"Name.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"muted_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Muted colour\",\n    \"description\": \"Eyebrow and detail.\",\n    \"default\": \"#52525b\"\n  },\n  {\n    \"id\": \"font_family\",\n    \"type\": \"string\",\n    \"role\": \"style\",\n    \"label\": \"Font\",\n    \"description\": \"Google Fonts family name; Geist is loaded, others only if the host loads them.\",\n    \"default\": \"Geist\"\n  },\n  {\n    \"id\": \"transparent\",\n    \"type\": \"boolean\",\n    \"role\": \"style\",\n    \"label\": \"Transparent\",\n    \"description\": \"Leave the background clear so the block sits over your own scene.\",\n    \"default\": false\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Glass Price Card</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute; inset: 0; overflow: hidden; container-type: size; pointer-events: none;\n          -webkit-font-smoothing: antialiased;\n          background: var(--gpc-bg); color: var(--gpc-text); font-family: var(--gpc-font);\n        }\n        #root * { box-sizing: border-box; }\n        .gpc-stage { position: absolute; inset: 0; --u: calc(100cqmin / 1080); }\n\n        #root { background: linear-gradient(165deg, var(--gpc-bg), var(--gpc-bg2)); }\n        .gpc-disc { position: absolute; border-radius: 50%; background: var(--gpc-shape); }\n        .gpc-bars { position: absolute; background: var(--gpc-shape); opacity: 0.6; border-radius: calc(var(--u) * 140); }\n        .gpc-card { position: absolute; left: 50%; top: 0; bottom: 0; margin-block: auto; height: fit-content; width: calc(var(--u) * 900); margin-left: calc(var(--u) * -450); padding: calc(var(--u) * 64) calc(var(--u) * 64) calc(var(--u) * 60);\n          border-radius: calc(var(--u) * 56); background: rgba(var(--gpc-glass-rgb), var(--gpc-glass-a)); border: calc(var(--u) * 2) solid rgba(255,255,255,0.7);\n          -webkit-backdrop-filter: blur(calc(var(--u) * 30)) saturate(1.15); backdrop-filter: blur(calc(var(--u) * 30)) saturate(1.15);\n          box-shadow: 0 calc(var(--u) * 30) calc(var(--u) * 80) rgba(10,10,10,0.14); display: flex; flex-direction: column; gap: calc(var(--u) * 10); }\n        .gpc-eyebrow { font-size: calc(var(--u) * 34); font-weight: 500; color: var(--gpc-muted); letter-spacing: 0.02em; }\n        .gpc-name { font-size: calc(var(--u) * 78); font-weight: 600; letter-spacing: -0.04em; line-height: 1.05; }\n        .gpc-detail { font-size: calc(var(--u) * 34); font-weight: 500; color: var(--gpc-muted); }\n        .gpc-rule { height: calc(var(--u) * 2); background: rgba(10,10,10,0.14); margin: calc(var(--u) * 26) 0 calc(var(--u) * 10); transform-origin: 0 50%; }\n        .gpc-row { display: flex; align-items: baseline; gap: calc(var(--u) * 16); }\n        .gpc-price { font-size: calc(var(--u) * 150); font-weight: 600; letter-spacing: -0.05em; line-height: 1.05; color: var(--gpc-main); font-variant-numeric: tabular-nums; white-space: nowrap; }\n        .gpc-unit { font-size: calc(var(--u) * 44); font-weight: 500; color: var(--gpc-muted); white-space: nowrap; }\n        .gpc-badge { position: absolute; right: calc(var(--u) * 44); top: calc(var(--u) * -34); padding: calc(var(--u) * 16) calc(var(--u) * 38); border-radius: calc(var(--u) * 80); background: var(--gpc-main); color: #fff; font-size: calc(var(--u) * 40); font-weight: 600; white-space: nowrap; }\n        @container (aspect-ratio > 1) { .gpc-card { width: calc(var(--u) * 960); margin-left: calc(var(--u) * -480); padding: calc(var(--u) * 56) calc(var(--u) * 64) calc(var(--u) * 52); } .gpc-name { font-size: calc(var(--u) * 72); } .gpc-price { font-size: calc(var(--u) * 140); } }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"glass-price-card\" data-duration=\"5\" data-fps=\"30\">\n        <div id=\"gpc-clip\" class=\"gpc-stage clip\" data-start=\"0\" data-duration=\"5\" data-track-index=\"0\">\n          <div class=\"gpc-disc\" id=\"gpc-disc\"></div><div class=\"gpc-bars\" id=\"gpc-bars\"></div>\n          <div class=\"gpc-card\" id=\"gpc-card\">\n            <span class=\"gpc-eyebrow\" id=\"gpc-eyebrow\"></span><span class=\"gpc-name\" id=\"gpc-name\"></span><span class=\"gpc-detail\" id=\"gpc-detail\"></span>\n            <div class=\"gpc-rule\" id=\"gpc-rule\"></div>\n            <div class=\"gpc-row\"><span class=\"gpc-price\" id=\"gpc-price\"></span><span class=\"gpc-unit\" id=\"gpc-unit\"></span></div>\n            <span class=\"gpc-badge\" id=\"gpc-badge\"></span>\n          </div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() || {} : {};\n            function num(v, d, a, b) { var n = Number(v); return Number.isFinite(n) ? Math.min(b, Math.max(a, n)) : d; }\n            function str(v, d) { return typeof v === \"string\" && v.trim() ? v : d; }\n            function colr(v, d) { return typeof v === \"string\" && v.trim() && window.CSS && CSS.supports(\"color\", v.trim()) ? v.trim() : d; }\n            function bool(v, d) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : d; }\n            function el(tag, cls, parent, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; if (parent) parent.appendChild(e); return e; }\n            function esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\"); }\n            function lines(v, d) { var s = typeof v === \"string\" && v.trim() ? v : d; return s.split(/\\r?\\n/).map(function (l) { return l.trim(); }).filter(Boolean); }\n            function dots(n) { return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"); }\n            function ease(n, a, b) { return Math.min(1, Math.max(0, (n - a) / (b - a))); }\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920, U = Math.min(W, H) / 1080, PORTRAIT = H > W;\n            var PAL = [[\"bg\", \"bg_color\", \"#f5f5f5\"], [\"bg2\", \"bg2_color\", \"#e5e5e5\"], [\"shape\", \"shape_color\", \"#ffffff\"], [\"glass\", \"glass_color\", \"#ffffff\"], [\"main\", \"main_color\", \"#2563eb\"], [\"text\", \"text_color\", \"#0a0a0a\"], [\"muted\", \"muted_color\", \"#52525b\"]];\n            PAL.forEach(function (c) { root.style.setProperty(\"--gpc-\" + c[0], colr(vars[c[1]], c[2])); });\n            root.style.setProperty(\"--gpc-font\", '\"' + str(vars.font_family, \"Geist\") + '\", Geist, system-ui, sans-serif');\n            if (bool(vars.transparent, false)) root.style.background = \"transparent\";\n\n\n            function rgb(c) { var d = document.createElement(\"canvas\").getContext(\"2d\"); d.fillStyle = \"#ffffff\"; d.fillStyle = c; var v = d.fillStyle; var m = /^#([0-9a-f]{6})$/i.exec(v); return m ? [parseInt(m[1].slice(0, 2), 16), parseInt(m[1].slice(2, 4), 16), parseInt(m[1].slice(4, 6), 16)].join(\",\") : \"255,255,255\"; }\n            root.style.setProperty(\"--gpc-glass-rgb\", rgb(colr(vars.glass_color, \"#ffffff\")));\n            root.style.setProperty(\"--gpc-glass-a\", String(num(vars.glass_opacity, 0.42, 0.15, 0.9)));\n            function txt(id, v, d) { var e = document.getElementById(id); var t = typeof v === \"string\" ? v.trim() : d; e.textContent = t; if (!t) e.style.display = \"none\"; return t; }\n            txt(\"gpc-eyebrow\", vars.eyebrow, \"Paket hemat\"); txt(\"gpc-name\", vars.product, \"Nasi Box Ayam Bakar\"); txt(\"gpc-detail\", vars.detail, \"Min. 10 box · gratis antar\");\n            txt(\"gpc-unit\", vars.unit, \"/ box\"); txt(\"gpc-badge\", vars.badge, \"Hemat 20%\");\n            var price = str(vars.price, \"Rp28.000\"), pe = document.getElementById(\"gpc-price\"); pe.textContent = price;\n            var m = /^(\\D*)(\\d[\\d.,]*)(.*)$/.exec(price), value = m ? parseInt(m[2].replace(/[.,]/g, \"\"), 10) : NaN;\n            var step = value >= 10000 ? 1000 : value >= 1000 ? 100 : 1, ctr = { v: 0 };\n            function show(v) { pe.textContent = !m || v >= value ? price : m[1] + dots(Math.round(v / step) * step) + m[3]; }\n            var d = document.getElementById(\"gpc-disc\"), b = document.getElementById(\"gpc-bars\"), dd = (PORTRAIT ? 980 : 800) * U;\n            d.style.width = d.style.height = dd + \"px\"; d.style.left = (PORTRAIT ? W * 0.5 - dd * 1.0 : W * 0.5 - dd * 1.5) + \"px\"; d.style.top = (PORTRAIT ? H * 0.5 - dd * 1.2 : H * 0.5 - dd * 1.0) + \"px\";\n            var bw = (PORTRAIT ? 640 : 640) * U, bh = (PORTRAIT ? 640 : 640) * U;\n            b.style.width = bw + \"px\"; b.style.height = bh + \"px\"; b.style.left = (W * 0.5 + (PORTRAIT ? 200 : 380) * U) + \"px\"; b.style.top = (H * 0.5 + (PORTRAIT ? 190 : 60) * U) + \"px\";\n            var tl = gsap.timeline({ paused: true });\n            tl.fromTo(\"#gpc-disc\", { opacity: 0, scale: 0.85 }, { opacity: 0.9, scale: 1, duration: 0.8, ease: \"power3.out\" }, 0);\n            tl.fromTo(\"#gpc-bars\", { opacity: 0, x: 40 * U }, { opacity: 0.6, x: 0, duration: 0.8, ease: \"power3.out\" }, 0.1);\n            tl.to(\"#gpc-disc\", { y: 40 * U, duration: 5, ease: \"none\" }, 0);\n            tl.fromTo(\"#gpc-card\", { y: 150 * U, opacity: 0, scale: 0.95 }, { y: 0, opacity: 1, scale: 1, duration: 0.9, ease: \"expo.out\" }, 0.3);\n            tl.fromTo(\"#gpc-rule\", { scaleX: 0 }, { scaleX: 1, duration: 0.6, ease: \"power2.inOut\" }, 1.0);\n            tl.fromTo(\"#gpc-price\", { opacity: 0.3 }, { opacity: 1, duration: 0.3, ease: \"power2.out\" }, 1.2);\n            tl.fromTo(ctr, { v: 0 }, { v: value || 0, duration: 1.1, ease: \"power2.out\", onUpdate: function () { show(ctr.v); } }, 1.2);\n            tl.fromTo(\"#gpc-badge\", { scale: 0.3, opacity: 0, rotation: -8, transformOrigin: \"100% 50%\" }, { scale: 1, opacity: 1, rotation: 0, duration: 0.5, ease: \"back.out(1.6)\" }, 2.6);\n            show(0);\n\n            var total = parseFloat(root.dataset.duration || \"5\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"glass-price-card\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
