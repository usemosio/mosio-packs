   "content": "<!doctype html>\n<!--\n  Followers Overview\n\n  Follow notifications flip through in 3D, one name at a time, then the total follower count blurs in with a spring pop, the account handle and a confetti burst.\n\n  Adapted as an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/x-followers-overview/index.tsx\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/confetti/index.tsx\n  The motion follows the sources (3D name flip on a fixed cadence, blur-in total with a spring overshoot, seeded confetti). The look was made generic: no product name, logo, verified-badge shape or signature blue; names, times, handle, label and accent are variables and the avatar is an initial disc.\n\n  MIT License\n\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"followers-overview\"\n  data-composition-duration=\"12\"\n  data-composition-variables='[\n    {\"id\": \"notifications\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Notifications\", \"description\": \"Semicolon-separated entries \\\"Name|time|v\\\"; add |v to show a check mark after the name.\", \"default\": \"Maya Lindqvist|7h|v; Jonas Reyes|7h|v; marcus|8h; Lena Okoro|9h|v; dev_jay|10h; Priya Nair|11h|v; Tomas Brandt|13h|v; hana.k|15h; Will Archer|18h|v; Yuki Mori|21h|v; benoit|23h; Amara Diallo|1d|v; Leo Martins|1d|v; sol|2d\"},\n    {\"id\": \"event_text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Event text\", \"description\": \"Text after the name; the entry&#39;s time follows it.\", \"default\": \"followed you\"},\n    {\"id\": \"total\", \"type\": \"number\", \"role\": \"content\", \"label\": \"Total\", \"description\": \"Follower total revealed at the end.\", \"default\": 1709, \"min\": 0, \"max\": 999999999, \"step\": 1},\n    {\"id\": \"label\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Count label\", \"description\": \"Word next to the total.\", \"default\": \"Followers\"},\n    {\"id\": \"handle\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Handle\", \"description\": \"Account handle shown above the total (an @ is added). Leave empty to hide the account.\", \"default\": \"studio\"},\n    {\"id\": \"orientation\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Orientation\", \"description\": \"Auto follows the host&#39;s shape.\", \"default\": \"auto\", \"options\": [\n    {\"value\": \"auto\", \"label\": \"Auto\"},\n    {\"value\": \"horizontal\", \"label\": \"Horizontal\"},\n    {\"value\": \"vertical\", \"label\": \"Vertical\"}\n  ]},\n    {\"id\": \"accent_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent\", \"description\": \"Colour of the check marks and the first confetti colour.\", \"default\": \"#6366f1\"},\n    {\"id\": \"theme\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Theme\", \"description\": \"Light or dark neutral theme.\", \"default\": \"light\", \"options\": [\n    {\"value\": \"light\", \"label\": \"Light\"},\n    {\"value\": \"dark\", \"label\": \"Dark\"}\n  ]},\n    {\"id\": \"transparent\", \"type\": \"boolean\", \"role\": \"style\", \"label\": \"Transparent\", \"description\": \"Leave the background clear so the scene sits over your own footage.\", \"default\": false},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier; above 1 the scene plays faster and holds the end.\", \"default\": 1, \"min\": 0.25, \"max\": 4, \"step\": 0.05}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Followers Overview</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute; inset: 0; overflow: hidden; container-type: size; pointer-events: none;\n          background: var(--fo-bg, #fff); color: var(--fo-fg, #14171c);\n          font-family: Manrope, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n          -webkit-font-smoothing: antialiased;\n        }\n        #root * { box-sizing: border-box; }\n        .fo-clip { position: absolute; inset: 0; }\n        .fo-stage { position: absolute; left: 50%; top: 50%; transform-origin: 50% 50%; display: flex; align-items: center; justify-content: center; }\n        .fo-band { position: relative; }\n        .fo-layer { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }\n        .fo-notif { gap: 0; }\n        .fo-slot { position: relative; display: inline-flex; }\n        .fo-name { position: absolute; left: 0; right: 0; top: 0; display: flex; align-items: center; justify-content: center; white-space: nowrap; font-weight: 800; color: var(--fo-fg); line-height: 1; transform-origin: center; backface-visibility: hidden; }\n        .fo-spacer { visibility: hidden; display: flex; align-items: center; white-space: nowrap; font-weight: 800; }\n        .fo-suffix { font-weight: 500; color: var(--fo-muted); white-space: nowrap; line-height: 1; }\n        .fo-col { flex-direction: column; }\n        .fo-acct { display: flex; align-items: center; gap: 14px; }\n        .fo-disc { border-radius: 50%; border: 1px solid var(--fo-border); background: var(--fo-border); color: var(--fo-muted); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0; }\n        .fo-handle { font-weight: 700; white-space: nowrap; }\n        .fo-total { display: flex; align-items: baseline; justify-content: center; gap: 18px; }\n        .fo-num { font-weight: 800; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; line-height: 1; }\n        .fo-lab { font-weight: 500; color: var(--fo-muted); line-height: 1; }\n        .fo-conf { position: absolute; border-radius: 2px; top: 0; left: 0; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"followers-overview\" data-duration=\"12\" data-fps=\"30\">\n        <div id=\"fo-clip\" class=\"fo-clip clip\" data-start=\"0\" data-duration=\"12\" data-track-index=\"0\">\n          <div id=\"fo-stage\" class=\"fo-stage\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var stage = document.getElementById(\"fo-stage\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() || {} : {};\n\n            var FPS = 30;\n            function num(v, d, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : d; }\n            function txt(v, d) { return typeof v === \"string\" ? v : d; }\n            function str(v, d) { return typeof v === \"string\" && v.trim() ? v : d; }\n            function colr(v, d) { return typeof v === \"string\" && v.trim() && window.CSS && CSS.supports(\"color\", v.trim()) ? v.trim() : d; }\n            function bool(v, d) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : d; }\n            function clamp(x, a, b) { return Math.min(b, Math.max(a, x)); }\n            function spring(frame, c) {\n              var t = Math.max(0, frame) / FPS, w0 = Math.sqrt(c.stiffness / c.mass), z = c.damping / (2 * Math.sqrt(c.stiffness * c.mass));\n              if (z < 1) { var wd = w0 * Math.sqrt(1 - z * z); return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + (z * w0 / wd) * Math.sin(wd * t)); }\n              if (z === 1) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              var s = w0 * Math.sqrt(z * z - 1), r1 = -z * w0 + s, r2 = -z * w0 - s;\n              return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n            }\n            function el(tag, cls, parent, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; if (parent) parent.appendChild(e); return e; }\n\n            function bez(x1, y1, x2, y2) {\n              return function (x) {\n                if (x <= 0) return 0; if (x >= 1) return 1;\n                var lo = 0, hi = 1, t = x;\n                for (var i = 0; i < 32; i++) {\n                  t = (lo + hi) / 2;\n                  var cx = 3 * (1 - t) * (1 - t) * t * x1 + 3 * (1 - t) * t * t * x2 + t * t * t;\n                  if (cx < x) lo = t; else hi = t;\n                }\n                return 3 * (1 - t) * (1 - t) * t * y1 + 3 * (1 - t) * t * t * y2 + t * t * t;\n              };\n            }\n            var EASE_OUT = bez(0.22, 1, 0.36, 1), EASE_IN = bez(0.64, 0, 0.78, 0);\n            // the source framework-style interpolate on two points, clamped, with an easing.\n            function interp(x, a, b, from, to, ease) { var p = clamp((x - a) / (b - a), 0, 1); if (ease) p = ease(p); return from + (to - from) * p; }\n\n            function mulberry32(seed) { var a = seed >>> 0; return function () { a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n            var items = txt(vars.notifications, \"\").split(\";\").map(function (s) { return s.trim(); }).filter(Boolean).map(function (r) { var p = r.split(\"|\").map(function (x) { return x.trim(); }); return { name: p[0], time: p[1] || \"\", v: p[2] === \"v\" }; }).filter(function (r) { return r.name; });\n            if (!items.length) items = [{ name: \"Maya Lindqvist\", time: \"7h\", v: true }, { name: \"Jonas Reyes\", time: \"7h\", v: true }, { name: \"marcus\", time: \"8h\", v: false }, { name: \"Lena Okoro\", time: \"9h\", v: true }, { name: \"dev_jay\", time: \"10h\", v: false }, { name: \"Priya Nair\", time: \"11h\", v: true }];\n            var count = items.length;\n            var eventText = txt(vars.event_text, \"followed you\").trim();\n            var total = Math.round(num(vars.total, 1709, 0, 999999999));\n            var label = txt(vars.label, \"Followers\").trim();\n            var handle = txt(vars.handle, \"studio\").trim();\n            var accent = colr(vars.accent_color, \"#6366f1\");\n            var dark = String(vars.theme) === \"dark\";\n            var speed = num(vars.speed, 1, 0.25, 4);\n            var T = dark ? { bg: \"#0b0c0e\", fg: \"#ececef\", muted: \"#8b8f98\", border: \"#2a2d33\" } : { bg: \"#ffffff\", fg: \"#14171c\", muted: \"#5b6470\", border: \"#eceff2\" };\n            Object.keys(T).forEach(function (k) { root.style.setProperty(\"--fo-\" + k, T[k]); });\n            if (bool(vars.transparent, false)) root.style.background = \"transparent\";\n\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920;\n            var o = String(vars.orientation);\n            var vertical = o === \"vertical\" || (o !== \"horizontal\" && H > W);\n            var RW = vertical ? 720 : 1280, RH = vertical ? 1280 : 720, k = Math.min(W / RW, H / RH);\n            stage.style.width = RW + \"px\"; stage.style.height = RH + \"px\";\n            stage.style.marginLeft = -RW / 2 + \"px\"; stage.style.marginTop = -RH / 2 + \"px\";\n            stage.style.transform = \"scale(\" + k + \")\";\n            var nS = vertical ? 38 : 46, numS = vertical ? 92 : 110, labS = vertical ? 40 : 46, persp = vertical ? 1000 : 1200, bandH = vertical ? 160 : 180, lineH = nS * 1.4;\n            var avS = vertical ? 72 : 64, hS = vertical ? 30 : 34;\n\n            var band = el(\"div\", \"fo-band\", stage); band.style.width = RW + \"px\"; band.style.height = bandH + \"px\";\n            var notif = el(\"div\", \"fo-layer fo-notif\", band); notif.style.gap = nS * 0.28 + \"px\";\n            var slot = el(\"div\", \"fo-slot\", notif); slot.style.height = lineH + \"px\"; slot.style.perspective = persp + \"px\";\n            var spacer = el(\"div\", \"fo-spacer\", slot); spacer.style.fontSize = nS + \"px\"; spacer.style.gap = nS * 0.2 + \"px\";\n            function badge(size) { return '<svg viewBox=\"0 0 20 20\" width=\"' + size + '\" height=\"' + size + '\" style=\"flex-shrink:0\"><circle cx=\"10\" cy=\"10\" r=\"10\" fill=\"' + accent + '\"/><path d=\"M5.6 10.4l3 3 5.8-6.4\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>'; }\n            function mkName(it) {\n              var d = el(\"div\", \"fo-name\", slot); d.style.fontSize = nS + \"px\"; d.style.height = lineH + \"px\"; d.style.gap = nS * 0.2 + \"px\";\n              el(\"span\", \"\", d).textContent = it.name; if (it.v) d.insertAdjacentHTML(\"beforeend\", badge(nS * 0.66));\n              return d;\n            }\n            var nameEls = items.map(mkName);\n            var suffix = el(\"span\", \"fo-suffix\", notif); suffix.style.fontSize = nS + \"px\";\n\n            var rev = el(\"div\", \"fo-layer fo-col\", band); rev.style.gap = (vertical ? 26 : 22) + \"px\";\n            var acct = el(\"div\", \"fo-acct\", rev), disc = null, hEl = null;\n            if (handle) {\n              disc = el(\"div\", \"fo-disc\", acct); disc.style.width = disc.style.height = avS + \"px\"; disc.style.fontSize = avS * 0.42 + \"px\"; disc.textContent = Array.from(handle)[0].toUpperCase();\n              hEl = el(\"span\", \"fo-handle\", acct); hEl.style.fontSize = hS + \"px\"; hEl.textContent = \"@\" + handle;\n            }\n            var tot = el(\"div\", \"fo-total\", rev);\n            var numEl = el(\"span\", \"fo-num\", tot); numEl.style.fontSize = numS + \"px\"; numEl.textContent = total.toLocaleString(\"en-US\");\n            var labEl = el(\"span\", \"fo-lab\", tot); labEl.style.fontSize = labS + \"px\"; labEl.textContent = label;\n\n            // Confetti: seeded burst from the middle of the frame, 160 pieces.\n            var COLORS = [accent, \"#ff5da2\", \"#ffd23f\", \"#22c55e\", \"#a855f7\"];\n            var rnd = mulberry32(1), parts = [];\n            for (var i = 0; i < 160; i++) {\n              var ang = rnd() * Math.PI * 2, sp = 0.35 + 0.65 * rnd(), col = COLORS[Math.floor(rnd() * COLORS.length)], sz = 0.7 + 0.6 * rnd(), r0 = rnd() * Math.PI * 2, spin = (rnd() - 0.5) * 0.6, drift = (rnd() - 0.5) * 2;\n              var d = el(\"div\", \"fo-conf\", stage); d.style.background = col; d.style.opacity = 0;\n              parts.push({ d: d, ang: ang, sp: sp, sz: sz, r0: r0, spin: spin, drift: drift });\n            }\n\n            var SLOT = 13, HOLD = 0.45, DUR = 360;\n            var revealStart = Math.min(count * SLOT, Math.round(DUR * 0.82));\n            var CONF_LIFE = 90, CONF_POWER = 17, CONF_GRAV = 0.45, CONF_SIZE = 13, sc = RH / 720;\n            function sm(x) { var c = clamp(x, 0, 1); return c * c * (3 - 2 * c); }\n            function draw(fc) {\n              var pos = fc / SLOT, idx = clamp(Math.floor(pos), 0, count - 1), frac = clamp(pos - idx, 0, 1);\n              var fp = HOLD >= 1 ? 0 : sm((frac - HOLD) / (1 - HOLD));\n              var hasNext = idx + 1 < count;\n              var cur = items[idx], active = hasNext && fp >= 0.5 ? items[idx + 1] : cur;\n              nameEls.forEach(function (e, i) {\n                if (i === idx) { e.style.display = \"\"; e.style.transform = \"rotateX(\" + (hasNext ? -90 * fp : 0) + \"deg)\"; e.style.opacity = hasNext ? interp(fp, 0, 0.55, 1, 0) : 1; }\n                else if (hasNext && i === idx + 1) { e.style.display = \"\"; e.style.transform = \"rotateX(\" + 90 * (1 - fp) + \"deg)\"; e.style.opacity = interp(fp, 0.45, 1, 0, 1); }\n                else e.style.display = \"none\";\n              });\n              spacer.innerHTML = '<span></span>' + (active.v ? '<span style=\"width:' + nS * 0.66 + 'px\"></span>' : \"\");\n              spacer.firstChild.textContent = active.name;\n              suffix.textContent = eventText + (active.time ? \" · \" + active.time : \"\");\n              notif.style.opacity = interp(fc, revealStart - 4, revealStart + 8, 1, 0);\n              var cin = interp(fc, revealStart + 4, revealStart + 28, 0, 1);\n              var blur = interp(fc, revealStart + 4, revealStart + 28, 10, 0);\n              var sprv = spring(fc - (revealStart + 2), { damping: 10, stiffness: 170, mass: 0.8 });\n              var rs = 0.5 + 0.5 * sprv;\n              var cs = blur > 0 ? \"blur(\" + blur + \"px)\" : \"none\";\n              tot.style.opacity = cin; tot.style.filter = cs; tot.style.transform = \"translateY(\" + 12 * (1 - cin) + \"px) scale(\" + rs + \")\";\n              if (disc) { disc.style.opacity = cin; disc.style.filter = cs; disc.style.transform = \"translateX(\" + -36 * (1 - cin) + \"px)\"; hEl.style.opacity = cin; hEl.style.filter = cs; hEl.style.transform = \"translateX(\" + 36 * (1 - cin) + \"px)\"; }\n              var tt = fc - (revealStart + 2);\n              var live = tt >= 0 && tt <= CONF_LIFE;\n              var op = !live ? 0 : Math.min(interp(tt, 0, 4, 0, 1), interp(tt, CONF_LIFE * 0.7, CONF_LIFE, 1, 0));\n              parts.forEach(function (p) {\n                if (op <= 0) { p.d.style.opacity = 0; return; }\n                var vx = Math.cos(p.ang) * p.sp * CONF_POWER + p.drift, vy = Math.sin(p.ang) * p.sp * CONF_POWER;\n                var x = RW * 0.5 + vx * tt * sc, y = RH * 0.5 + (vy * tt + 0.5 * CONF_GRAV * tt * tt) * sc;\n                var w = CONF_SIZE * p.sz * sc, fl = Math.cos(p.r0 + p.spin * tt * 1.6);\n                p.d.style.width = w + \"px\"; p.d.style.height = w * 0.62 + \"px\"; p.d.style.opacity = op;\n                p.d.style.transform = \"translate(\" + x + \"px,\" + y + \"px) translate(-50%,-50%) rotate(\" + (p.r0 + p.spin * tt) + \"rad) scale(\" + fl + \",1)\";\n              });\n            }\n\n            var seconds = parseFloat(root.dataset.duration || \"12\");\n            var clock = { f: 0 };\n            var tl = gsap.timeline({ paused: true });\n            tl.to(clock, { f: seconds * FPS * speed, duration: seconds, ease: \"none\", onUpdate: function () { draw(clock.f); } }, 0);\n            draw(0);\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"followers-overview\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
