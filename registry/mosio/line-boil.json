   "role": "source",
   "content": "<!doctype html>\n<!--\n  Line Boil\n\n  A hand-drawn outline draws itself, boils on threes like a cel animation, and fills with color while it keeps boiling. Give it any closed outline as SVG path data in the path variable; it defaults to a five-point star.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/line-boil/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"line-boil\"\n  data-composition-duration=\"3\"\n  data-composition-variables='[\n    {\"id\": \"path\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Path\", \"description\": \"Closed outline as SVG path data, in any coordinate space. It is fitted to the frame.\", \"default\": \"M 100.00 0.00 L 123.51 67.64 L 195.11 69.10 L 138.04 112.36 L 158.78 180.90 L 100.00 140.00 L 41.22 180.90 L 61.96 112.36 L 4.89 69.10 L 76.49 67.64 Z\"},\n    {\"id\": \"boil_every\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Boil every\", \"description\": \"Frames each drawing holds before the next one (3 is on threes).\", \"default\": 3, \"min\": 1, \"max\": 8, \"step\": 1, \"unit\": \"frames\"},\n    {\"id\": \"drawings\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Drawings\", \"description\": \"Distinct drawings the boil cycles through.\", \"default\": 3, \"min\": 1, \"max\": 8, \"step\": 1},\n    {\"id\": \"amplitude\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Wobble\", \"description\": \"Wobble strength; 1 is a gentle hand-drawn boil.\", \"default\": 1, \"min\": 0, \"max\": 3, \"step\": 0.1},\n    {\"id\": \"stroke_width\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Line weight\", \"description\": \"Base line weight in pixels at 720p.\", \"default\": 9, \"min\": 2, \"max\": 24, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Size\", \"description\": \"Shape size as a fraction of the short frame side.\", \"default\": 0.66, \"min\": 0.2, \"max\": 0.9, \"step\": 0.02},\n    {\"id\": \"line\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Line\", \"description\": \"Outline color.\", \"default\": \"#111111\"},\n    {\"id\": \"fill\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Fill\", \"description\": \"Shape fill color.\", \"default\": \"#E5322D\"},\n    {\"id\": \"background\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Background color.\", \"default\": \"#FFFFFF\"},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed.\", \"default\": 1, \"min\": 0.1, \"max\": 4, \"step\": 0.1}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Line Boil</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n        #root { background: #ffffff; }\n        .lb-stage { position: absolute; inset: 0; }\n        .lb-stage svg { display: block; width: 100%; height: 100%; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"line-boil\" data-duration=\"3\" data-fps=\"30\">\n        <div id=\"lb-clip\" class=\"lb-stage clip\" data-start=\"0\" data-duration=\"3\" data-track-index=\"0\">\n          <svg id=\"lb-svg\" role=\"img\" aria-label=\"Boiling hand-drawn outline\">\n            <polygon id=\"lb-fill\" />\n            <g id=\"lb-lines\" stroke-linecap=\"round\" fill=\"none\"></g>\n          </svg>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value.trim() ? value : fallback;\n            }\n            function bool(value, fallback) {\n              if (typeof value === \"boolean\") return value;\n              if (value === \"true\") return true;\n              if (value === \"false\") return false;\n              return fallback;\n            }\n            var FPS = 30;\n            var W = root.clientWidth || 1080;\n            var H = root.clientHeight || 1920;\n\n            // Seeded random in [0, 1): a string hash, so the same key always gives the same value.\n            function rnd(key) {\n              var h = 1779033703 ^ key.length;\n              for (var i = 0; i < key.length; i++) {\n                h = Math.imul(h ^ key.charCodeAt(i), 3432918353);\n                h = (h << 13) | (h >>> 19);\n              }\n              h = Math.imul(h ^ (h >>> 16), 2246822507);\n              h = Math.imul(h ^ (h >>> 13), 3266489909);\n              h ^= h >>> 16;\n              return (h >>> 0) / 4294967296;\n            }\n\n            // Piecewise-linear map of x from inR to outR, optionally eased per segment and clamped.\n            function interp(x, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var i = 0;\n              if (x >= inR[n - 1]) i = n - 2;\n              else if (x > inR[0]) { while (x > inR[i + 1]) i++; }\n              var t = (x - inR[i]) / (inR[i + 1] - inR[i]);\n              if (o.clamp !== false) t = Math.min(1, Math.max(0, t));\n              if (o.easing) t = o.easing(t);\n              return outR[i] + (outR[i + 1] - outR[i]) * t;\n            }\n            function clamp01(t) { return Math.min(1, Math.max(0, t)); }\n\n            // Easings with the usual names; every one maps 0..1 to 0..1.\n            var E = {\n              linear: function (t) { return t; },\n              quad: function (t) { return t * t; },\n              cubic: function (t) { return t * t * t; },\n              sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n              back: function (s) { return function (t) { return t * t * ((s + 1) * t - s); }; },\n              out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n              inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; },\n              bezier: function (x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var k = 0; k < 24; k++) {\n                    var mt = 1 - t;\n                    var bx = 3 * mt * mt * t * x1 + 3 * mt * t * t * x2 + t * t * t;\n                    if (bx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var m = 1 - t;\n                  return 3 * m * m * t * y1 + 3 * m * t * t * y2 + t * t * t;\n                };\n              }\n            };\n\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function el(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n            var tl = gsap.timeline({ paused: true });\n            // Runs draw(frame) from the timeline so seeking to a time always draws the same picture.\n            function drive(frames, draw) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n              draw(0);\n            }\n\n            var pathData = str(vars.path, 'M 100.00 0.00 L 123.51 67.64 L 195.11 69.10 L 138.04 112.36 L 158.78 180.90 L 100.00 140.00 L 41.22 180.90 L 61.96 112.36 L 4.89 69.10 L 76.49 67.64 Z');\n            var boilEvery = Math.max(1, Math.round(num(vars.boil_every, 3, 1, 8)));\n            var drawings = Math.max(1, Math.round(num(vars.drawings, 3, 1, 8)));\n            var amplitude = num(vars.amplitude, 1, 0, 3);\n            var strokeWidth = num(vars.stroke_width, 9, 2, 24);\n            var size = num(vars.size, 0.66, 0.2, 0.9);\n            var lineColor = str(vars.line, \"#111111\");\n            var fillColor = str(vars.fill, \"#E5322D\");\n            var background = str(vars.background, \"#FFFFFF\");\n            var speed = num(vars.speed, 1, 0.1, 4);\n            root.style.background = background;\n\n            var SAMPLES = 160, DRAW_END = 22, FILL_START = 28, FILL_END = 40;\n            var unit = Math.min(W, H) / 720;\n            var svg = document.getElementById(\"lb-svg\");\n            svg.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H);\n            var fillEl = document.getElementById(\"lb-fill\"), linesG = document.getElementById(\"lb-lines\");\n            fillEl.setAttribute(\"fill\", fillColor);\n            linesG.setAttribute(\"stroke\", lineColor);\n\n            // Sample the outline, then fit it to the frame.\n            var measure = el(\"path\", { d: pathData });\n            svg.appendChild(measure);\n            var length = measure.getTotalLength(), raw = [];\n            for (var i = 0; i < SAMPLES; i++) { var q = measure.getPointAtLength((length * i) / SAMPLES); raw.push({ x: q.x, y: q.y }); }\n            svg.removeChild(measure);\n            var minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;\n            raw.forEach(function (p) { minX = Math.min(minX, p.x); minY = Math.min(minY, p.y); maxX = Math.max(maxX, p.x); maxY = Math.max(maxY, p.y); });\n            var bw = maxX - minX, bh = maxY - minY;\n            var scale = (size * Math.min(W, H)) / Math.max(bw, bh, 1e-6);\n            var ox = W / 2 - (bw * scale) / 2, oy = H / 2 - (bh * scale) / 2;\n            var base = raw.map(function (p) { return { x: ox + (p.x - minX) * scale, y: oy + (p.y - minY) * scale }; });\n\n            // Low-frequency integer harmonics keep the closed loop seamless while giving the rubbery wobble of a re-traced cel line.\n            function boil(points, seed, amp) {\n              var harmonics = [2, 4, 9, 15].map(function (k, j) {\n                return { k: k, weight: [1, 0.7, 0.45, 0.3][j], px: rnd(seed + \"-px-\" + k) * Math.PI * 2, py: rnd(seed + \"-py-\" + k) * Math.PI * 2 };\n              });\n              return points.map(function (p, i) {\n                var s = i / points.length, dx = 0, dy = 0;\n                harmonics.forEach(function (h) {\n                  dx += h.weight * Math.sin(Math.PI * 2 * h.k * s + h.px);\n                  dy += h.weight * Math.sin(Math.PI * 2 * h.k * s + h.py);\n                });\n                var nx = rnd(seed + \"-nx-\" + i) - 0.5, ny = rnd(seed + \"-ny-\" + i) - 0.5;\n                return { x: p.x + amp * (dx * 0.6 + nx * 0.14), y: p.y + amp * (dy * 0.6 + ny * 0.14) };\n              });\n            }\n            var amp = amplitude * 6.5 * unit;\n            var cache = {};\n            function drawing(d) {\n              if (!cache[d]) cache[d] = { line: boil(base, \"line-boil-\" + d, amp), fill: boil(base, \"line-boil-fill-\" + d, amp * 1.4), phase: rnd(\"line-boil-pressure-\" + d) * Math.PI * 2 };\n              return cache[d];\n            }\n            var cx = base.reduce(function (sum, p) { return sum + p.x; }, 0) / base.length;\n            var cy = base.reduce(function (sum, p) { return sum + p.y; }, 0) / base.length;\n            var segs = [];\n            for (var n = 0; n < SAMPLES; n++) segs.push(el(\"line\", {}, linesG));\n            var drawEase = E.inOut(E.cubic), fillEase = E.out(E.back(1.6));\n\n            function draw(frame) {\n              var t = frame * speed;\n              var d = Math.floor(t / boilEvery) % drawings;\n              var shape = drawing(d);\n              var prog = interp(t, [0, DRAW_END], [0, 1], { easing: drawEase });\n              var visible = Math.round(prog * SAMPLES);\n              var fill = interp(t, [FILL_START, FILL_END], [0, 1], { easing: fillEase });\n              if (fill > 0) {\n                fillEl.setAttribute(\"points\", shape.fill.map(function (p) { return p.x + \",\" + p.y; }).join(\" \"));\n                fillEl.setAttribute(\"transform\", \"translate(\" + cx + \" \" + cy + \") scale(\" + fill + \") translate(\" + -cx + \" \" + -cy + \")\");\n                fillEl.setAttribute(\"opacity\", 1);\n              } else fillEl.setAttribute(\"opacity\", 0);\n              for (var i = 0; i < SAMPLES; i++) {\n                var seg = segs[i];\n                if (i >= visible) { seg.setAttribute(\"stroke-width\", 0); continue; }\n                var p = shape.line[i], next = shape.line[(i + 1) % SAMPLES], s = i / SAMPLES;\n                var pressure = 0.75 + 0.25 * Math.sin(Math.PI * 2 * 3 * s + shape.phase) + 0.12 * Math.sin(Math.PI * 2 * 7 * s - shape.phase);\n                // Taper the pen in and out while the line is still being drawn.\n                var taper = prog < 1 ? Math.min(1, (visible - i) / 10, (i + 4) / 10) : 1;\n                seg.setAttribute(\"x1\", p.x); seg.setAttribute(\"y1\", p.y);\n                seg.setAttribute(\"x2\", next.x); seg.setAttribute(\"y2\", next.y);\n                seg.setAttribute(\"stroke-width\", strokeWidth * unit * pressure * taper);\n              }\n            }\n            drive(Math.round(parseFloat(root.dataset.duration || \"3\") * FPS), draw);\n\n            var total = parseFloat(root.dataset.duration || \"3\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"line-boil\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
