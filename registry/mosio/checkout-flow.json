 "files": [
  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Checkout Flow\n\nA cursor-driven checkout card: pick the yearly plan, type a card number, accept the terms, pay, and a toast confirms.\n\nCategory: ui-blocks. Length: 10.5 s. WebGL: no.\n\nUse when:\n- Demoing a SaaS payment or upgrade UX end to end with cursor navigation and a toast confirmation.\n- A product video needs a complete purchase journey (plan, card, pay, success) in one scene.\n- Showing the full checkout funnel without assembling the primitives.\n\nAvoid when:\n- You only need a payment form without cursor animation: compose field, input and button.\n- The flow is a multi-step onboarding, not payment: use onboarding-stepper-flow.\n- You need custom timing control over individual steps: orchestrate the primitives.\n\nVariables:\n- title (string): Title, default \"Upgrade your plan\"\n- description (string): Description, default \"Complete your purchase to unlock every feature.\"\n- plans (string): Plans, default \"[{\\\"value\\\": \\\"monthly\\\", \\\"label\\\": \\\"Monthly\\\"}, {\\\"value\\\": \\\"yearly\\\", \\\"label\\\": \\\"Yearly\\\"}]\"\n- card_label (string): Card label, default \"Card number\"\n- card_placeholder (string): Card number, default \"4242 4242 4242 4242\"\n- terms_label (string): Terms label, default \"I accept the terms and conditions\"\n- pay_label (string): Pay label, default \"Pay $49\"\n- toast_title (string): Toast title, default \"Payment successful\"\n- mode (enum): Mode, default \"light\"\n- speed (number, 0.25-4): Speed, default 1\n- transparent (boolean): Transparent, default false\n\nSource: https://github.com/Remocn/remocn. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Checkout Flow\n\n  A cursor-driven checkout card: pick the yearly plan, type a card number, accept the terms, pay, and a toast confirms.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn-ui/checkout-flow/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"checkout-flow\"\n  data-composition-duration=\"10.5\"\n  data-composition-variables='[\n    {\"id\": \"title\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Title\", \"description\": \"Card heading.\", \"default\": \"Upgrade your plan\"},\n    {\"id\": \"description\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Description\", \"description\": \"Line under the heading.\", \"default\": \"Complete your purchase to unlock every feature.\"},\n    {\"id\": \"plans\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Plans\", \"description\": \"JSON array of {\\\"value\\\",\\\"label\\\"}; the cursor picks the second one.\", \"default\": \"[{\\\"value\\\": \\\"monthly\\\", \\\"label\\\": \\\"Monthly\\\"}, {\\\"value\\\": \\\"yearly\\\", \\\"label\\\": \\\"Yearly\\\"}]\"},\n    {\"id\": \"card_label\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Card label\", \"description\": \"Label above the card field.\", \"default\": \"Card number\"},\n    {\"id\": \"card_placeholder\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Card number\", \"description\": \"Placeholder, and the number that types itself.\", \"default\": \"4242 4242 4242 4242\"},\n    {\"id\": \"terms_label\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Terms label\", \"description\": \"Label of the checkbox.\", \"default\": \"I accept the terms and conditions\"},\n    {\"id\": \"pay_label\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Pay label\", \"description\": \"Label of the pay button.\", \"default\": \"Pay $49\"},\n    {\"id\": \"toast_title\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Toast title\", \"description\": \"Heading of the confirmation toast.\", \"default\": \"Payment successful\"},\n    {\"id\": \"mode\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Mode\", \"description\": \"Light or dark neutral theme.\", \"default\": \"light\", \"options\": [{\"value\": \"light\", \"label\": \"Light\"}, {\"value\": \"dark\", \"label\": \"Dark\"}]},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed of the scripted interaction. 2 plays it twice as fast and holds the end.\", \"default\": 1, \"min\": 0.25, \"max\": 4, \"step\": 0.05},\n    {\"id\": \"transparent\", \"type\": \"boolean\", \"role\": \"style\", \"label\": \"Transparent\", \"description\": \"Leave the background clear so the control sits over your own scene.\", \"default\": false}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Checkout Flow</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n/* ui-core / core.css: inline inside the component's <style>, once.\n   No class names on purpose: every element is built by core.js with inline\n   styles, so two blocks can mount in one video without selector clashes.\n   Colours come from CSS variables that core.js sets on #root from the theme. */\n#root {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  container-type: size;\n  pointer-events: none;\n  background: var(--ui-background, #fff);\n  color: var(--ui-foreground, #0a0a0a);\n  font-family: \"Geist\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  -webkit-font-smoothing: antialiased;\n}\n#root * { box-sizing: border-box; }\n        #cof-clip {\n          position: absolute;\n          inset: 0;\n        }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"checkout-flow\" data-duration=\"10.5\" data-fps=\"30\">\n        <div id=\"cof-clip\" class=\"clip\" data-start=\"0\" data-duration=\"10.5\" data-track-index=\"0\"></div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n/* ui-core / core.js: the HTML + GSAP equivalent of remocn-ui's shared core\n   (theme, colour mixing, easings, springs, state timeline, cursor path, stage fit).\n   Inline it at the top of the component's IIFE as `var UI = (function () { ... })();`\n   (this file is already written that way: copy it whole, or drop what you do not use).\n   Everything is a pure function of the frame number; there is no clock in here. */\nvar UI = (function () {\n  \"use strict\";\n  var FPS = 30;\n  var FONT = '\"Geist\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif';\n  var NS = \"http://www.w3.org/2000/svg\";\n\n  /* ---------- numbers ---------- */\n  function clamp01(t) { return t < 0 ? 0 : t > 1 ? 1 : t; }\n  function lerp(a, b, t) { return a + (b - a) * t; }\n  function num(v, d, min, max) {\n    var n = Number(v);\n    return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : d;\n  }\n  function str(v, d) { return typeof v === \"string\" && v.trim() ? v : d; }\n  function oneOf(v, list, d) { return list.indexOf(String(v)) >= 0 ? String(v) : d; }\n  function bool(v, d) { return typeof v === \"boolean\" ? v : v === \"true\" ? true : v === \"false\" ? false : d; }\n  function vars() {\n    return window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() || {} : {};\n  }\n\n  /* ---------- easings (remocn-ui core `easings`) ---------- */\n  var ease = {\n    linear: function (t) { return t; },\n    out: function (t) { return 1 - Math.pow(1 - t, 3); },\n    in: function (t) { return t * t * t; },\n    inOut: function (t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }\n  };\n\n  /* ---------- springs (remocn-ui core `springs`) ----------\n     spring(frame, cfg) is a damped spring going 0 -> 1 from rest, evaluated in closed form\n     (frame in 30 fps frames). Underdamped, critically damped and overdamped cases. */\n  var springs = {\n    snappy: { damping: 18, stiffness: 220, mass: 0.7 },\n    soft: { damping: 14, stiffness: 120, mass: 0.9 },\n    bouncy: { damping: 10, stiffness: 180, mass: 0.8 }\n  };\n  function spring(frame, cfg) {\n    cfg = cfg || springs.snappy;\n    var t = Math.max(0, frame) / FPS;\n    var w0 = Math.sqrt(cfg.stiffness / cfg.mass);\n    var z = cfg.damping / (2 * Math.sqrt(cfg.stiffness * cfg.mass));\n    if (z < 1) {\n      var wd = w0 * Math.sqrt(1 - z * z);\n      return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + (z * w0 / wd) * Math.sin(wd * t));\n    }\n    if (z === 1) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n    var s = w0 * Math.sqrt(z * z - 1), r1 = -z * w0 + s, r2 = -z * w0 - s;\n    return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n  }\n\n  /* ---------- colour (remocn-ui core `mixOklch`) ----------\n     Colours are kept as OKLab + alpha and mixed there (identical to oklch mixing for the\n     neutral greys the theme is made of). parse() reads oklch(L C h / a), #rgb, #rrggbb,\n     rgb()/rgba(); css() turns any colour into an rgba() string. */\n  function lin(c) { c /= 255; return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); }\n  function gam(c) { c = c <= 0.0031308 ? 12.92 * c : 1.055 * Math.pow(Math.max(0, c), 1 / 2.4) - 0.055; return Math.round(255 * Math.min(1, Math.max(0, c))); }\n  function fromRgb(r, g, b, a) {\n    r = lin(r); g = lin(g); b = lin(b);\n    var l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);\n    var m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);\n    var s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);\n    return { L: 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s, a: 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s, b: 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s, alpha: a };\n  }\n  function parse(c) {\n    if (c && typeof c === \"object\") return c;\n    c = String(c || \"\").trim();\n    var m = c.match(/^oklch\\(\\s*([\\d.]+)(%?)\\s+([\\d.]+)\\s+([\\d.]+)(?:deg)?\\s*(?:\\/\\s*([\\d.]+)(%?))?\\s*\\)$/i);\n    if (m) {\n      var L = parseFloat(m[1]) / (m[2] ? 100 : 1), C = parseFloat(m[3]), h = parseFloat(m[4]) * Math.PI / 180;\n      var al = m[5] === undefined ? 1 : parseFloat(m[5]) / (m[6] ? 100 : 1);\n      return { L: L, a: C * Math.cos(h), b: C * Math.sin(h), alpha: al };\n    }\n    m = c.match(/^#([0-9a-f]{3,8})$/i);\n    if (m) {\n      var x = m[1];\n      if (x.length === 3 || x.length === 4) x = x.replace(/./g, \"$&$&\");\n      return fromRgb(parseInt(x.slice(0, 2), 16), parseInt(x.slice(2, 4), 16), parseInt(x.slice(4, 6), 16), x.length === 8 ? parseInt(x.slice(6, 8), 16) / 255 : 1);\n    }\n    m = c.match(/^rgba?\\(\\s*([\\d.]+)[\\s,]+([\\d.]+)[\\s,]+([\\d.]+)(?:[\\s,/]+([\\d.]+)(%?))?\\s*\\)$/i);\n    if (m) return fromRgb(+m[1], +m[2], +m[3], m[4] === undefined ? 1 : parseFloat(m[4]) / (m[5] ? 100 : 1));\n    return fromRgb(0, 0, 0, 1);\n  }\n  function css(c) {\n    var k = parse(c);\n    var l = Math.pow(k.L + 0.3963377774 * k.a + 0.2158037573 * k.b, 3);\n    var m = Math.pow(k.L - 0.1055613458 * k.a - 0.0638541728 * k.b, 3);\n    var s = Math.pow(k.L - 0.0894841775 * k.a - 1.291485548 * k.b, 3);\n    var r = gam(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s);\n    var g = gam(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s);\n    var b = gam(-0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s);\n    return \"rgba(\" + r + \",\" + g + \",\" + b + \",\" + Math.round(k.alpha * 1000) / 1000 + \")\";\n  }\n  function mix(a, b, t) {\n    var p = parse(a), q = parse(b);\n    return css({ L: lerp(p.L, q.L, t), a: lerp(p.a, q.a, t), b: lerp(p.b, q.b, t), alpha: lerp(p.alpha, q.alpha, t) });\n  }\n  function isColor(v) { return typeof v === \"string\" && /^(oklch|rgb|rgba|#)/i.test(v.trim()); }\n\n  /* ---------- theme (remocn-ui core `defaultLightTheme` / `defaultDarkTheme`) ----------\n     theme(mode, primary) returns the token object (stock shadcn neutral); primary, when given\n     (the remocn `primary` prop), replaces `primary` (and the button hover colours follow). */\n  var LIGHT = {\n    background: \"oklch(1 0 0)\", foreground: \"oklch(0.145 0 0)\", card: \"oklch(1 0 0)\", cardForeground: \"oklch(0.145 0 0)\",\n    popover: \"oklch(1 0 0)\", popoverForeground: \"oklch(0.145 0 0)\", primary: \"oklch(0.205 0 0)\", primaryForeground: \"oklch(0.985 0 0)\",\n    secondary: \"oklch(0.97 0 0)\", secondaryForeground: \"oklch(0.205 0 0)\", muted: \"oklch(0.97 0 0)\", mutedForeground: \"oklch(0.556 0 0)\",\n    accent: \"oklch(0.97 0 0)\", accentForeground: \"oklch(0.205 0 0)\", destructive: \"oklch(0.577 0.245 27.325)\",\n    destructiveForeground: \"oklch(0.985 0 0)\", border: \"oklch(0.922 0 0)\", input: \"oklch(0.922 0 0)\", ring: \"oklch(0.708 0 0)\", radius: 10\n  };\n  var DARK = {\n    background: \"oklch(0.145 0 0)\", foreground: \"oklch(0.985 0 0)\", card: \"oklch(0.205 0 0)\", cardForeground: \"oklch(0.985 0 0)\",\n    popover: \"oklch(0.205 0 0)\", popoverForeground: \"oklch(0.985 0 0)\", primary: \"oklch(0.922 0 0)\", primaryForeground: \"oklch(0.205 0 0)\",\n    secondary: \"oklch(0.269 0 0)\", secondaryForeground: \"oklch(0.985 0 0)\", muted: \"oklch(0.269 0 0)\", mutedForeground: \"oklch(0.708 0 0)\",\n    accent: \"oklch(0.269 0 0)\", accentForeground: \"oklch(0.985 0 0)\", destructive: \"oklch(0.704 0.191 22.216)\",\n    destructiveForeground: \"oklch(0.985 0 0)\", border: \"oklch(1 0 0 / 10%)\", input: \"oklch(1 0 0 / 15%)\", ring: \"oklch(0.556 0 0)\", radius: 10\n  };\n  function theme(mode, primary) {\n    var t = {}, base = mode === \"dark\" ? DARK : LIGHT;\n    Object.keys(base).forEach(function (k) { t[k] = base[k]; });\n    if (primary && isColor(primary)) {\n      t.primary = primary;\n      // A light primary (dark mode) needs dark text on it, a dark one needs light text.\n      t.primaryForeground = parse(primary).L > 0.6 ? LIGHT.primary : LIGHT.primaryForeground;\n    }\n    return t;\n  }\n  /* boot(root, vars): reads the shared variables `mode` (light | dark), `primary`, `transparent`,\n     `speed`, paints the background, exposes the tokens as --ui-<name> on #root, returns {theme, speed, mode}. */\n  function boot(root, v) {\n    var mode = oneOf(v.mode, [\"light\", \"dark\"], \"light\");\n    var th = theme(mode, str(v.primary, \"\"));\n    Object.keys(th).forEach(function (k) {\n      if (k === \"radius\") return;\n      root.style.setProperty(\"--ui-\" + k.replace(/[A-Z]/g, function (c) { return \"-\" + c.toLowerCase(); }), css(th[k]));\n    });\n    if (bool(v.transparent, false)) root.style.background = \"transparent\";\n    return { theme: th, mode: mode, speed: num(v.speed, 1, 0.1, 4) };\n  }\n\n  /* ---------- state timeline (remocn-ui core `useStateTransition`) ----------\n     steps: [{at, state, duration?}] in 30 fps frames (authored, before `speed`).\n     Returns {from, to, progress}: `to` is the latest started step (ties: the later entry),\n     `from` the one before it (else the default state), progress ramps 0..1 over `duration`. */\n  function stateAt(steps, f, def, dd) {\n    var order = steps.map(function (s, i) { return { s: s, i: i }; }).sort(function (a, b) { return a.s.at - b.s.at || a.i - b.i; });\n    var idx = -1;\n    for (var i = 0; i < order.length; i++) if (order[i].s.at <= f) idx = i;\n    if (idx < 0) return { from: def, to: def, progress: 1 };\n    var to = order[idx].s, from = idx > 0 ? order[idx - 1].s.state : def;\n    var dur = to.duration === undefined ? dd : to.duration;\n    return { from: from, to: to.state, progress: dur <= 0 ? 1 : clamp01((f - to.at) / dur) };\n  }\n  /* tween(a, b, t): blends two style objects (the \"<Name>Style\" of remocn): numbers lerp,\n     colour strings mix, everything else switches at the end. */\n  function tween(a, b, t) {\n    var o = {};\n    Object.keys(b).forEach(function (k) {\n      var x = a[k], y = b[k];\n      o[k] = typeof y === \"number\" && typeof x === \"number\" ? lerp(x, y, t) : isColor(y) && isColor(x) ? mix(x, y, t) : t >= 1 ? y : x;\n    });\n    return o;\n  }\n  /* styleAt(preset, steps, f, def, dd): the whole `use<Name>Transition` in one call.\n     preset(state) must return the COMPLETE style of that state. Eased with easings.out like remocn. */\n  function styleAt(preset, steps, f, def, dd, easeFn) {\n    var r = stateAt(steps, f, def, dd);\n    return tween(preset(r.from), preset(r.to), (easeFn || ease.out)(r.progress));\n  }\n\n  /* ---------- DOM h