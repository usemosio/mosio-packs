  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Word Push\n\nWords drive in from the right and push the line left into its new center.\n\nCategory: typography. Length: 3 s. WebGL: no.\n\nUse when:\n- A single tagline or closing phrase should build word by word with physical, push-driven motion.\n- The first word glides in to center and is shoved left as each next word arrives from the right.\n\nAvoid when:\n- Several phrases must play in sequence with cuts: use word-stream.\n- You want a calm, driftless word-by-word entrance: use per-word-crossfade.\n\nVariables:\n- text (string): Text, default \"move at your own pace\"\n- word_gap (number, 3-30): Word gap, default 10\n- accel (number, 0.5-1): Acceleration, default 0.8\n- font_size (number, 12-160): Font size, default 72\n- color (color): Color, default \"#171717\"\n- font_weight (enum): Font weight, default \"400\"\n\nSource: https://github.com/Remocn/remocn. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Word Push\n\n  Words drive in from the right and push the line left into its new center.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/word-push/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"word-push\"\n  data-composition-duration=\"3\"\n  data-composition-variables='[\n    { \"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Text\", \"description\": \"A single phrase that builds word by word.\", \"default\": \"move at your own pace\" },\n    { \"id\": \"word_gap\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Word gap\", \"description\": \"Frames before the second word arrives (30 fps).\", \"default\": 10, \"min\": 3, \"max\": 30, \"step\": 1, \"unit\": \"frames\" },\n    { \"id\": \"accel\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Acceleration\", \"description\": \"Each gap is this fraction of the previous one: below 1 the words speed up.\", \"default\": 0.8, \"min\": 0.5, \"max\": 1, \"step\": 0.05 },\n    { \"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Maximum text size in pixels. Longer text shrinks to fit the frame.\", \"default\": 72, \"min\": 12, \"max\": 160, \"step\": 1, \"unit\": \"px\" },\n    { \"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Color\", \"description\": \"Text color.\", \"default\": \"#171717\" },\n    { \"id\": \"font_weight\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Font weight\", \"description\": \"Weight of the text.\", \"default\": \"400\", \"options\": [{\"value\": \"400\", \"label\": \"Regular\"}, {\"value\": \"500\", \"label\": \"Medium\"}, {\"value\": \"600\", \"label\": \"Semibold\"}, {\"value\": \"700\", \"label\": \"Bold\"}] }\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Word Push</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          color: var(--color, #171717);\n          font-family: var(--font-display, Geist, system-ui, sans-serif);\n          pointer-events: none;\n        }\n        .wpu-stage {\n          position: absolute;\n          inset: 0;\n          display: flex;\n          align-items: center;\n          justify-content: center;\n        }\n        .wpu-shift { display: flex; align-items: center; justify-content: center; white-space: nowrap; }\n        .wpu-line { letter-spacing: -0.02em; line-height: 1.1; white-space: nowrap; }\n        .wpu-word { display: inline-block; white-space: pre; opacity: 0; margin-right: 0.22em; }\n        .wpu-word:last-child { margin-right: 0; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"word-push\" data-duration=\"3\" data-fps=\"30\">\n        <div id=\"wpu-clip\" class=\"wpu-stage clip\" data-start=\"0\" data-duration=\"3\" data-track-index=\"0\">\n          <div id=\"wpu-shift\" class=\"wpu-shift\"><span id=\"wpu-line\" class=\"wpu-line\"></span></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/CustomEase.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value.trim() ? value : fallback;\n            }\n            function pick(value, list, fallback) {\n              return list.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            gsap.registerPlugin(CustomEase);\n            function bz(id, a, b, c, d) {\n              return CustomEase.create(\"wpu-\" + id, \"M0,0 C\" + a + \",\" + b + \" \" + c + \",\" + d + \" 1,1\");\n            }\n            // interpolate(frame, [a, b], [from, to], { easing }) as a tween (frames at 30 fps).\n            function tw(tl, el, from, to, a, b, ease, keep) {\n              var t = Object.assign({}, to, { duration: (b - a) / 30, ease: ease || \"none\", immediateRender: !keep });\n              tl.fromTo(el, from, t, a / 30);\n            }\n            // Shrink an element's font size so it fits a fraction of the frame width.\n            function fit(el, size, frac) {\n              el.style.fontSize = size + \"px\";\n              var maxWidth = Math.max(1, root.clientWidth * frac);\n              if (el.scrollWidth > maxWidth) {\n                size = Math.max(12, size * (maxWidth / el.scrollWidth));\n                el.style.fontSize = size + \"px\";\n              }\n              return size;\n            }\n            var TOTAL = parseFloat(root.dataset.duration || \"3\");\n            function finish(tl) {\n              if (tl.duration() < TOTAL) tl.to({}, { duration: TOTAL - tl.duration() });\n              tl.seek(0);\n              window.__timelines = window.__timelines || {};\n              window.__timelines[\"word-push\"] = tl;\n            }\n            var text = str(vars.text, \"move at your own pace\");\n            var weight = pick(vars.font_weight, [\"400\", \"500\", \"600\", \"700\"], \"400\");\n            if (typeof vars.color === \"string\" && vars.color) root.style.setProperty(\"--color\", vars.color);\n            // interpolate() with clamping, easing given as a function of progress.\n            function ip(f, a, b, from, to, ease) {\n              var p = b === a ? 1 : Math.min(1, Math.max(0, (f - a) / (b - a)));\n              return from + (to - from) * (ease ? ease(p) : p);\n            }\n\n            var gap = num(vars.word_gap, 10, 3, 30);\n            var accel = num(vars.accel, 0.8, 0.5, 1);\n            var line = document.getElementById(\"wpu-line\");\n            var shift = document.getElementById(\"wpu-shift\");\n            line.style.fontWeight = weight;\n            var list = text.trim().split(/\\s+/).filter(Boolean);\n            var spans = list.map(function (w, j) {\n              var s = document.createElement(\"span\");\n              s.id = \"wpu-word-\" + j;\n              s.className = \"wpu-word\";\n              s.textContent = w;\n              line.appendChild(s);\n              return s;\n            });\n            var size = fit(line, num(vars.font_size, 72, 12, 160), 0.8);\n\n            var REVEAL = 2, SLIDE = 12, OVER = 0.5;\n            function revealFrame(i) {\n              return accel === 1 ? i * gap : (gap * (1 - Math.pow(accel, i))) / (1 - accel);\n            }\n            var push = bz(\"push\", 0.215, 0.61, 0.355, 1);\n            var drive = bz(\"drive\", 0.15, 0.7, 0.25, 1);\n            var tl = gsap.timeline({ paused: true });\n            spans.forEach(function (s, j) {\n              var at = revealFrame(j);\n              tw(tl, s, { opacity: 0 }, { opacity: 1 }, at, at + REVEAL);\n              if (j > 0) tw(tl, s, { x: OVER * size }, { x: 0 }, at, at + SLIDE, drive);\n              else s.style.opacity = 0;\n            });\n            // The whole line starts left of center, then is nudged half a word width at each arrival.\n            var P = { f: 0 };\n            function apply() {\n              var f = P.f;\n              var x = ip(f, 0, SLIDE, -OVER * size, 0, drive);\n              for (var j = 1; j < list.length; j++) {\n                var wordWidth = (list[j].length * 0.5 + 0.22) * size;\n                var at = revealFrame(j);\n                x += (wordWidth / 2) * (1 - ip(f, at + 1, at + 1 + SLIDE, 0, 1, push));\n              }\n              shift.style.transform = \"translate(\" + x + \"px, 0)\";\n            }\n            apply();\n            tl.to(P, { f: TOTAL * 30, duration: TOTAL, ease: \"none\", onUpdate: apply }, 0);\n            finish(tl);\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
