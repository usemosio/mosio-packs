 "files": [
  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Stat Trio\n\nThree stats count up side by side (stacked in a vertical frame), staggered, each with its label and an accent underline that draws in beneath it. Values like 1.200+, 4,9 or 98% keep their prefix, suffix and decimals while they count.\n\nCategory: commerce. Length: 5 s. WebGL: no.\n\nUse when:\n- Social proof in three numbers: customers, rating, repeat orders.\n- A small shop's milestones at a glance.\n\nAvoid when:\n- One hero number with a chart: use stat-count-up-bars.\n- More than three numbers.\n\nVariables:\n- title (string): Title, default \"Toko kami dalam angka\"\n- stats (string): Stats, default \"1.200+|Pelanggan setia\\n4,9|Rating dari 860 ulasan\\n98%|Pesanan datang tepat waktu\"\n- bg_color (color): Background, default \"#ffffff\"\n- main_color (color): Main colour, default \"#2563eb\"\n- text_color (color): Text colour, default \"#0a0a0a\"\n- muted_color (color): Muted colour, default \"#737373\"\n- font_family (string): Font, default \"Geist\"\n- transparent (boolean): Transparent, default false\n\nSource: Mosio original. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Stat Trio\n\n  Three stats count up side by side (stacked in a vertical frame), staggered, each with its label and an accent underline that draws in beneath it. Values like 1.200+, 4,9 or 98% keep their prefix, suffix and decimals while they count.\n\n  An original usemosio/blocks block (MIT, see LICENSE).\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"stat-trio\"\n  data-composition-duration=\"5\"\n  data-composition-variables='[\n  {\n    \"id\": \"title\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Title\",\n    \"description\": \"Line above the stats. Empty hides it.\",\n    \"default\": \"Toko kami dalam angka\"\n  },\n  {\n    \"id\": \"stats\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Stats\",\n    \"description\": \"Three lines, Value|Label. Dots are thousands and a comma is a decimal: 1.200+ or 4,9.\",\n    \"default\": \"1.200+|Pelanggan setia\\n4,9|Rating dari 860 ulasan\\n98%|Pesanan datang tepat waktu\"\n  },\n  {\n    \"id\": \"bg_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Background\",\n    \"description\": \"Background.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"main_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Main colour\",\n    \"description\": \"The three underlines: the one accent.\",\n    \"default\": \"#2563eb\"\n  },\n  {\n    \"id\": \"text_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Text colour\",\n    \"description\": \"Numbers and title.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"muted_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Muted colour\",\n    \"description\": \"Labels.\",\n    \"default\": \"#737373\"\n  },\n  {\n    \"id\": \"font_family\",\n    \"type\": \"string\",\n    \"role\": \"style\",\n    \"label\": \"Font\",\n    \"description\": \"Google Fonts family name; Geist is loaded, others only if the host loads them.\",\n    \"default\": \"Geist\"\n  },\n  {\n    \"id\": \"transparent\",\n    \"type\": \"boolean\",\n    \"role\": \"style\",\n    \"label\": \"Transparent\",\n    \"description\": \"Leave the background clear so the block sits over your own scene.\",\n    \"default\": false\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Stat Trio</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute; inset: 0; overflow: hidden; container-type: size; pointer-events: none;\n          -webkit-font-smoothing: antialiased;\n          background: var(--stt-bg); color: var(--stt-text); font-family: var(--stt-font);\n        }\n        #root * { box-sizing: border-box; }\n        .stt-stage { position: absolute; inset: 0; --u: calc(100cqmin / 1080); }\n\n        .stt-title { position: absolute; left: 0; right: 0; text-align: center; font-weight: 500; color: var(--stt-muted); white-space: nowrap; letter-spacing: -0.01em; }\n        .stt-wrap { position: absolute; display: flex; }\n        .stt-item { flex: 1 1 0; display: flex; flex-direction: column; justify-content: center; min-width: 0; }\n        .stt-num { font-weight: 600; letter-spacing: -0.06em; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }\n        .stt-lab { font-weight: 500; color: var(--stt-muted); letter-spacing: -0.01em; }\n        .stt-line { height: calc(var(--u) * 6); border-radius: calc(var(--u) * 3); background: var(--stt-main); transform-origin: 0 50%; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"stat-trio\" data-duration=\"5\" data-fps=\"30\">\n        <div id=\"stt-clip\" class=\"stt-stage clip\" data-start=\"0\" data-duration=\"5\" data-track-index=\"0\">\n          <div class=\"stt-title\" id=\"stt-title\"></div><div class=\"stt-wrap\" id=\"stt-wrap\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() || {} : {};\n            function num(v, d, a, b) { var n = Number(v); return Number.isFinite(n) ? Math.min(b, Math.max(a, n)) : d; }\n            function str(v, d) { return typeof v === \"string\" && v.trim() ? v : d; }\n            function colr(v, d) { return typeof v === \"string\" && v.trim() && window.CSS && CSS.supports(\"color\", v.trim()) ? v.trim() : d; }\n            function bool(v, d) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : d; }\n            function el(tag, cls, parent, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; if (parent) parent.appendChild(e); return e; }\n            function esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\"); }\n            function lines(v, d) { var s = typeof v === \"string\" && v.trim() ? v : d; return s.split(/\\r?\\n/).map(function (l) { return l.trim(); }).filter(Boolean); }\n            function dots(n) { return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"); }\n            function ease(n, a, b) { return Math.min(1, Math.max(0, (n - a) / (b - a))); }\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920, U = Math.min(W, H) / 1080, PORTRAIT = H > W;\n            var PAL = [[\"bg\", \"bg_color\", \"#ffffff\"], [\"main\", \"main_color\", \"#2563eb\"], [\"text\", \"text_color\", \"#0a0a0a\"], [\"muted\", \"muted_color\", \"#737373\"]];\n            PAL.forEach(function (c) { root.style.setProperty(\"--stt-\" + c[0], colr(vars[c[1]], c[2])); });\n            root.style.setProperty(\"--stt-font\", '\"' + str(vars.font_family, \"Geist\") + '\", Geist, system-ui, sans-serif');\n            if (bool(vars.transparent, false)) root.style.background = \"transparent\";\n\n\n            var raw = lines(vars.stats, \"1.200+|Pelanggan setia\\n4,9|Rating dari 860 ulasan\\n98%|Pesanan datang tepat waktu\").slice(0, 3);\n            var tt = typeof vars.title === \"string\" ? vars.title.trim() : \"Toko kami dalam angka\";\n            var te = document.getElementById(\"stt-title\"); te.textContent = tt; te.style.fontSize = (PORTRAIT ? 48 : 44) * U + \"px\"; te.style.top = (PORTRAIT ? 150 : 90) * U + \"px\";\n            var wrap = document.getElementById(\"stt-wrap\"), mx = (PORTRAIT ? 100 : 110) * U;\n            wrap.style.left = mx + \"px\"; wrap.style.right = mx + \"px\"; wrap.style.top = (tt ? (PORTRAIT ? 300 : 230) : (PORTRAIT ? 160 : 100)) * U + \"px\"; wrap.style.bottom = (PORTRAIT ? 160 : 140) * U + \"px\";\n            wrap.style.flexDirection = PORTRAIT ? \"column\" : \"row\"; wrap.style.gap = (PORTRAIT ? 40 : 70) * U + \"px\";\n            function fmt(v, dec) { var neg = v < 0, s = Math.abs(v).toFixed(dec), a = s.split(\".\"), i = a[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"); return (neg ? \"-\" : \"\") + i + (dec ? \",\" + a[1] : \"\"); }\n            var tl = gsap.timeline({ paused: true }), ns = (PORTRAIT ? 250 : 240) * U, itemW = PORTRAIT ? W - 2 * mx : (W - 2 * mx - 140 * U) / 3;\n            if (!PORTRAIT) { wrap.style.alignItems = \"flex-start\"; wrap.style.paddingTop = 120 * U + \"px\"; }\n            tl.fromTo(\"#stt-title\", { opacity: 0, y: -16 * U }, { opacity: 1, y: 0, duration: 0.5, ease: \"power3.out\" }, 0.1);\n            raw.forEach(function (l, i) {\n              var a = l.split(\"|\"), val = (a[0] || \"\").trim(), label = (a[1] || \"\").trim();\n              var mt = /^(\\D*?)(\\d[\\d.,]*)(.*)$/.exec(val), pre = mt ? mt[1] : \"\", suf = mt ? mt[3] : \"\", tok = mt ? mt[2] : \"\", dec = 0, value = NaN;\n              if (mt) { if (/,\\d{1,2}$/.test(tok)) { dec = tok.length - tok.lastIndexOf(\",\") - 1; value = parseFloat(tok.replace(/\\./g, \"\").replace(\",\", \".\")); } else value = parseInt(tok.replace(/[.,]/g, \"\"), 10); }\n              var it = el(\"div\", \"stt-item\", wrap), num_ = el(\"div\", \"stt-num\", it, esc(val)), lab = el(\"div\", \"stt-lab\", it, esc(label)), ln = el(\"div\", \"stt-line\", it);\n              num_.style.fontSize = Math.min(ns, itemW / Math.max(2.2, val.length * 0.54)) + \"px\"; lab.style.fontSize = (PORTRAIT ? 44 : 42) * U + \"px\";\n              if (!PORTRAIT) lab.style.minHeight = 2.5 * 42 * U + \"px\";\n              lab.style.margin = (PORTRAIT ? 18 : 22) * U + \"px 0 \" + (PORTRAIT ? 22 : 26) * U + \"px\";\n              var c = { v: 0 }, show = function (v) { num_.textContent = isNaN(value) || v >= value ? val : pre + fmt(v, dec) + suf; };\n              var t0 = 0.5 + i * 0.3;\n              tl.fromTo(num_, { opacity: 0, y: 30 * U }, { opacity: 1, y: 0, duration: 0.5, ease: \"power3.out\" }, t0);\n              tl.fromTo(c, { v: 0 }, { v: isNaN(value) ? 0 : value, duration: 1.3, ease: \"power2.out\", onUpdate: function () { show(c.v); } }, t0);\n              tl.fromTo(lab, { opacity: 0, y: 18 * U }, { opacity: 1, y: 0, duration: 0.45, ease: \"power3.out\" }, t0 + 0.25);\n              tl.fromTo(ln, { scaleX: 0 }, { scaleX: 1, duration: 0.7, ease: \"power2.inOut\" }, t0 + 0.4);\n              show(0);\n            });\n\n            var total = parseFloat(root.dataset.duration || \"5\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"stat-trio\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
 "sha256": "c8189d3afa12699bde65760b0f1c7989a97dff8b7bd160cd6d378f9a570d6b90",
