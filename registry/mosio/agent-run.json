   "content": "<!doctype html>\n<!--\n  Agent Run\n\n  A brand-neutral AI agent run that thinks, calls tools against a real-seconds timer and streams a markdown answer in bursts. Rewritten as DOM layout driven by the timeline; the streaming schedule, timer and spinner follow remocn's design.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/agent-run/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"agent-run\"\n  data-composition-duration=\"10.433\"\n  data-composition-variables='[\n    {\"id\": \"run\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Run script\", \"description\": \"JSON of the agent run: title, prompt, plan (list of strings), steps (name, detail, duration in seconds, icon of chart, database, search, book, globe, terminal or file, optional sources list) and answer (short markdown: heading, bullets, code fence, bold, inline code, citations like [1]).\", \"default\": \"{\\\"title\\\": \\\"Checkout conversion drop\\\", \\\"prompt\\\": \\\"Why did checkout conversion drop last week?\\\", \\\"plan\\\": [\\\"Compare the checkout funnel with the week before\\\", \\\"Break the drop down by browser and step\\\", \\\"Check what shipped and what the error logs say\\\"], \\\"steps\\\": [{\\\"icon\\\": \\\"chart\\\", \\\"name\\\": \\\"Query analytics\\\", \\\"detail\\\": \\\"checkout funnel, last 7 days vs prior 7\\\", \\\"duration\\\": 1.4}, {\\\"icon\\\": \\\"database\\\", \\\"name\\\": \\\"Run SQL\\\", \\\"detail\\\": \\\"conversion by browser and step\\\", \\\"duration\\\": 2.3}, {\\\"icon\\\": \\\"search\\\", \\\"name\\\": \\\"Search logs\\\", \\\"detail\\\": \\\"Wallet payment errors on Safari\\\", \\\"duration\\\": 1.1}, {\\\"icon\\\": \\\"book\\\", \\\"name\\\": \\\"Read 12 sources\\\", \\\"duration\\\": 3.2, \\\"sources\\\": [\\\"Checkout funnel\\\", \\\"Browser report\\\", \\\"Release 4.12\\\", \\\"PR #2186\\\", \\\"webkit.org\\\", \\\"developer.mozilla.org\\\", \\\"Payments runbook\\\", \\\"Error log\\\", \\\"Incident notes\\\", \\\"Wallet payments guide\\\", \\\"Support tickets\\\", \\\"Status page\\\"]}], \\\"answer\\\": \\\"## Wallet payments broke on Safari in release 4.12\\\\n\\\\nCheckout conversion fell from 3.4% to 2.7% last week, a 21% drop [1]. All of it comes from the payment step on Safari, 41% of checkouts [2].\\\\n\\\\n- Safari conversion halved, from 3.5% to 1.8%\\\\n- Desktop and tablet held steady at 3.3%\\\\n- 4.12 moved the card form into an iframe without `allow=\\\\\\\"payment\\\\\\\"` [3]\\\\n\\\\n```tsx\\\\n<iframe\\\\n  src={cardFormUrl}\\\\n  allow=\\\\\\\"payment\\\\\\\"\\\\n/>\\\\n```\\\\n\\\\n**Fix:** add the attribute and ship 4.12.1 today.\\\"}\"},\n    {\"id\": \"theme\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Theme\", \"description\": \"Light or dark panel.\", \"default\": \"light\", \"options\": [{\"value\": \"light\", \"label\": \"Light\"}, {\"value\": \"dark\", \"label\": \"Dark\"}]},\n    {\"id\": \"accent_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent\", \"description\": \"The one accent color.\", \"default\": \"#2563eb\"},\n    {\"id\": \"compression\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Compression\", \"description\": \"How many real seconds one second of video stands for; sets the timer and the tool durations.\", \"default\": 3, \"min\": 1, \"max\": 8, \"step\": 0.5},\n    {\"id\": \"seed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Seed\", \"description\": \"Seed for the streaming bursts.\", \"default\": 1, \"min\": 1, \"max\": 99, \"step\": 1},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier.\", \"default\": 1, \"min\": 0.25, \"max\": 4, \"step\": 0.05}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Agent Run</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: var(--stage); font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }\n        .ar-stage { position: absolute; inset: 0; }\n        .ar-panel { position: absolute; left: 50%; top: 50%; width: 800px; transform-origin: 0 0; }\n        .ar-card { position: relative; width: 100%; height: 100%; box-sizing: border-box; overflow: hidden; background: var(--panel); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow); color: var(--fg); font-size: 16px; -webkit-font-smoothing: antialiased; }\n        .ar-head { height: 48px; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 32px; border-bottom: 1px solid var(--divider); }\n        .ar-title { min-width: 0; font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n        .ar-timer { display: flex; align-items: center; gap: 7px; flex-shrink: 0; }\n        .ar-time { min-width: 38px; font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; text-align: right; }\n        .ar-view { position: relative; overflow: hidden; }\n        .ar-col { position: absolute; top: 0; left: 32px; width: 736px; padding: 24px 0 40px; box-sizing: border-box; }\n        .ar-bubble { display: flex; justify-content: flex-end; }\n        .ar-bubble > div { padding: 10px 16px; border-radius: 18px; background: var(--surface); font-size: 16px; line-height: 24px; }\n        .ar-status { margin-top: 20px; height: 24px; position: relative; font-size: 15px; font-weight: 500; line-height: 24px; white-space: pre; }\n        .ar-status > span { position: absolute; left: 0; top: 0; }\n        .ar-thought { color: var(--muted); }\n        .ar-plan { position: relative; margin-top: 8px; padding-left: 40px; font-size: 15px; line-height: 24px; color: var(--muted); }\n        .ar-rule { position: absolute; left: 0; top: 2px; bottom: 2px; width: 2px; border-radius: 1px; background: var(--track); }\n        .ar-item { position: relative; margin: 4px 0; }\n        .ar-num { position: absolute; left: -26px; color: var(--subtle); font-variant-numeric: tabular-nums; }\n        .ar-tools { margin-top: 20px; border: 1px solid var(--surfaceBorder); border-radius: 12px; background: var(--surface); overflow: hidden; }\n        .ar-row { box-sizing: border-box; overflow: hidden; }\n        .ar-row + .ar-row { border-top: 1px solid var(--divider); }\n        .ar-line { height: 44px; display: flex; align-items: center; gap: 10px; padding: 0 14px; }\n        .ar-name { flex-shrink: 0; font-size: 15px; font-weight: 500; white-space: nowrap; }\n        .ar-detail { flex: 1; min-width: 0; font-size: 15px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n        .ar-dur { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }\n        .ar-chips { display: flex; gap: 8px; height: 34px; padding: 0 14px 0 40px; overflow: hidden; }\n        .ar-chip { display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 9px 0 7px; border-radius: 999px; border: 1px solid var(--surfaceBorder); background: var(--panel); font-size: 12px; color: var(--muted); white-space: nowrap; transform-origin: 0 50%; }\n        .ar-answer { margin-top: 24px; font-size: 16px; line-height: 26px; }\n        .ar-blk { margin-bottom: 12px; }\n        .ar-h { font-size: 22px; line-height: 30px; font-weight: 600; letter-spacing: -0.01em; }\n        .ar-li { position: relative; padding-left: 22px; margin-bottom: 4px; }\n        .ar-li::before { content: \"\"; position: absolute; left: 7px; top: 11px; width: 5px; height: 5px; border-radius: 50%; background: var(--subtle); }\n        .ar-code { border: 1px solid var(--surfaceBorder); background: var(--codebg); border-radius: 10px; padding: 12px 16px; font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace; font-size: 14px; line-height: 22px; white-space: pre; overflow: hidden; }\n        .ar-lang { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--subtle); margin-bottom: 4px; }\n        .ar-ic { font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace; font-size: 0.88em; background: var(--surface); border: 1px solid var(--surfaceBorder); border-radius: 5px; padding: 0 4px; }\n        .ar-b { font-weight: 600; }\n        .ar-cite { display: inline-block; min-width: 18px; text-align: center; font-size: 11px; line-height: 18px; font-weight: 600; border-radius: 9px; background: var(--accentTint); color: var(--accentText); vertical-align: 2px; margin: 0 1px; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"agent-run\" data-duration=\"10.433\" data-fps=\"30\">\n        <div id=\"ar-clip\" class=\"ar-stage clip\" data-start=\"0\" data-duration=\"10.433\" data-track-index=\"0\">\n          <div class=\"ar-panel\" id=\"ar-panel\"><div class=\"ar-card\" id=\"ar-card\">\n            <div class=\"ar-head\"><span class=\"ar-title\" id=\"ar-title\"></span><div class=\"ar-timer\" id=\"ar-timer\"><span id=\"ar-hspin\"></span><span class=\"ar-time\" id=\"ar-time\">0.0s</span></div></div>\n            <div class=\"ar-view\" id=\"ar-view\"><div class=\"ar-col\" id=\"ar-col\">\n              <div class=\"ar-bubble\" id=\"ar-bubble\"><div id=\"ar-prompt\"></div></div>\n              <div class=\"ar-status\" id=\"ar-status\"><span id=\"ar-thinking\"></span><span class=\"ar-thought\" id=\"ar-thought\"></span></div>\n              <div class=\"ar-plan\" id=\"ar-plan\"><div class=\"ar-rule\"></div></div>\n              <div class=\"ar-tools\" id=\"ar-tools\"></div>\n              <div class=\"ar-answer\" id=\"ar-answer\"></div>\n            </div></div>\n          </div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"agent-run\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\nfunction col(v, f) { return typeof v === \"string\" && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v.trim()) ? v.trim() : f; }\nfunction bool(v, f) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : f; }\nvar FPS = 30;\nvar DUR = parseFloat(root.dataset.duration || \"2\");\nvar TOTAL = Math.round(DUR * FPS);\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction cl(x, a, b) { return Math.min(b, Math.max(a, x)); }\n// interpolate(x, [in...], [out...], easing): clamped on both sides, easing applied per segment.\nfunction interp(x, inp, out, easing) {\n  if (x <= inp[0]) return out[0];\n  if (x >= inp[inp.length - 1]) return out[out.length - 1];\n  var i = 0;\n  while (x > inp[i + 1]) i++;\n  var t = (x - inp[i]) / (inp[i + 1] - inp[i]);\n  if (easing) t = easing(t);\n  return out[i] + (out[i + 1] - out[i]) * t;\n}\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0; if (x >= 1) return 1;\n    var t = x;\n    for (var i = 0; i < 8; i++) {\n      var cx = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t - x;\n      var d = 3 * x1 * (1 - t) * (1 - t) - 6 * x1 * t * (1 - t) + 6 * x2 * t * (1 - t) - 3 * x2 * t * t + 3 * t * t;\n      if (Math.abs(cx) < 1e-6 || Math.abs(d) < 1e-6) break;\n      t -= cx / d;\n    }\n    t = cl(t, 0, 1);\n    return 3 * y1 * t * (1 - t) * (1 - t) + 3 * y2 * t * t * (1 - t) + t * t * t;\n  };\n}\nvar E = {\n  lin: function (t) { return t; },\n  quad: function (t) { return t * t; },\n  cubic: function (t) { return t * t * t; },\n  sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); }\n};\nfunction eOut(f) { return function (t) { return 1 - f(1 - t); }; }\nfunction eInOut(f) { return function (t) { return t < 0.5 ? f(2 * t) / 2 : 1 - f(2 - 2 * t) / 2; }; }\nvar outCubic = eOut(E.cubic), outQuad = eOut(E.quad), inCubic = E.cubic, inQuad = E.quad;\nvar inOutCubic = eInOut(E.cubic), inOutQuad = eInOut(E.quad), inOutSin = eInOut(E.sin), outSin = eOut(E.sin);\n// Damped spring from 0 to 1 (rest at 1, no initial velocity), frames at 30 fps.\nfunction spring(frame, cfg) {\n  if (frame <= 0) return 0;\n  var m = cfg.mass || 1, k = cfg.stiffness, c = cfg.damping;\n  var w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m)), t = frame / FPS;\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n  }\n  if (z === 1) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  var s = w0 * Math.sqrt(z * z - 1), r1 = -z * w0 + s, r2 = -z * w0 - s;\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\n// Seeded random: same string in, same number out.\nfunction rnd(seed) {\n  var sd = String(seed), h = 1779033703 ^ sd.length;\n  for (var i = 0; i < sd.length; i++) { h = Math.imul(h ^ sd.charCodeAt(i), 3432918353); h = (h << 13) | (h >>> 19); }\n  h = Math.imul(h ^ (h >>> 16), 2246822507); h = Math.imul(h ^ (h >>> 13), 3266489909); h ^= h >>> 16;\n  var a = (h >>> 0);\n  a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a);\n  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n}\nfunction rgb(h) {\n  h = h.replace(\"#\", \"\");\n  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];\n  return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];\n}\nfunction mixc(a, b, t) {\n  var x = rgb(a), y = rgb(b);\n  return \"rgb(\" + Math.round(lerp(x[0], y[0], t)) + \",\" + Math.round(lerp(x[1], y[1], t)) + \",\" + Math.round(lerp(x[2], y[2], t)) + \")\";\n}\nfunction rgba(h, a) { var x = rgb(h); return \"rgba(\" + x[0] + \",\" + x[1] + \",\" + x[2] + \",\" + a + \")\"; }\nvar SVGNS = \"http://www.w3.org/2000/svg\";\nfunction svgEl(tag, attrs, parent) {\n  var e = document.createElementNS(SVGNS, tag);\n  for (var k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\nfunction setA(e, attrs) { for (var k in attrs) e.setAttribute(k, attrs[k]); }\n// Drive draw(frame) from the timeline; frames run 0..frames over frames/30 seconds.\nfunction drive(draw, frames) {\n  var tl = gsap.timeline({ paused: true });\n  var clock = { frame: 0 };\n  tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n  draw(0);\n  return tl;\n}\nfunction finish(tl) {\n  if (tl.duration() < DUR) tl.to({}, { duration: DUR - tl.duration() });\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[NAME] = tl;\n}\n\n\nvar RUN_START = 16, THINK_LEAD = 14, THINK_TAIL = 8, TOOL_GAP = 5, TOOL_MIN = 12, TOOL_MAX = 120, ANSWER_GAP = 8, SETTLE = 16, HOLD = 45;\nfunction pickW(w, v) { var s = 0, i; for (i = 0; i < w.length; i++) s += w[i]; var t = v * s, a = 0; for (i = 0; i < w.length; i++) { a += w[i]; if (t < a) return i; } return w.length - 1; }\n// Streaming schedule: text arrives in bursts of a few words; every character gets the frame it appears on.\nfunction chunkArrivals(text, seed, salt) {\n  var arr = [], pos = 0, fr = 0, k = 0, last = 0, SIZES = [3, 6, 8, 10, 12, 15], SW = [8, 16, 22, 22, 17, 15], GW = [42, 33, 16, 9];\n  while (pos < text.length) {\n    var key = \"agent-run-\" + seed + \"-\" + salt + \"-\" + k;\n    var end = Math.min(text.length, pos + SIZES[pickW(SW, rnd(key + \"-s\"))]);\n    while (end < text.length && !/\\s/.test(text.charAt(end - 1))) end++;\n    for (var i = pos; i < end; i++) arr[i] = fr;\n    last = fr;\n    fr += 1 + pickW(GW, rnd(key + \"-g\"));\n    if (rnd(key + \"-p\") < 0.06) fr += 4 + Math.floor(rnd(key + \"-q\") * 4);\n    pos = end; k++;\n  }\n  return { arr: arr, last: last };\n}\nfunction buildTimeline(run, seed, compression) {\n  var perFrame = compression / 30, planText = (run.plan || []).join(\"\\n\");\n  var pc = planText ? chunkArrivals(planText, seed, \"plan\") : { arr: [], last: 0 };\n  var planStart = RUN_START + THINK_LEAD, planEnd = planStart + pc.last, thinkEnd = planEnd + THINK_TAIL;\n  var segs = [], real = 0;\n  function push(kind, from, to, sec) { segs.push({ kind: kind