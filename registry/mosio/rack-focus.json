   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Rack Focus\n\n  A focus pull with real aperture bokeh: a night scene of lights spread from 1.2 m to 80 m, where the focal plane travels from the string of bulbs in front of the lens to the lit towers behind it, and every light is an image of the lens aperture sized by its circle of confusion. WebGL point sprites.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/heygen-com/hyperframes/blob/bd6cff8157a1a0ed5075527e673cc4f321fe9123/registry/blocks/rack-focus/rack-focus.html\n\n  Copyright HeyGen, Inc. and the Hyperframes contributors. Licensed under the Apache License, Version\n  2.0 (the \"License\"); you may not use this file except in compliance with the License. You may obtain\n  a copy of the License at http://www.apache.org/licenses/LICENSE-2.0. Unless required by applicable\n  law or agreed to in writing, software distributed under the License is distributed on an \"AS IS\"\n  BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for\n  the specific language governing permissions and limitations under the License.\n\n  Changes by usemosio/blocks: fills the host frame: the scene keeps its 16:9 stage across the full width and a taller frame (vertical video) gets more lights above and below; the shaders are WebGL2 (GLSL ES 3.0 syntax, otherwise unchanged); the canvas is drawn at the `resolution` variable and the focal distance is computed from the timeline; without WebGL the backdrop colour shows. The circle-of-confusion constants come from the three.js BokehShader2 example (MIT), as noted upstream.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"rack-focus\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[{\"id\": \"nearfocus\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Near focal distance\", \"default\": 1.2, \"min\": 0.2, \"max\": 100, \"step\": 0.05, \"unit\": \"m\"},\n    {\"id\": \"farfocus\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Far focal distance\", \"default\": 80, \"min\": 0.3, \"max\": 400, \"step\": 0.5, \"unit\": \"m\"},\n    {\"id\": \"focallength\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Focal length\", \"default\": 85, \"min\": 12, \"max\": 300, \"step\": 1, \"unit\": \"mm\"},\n    {\"id\": \"aperture\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Aperture (f-number)\", \"default\": 1.8, \"min\": 0.95, \"max\": 22, \"step\": 0.05},\n    {\"id\": \"blades\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Aperture blades (bokeh shape)\", \"default\": 6, \"min\": 3, \"max\": 14, \"step\": 1},\n    {\"id\": \"catseye\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Cat eye clipping at the corners\", \"default\": 0.62, \"min\": 0, \"max\": 1, \"step\": 0.02},\n    {\"id\": \"pullstart\", \"type\": \"number\", \"role\": \"timing\", \"label\": \"Pull start\", \"default\": 1.2, \"min\": 0, \"max\": 30, \"step\": 0.05, \"unit\": \"s\"},\n    {\"id\": \"pullduration\", \"type\": \"number\", \"role\": \"timing\", \"label\": \"Pull duration\", \"default\": 3.2, \"min\": 0.1, \"max\": 30, \"step\": 0.05, \"unit\": \"s\"},\n    {\"id\": \"pullease\", \"type\": \"string\", \"role\": \"motion\", \"label\": \"Pull easing (GSAP ease)\", \"default\": \"power2.inOut\"},\n    {\"id\": \"bokeh\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Bokeh exposure\", \"default\": 1, \"min\": 0, \"max\": 3, \"step\": 0.05},\n    {\"id\": \"backdrop\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Backdrop\", \"default\": \"#05060a\"},\n    {\"id\": \"resolution\", \"type\": \"number\", \"role\": \"quality\", \"label\": \"Resolution\", \"description\": \"Share of the frame size the lights are drawn at, then scaled up. Fine wires and filaments need 0.75.\", \"default\": 0.75, \"min\": 0.25, \"max\": 1, \"step\": 0.05}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Rack Focus</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          background: #000;\n          pointer-events: none;\n        }\n        .rkf-stage {\n          position: absolute;\n          inset: 0;\n        }\n        .rkf-canvas {\n          position: absolute;\n          inset: 0;\n          width: 100%;\n          height: 100%;\n          display: block;\n        }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"rack-focus\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"rkf-clip\" class=\"rkf-stage clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\">\n          <canvas id=\"rkf-canvas\" class=\"rkf-canvas\"></canvas>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"rack-focus\";\n            var DUR = 6;\n            var root = document.getElementById(\"root\");\n            var canvas = document.getElementById(\"rkf-canvas\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function clampNum(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function hex(value, fallback) {\n              var m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(String(value || \"\").trim());\n              if (!m) return fallback;\n              var h = m[1].length === 3 ? m[1].replace(/./g, \"$&$&\") : m[1];\n              return \"#\" + h.toLowerCase();\n            }\n            function rgb(value) {\n              var h = hex(value, \"#000000\").slice(1);\n              return [parseInt(h.slice(0, 2), 16) / 255, parseInt(h.slice(2, 4), 16) / 255, parseInt(h.slice(4, 6), 16) / 255];\n            }\n            var DEFS = [{\"id\": \"nearfocus\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Near focal distance\", \"default\": 1.2, \"min\": 0.2, \"max\": 100, \"step\": 0.05, \"unit\": \"m\"}, {\"id\": \"farfocus\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Far focal distance\", \"default\": 80, \"min\": 0.3, \"max\": 400, \"step\": 0.5, \"unit\": \"m\"}, {\"id\": \"focallength\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Focal length\", \"default\": 85, \"min\": 12, \"max\": 300, \"step\": 1, \"unit\": \"mm\"}, {\"id\": \"aperture\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Aperture (f-number)\", \"default\": 1.8, \"min\": 0.95, \"max\": 22, \"step\": 0.05}, {\"id\": \"blades\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Aperture blades (bokeh shape)\", \"default\": 6, \"min\": 3, \"max\": 14, \"step\": 1}, {\"id\": \"catseye\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Cat eye clipping at the corners\", \"default\": 0.62, \"min\": 0, \"max\": 1, \"step\": 0.02}, {\"id\": \"pullstart\", \"type\": \"number\", \"role\": \"timing\", \"label\": \"Pull start\", \"default\": 1.2, \"min\": 0, \"max\": 30, \"step\": 0.05, \"unit\": \"s\"}, {\"id\": \"pullduration\", \"type\": \"number\", \"role\": \"timing\", \"label\": \"Pull duration\", \"default\": 3.2, \"min\": 0.1, \"max\": 30, \"step\": 0.05, \"unit\": \"s\"}, {\"id\": \"pullease\", \"type\": \"string\", \"role\": \"motion\", \"label\": \"Pull easing (GSAP ease)\", \"default\": \"power2.inOut\"}, {\"id\": \"bokeh\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Bokeh exposure\", \"default\": 1, \"min\": 0, \"max\": 3, \"step\": 0.05}, {\"id\": \"backdrop\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Backdrop\", \"default\": \"#05060a\"}, {\"id\": \"resolution\", \"type\": \"number\", \"role\": \"quality\", \"label\": \"Resolution\", \"description\": \"Share of the frame size the lights are drawn at, then scaled up. Fine wires and filaments need 0.75.\", \"default\": 0.75, \"min\": 0.25, \"max\": 1, \"step\": 0.05}];\n            var V = {};\n            DEFS.forEach(function (d) {\n              var raw = vars[d.id];\n              if (d.type === \"number\") V[d.id] = clampNum(raw, d.default, d.min, d.max);\n              else if (d.type === \"color\") V[d.id] = hex(raw, d.default);\n              else if (d.type === \"boolean\") V[d.id] = typeof raw === \"boolean\" ? raw : raw === \"true\" ? true : raw === \"false\" ? false : d.default;\n              else V[d.id] = typeof raw === \"string\" ? raw.trim() : d.default;\n            });\n\n            var W = Math.max(2, root.clientWidth);\n            var H = Math.max(2, root.clientHeight);\n            var cw = Math.max(2, Math.round(W * V.resolution));\n            var ch = Math.max(2, Math.round(H * V.resolution));\n            root.style.background = V.backdrop;\n            canvas.width = cw;\n            canvas.height = ch;\n            var SENSOR_W_MM = 36;\n            // The scene is laid out for a 16:9 stage that fills the width; a taller frame\n            // (vertical video) gets that stage in the middle and more lights above and below.\n            var PX_PER_MM = cw / SENSOR_W_MM;\n            var COC_MM = 0.03;\n            var MAX_COC_R_PX = 0.1 * Math.min(ch, cw * 9 / 16);\n            var MIN_R_PX = 0.75;\n            var NEAR = V.nearfocus, FAR = V.farfocus, FOCAL = V.focallength;\n            var MID_COUNT = Math.round(90 * Math.max(1, (H / W) / (9 / 16)));\n            var EASE = gsap.parseEase(V.pullease) || gsap.parseEase(\"power2.inOut\");\n            function focusAt(t) {\n              var u = Math.min(1, Math.max(0, (t - V.pullstart) / Math.max(0.001, V.pullduration)));\n              var e = EASE(u);\n              var inv = 1 / NEAR + (1 / FAR - 1 / NEAR) * e;\n              return 1 / inv;\n            }\n            function mulberry32(a) {\n              return function () {\n                a |= 0;\n                a = (a + 0x6d2b79f5) | 0;\n                var t = Math.imul(a ^ (a >>> 15), 1 | a);\n                t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n                return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n              };\n            }\n        var rnd = mulberry32(0x5eed1a3);\n        function rr(lo, hi) {\n          return lo + (hi - lo) * rnd();\n        }\n\n        // x, y in metres (y up, origin on the optical axis), z in metres,\n        // r0 = the light's own physical radius in metres, b = peak\n        // brightness when perfectly in focus (values above 1 are highlights\n        // that clip, which is exactly why they stay visible once spread\n        // across a bokeh disc), rgb = colour.\n        var P = [];\n        function light(x, y, z, r0, b, c) {\n          P.push(x, y, z, r0, b, c[0], c[1], c[2]);\n        }\n\n        var TUNGSTEN = [1.0, 0.74, 0.45];\n        var FILAMENT = [1.0, 0.9, 0.74];\n        var WIRE = [0.86, 0.74, 0.6];\n        var WARM_WIN = [1.0, 0.79, 0.52];\n        var COOL_WIN = [0.6, 0.75, 1.0];\n        var SIGN_A = [0.35, 0.95, 1.0];\n        var SIGN_B = [1.0, 0.42, 0.72];\n\n        // Half the frame's width, in metres, at depth z. Both subjects are\n        // laid out against the reference framing (85mm, 1.2m / 80m) and then\n        // scaled by this, so retuning the lens or either focal distance moves\n        // the subjects with the frame instead of pushing them out of it.\n        function halfW(z) {\n          return (0.5 * SENSOR_W_MM * z) / FOCAL;\n        }\n\n        // Near subject: a catenary string of bulbs at `nearfocus`. The wire is\n        // what makes \"sharp\" unmistakable, a one-pixel line either resolves\n        // or it does not, and the filament inside each bulb is the second cue.\n        var NEAR_Z = NEAR;\n        var NS = halfW(NEAR_Z) / 0.25412;\n        var X_END = 0.4;\n        var SAG_A = 0.3;\n        var SAG = 0.1;\n        var COSH_END = Math.cosh(X_END / SAG_A);\n        function stringY(x) {\n          var s = (COSH_END - Math.cosh(x / SAG_A)) / (COSH_END - 1);\n          return 0.075 - SAG * s - 0.035 * (x / X_END);\n        }\n        function stringZ(x) {\n          return NEAR_Z + 0.05 * (x / X_END);\n        }\n        for (var i = 0; i < 1100; i++) {\n          var wx = -0.42 + (0.84 * i) / 1099;\n          light(wx * NS, stringY(wx) * NS, stringZ(wx), 0.0006 * NS, 1.4, WIRE);\n        }\n        for (var k = -5; k <= 5; k++) {\n          var bx = k * 0.085;\n          var by = stringY(bx) - 0.011;\n          var bz = stringZ(bx);\n          light(bx * NS, by * NS, bz, 0.006 * NS, 26, TUNGSTEN);\n          light((bx - 0.0022) * NS, by * NS, bz, 0.0006 * NS, 7, FILAMENT);\n          light(bx * NS, (by - 0.0022) * NS, bz, 0.0006 * NS, 7, FILAMENT);\n          light((bx + 0.0022) * NS, by * NS, bz, 0.0006 * NS, 7, FILAMENT);\n        }\n\n        // Far subject: three lit towers plus a dense LED sign strip, sitting\n        // around `farfocus`. The sign's pitch is fine enough that it only\n        // resolves into separate lamps when focus actually arrives.\n        var FAR_Z = FAR;\n        var FS = halfW(FAR_Z) / 16.941;\n        function tower(cx, hw, topY, botY, cols, rows, z, lit) {\n          for (var c = 0; c < cols; c++) {\n            for (var r = 0; r < rows; r++) {\n              if (rnd() > lit) continue;\n              var x = cx - hw + (2 * hw * (c + 0.5)) / cols;\n              var y = botY + ((topY - botY) * (r + 0.5)) / rows;\n              var cool = rnd() < 0.28;\n              light(x, y, z + rr(-0.4, 0.4) * FS, 0.24 * FS, rr(9, 20), cool ? COOL_WIN : WARM_WIN);\n            }\n          }\n        }\n        tower(-9.5 * FS, 3.5 * FS, 9.6 * FS, -4.0 * FS, 6, 14, FAR_Z * 1.03, 0.34);\n        tower(2.0 * FS, 4.5 * FS, 6.4 * FS, -4.0 * FS, 8, 12, FAR_Z * 0.98, 0.3);\n        tower(12.5 * FS, 3.0 * FS, 11.0 * FS, -4.0 * FS, 5, 15, FAR_Z * 1.08, 0.36);\n        for (var s = 0; s < 40; s++) {\n          var sx = (-5.5 + (11 * s) / 39) * FS;\n          var mixc = s / 39;\n          var sc = [\n            SIGN_A[0] + (SIGN_B[0] - SIGN_A[0]) * mixc,\n            SIGN_A[1] + (SIGN_B[1] - SIGN_A[1]) * mixc,\n            SIGN_A[2] + (SIGN_B[2] - SIGN_A[2]) * mixc,\n          ];\n          light(sx, -5.0 * FS, FAR_Z * 0.99, 0.1 * FS, 7, sc);\n          light(sx, -5.55 * FS, FAR_Z * 0.99, 0.1 * FS, 7, sc);\n        }\n\n        // Everything between. Depth is drawn log-uniform between the two\n        // subjects and the screen position is uniform, so the mid-ground\n        // stays evenly spread whatever the two focal distances are.\n        var Z_LO = Math.min(NEAR_Z, FAR_Z) * 1.9;\n        var Z_HI = Math.max(NEAR_Z, FAR_Z) * 0.85;\n        for (var m = 0; m < MID_COUNT; m++) {\n          var z = Z_LO * Math.pow(Z_HI / Z_LO, rnd());\n          var halfWm = (0.5 * SENSOR_W_MM * z) / FOCAL;\n          var halfHm = (halfWm * ch) / cw;\n          var warm = rnd() < 0.66;\n          light(\n            rr(-1.05, 1.05) * halfWm,\n            rr(-1.0, 0.75) * halfHm,\n            z,\n            rr(0.006, 0.05) * (z / 12),\n            rr(5, 18),\n            warm ? WARM_WIN : COOL_WIN,\n          );\n        }\n\n\n            var VERTEX = `#version 300 es\nprecision highp float;\n\nin vec2 aCorner;\nin vec3 aPos;\nin vec2 aSize;\nin vec3 aColor;\nuniform vec2 uRes;\nuniform float uPxPerMm;\nuniform float uFocal;\nuniform float uFocus;\nuniform float uFstop;\nuniform float uCoCmm;\nuniform float uMaxR;\nuniform float uMinR;\nuniform float uCatsEye;\nuniform float uBokeh;\nout vec2 vQ;\nout vec3 vColor;\nout float vGain;\nout float vShape;\nout float vAA;\nout vec2 vRadial;\nout float vCat;\nvoid main() {\n  float z = max(aPos.z, 0.001);\n  float ppm = uPxPerMm * uFocal / z;\n  vec2 centre = uRes * 0.5 + aPos.xy * ppm;\n  float r0 = max(aSize.x * ppm, uMinR);\n\n  // BokehShader2's circle of confusion, in units of uCoCmm.\n  float f = uFocal;\n  float d = uFocus * 1000.0;\n  float o = z * 1000.0;\n  float a = (o * f) / max(o - f, 1e-4);\n  float b = (d * f) / max(d - f, 1e-4);\n  float c = (d - f) / max(d * uFstop * uCoCmm, 1e-6);\n  float blur = abs(a - b) * c;\n  // -> defocus diameter in mm -> pixels -> radius.\n  float cocR = min(blur * uCoCmm * uPxPerMm * 0.5, uMaxR);\n\n  // A finite source convolved with the defocus disc: radii add in\n  // quadrature. Flux is conserved, so peak brightness falls as the\n  // inverse square of the radius. That single term is why an\n  // in-focus lamp clips to white and a defocused one is a readable\n  // disc instead of a smear.\n  float R = sqrt(r0 * r0 + cocR * cocR);\n  vGain = aSize.y * uBokeh * (r0 * r0) / (R * R);\n  // Near focus the sprite is the lamp (round); far from it the\n  // sprite is an image of the aperture (polygonal).\n  vShape = (cocR * cocR) / (cocR * cocR + r0 * r0);\n  vAA = 1.0 / max(R, 0.5);\n  vColor = aColor;\n  vQ = aCorner;\n\n  // Mechanical vignetting: the barrel openings clip the aperture\n  // harder the further the sprite sits from the optical axis.\n  vec2 off = centre - uRes * 0.5;\n  float rad = length(off);\n  vRadial = rad > 1.0 ? off / rad : vec2(1.0, 0.0);\n  vCat = uCatsEye * min(1.0, rad / (length(uRes) * 0.5));\n\n  // A light spread thin enough to land under half a display code\n  // value contributes nothing but fill rate. Culling it here is what\n  // keeps a 900-point wire from splatting 900 invisible discs the\n  // moment it goes out of focus.\n  if (vGain < 0.0015) {\n    gl_Position = vec4(2.0, 2.0, 2.0, 1.0);\n    return;\n  }\n\n  vec2 p = centre + aCorner * R;\n  gl_Position = vec4((p / uRes) * 2.0 - 1.0, 0.0, 1.0);\n}`;\n            var FRAGMENT = `#version 300 es\nprecision highp float;\nout vec4 outColor;\n\nin vec2 vQ;\nin vec3 vColor;\nin float vGain;\nin float vShape;\nin float vAA;\nin vec2 vRadial;\nin float vCat;\nuniform float uBlades;\nconst float PI = 3.14159265;\nvoid main() {\n  float r = length(vQ);\n  if (r > 1.0) discard;\n  float th = r > 1e-5 ? atan(vQ.y, vQ.x) : 0.0;\n\n  // Regular-polygon aperture boundary: circumradius 1 at a blade\n  // vertex, cos(PI/n) at a blade midpoint.\n  float n = uBlades;\n  float seg = 2.0 * PI / n;\n  float poly = cos(PI / n) / cos(mod(th, seg) - PI / n);\n  float bound = mix(1.0, poly, vShape);\n\n  float cov = smoothstep(bound, bound - vAA, r);\n  // Two offset barrel openings cut the disc from opposite sides,\n  // which is what turns a corner bokeh into a cat's eye.\n  float cut = vCat * vShape;\n  cov *= smoothstep(1.0, 1.0 - vAA, length(vQ - vRadial * cut));\n  cov *= smoothstep(1.0, 1.0 - vAA, length(vQ + vRadial * cut));\n\n  outColor = vec4(vColor * (vGain * cov), 1.0);\n}`;\n\n            var gl = canvas.getContext(\"webgl2\", { alpha: true, antialias: false, depth: false, stencil: false, preserveDrawingBuffer: true });\n            function compile(type, source) {\n              var shader = gl.createShader(type);\n              gl.shaderSource(shader, source);\n              gl.compileShader(shader);\n              if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader) || \"shader compile failed\");\n              return shader;\n            }\n            var paint = null;\n            try {\n              if (!gl) throw new Error(\"WebGL2 is not available\");\n              var prog = gl.createProgram();\n              gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERTEX));\n              gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAGMENT));\n              gl.linkProgram(prog);\n              if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog) || \"link failed\");\n              gl.useProgram(prog);\n              // Six vertices per light: two triangles carrying the same point payload and four corner offsets.\n              var