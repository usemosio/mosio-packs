  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Typewriter\n\nText is typed out character by character at a steady rate, followed by a bar cursor that blinks once typing stops.\n\nCategory: typography. Length: 4 s. WebGL: no.\n\nUse when:\n- Simulating a command being typed into a terminal or input: pairs with terminal-simulator.\n- A title should feel authored live rather than appearing all at once.\n- You need the reveal duration to track the text length predictably (characters per second).\n\nAvoid when:\n- The text is long: typing a paragraph at a readable speed takes far longer than a viewer will wait; use staggered-fade-up.\n- You want a designed, weighted entrance (springy, blurred, kinetic): use tracking-in or kinetic-center-build.\n- Multiple lines should reveal together: typing is single-stream.\n\nVariables:\n- text (string): Text, default \"console.log('hello, world')\"\n- cursor (boolean): Cursor, default true\n- chars_per_second (number, 4-60): Characters per second, default 22\n- font_size (number, 12-220): Font size, default 72\n- color (color): Color, default \"#171717\"\n- cursor_color (color): Cursor color, default \"#171717\"\n- font_weight (enum): Font weight, default \"600\"\n- speed (number, 0.25-4): Speed, default 1\n\nSource: https://github.com/Remocn/remocn. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Typewriter\n\n  Character-by-character text reveal with a deterministic blinking cursor.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/typewriter/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"typewriter\"\n  data-composition-duration=\"4\"\n  data-composition-variables='[\n    {\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Text\", \"description\": \"Text that gets typed.\", \"default\": \"console.log(&#39;hello, world&#39;)\"},\n    {\"id\": \"cursor\", \"type\": \"boolean\", \"role\": \"style\", \"label\": \"Cursor\", \"description\": \"Show the bar cursor after the text.\", \"default\": true},\n    {\"id\": \"chars_per_second\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Characters per second\", \"description\": \"Typing rate.\", \"default\": 22, \"min\": 4, \"max\": 60, \"step\": 1, \"unit\": \"cps\"},\n    {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Maximum text size in pixels. Longer text shrinks to fit the frame.\", \"default\": 72, \"min\": 12, \"max\": 220, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Color\", \"description\": \"Text color.\", \"default\": \"#171717\"},\n    {\"id\": \"cursor_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Cursor color\", \"description\": \"Color of the cursor bar.\", \"default\": \"#171717\"},\n    {\"id\": \"font_weight\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Font weight\", \"description\": \"Weight of the text.\", \"default\": \"600\", \"options\": [{\"value\": \"400\", \"label\": \"Regular\"}, {\"value\": \"500\", \"label\": \"Medium\"}, {\"value\": \"600\", \"label\": \"Semibold\"}, {\"value\": \"700\", \"label\": \"Bold\"}]},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier.\", \"default\": 1, \"min\": 0.25, \"max\": 4, \"step\": 0.05, \"unit\": \"x\"}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Typewriter</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n          color: var(--color, #171717);\n          font-family: var(--font-display, Geist, -apple-system, BlinkMacSystemFont, sans-serif);\n        }\n        .twr-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }\n        .twr-line { letter-spacing: -0.03em; white-space: pre; line-height: 1.2; }\n        .twr-caret { display: inline-block; flex-shrink: 0; width: 0.08em; height: 1em; margin-left: 0.04em; vertical-align: text-bottom; background: var(--cursor-color, #171717); }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"typewriter\" data-duration=\"4\" data-fps=\"30\">\n        <div id=\"twr-clip\" class=\"twr-stage clip\" data-start=\"0\" data-duration=\"4\" data-track-index=\"0\">\n          <span id=\"twr-line\" class=\"twr-line\" role=\"img\"><span id=\"twr-text\"></span><span id=\"twr-caret\" class=\"twr-caret\"></span></span>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value.trim() ? value : fallback;\n            }\n            function pick(value, list, fallback) {\n              return list.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            // Easing.bezier(x1, y1, x2, y2) as a function of t (Newton, then bisection).\n            function bez(x1, y1, x2, y2) {\n              function cx(s) { return 3 * x1 * s * (1 - s) * (1 - s) + 3 * x2 * s * s * (1 - s) + s * s * s; }\n              function cy(s) { return 3 * y1 * s * (1 - s) * (1 - s) + 3 * y2 * s * s * (1 - s) + s * s * s; }\n              return function (t) {\n                if (t <= 0) return 0;\n                if (t >= 1) return 1;\n                var lo = 0, hi = 1, s = t;\n                for (var i = 0; i < 40; i++) {\n                  var x = cx(s);\n                  if (Math.abs(x - t) < 1e-6) break;\n                  if (x < t) lo = s; else hi = s;\n                  s = (lo + hi) / 2;\n                }\n                return cy(s);\n              };\n            }\n            // interpolate(f, [a, b], [from, to]) with both ends clamped, like the source framework's extrapolate \"clamp\".\n            function interp(f, a, b, from, to, ease) {\n              var t = b === a ? 1 : Math.min(1, Math.max(0, (f - a) / (b - a)));\n              return from + (to - from) * (ease ? ease(t) : t);\n            }\n            // Fit one line to 90 % of the frame width: shrinks the font size when it overflows.\n            function fit(root, line, size) {\n              line.style.fontSize = size + \"px\";\n              var maxWidth = Math.max(1, root.clientWidth * 0.9);\n              if (line.scrollWidth > maxWidth) {\n                size = Math.max(12, size * (maxWidth / line.scrollWidth));\n                line.style.fontSize = size + \"px\";\n              }\n              return size;\n            }\n            // Drives draw(frame) from the paused timeline: frame = time * 30 * speed (the source framework's useCurrentFrame() * speed).\n            function drive(tl, total, speed, draw) {\n              var clock = { t: 0 };\n              tl.to(clock, { t: total, duration: total, ease: \"none\", onUpdate: function () { draw(clock.t * 30 * speed); } }, 0);\n              draw(0);\n            }\n\n            var total = parseFloat(root.dataset.duration || \"4\");\n            var text = str(vars.text, \"console.log('hello, world')\");\n            var showCursor = bool(vars.cursor, true);\n            var cps = num(vars.chars_per_second, 22, 4, 60);\n            var speed = num(vars.speed, 1, 0.25, 4);\n            var line = document.getElementById(\"twr-line\");\n            var textEl = document.getElementById(\"twr-text\");\n            var caret = document.getElementById(\"twr-caret\");\n            line.style.fontWeight = pick(vars.font_weight, [\"400\", \"500\", \"600\", \"700\"], \"600\");\n            line.setAttribute(\"aria-label\", text);\n            if (typeof vars.color === \"string\" && vars.color) root.style.setProperty(\"--color\", vars.color);\n            if (typeof vars.cursor_color === \"string\" && vars.cursor_color) root.style.setProperty(\"--cursor-color\", vars.cursor_color);\n            if (!showCursor) caret.style.display = \"none\";\n            // Size is fitted against the full text, then the typing starts from empty.\n            textEl.textContent = text;\n            fit(root, line, num(vars.font_size, 72, 12, 220));\n            var len = text.length;\n\n            // remocn: count = floor(frame / (len / cps * 30) * len); the bar is solid while typing,\n            // and blinks (15 frames on, 15 off) before the first and after the last character.\n            function draw(frame) {\n              var over = (len / cps) * 30;\n              var count = frame <= 0 ? 0 : over <= 0 ? len : Math.max(0, Math.min(len, Math.floor((frame / over) * len)));\n              textEl.textContent = text.slice(0, count);\n              var typing = count > 0 && count < len;\n              var rawFrame = frame / speed;\n              caret.style.opacity = typing ? 1 : (Math.floor((rawFrame * speed) / 15) % 2 === 0 ? 1 : 0);\n            }\n            var tl = gsap.timeline({ paused: true });\n            drive(tl, total, speed, draw);\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"typewriter\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
