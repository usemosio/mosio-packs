   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Breathing Text\n\n  Letters flex between two variable-font settings (weight and slant) in a staggered, mirrored loop, so the word appears to breathe.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/danielpetho/fancy/blob/f9f62c61207b2dd3210476dd98af3c9a5be24094/src/fancy/components/text/breathing-text.tsx\n\n  MIT License\n\n  Copyright (c) 2024 Daniel Petho\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"breathing-text\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[\n    {\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Text\", \"description\": \"Word or short phrase that breathes.\", \"default\": \"breathing text\"},\n    {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Maximum text size in pixels. Longer text shrinks to fit the frame.\", \"default\": 120, \"min\": 24, \"max\": 400, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Color\", \"description\": \"Text color.\", \"default\": \"#111111\"},\n    {\"id\": \"from_weight\", \"type\": \"number\", \"role\": \"style\", \"label\": \"From weight\", \"description\": \"Variable-font weight (wght axis) the letters start from.\", \"default\": 100, \"min\": 100, \"max\": 1000, \"step\": 10},\n    {\"id\": \"to_weight\", \"type\": \"number\", \"role\": \"style\", \"label\": \"To weight\", \"description\": \"Weight the letters breathe to.\", \"default\": 800, \"min\": 100, \"max\": 1000, \"step\": 10},\n    {\"id\": \"from_slant\", \"type\": \"number\", \"role\": \"style\", \"label\": \"From slant\", \"description\": \"Slant axis value (slnt, 0 is upright) the letters start from.\", \"default\": 0, \"min\": -10, \"max\": 0, \"step\": 1, \"unit\": \"deg\"},\n    {\"id\": \"to_slant\", \"type\": \"number\", \"role\": \"style\", \"label\": \"To slant\", \"description\": \"Slant the letters breathe to.\", \"default\": -10, \"min\": -10, \"max\": 0, \"step\": 1, \"unit\": \"deg\"},\n    {\"id\": \"breath_duration\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Breath duration\", \"description\": \"Seconds for one breath in or out.\", \"default\": 1.5, \"min\": 0.2, \"max\": 6, \"step\": 0.1, \"unit\": \"s\"},\n    {\"id\": \"stagger\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Stagger\", \"description\": \"Seconds between neighbouring letters.\", \"default\": 0.08, \"min\": 0, \"max\": 0.5, \"step\": 0.01, \"unit\": \"s\"},\n    {\"id\": \"stagger_from\", \"type\": \"enum\", \"role\": \"motion\", \"label\": \"Stagger from\", \"description\": \"Where the wave of breathing starts.\", \"default\": \"first\", \"options\": [{\"value\": \"first\", \"label\": \"First letter\"}, {\"value\": \"last\", \"label\": \"Last letter\"}, {\"value\": \"center\", \"label\": \"Center\"}]},\n    {\"id\": \"repeat_delay\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Repeat delay\", \"description\": \"Pause between a breath in and the breath back.\", \"default\": 0.1, \"min\": 0, \"max\": 2, \"step\": 0.05, \"unit\": \"s\"}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Breathing Text</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,slnt,wdth,wght@8..144,-10..0,25..151,100..1000&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n        #root { color: #111111; font-family: \"Roboto Flex\", system-ui, sans-serif; }\n        .bt-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }\n        .bt-line { line-height: 1.15; white-space: pre; text-align: center; }\n        .bt-char { display: inline-block; white-space: pre; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"breathing-text\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"bt-clip\" class=\"bt-stage clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\">\n          <div id=\"bt-line\" class=\"bt-line\" role=\"img\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/CustomEase.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n\n            var DEFS = [{\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Text\", \"description\": \"Word or short phrase that breathes.\", \"default\": \"breathing text\"}, {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Maximum text size in pixels. Longer text shrinks to fit the frame.\", \"default\": 120, \"min\": 24, \"max\": 400, \"step\": 1, \"unit\": \"px\"}, {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Color\", \"description\": \"Text color.\", \"default\": \"#111111\"}, {\"id\": \"from_weight\", \"type\": \"number\", \"role\": \"style\", \"label\": \"From weight\", \"description\": \"Variable-font weight (wght axis) the letters start from.\", \"default\": 100, \"min\": 100, \"max\": 1000, \"step\": 10}, {\"id\": \"to_weight\", \"type\": \"number\", \"role\": \"style\", \"label\": \"To weight\", \"description\": \"Weight the letters breathe to.\", \"default\": 800, \"min\": 100, \"max\": 1000, \"step\": 10}, {\"id\": \"from_slant\", \"type\": \"number\", \"role\": \"style\", \"label\": \"From slant\", \"description\": \"Slant axis value (slnt, 0 is upright) the letters start from.\", \"default\": 0, \"min\": -10, \"max\": 0, \"step\": 1, \"unit\": \"deg\"}, {\"id\": \"to_slant\", \"type\": \"number\", \"role\": \"style\", \"label\": \"To slant\", \"description\": \"Slant the letters breathe to.\", \"default\": -10, \"min\": -10, \"max\": 0, \"step\": 1, \"unit\": \"deg\"}, {\"id\": \"breath_duration\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Breath duration\", \"description\": \"Seconds for one breath in or out.\", \"default\": 1.5, \"min\": 0.2, \"max\": 6, \"step\": 0.1, \"unit\": \"s\"}, {\"id\": \"stagger\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Stagger\", \"description\": \"Seconds between neighbouring letters.\", \"default\": 0.08, \"min\": 0, \"max\": 0.5, \"step\": 0.01, \"unit\": \"s\"}, {\"id\": \"stagger_from\", \"type\": \"enum\", \"role\": \"motion\", \"label\": \"Stagger from\", \"description\": \"Where the wave of breathing starts.\", \"default\": \"first\", \"options\": [{\"value\": \"first\", \"label\": \"First letter\"}, {\"value\": \"last\", \"label\": \"Last letter\"}, {\"value\": \"center\", \"label\": \"Center\"}]}, {\"id\": \"repeat_delay\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Repeat delay\", \"description\": \"Pause between a breath in and the breath back.\", \"default\": 0.1, \"min\": 0, \"max\": 2, \"step\": 0.05, \"unit\": \"s\"}];\n            var root = document.getElementById(\"root\");\n            var raw = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\n            var D = parseFloat(root.dataset.duration || \"6\");\n            function V(id) {\n              var d = null;\n              for (var i = 0; i < DEFS.length; i++) if (DEFS[i].id === id) d = DEFS[i];\n              var v = raw[id];\n              if (v === undefined || v === null || (v === \"\" && d.type !== \"string\")) return d.default;\n              if (d.type === \"number\") { var n = Number(v); return Number.isFinite(n) ? Math.min(d.max, Math.max(d.min, n)) : d.default; }\n              if (d.type === \"boolean\") return v === true || v === \"true\";\n              if (d.type === \"enum\") { for (var j = 0; j < d.options.length; j++) if (String(d.options[j].value) === String(v)) return d.options[j].value; return d.default; }\n              if (d.type === \"string\") return typeof v === \"string\" ? v : d.default;\n              return typeof v === \"string\" && v ? v : d.default;\n            }\n            function mulberry32(a) { return function () { a |= 0; a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n            function hash3(a, b, c) { return mulberry32((a * 7919 + b * 104729 + c * 1299709) | 0)(); }\n            // Stagger delays in seconds: \"first\", \"last\", \"center\", \"random\" (seeded shuffle) or an index.\n            function stagger(n, from, step, seed) {\n              var out = [], i;\n              if (from === \"random\") {\n                var rng = mulberry32(seed || 7), idx = [];\n                for (i = 0; i < n; i++) idx.push(i);\n                for (i = n - 1; i > 0; i--) { var j = Math.floor(rng() * (i + 1)); var tmp = idx[i]; idx[i] = idx[j]; idx[j] = tmp; }\n                for (i = 0; i < n; i++) out[idx[i]] = i * step;\n                return out;\n              }\n              for (i = 0; i < n; i++) {\n                var k = from === \"last\" ? n - 1 - i : from === \"center\" ? Math.abs(Math.floor(n / 2) - i) : typeof from === \"number\" ? Math.abs(from - i) : i;\n                out.push(k * step);\n              }\n              return out;\n            }\n            // Damped spring from 0 to 1 (stiffness/damping/mass or duration/bounce, as Motion defines them).\n            function spring(o) {\n              var m = o.mass || 1, k, c;\n              if (o.duration !== undefined) { var w = (2 * Math.PI) / o.duration; k = w * w * m; c = 2 * (1 - (o.bounce || 0)) * Math.sqrt(k * m); }\n              else { k = o.stiffness; c = o.damping; }\n              var w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m));\n              function at(t) {\n                if (t <= 0) return 0;\n                if (Math.abs(z - 1) < 1e-6) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n                if (z < 1) { var wd = w0 * Math.sqrt(1 - z * z); return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t)); }\n                var s = Math.sqrt(z * z - 1), r1 = -w0 * (z - s), r2 = -w0 * (z + s);\n                return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n              }\n              var settle = 6;\n              for (var t = 0.02; t < 6; t += 0.02) {\n                var ok = true;\n                for (var u = t; u < Math.min(t + 0.3, 6); u += 0.05) if (Math.abs(1 - at(u)) > 0.002) { ok = false; break; }\n                if (ok) { settle = t; break; }\n              }\n              return { at: at, duration: settle };\n            }\n            function fitText(text) { return Array.from(text); }\n\n            var line = document.getElementById(\"bt-line\");\n            var text = V(\"text\") || \"breathing text\";\n            var chars = fitText(text).map(function (ch, i) {\n              var s = document.createElement(\"span\");\n              s.id = \"bt-char-\" + i; s.className = \"bt-char\"; s.textContent = ch;\n              line.appendChild(s); return s;\n            });\n            line.setAttribute(\"aria-label\", text);\n            line.style.color = V(\"color\");\n            line.style.fontSize = \"min(\" + V(\"font_size\") + \"px, calc(90cqw / \" + Math.max(1, chars.length * 0.62).toFixed(2) + \"))\";\n            var w0 = V(\"from_weight\"), w1 = V(\"to_weight\"), s0 = V(\"from_slant\"), s1 = V(\"to_slant\");\n            var dur = V(\"breath_duration\"), rep = V(\"repeat_delay\");\n            var delays = stagger(chars.length, V(\"stagger_from\"), V(\"stagger\"));\n            gsap.registerPlugin(CustomEase);\n            var ez = CustomEase.create(\"bt-ease\", \"M0,0 C0.42,0 0.58,1 1,1\");\n            var tl = gsap.timeline({ paused: true });\n            function draw(t) {\n              for (var i = 0; i < chars.length; i++) {\n                var tt = t - delays[i], p = 0;\n                if (tt > 0) {\n                  var period = dur + rep, k = Math.floor(tt / period), ph = tt - k * period;\n                  var e = ez(Math.min(1, ph / dur));\n                  p = k % 2 === 0 ? e : 1 - e;\n                }\n                chars[i].style.fontVariationSettings = \"'wght' \" + (w0 + (w1 - w0) * p).toFixed(1) + \", 'slnt' \" + (s0 + (s1 - s0) * p).toFixed(2);\n              }\n            }\n\n            var clock = { t: 0 };\n            tl.to(clock, { t: D, duration: D, ease: \"none\", onUpdate: function () { draw(clock.t); } }, 0);\n            draw(0);\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"breathing-text\"] = tl;\n\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
