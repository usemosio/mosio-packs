 "files": [
  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Short Slide Right\n\nThe whole phrase glides in from the left while words reveal in sequence through opacity.\n\nCategory: typography. Length: 2 s. WebGL: no.\n\nUse when:\n- A short headline should enter with horizontal momentum that reads as forward motion or progress.\n- Word-level opacity stagger is layered on a single group translation.\n\nAvoid when:\n- You are transitioning between two texts: use shared-axis-z or shared-axis-y.\n- You want vertical stacking motion: use short-slide-down.\n\nVariables:\n- text (string): Text, default \"Move with intent.\"\n- distance (number, 0-120): Distance, default 24\n- stagger_delay (number, 0-12): Stagger, default 3\n- font_size (number, 12-160): Font size, default 72\n- color (color): Color, default \"#171717\"\n- font_weight (enum): Font weight, default \"600\"\n\nSource: https://github.com/Remocn/remocn. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Short Slide Right\n\n  The whole phrase glides in from the left while words reveal in sequence through opacity.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/short-slide-right/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"short-slide-right\"\n  data-composition-duration=\"2\"\n  data-composition-variables='[\n    { \"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Text\", \"description\": \"Headline that glides in.\", \"default\": \"Move with intent.\" },\n    { \"id\": \"distance\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Distance\", \"description\": \"How far left of its place the phrase starts.\", \"default\": 24, \"min\": 0, \"max\": 120, \"step\": 1, \"unit\": \"px\" },\n    { \"id\": \"stagger_delay\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Stagger\", \"description\": \"Frames between each word's fade (30 fps).\", \"default\": 3, \"min\": 0, \"max\": 12, \"step\": 1, \"unit\": \"frames\" },\n    { \"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Maximum text size in pixels. Longer text shrinks to fit the frame.\", \"default\": 72, \"min\": 12, \"max\": 160, \"step\": 1, \"unit\": \"px\" },\n    { \"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Color\", \"description\": \"Text color.\", \"default\": \"#171717\" },\n    { \"id\": \"font_weight\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Font weight\", \"description\": \"Weight of the text.\", \"default\": \"600\", \"options\": [{\"value\": \"400\", \"label\": \"Regular\"}, {\"value\": \"500\", \"label\": \"Medium\"}, {\"value\": \"600\", \"label\": \"Semibold\"}, {\"value\": \"700\", \"label\": \"Bold\"}] }\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Short Slide Right</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          color: var(--color, #171717);\n          font-family: var(--font-display, Geist, system-ui, sans-serif);\n          pointer-events: none;\n        }\n        .ssr-stage {\n          position: absolute;\n          inset: 0;\n          display: flex;\n          align-items: center;\n          justify-content: center;\n        }\n        .ssr-line { display: inline-block; letter-spacing: -0.03em; line-height: 1.1; white-space: nowrap; }\n        .ssr-word { display: inline-block; margin-right: 0.25em; opacity: 0; white-space: pre; }\n        .ssr-word:last-child { margin-right: 0; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"short-slide-right\" data-duration=\"2\" data-fps=\"30\">\n        <div id=\"ssr-clip\" class=\"ssr-stage clip\" data-start=\"0\" data-duration=\"2\" data-track-index=\"0\">\n          <span id=\"ssr-line\" class=\"ssr-line\" role=\"img\"></span>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/CustomEase.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value.trim() ? value : fallback;\n            }\n            function pick(value, list, fallback) {\n              return list.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            gsap.registerPlugin(CustomEase);\n            function bz(id, a, b, c, d) {\n              return CustomEase.create(\"ssr-\" + id, \"M0,0 C\" + a + \",\" + b + \" \" + c + \",\" + d + \" 1,1\");\n            }\n            // interpolate(frame, [a, b], [from, to], { easing }) as a tween (frames at 30 fps).\n            function tw(tl, el, from, to, a, b, ease, keep) {\n              var t = Object.assign({}, to, { duration: (b - a) / 30, ease: ease || \"none\", immediateRender: !keep });\n              tl.fromTo(el, from, t, a / 30);\n            }\n            // Shrink an element's font size so it fits a fraction of the frame width.\n            function fit(el, size, frac) {\n              el.style.fontSize = size + \"px\";\n              var maxWidth = Math.max(1, root.clientWidth * frac);\n              if (el.scrollWidth > maxWidth) {\n                size = Math.max(12, size * (maxWidth / el.scrollWidth));\n                el.style.fontSize = size + \"px\";\n              }\n              return size;\n            }\n            var TOTAL = parseFloat(root.dataset.duration || \"2\");\n            function finish(tl) {\n              if (tl.duration() < TOTAL) tl.to({}, { duration: TOTAL - tl.duration() });\n              tl.seek(0);\n              window.__timelines = window.__timelines || {};\n              window.__timelines[\"short-slide-right\"] = tl;\n            }\n            var text = str(vars.text, \"Move with intent.\");\n            var weight = pick(vars.font_weight, [\"400\", \"500\", \"600\", \"700\"], \"600\");\n            if (typeof vars.color === \"string\" && vars.color) root.style.setProperty(\"--color\", vars.color);\n\n            var distance = num(vars.distance, 24, 0, 120);\n            var stagger = num(vars.stagger_delay, 3, 0, 12);\n            var line = document.getElementById(\"ssr-line\");\n            line.style.fontWeight = weight;\n            line.setAttribute(\"aria-label\", text);\n            var words = text.trim().split(/\\s+/).map(function (w, i) {\n              var s = document.createElement(\"span\");\n              s.id = \"ssr-word-\" + i;\n              s.className = \"ssr-word\";\n              s.textContent = w;\n              line.appendChild(s);\n              return s;\n            });\n            fit(line, num(vars.font_size, 72, 12, 160), 0.85);\n\n            var ease = bz(\"ease\", 0.2, 0.8, 0.2, 1);\n            var tl = gsap.timeline({ paused: true });\n            tw(tl, line, { x: -distance }, { x: 0 }, 0, 8, ease);\n            tw(tl, line, { filter: \"blur(1.2px)\" }, { filter: \"blur(0px)\" }, 0, 16, ease);\n            words.forEach(function (w, i) {\n              tw(tl, w, { opacity: 0 }, { opacity: 1 }, i * stagger, i * stagger + 6, ease);\n            });\n            finish(tl);\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
