   "content": "<!doctype html>\n<!--\n  Accordion Unfold\n\n  A tight paper zigzag unfolds sideways into a flat card with the logo printed across it. The placeholder lockup is a stand-in: a host prints its own logo by replacing the .au-print contents in the script.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/accordion-unfold/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"accordion-unfold\"\n  data-composition-duration=\"2.2\"\n  data-composition-variables='[\n    {\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Wordmark\", \"description\": \"Placeholder lockup text printed across the card.\", \"default\": \"studio\"},\n    {\"id\": \"panels\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Panels\", \"description\": \"Number of vertical pleats.\", \"default\": 6, \"min\": 2, \"max\": 12, \"step\": 1},\n    {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Paper\", \"description\": \"Paper color of the card.\", \"default\": \"#FFFFFF\"},\n    {\"id\": \"shade\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Shade\", \"description\": \"Darkness of the panels facing away from the light, 0 to 1.\", \"default\": 0.55, \"min\": 0, \"max\": 1, \"step\": 0.01},\n    {\"id\": \"background_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Stage color, also the lockup color printed on the paper.\", \"default\": \"#111111\"},\n    {\"id\": \"fold_angle\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Fold angle\", \"description\": \"Fold angle of each pleat at the start, in degrees.\", \"default\": 82, \"min\": 0, \"max\": 89, \"step\": 1, \"unit\": \"deg\"},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier.\", \"default\": 1, \"min\": 0.25, \"max\": 3, \"step\": 0.05}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Accordion Unfold</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        .au-lockup { display: flex; align-items: center; gap: 28px; }\n        .au-mark { width: 120px; height: 120px; border-radius: 32px; display: flex; align-items: center; justify-content: center; background: var(--mark); }\n        .au-dot { width: 36px; height: 36px; border-radius: 50%; background: var(--dot); }\n        .au-word { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Helvetica, Arial, sans-serif; font-size: 104px; font-weight: 800; letter-spacing: -0.04em; color: var(--text); white-space: nowrap; }\n        #root { background: var(--bg); }\n        .au-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; perspective: 1000px; }\n        .au-card { position: relative; transform-style: preserve-3d; }\n        .au-panel { position: absolute; top: 0; transform-origin: 0% 50%; transform-style: preserve-3d; }\n        .au-face { position: absolute; inset: 0; overflow: hidden; backface-visibility: hidden; background: var(--paper); }\n        .au-print { position: absolute; top: 0; display: flex; align-items: center; justify-content: center; }\n        .au-print .au-lockup { transform: scale(0.8); }\n        .au-shade { position: absolute; inset: 0; }\n        .au-flat { position: absolute; inset: 0; overflow: hidden; background: var(--paper); }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"accordion-unfold\" data-duration=\"2.2\" data-fps=\"30\">\n        <div id=\"au-clip\" class=\"au-stage clip\" data-start=\"0\" data-duration=\"2.2\" data-track-index=\"0\">\n          <div class=\"au-card\" id=\"au-card\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"accordion-unfold\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\nfunction col(v, f) { return typeof v === \"string\" && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v.trim()) ? v.trim() : f; }\nfunction bool(v, f) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : f; }\nvar FPS = 30;\nvar DUR = parseFloat(root.dataset.duration || \"2\");\nvar TOTAL = Math.round(DUR * FPS);\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction cl(x, a, b) { return Math.min(b, Math.max(a, x)); }\n// interpolate(x, [in...], [out...], easing): clamped on both sides, easing applied per segment.\nfunction interp(x, inp, out, easing) {\n  if (x <= inp[0]) return out[0];\n  if (x >= inp[inp.length - 1]) return out[out.length - 1];\n  var i = 0;\n  while (x > inp[i + 1]) i++;\n  var t = (x - inp[i]) / (inp[i + 1] - inp[i]);\n  if (easing) t = easing(t);\n  return out[i] + (out[i + 1] - out[i]) * t;\n}\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0; if (x >= 1) return 1;\n    var t = x;\n    for (var i = 0; i < 8; i++) {\n      var cx = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t - x;\n      var d = 3 * x1 * (1 - t) * (1 - t) - 6 * x1 * t * (1 - t) + 6 * x2 * t * (1 - t) - 3 * x2 * t * t + 3 * t * t;\n      if (Math.abs(cx) < 1e-6 || Math.abs(d) < 1e-6) break;\n      t -= cx / d;\n    }\n    t = cl(t, 0, 1);\n    return 3 * y1 * t * (1 - t) * (1 - t) + 3 * y2 * t * t * (1 - t) + t * t * t;\n  };\n}\nvar E = {\n  lin: function (t) { return t; },\n  quad: function (t) { return t * t; },\n  cubic: function (t) { return t * t * t; },\n  sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); }\n};\nfunction eOut(f) { return function (t) { return 1 - f(1 - t); }; }\nfunction eInOut(f) { return function (t) { return t < 0.5 ? f(2 * t) / 2 : 1 - f(2 - 2 * t) / 2; }; }\nvar outCubic = eOut(E.cubic), outQuad = eOut(E.quad), inCubic = E.cubic, inQuad = E.quad;\nvar inOutCubic = eInOut(E.cubic), inOutQuad = eInOut(E.quad), inOutSin = eInOut(E.sin), outSin = eOut(E.sin);\n// Damped spring from 0 to 1 (rest at 1, no initial velocity), frames at 30 fps.\nfunction spring(frame, cfg) {\n  if (frame <= 0) return 0;\n  var m = cfg.mass || 1, k = cfg.stiffness, c = cfg.damping;\n  var w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m)), t = frame / FPS;\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n  }\n  if (z === 1) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  var s = w0 * Math.sqrt(z * z - 1), r1 = -z * w0 + s, r2 = -z * w0 - s;\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\n// Seeded random: same string in, same number out.\nfunction rnd(seed) {\n  var sd = String(seed), h = 1779033703 ^ sd.length;\n  for (var i = 0; i < sd.length; i++) { h = Math.imul(h ^ sd.charCodeAt(i), 3432918353); h = (h << 13) | (h >>> 19); }\n  h = Math.imul(h ^ (h >>> 16), 2246822507); h = Math.imul(h ^ (h >>> 13), 3266489909); h ^= h >>> 16;\n  var a = (h >>> 0);\n  a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a);\n  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n}\nfunction rgb(h) {\n  h = h.replace(\"#\", \"\");\n  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];\n  return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];\n}\nfunction mixc(a, b, t) {\n  var x = rgb(a), y = rgb(b);\n  return \"rgb(\" + Math.round(lerp(x[0], y[0], t)) + \",\" + Math.round(lerp(x[1], y[1], t)) + \",\" + Math.round(lerp(x[2], y[2], t)) + \")\";\n}\nfunction rgba(h, a) { var x = rgb(h); return \"rgba(\" + x[0] + \",\" + x[1] + \",\" + x[2] + \",\" + a + \")\"; }\nvar SVGNS = \"http://www.w3.org/2000/svg\";\nfunction svgEl(tag, attrs, parent) {\n  var e = document.createElementNS(SVGNS, tag);\n  for (var k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\nfunction setA(e, attrs) { for (var k in attrs) e.setAttribute(k, attrs[k]); }\n// Drive draw(frame) from the timeline; frames run 0..frames over frames/30 seconds.\nfunction drive(draw, frames) {\n  var tl = gsap.timeline({ paused: true });\n  var clock = { frame: 0 };\n  tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n  draw(0);\n  return tl;\n}\nfunction finish(tl) {\n  if (tl.duration() < DUR) tl.to({}, { duration: DUR - tl.duration() });\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[NAME] = tl;\n}\n\n\nvar card = document.getElementById(\"au-card\");\nvar n = Math.round(num(vars.panels, 6, 2, 12)), paper = col(vars.color, \"#FFFFFF\"), shade = num(vars.shade, 0.55, 0, 1), bg = col(vars.background_color, \"#111111\"), foldAngle = num(vars.fold_angle, 82, 0, 89), speed = num(vars.speed, 1, 0, 4);\nvar wordText = str(vars.text, \"studio\");\nroot.style.setProperty(\"--bg\", bg); root.style.setProperty(\"--paper\", paper); root.style.setProperty(\"--mark\", bg); root.style.setProperty(\"--dot\", paper); root.style.setProperty(\"--text\", bg);\nvar W = root.clientWidth, H = root.clientHeight;\nvar cardW = Math.round(Math.min(W * 0.66, H * 1.3)), cardH = Math.round(Math.min(H * 0.4, cardW * 0.4)), pw = cardW / n;\nroot.querySelector(\".au-stage\").style.perspective = cardW * 1.8 + \"px\";\ncard.style.width = cardW + \"px\"; card.style.height = cardH + \"px\";\nvar START = 4;\nfunction printEl(offset) {\n  var d = document.createElement(\"div\"); d.className = \"au-print\";\n  d.style.left = -offset + \"px\"; d.style.width = cardW + \"px\"; d.style.height = cardH + \"px\";\n  d.innerHTML = '<div class=\"au-lockup\"><div class=\"au-mark\"><div class=\"au-dot\"></div></div><span class=\"au-word\"></span></div>';\n  d.querySelector(\".au-word\").textContent = wordText;\n  return d;\n}\nvar flat = document.createElement(\"div\"); flat.className = \"au-flat\"; flat.appendChild(printEl(0));\nvar panels = [], parent = card;\nfor (var i = 0; i < n; i++) {\n  var pn = document.createElement(\"div\"); pn.className = \"au-panel\";\n  pn.style.left = (i === 0 ? 0 : pw) + \"px\"; pn.style.width = pw + \"px\"; pn.style.height = cardH + \"px\";\n  var face = document.createElement(\"div\"); face.className = \"au-face\"; face.style.width = pw + 1 + \"px\";\n  face.appendChild(printEl(i * pw));\n  var sh = document.createElement(\"div\"); sh.className = \"au-shade\"; face.appendChild(sh);\n  pn.appendChild(face);\n  parent.appendChild(pn);\n  panels.push({ el: pn, shade: sh }); parent = pn;\n}\nvar first = panels[0].el;\nfunction draw(frame) {\n  var t = frame * speed;\n  var open = spring(t - START, { damping: 15, stiffness: 70, mass: 0.9 });\n  var theta = foldAngle * (1 - open), rad = (theta * Math.PI) / 180;\n  var shift = (cardW - cardW * Math.cos(rad)) / 2;\n  var lift = interp(t, [0, START + 2], [0.92, 1]);\n  card.style.opacity = interp(t, [0, 3], [0, 1]);\n  card.style.transform = \"translateX(\" + shift + \"px) scale(\" + lift + \")\";\n  var isFlat = Math.abs(theta) < 0.3;\n  if (isFlat) { if (!flat.parentNode) card.appendChild(flat); first.style.display = \"none\"; }\n  else { if (flat.parentNode) card.removeChild(flat); first.style.display = \"\"; }\n  panels.forEach(function (pn, i) {\n    var angle = i === 0 ? theta : (i % 2 === 1 ? -2 : 2) * theta;\n    var facing = i % 2 === 0 ? 1 : -1, tilt = Math.abs(Math.sin(rad));\n    var dark = facing > 0 ? shade * tilt : shade * 0.25 * tilt;\n    pn.el.style.transform = \"rotateY(\" + angle + \"deg)\";\n    pn.shade.style.background = facing > 0 ? \"linear-gradient(90deg, rgba(0,0,0,\" + dark * 0.6 + \"), rgba(0,0,0,\" + dark + \"))\" : \"linear-gradient(90deg, rgba(255,255,255,\" + 0.12 * tilt + \"), rgba(0,0,0,\" + dark + \"))\";\n  });\n}\nfinish(drive(draw, TOTAL));\n\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
