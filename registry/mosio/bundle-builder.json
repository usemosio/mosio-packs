  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Bundle Builder\n\nThree or four product tiles drop one by one into an open box while the total counts up, then a \"Hemat\" badge lands on the box and the total steps down to the bundle price. Products, prices and the saving are variables.\n\nCategory: commerce. Length: 6 s. WebGL: no.\n\nUse when:\n- Selling a bundle or package (paket hemat, hampers, combo) at a lower price than the items alone.\n- A shop wants to show what is inside a set and what it saves.\n\nAvoid when:\n- One product with an old and new price: use price-drop.\n- A price list: use menu-price-board.\n- A countdown to a limited sale: use fomo-limit-orders.\n\nVariables:\n- title (string): Box title, default \"Paket Hemat\"\n- products (string): Products, default \"Kopi susu|Rp18.000; Roti bakar|Rp15.000; Cookies|Rp12.000\"\n- total_label (string): Total label, default \"Total\"\n- saving (string): Saving, default \"Rp15.000\"\n- saving_label (string): Saving label, default \"Hemat\"\n- drop_gap (number, 0.4-1.4): Gap between drops, default 0.7\n- box_color (color): Box colour, default \"#e4e4e7\"\n- tile_color (color): Tile colour, default \"#ffffff\"\n- bg_color (color): Background, default \"#ffffff\"\n- text_color (color): Text colour, default \"#0a0a0a\"\n- muted_color (color): Muted colour, default \"#737373\"\n- main_color (color): Accent, default \"#2563eb\"\n- font_family (string): Font, default \"Geist\"\n- transparent (boolean): Transparent, default false\n\nSource: Mosio original. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Bundle Builder\n\n  Three or four product tiles drop one by one into an open box while the total counts up, then a \"Hemat\" badge lands on the box and the total steps down to the bundle price. Products, prices and the saving are variables.\n\n  An original usemosio/blocks block (MIT, see LICENSE).\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"bundle-builder\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[\n  {\n    \"id\": \"title\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Box title\",\n    \"description\": \"Printed on the front of the box.\",\n    \"default\": \"Paket Hemat\"\n  },\n  {\n    \"id\": \"products\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Products\",\n    \"description\": \"Three or four products separated by semicolons, each as name|price.\",\n    \"default\": \"Kopi susu|Rp18.000; Roti bakar|Rp15.000; Cookies|Rp12.000\"\n  },\n  {\n    \"id\": \"total_label\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Total label\",\n    \"description\": \"Small label above the running total.\",\n    \"default\": \"Total\"\n  },\n  {\n    \"id\": \"saving\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Saving\",\n    \"description\": \"Amount saved by buying the bundle. The total steps down by this at the end. Use 0 or leave empty for no saving.\",\n    \"default\": \"Rp15.000\"\n  },\n  {\n    \"id\": \"saving_label\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Saving label\",\n    \"description\": \"Word in front of the saving amount on the badge.\",\n    \"default\": \"Hemat\"\n  },\n  {\n    \"id\": \"drop_gap\",\n    \"type\": \"number\",\n    \"role\": \"motion\",\n    \"label\": \"Gap between drops\",\n    \"description\": \"Seconds between two products dropping.\",\n    \"default\": 0.7,\n    \"min\": 0.4,\n    \"max\": 1.4,\n    \"step\": 0.05\n  },\n  {\n    \"id\": \"box_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Box colour\",\n    \"description\": \"The box.\",\n    \"default\": \"#e4e4e7\"\n  },\n  {\n    \"id\": \"tile_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Tile colour\",\n    \"description\": \"Product tiles.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"bg_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Background\",\n    \"description\": \"Background.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"text_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Text colour\",\n    \"description\": \"Main text and outlines.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"muted_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Muted colour\",\n    \"description\": \"Secondary text and hairlines.\",\n    \"default\": \"#737373\"\n  },\n  {\n    \"id\": \"main_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Accent\",\n    \"description\": \"The saving badge: the one accent.\",\n    \"default\": \"#2563eb\"\n  },\n  {\n    \"id\": \"font_family\",\n    \"type\": \"string\",\n    \"role\": \"style\",\n    \"label\": \"Font\",\n    \"description\": \"Font family name. Geist is loaded by default; another family must be loaded by the host.\",\n    \"default\": \"Geist\"\n  },\n  {\n    \"id\": \"transparent\",\n    \"type\": \"boolean\",\n    \"role\": \"style\",\n    \"label\": \"Transparent\",\n    \"description\": \"Leave the background clear so the block sits over your own scene.\",\n    \"default\": false\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Bundle Builder</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute; inset: 0; overflow: hidden; container-type: size; pointer-events: none;\n          -webkit-font-smoothing: antialiased;\n          color: var(--bb-text); font-family: var(--FAM, Geist), system-ui, sans-serif; background: var(--bb-bg);\n        }\n        #root * { box-sizing: border-box; }\n        .bb-stage { position: absolute; inset: 0; --u: calc(100cqmin / 1080); }\n\n        .bb-wrap { position: absolute; left: 50%; top: 50%; transform-origin: 50% 50%; }\n        .bb-top { position: absolute; left: 0; right: 0; top: 0; text-align: center; }\n        .bb-tl { font-size: calc(var(--u) * 40); font-weight: 500; color: var(--bb-muted); }\n        .bb-total { font-size: calc(var(--u) * 190); font-weight: 700; letter-spacing: -0.055em; line-height: 1.05; font-variant-numeric: tabular-nums; white-space: nowrap; }\n        .bb-stage { position: absolute; left: 0; right: 0; }\n        .bb-back, .bb-front { position: absolute; left: 0; right: 0; }\n        .bb-back { bottom: 0; height: calc(var(--u) * 230); border-radius: calc(var(--u) * 28) calc(var(--u) * 28) calc(var(--u) * 36) calc(var(--u) * 36); background: color-mix(in srgb, var(--bb-box) 82%, #000); }\n        .bb-front { bottom: 0; height: calc(var(--u) * 150); border-radius: calc(var(--u) * 20) calc(var(--u) * 20) calc(var(--u) * 36) calc(var(--u) * 36); background: var(--bb-box); z-index: 5; display: flex; align-items: center; padding: 0 calc(var(--u) * 44); box-shadow: 0 calc(var(--u) * -6) calc(var(--u) * 14) rgba(0,0,0,0.06); }\n        .bb-ft { font-size: calc(var(--u) * 52); font-weight: 700; letter-spacing: -0.03em; }\n        .bb-tile { position: absolute; z-index: 3; height: calc(var(--u) * 330); border-radius: calc(var(--u) * 30); background: var(--bb-tile); border: calc(var(--u) * 2) solid rgba(10,10,10,0.1); box-shadow: 0 calc(var(--u) * 6) calc(var(--u) * 14) rgba(0,0,0,0.08); padding: calc(var(--u) * 24) calc(var(--u) * 20) 0; text-align: center; overflow: hidden; }\n        .bb-tn { font-size: calc(var(--u) * 38); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }\n        .bb-tp { margin-top: calc(var(--u) * 6); font-size: calc(var(--u) * 34); font-weight: 500; color: var(--bb-muted); font-variant-numeric: tabular-nums; }\n        .bb-tile svg { position: absolute; left: 50%; bottom: calc(var(--u) * 44); width: calc(var(--u) * 170); height: calc(var(--u) * 170); margin-left: calc(var(--u) * -85); }\n        .bb-badge { position: absolute; z-index: 6; right: calc(var(--u) * 28); bottom: calc(var(--u) * 52); padding: calc(var(--u) * 16) calc(var(--u) * 36); border-radius: calc(var(--u) * 60); background: var(--bb-main); color: #fff; font-size: calc(var(--u) * 54); font-weight: 700; letter-spacing: -0.02em; white-space: nowrap; transform: rotate(-6deg); font-variant-numeric: tabular-nums; box-shadow: 0 calc(var(--u) * 8) calc(var(--u) * 16) rgba(0,0,0,0.16); }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"bundle-builder\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"bb-clip\" class=\"bb-stage clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\">\n\n          <div class=\"bb-wrap\" id=\"bb-wrap\">\n            <div class=\"bb-top\"><div class=\"bb-tl\" id=\"bb-tl\"></div><div class=\"bb-total\" id=\"bb-total\"></div></div>\n            <div class=\"bb-stage\" id=\"bb-stage\"><div class=\"bb-back\"></div><div class=\"bb-front\"><span class=\"bb-ft\" id=\"bb-ft\"></span></div><div class=\"bb-badge\" id=\"bb-badge\"></div></div>\n          </div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() || {} : {};\n            function num(v, d, a, b) { var n = Number(v); return Number.isFinite(n) ? Math.min(b, Math.max(a, n)) : d; }\n            function str(v, d) { return typeof v === \"string\" && v.trim() ? v : d; }\n            function colr(v, d) { return typeof v === \"string\" && v.trim() && window.CSS && CSS.supports(\"color\", v.trim()) ? v.trim() : d; }\n            function bool(v, d) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : d; }\n            function el(tag, cls, parent, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; if (parent) parent.appendChild(e); return e; }\n            function svg(tag, attrs, parent) { var e = document.createElementNS(\"http://www.w3.org/2000/svg\", tag); for (var k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; }\n            function esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\"); }\n            function dots(n) { return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"); }\n            function rp(n) { return \"Rp\" + dots(n); }\n            function money(s) { var d = String(s).replace(/[^\\d]/g, \"\"); return d ? parseInt(d, 10) : 0; }\n            function list(s, d) { var a = String(str(s, d)).split(\";\").map(function (x) { return x.trim(); }).filter(Boolean); return a.length ? a : String(d).split(\";\").map(function (x) { return x.trim(); }); }\n            function mulberry(seed) { var a = seed >>> 0; return function () { a = (a + 0x6D2B79F5) >>> 0; var t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n            function setColors(p, c) { for (var k in c) root.style.setProperty(\"--\" + p + \"-\" + k, colr(vars[k + \"_color\"], c[k])); }\n            var fam = str(vars.font_family, \"Geist\");\n            root.style.setProperty(\"--FAM\", /^[\\w\\s-]+$/.test(fam) ? '\"' + fam + '\"' : \"Geist\");\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920, U = Math.min(W, H) / 1080, PORTRAIT = H > W;\n            if (bool(vars.transparent, false)) root.style.background = \"transparent\";\n\n            setColors(\"bb\", { bg: \"#ffffff\", text: \"#0a0a0a\", muted: \"#737373\", main: \"#2563eb\", box: \"#e4e4e7\", tile: \"#ffffff\" });\n\n\n            var u = U;\n            root.style.setProperty(\"--bb-box\", colr(vars.box_color, \"#e4e4e7\"));\n            root.style.setProperty(\"--bb-tile\", colr(vars.tile_color, \"#ffffff\"));\n            var prods = list(vars.products, \"Kopi susu|Rp18.000; Roti bakar|Rp15.000; Cookies|Rp12.000\").slice(0, 4).map(function (s) { var a = s.split(\"|\"); return { name: (a[0] || \"\").trim(), price: money(a[1] || \"0\") }; });\n            var n = prods.length, sum = prods.reduce(function (t, p) { return t + p.price; }, 0);\n            var saving = Math.min(sum, money(typeof vars.saving === \"string\" ? vars.saving : \"Rp15.000\"));\n            var savingLabel = str(vars.saving_label, \"Hemat\");\n            var gap = num(vars.drop_gap, 0.7, 0.4, 1.4);\n            document.getElementById(\"bb-tl\").textContent = str(vars.total_label, \"Total\");\n            document.getElementById(\"bb-ft\").textContent = str(vars.title, \"Paket Hemat\");\n            var totalEl = document.getElementById(\"bb-total\"), badge = document.getElementById(\"bb-badge\");\n            badge.textContent = savingLabel + \" \" + rp(saving);\n            if (!saving) badge.style.display = \"none\";\n            var gw = 960 * u, topH = 280 * u, ah = 560 * u, gh = topH + ah;\n            var wrap = document.getElementById(\"bb-wrap\"), stage = document.getElementById(\"bb-stage\");\n            wrap.style.width = gw + \"px\"; wrap.style.height = gh + \"px\";\n            stage.style.top = topH + \"px\"; stage.style.height = ah + \"px\";\n            var S = Math.min(1.3, (H * 0.88) / gh, (W * 0.94) / gw);\n            gsap.set(wrap, { xPercent: -50, yPercent: -50, scale: S });\n\n            var GLYPH = [\n              '<path d=\"M22 34h50l-5 44a8 8 0 0 1-8 7H35a8 8 0 0 1-8-7z\" fill=\"ART\"></path><path d=\"M72 42h6a10 10 0 0 1 0 20h-9\" fill=\"none\" stroke=\"ART\" stroke-width=\"6\" stroke-linecap=\"round\"></path><rect x=\"28\" y=\"40\" width=\"38\" height=\"7\" rx=\"3\" fill=\"DET\"></rect>',\n              '<rect x=\"14\" y=\"36\" width=\"72\" height=\"46\" rx=\"20\" fill=\"ART\"></rect><path d=\"M34 40v30M50 40v30M66 40v30\" stroke=\"DET\" stroke-width=\"5\" stroke-linecap=\"round\"></path>',\n              '<circle cx=\"50\" cy=\"58\" r=\"38\" fill=\"ART\"></circle><circle cx=\"38\" cy=\"48\" r=\"4.5\" fill=\"DET\"></circle><circle cx=\"60\" cy=\"44\" r=\"4.5\" fill=\"DET\"></circle><circle cx=\"64\" cy=\"66\" r=\"4.5\" fill=\"DET\"></circle><circle cx=\"42\" cy=\"70\" r=\"4.5\" fill=\"DET\"></circle>',\n              '<rect x=\"24\" y=\"30\" width=\"52\" height=\"12\" rx=\"5\" fill=\"DET\"></rect><rect x=\"20\" y=\"42\" width=\"60\" height=\"46\" rx=\"12\" fill=\"ART\"></rect><rect x=\"30\" y=\"56\" width=\"40\" height=\"16\" rx=\"5\" fill=\"DET\"></rect>'\n            ];\n            var art = \"#d4d4d8\", det = \"rgba(10,10,10,0.2)\";\n            var gap2 = 20 * u, tw = Math.min(250 * u, (gw - 40 * u - (n - 1) * gap2) / n);\n            var rowW = n * tw + (n - 1) * gap2, x0 = (gw - rowW) / 2, rnd = mulberry(9);\n            var tiles = [];\n            prods.forEach(function (p, i) {\n              var t = el(\"div\", \"bb-tile\", stage);\n              t.style.width = tw + \"px\"; t.style.left = x0 + i * (tw + gap2) + \"px\"; t.style.top = ah - 100 * u - 330 * u + \"px\";\n              el(\"div\", \"bb-tn\", t).textContent = p.name; el(\"div\", \"bb-tp\", t).textContent = rp(p.price);\n              var sv = svg(\"svg\", { viewBox: \"0 0 100 100\" }, t); sv.innerHTML = GLYPH[i % 4].replace(/ART/g, art).replace(/DET/g, det);\n              tiles.push({ el: t, rot: Math.round((rnd() - 0.5) * 5 * 10) / 10 });\n            });\n\n            var counter = { v: 0 };\n            function show(v) { totalEl.textContent = rp(Math.round(v / 500) * 500); }\n            show(0);\n            var tl = gsap.timeline({ paused: true });\n            tl.fromTo(\".bb-top\", { y: -30 * u, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: \"power3.out\" }, 0.1);\n            tl.fromTo([\".bb-back\", \".bb-front\"], { y: 80 * u, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, ease: \"power3.out\" }, 0.2);\n            var cum = 0, t0 = 0.9, last = t0;\n            tiles.forEach(function (o, i) {\n              var t = t0 + i * gap, d = 0.42;\n              tl.fromTo(o.el, { y: -(topH + ah + 900 * u), rotation: o.rot * 4, opacity: 1 }, { y: 0, rotation: o.rot, duration: d, ease: \"power2.in\" }, t);\n              tl.to(o.el, { y: -16 * u, duration: 0.11, ease: \"power2.out\" }, t + d);\n              tl.to(o.el, { y: 0, duration: 0.11, ease: \"power2.in\" }, t + d + 0.11);\n              var from = cum; cum += prods[i].price;\n              tl.fromTo(counter, { v: from }, { v: cum, duration: 0.35, ease: \"power2.out\", immediateRender: false, onUpdate: function () { show(counter.v); } }, t + d - 0.05);\n              tl.fromTo(totalEl, { scale: 1 }, { scale: 1.04, duration: 0.08, ease: \"power2.out\" }, t + d);\n              tl.to(totalEl, { scale: 1, duration: 0.2, ease: \"power2.out\" }, t + d + 0.08);\n              last = t + d + 0.3;\n            });\n            tl.set(totalEl, { transformOrigin: \"50% 60%\" }, 0);\n            var tb = last + 0.15;\n            if (saving) {\n              tl.fromTo(badge, { scale: 2.2, opacity: 0, rotation: -14 }, { scale: 1, opacity: 1, rotation: -6, duration: 0.22, ease: \"power3.in\" }, tb);\n              tl.to(stage, { y: 6 * u, duration: 0.06, ease: \"power2.out\" }, tb + 0.22);\n              tl.to(stage, { y: 0, duration: 0.3, ease: \"back.out(2.4)\" }, tb + 0.28);\n              var c2 = { v: sum };\n              tl.fromTo(c2, { v: sum }, { v: sum - saving, duration: 0.8, ease: \"power2.inOut\", immediateRender: false, onUpdate: function () { show(c2.v); } }, tb + 0.3);\n            }\n\n            var total = parseFloat(root.dataset.duration || \"6\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"bundle-builder\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
