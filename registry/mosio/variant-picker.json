   "content": "<!doctype html>\n<!--\n  Variant Picker\n\n  A product card with colour swatches and sizes: a cursor taps one colour and one size, the product shape changes tint, a ring moves to the chosen swatch and the chosen size fills. Product, price, colours, sizes and the two choices are variables.\n\n  An original usemosio/blocks block (MIT, see LICENSE).\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"variant-picker\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[\n  {\n    \"id\": \"product\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Product name\",\n    \"description\": \"Product name on the card.\",\n    \"default\": \"Kaos Polos\"\n  },\n  {\n    \"id\": \"price\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Price\",\n    \"description\": \"Price on the card.\",\n    \"default\": \"Rp89.000\"\n  },\n  {\n    \"id\": \"colors\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Colours\",\n    \"description\": \"Colours separated by semicolons, each as name|#hex, two to five.\",\n    \"default\": \"Hitam|#171717; Krem|#e5dcc8; Sage|#8da08b\"\n  },\n  {\n    \"id\": \"color_pick\",\n    \"type\": \"number\",\n    \"role\": \"content\",\n    \"label\": \"Colour tapped\",\n    \"description\": \"Which colour the cursor taps (1 is the first).\",\n    \"default\": 3,\n    \"min\": 1,\n    \"max\": 5,\n    \"step\": 1\n  },\n  {\n    \"id\": \"sizes\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Sizes\",\n    \"description\": \"Sizes separated by semicolons, two to five.\",\n    \"default\": \"S; M; L; XL\"\n  },\n  {\n    \"id\": \"size_pick\",\n    \"type\": \"number\",\n    \"role\": \"content\",\n    \"label\": \"Size tapped\",\n    \"description\": \"Which size the cursor taps (1 is the first).\",\n    \"default\": 3,\n    \"min\": 1,\n    \"max\": 5,\n    \"step\": 1\n  },\n  {\n    \"id\": \"color_label\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Colour label\",\n    \"description\": \"Label above the swatches.\",\n    \"default\": \"Warna\"\n  },\n  {\n    \"id\": \"size_label\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Size label\",\n    \"description\": \"Label above the sizes.\",\n    \"default\": \"Ukuran\"\n  },\n  {\n    \"id\": \"panel_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Panel colour\",\n    \"description\": \"Background behind the product shape.\",\n    \"default\": \"#f4f4f5\"\n  },\n  {\n    \"id\": \"bg_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Background\",\n    \"description\": \"Background.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"text_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Text colour\",\n    \"description\": \"Main text and outlines.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"muted_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Muted colour\",\n    \"description\": \"Secondary text and hairlines.\",\n    \"default\": \"#737373\"\n  },\n  {\n    \"id\": \"main_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Accent\",\n    \"description\": \"The selected swatch ring and size: the one accent.\",\n    \"default\": \"#2563eb\"\n  },\n  {\n    \"id\": \"font_family\",\n    \"type\": \"string\",\n    \"role\": \"style\",\n    \"label\": \"Font\",\n    \"description\": \"Font family name. Geist is loaded by default; another family must be loaded by the host.\",\n    \"default\": \"Geist\"\n  },\n  {\n    \"id\": \"transparent\",\n    \"type\": \"boolean\",\n    \"role\": \"style\",\n    \"label\": \"Transparent\",\n    \"description\": \"Leave the background clear so the block sits over your own scene.\",\n    \"default\": false\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Variant Picker</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute; inset: 0; overflow: hidden; container-type: size; pointer-events: none;\n          -webkit-font-smoothing: antialiased;\n          color: var(--vp-text); font-family: var(--FAM, Geist), system-ui, sans-serif; background: var(--vp-bg);\n        }\n        #root * { box-sizing: border-box; }\n        .vp-stage { position: absolute; inset: 0; --u: calc(100cqmin / 1080); }\n\n        .vp-wrap { position: absolute; left: 50%; top: 50%; transform-origin: 50% 50%; }\n        .vp-card { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; border-radius: calc(var(--u) * 48); background: #fff; border: calc(var(--u) * 2) solid rgba(10,10,10,0.1); box-shadow: 0 calc(var(--u) * 16) calc(var(--u) * 40) rgba(0,0,0,0.09); overflow: hidden; }\n        .vp-panel { flex: none; background: var(--vp-panel); display: flex; align-items: center; justify-content: center; }\n        .vp-panel svg { width: 78%; height: 78%; max-width: calc(var(--u) * 520); }\n        .vp-det { flex: 1; padding: calc(var(--u) * 48); display: flex; flex-direction: column; justify-content: center; gap: calc(var(--u) * 34); min-width: 0; }\n        .vp-nr { display: flex; align-items: baseline; justify-content: space-between; gap: calc(var(--u) * 20); }\n        .vp-name { font-size: calc(var(--u) * 62); font-weight: 700; letter-spacing: -0.04em; }\n        .vp-price { font-size: calc(var(--u) * 52); font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }\n        .vp-lr { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: calc(var(--u) * 18); font-size: calc(var(--u) * 34); font-weight: 600; }\n        .vp-lr .vp-v { position: relative; display: inline-block; color: var(--vp-muted); font-weight: 500; }\n        .vp-v span { display: inline-block; white-space: nowrap; }\n        .vp-v .vp-b { position: absolute; right: 0; top: 0; opacity: 0; color: var(--vp-text); font-weight: 600; }\n        .vp-sw { position: relative; display: flex; gap: calc(var(--u) * 26); }\n        .vp-sw i { display: block; width: calc(var(--u) * 80); height: calc(var(--u) * 80); border-radius: 50%; border: calc(var(--u) * 2) solid rgba(10,10,10,0.16); }\n        .vp-ring { position: absolute; left: 0; top: 0; width: calc(var(--u) * 100); height: calc(var(--u) * 100); margin: calc(var(--u) * -10) 0 0 calc(var(--u) * -10); border-radius: 50%; border: calc(var(--u) * 5) solid var(--vp-main); }\n        .vp-sz { display: flex; gap: calc(var(--u) * 18); }\n        .vp-chip { position: relative; min-width: calc(var(--u) * 118); height: calc(var(--u) * 88); padding: 0 calc(var(--u) * 24); display: flex; align-items: center; justify-content: center; border-radius: calc(var(--u) * 24); border: calc(var(--u) * 3) solid rgba(10,10,10,0.16); font-size: calc(var(--u) * 38); font-weight: 600; background: #fff; color: var(--vp-text); }\n        .vp-chip b { position: absolute; inset: calc(var(--u) * -3); border-radius: calc(var(--u) * 24); background: var(--vp-main); opacity: 0; }\n        .vp-chip span { position: relative; }\n        .vp-cur { position: absolute; left: 0; top: 0; width: calc(var(--u) * 64); height: calc(var(--u) * 64); z-index: 9; transform-origin: 0 0; filter: drop-shadow(0 calc(var(--u) * 4) calc(var(--u) * 6) rgba(0,0,0,0.25)); }\n        .vp-tap { position: absolute; width: calc(var(--u) * 90); height: calc(var(--u) * 90); margin: calc(var(--u) * -45) 0 0 calc(var(--u) * -45); border-radius: 50%; border: calc(var(--u) * 4) solid var(--vp-text); opacity: 0; z-index: 8; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"variant-picker\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"vp-clip\" class=\"vp-stage clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\">\n\n          <div class=\"vp-wrap\" id=\"vp-wrap\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() || {} : {};\n            function num(v, d, a, b) { var n = Number(v); return Number.isFinite(n) ? Math.min(b, Math.max(a, n)) : d; }\n            function str(v, d) { return typeof v === \"string\" && v.trim() ? v : d; }\n            function colr(v, d) { return typeof v === \"string\" && v.trim() && window.CSS && CSS.supports(\"color\", v.trim()) ? v.trim() : d; }\n            function bool(v, d) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : d; }\n            function el(tag, cls, parent, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; if (parent) parent.appendChild(e); return e; }\n            function svg(tag, attrs, parent) { var e = document.createElementNS(\"http://www.w3.org/2000/svg\", tag); for (var k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; }\n            function esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\"); }\n            function dots(n) { return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"); }\n            function rp(n) { return \"Rp\" + dots(n); }\n            function money(s) { var d = String(s).replace(/[^\\d]/g, \"\"); return d ? parseInt(d, 10) : 0; }\n            function list(s, d) { var a = String(str(s, d)).split(\";\").map(function (x) { return x.trim(); }).filter(Boolean); return a.length ? a : String(d).split(\";\").map(function (x) { return x.trim(); }); }\n            function mulberry(seed) { var a = seed >>> 0; return function () { a = (a + 0x6D2B79F5) >>> 0; var t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n            function setColors(p, c) { for (var k in c) root.style.setProperty(\"--\" + p + \"-\" + k, colr(vars[k + \"_color\"], c[k])); }\n            var fam = str(vars.font_family, \"Geist\");\n            root.style.setProperty(\"--FAM\", /^[\\w\\s-]+$/.test(fam) ? '\"' + fam + '\"' : \"Geist\");\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920, U = Math.min(W, H) / 1080, PORTRAIT = H > W;\n            if (bool(vars.transparent, false)) root.style.background = \"transparent\";\n\n            setColors(\"vp\", { bg: \"#ffffff\", text: \"#0a0a0a\", muted: \"#737373\", main: \"#2563eb\", panel: \"#f4f4f5\" });\n\n\n            var u = U, wrap = document.getElementById(\"vp-wrap\");\n            root.style.setProperty(\"--vp-panel\", colr(vars.panel_color, \"#f4f4f5\"));\n            var colors = list(vars.colors, \"Hitam|#171717; Krem|#e5dcc8; Sage|#8da08b\").slice(0, 5).map(function (s) { var a = s.split(\"|\"); return { name: (a[0] || \"\").trim(), hex: colr(a[1], \"#8da08b\") }; });\n            if (colors.length < 2) colors = [{ name: \"Hitam\", hex: \"#171717\" }, { name: \"Sage\", hex: \"#8da08b\" }];\n            var sizes = list(vars.sizes, \"S; M; L; XL\").slice(0, 5); if (sizes.length < 2) sizes = [\"M\", \"L\"];\n            var cp = Math.min(colors.length, Math.round(num(vars.color_pick, 3, 1, 5))) - 1, sp = Math.min(sizes.length, Math.round(num(vars.size_pick, 3, 1, 5))) - 1;\n            var gw = PORTRAIT ? 880 * u : 1500 * u, gh = PORTRAIT ? 1060 * u : 700 * u;\n            wrap.style.width = gw + \"px\"; wrap.style.height = gh + \"px\";\n            var card = el(\"div\", \"vp-card\", wrap);\n            var panel = el(\"div\", \"vp-panel\", card);\n            if (PORTRAIT) { card.style.flexDirection = \"column\"; panel.style.height = 520 * u + \"px\"; panel.style.width = \"100%\"; } else { panel.style.width = 640 * u + \"px\"; panel.style.height = \"100%\"; }\n            var tsv = svg(\"svg\", { viewBox: \"0 0 200 200\" }, panel);\n            var shape = svg(\"path\", { d: \"M70 22 L38 36 L8 74 L38 96 L52 82 L52 178 L148 178 L148 82 L162 96 L192 74 L162 36 L130 22 C124 38 112 46 100 46 C88 46 76 38 70 22 Z\" }, tsv);\n            svg(\"path\", { d: \"M70 22 C76 38 88 46 100 46 C112 46 124 38 130 22 C124 50 76 50 70 22 Z\", fill: \"rgba(0,0,0,0.16)\" }, tsv);\n            shape.style.fill = colors[0].hex;\n            var det = el(\"div\", \"vp-det\", card);\n            var nr = el(\"div\", \"vp-nr\", det); el(\"span\", \"vp-name\", nr).textContent = str(vars.product, \"Kaos Polos\"); el(\"span\", \"vp-price\", nr).textContent = str(vars.price, \"Rp89.000\");\n            function labelRow(label, a, b) {\n              var blk = el(\"div\", \"\", det), lr = el(\"div\", \"vp-lr\", blk);\n              el(\"span\", \"\", lr).textContent = label;\n              var v = el(\"span\", \"vp-v\", lr); var sa = el(\"span\", \"vp-a\", v); sa.textContent = a; var sb = el(\"span\", \"vp-b\", v); sb.textContent = b;\n              return { blk: blk, a: sa, b: sb };\n            }\n            var rc = labelRow(str(vars.color_label, \"Warna\"), colors[0].name, colors[cp].name);\n            var sw = el(\"div\", \"vp-sw\", rc.blk), swEls = colors.map(function (c) { var i = el(\"i\", \"\", sw); i.style.background = c.hex; return i; });\n            var ring = el(\"div\", \"vp-ring\", sw);\n            var rs = labelRow(str(vars.size_label, \"Ukuran\"), \"Pilih\", sizes[sp]);\n            var sz = el(\"div\", \"vp-sz\", rs.blk), chips = sizes.map(function (s) { var c = el(\"div\", \"vp-chip\", sz); el(\"b\", \"\", c); el(\"span\", \"\", c).textContent = s; return c; });\n\n            // Measure target points (in wrap coordinates) before scaling.\n            var wr = wrap.getBoundingClientRect();\n            function centre(e) { var r = e.getBoundingClientRect(); return { x: r.left - wr.left + r.width / 2, y: r.top - wr.top + r.height / 2 }; }\n            var pSw = centre(swEls[cp]), pChip = centre(chips[sp]), p0 = centre(swEls[0]);\n            var S = Math.min(1.3, (H * 0.88) / gh, (W * 0.94) / gw);\n            gsap.set(wrap, { xPercent: -50, yPercent: -50, scale: S });\n            ring.style.left = swEls[0].offsetLeft + \"px\";\n            var ringDx = swEls[cp].offsetLeft - swEls[0].offsetLeft;\n\n            var cur = el(\"div\", \"vp-cur\", wrap);\n            cur.innerHTML = '<svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\"><path d=\"M3 2 L3 18.5 L7.6 14.4 L10.6 21 L13.4 19.8 L10.5 13.3 L16.6 13 Z\" fill=\"#0a0a0a\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linejoin=\"round\"></path></svg>';\n            var tap = el(\"div\", \"vp-tap\", wrap);\n            var startX = gw - 140 * u, startY = gh - 120 * u;\n            gsap.set(cur, { x: startX, y: startY, opacity: 0 });\n\n            var tl = gsap.timeline({ paused: true });\n            tl.fromTo(card, { y: 50 * u, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: \"power3.out\" }, 0.1);\n            tl.fromTo(tsv, { scale: 0.85, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.6, ease: \"power3.out\" }, 0.35);\n            tl.fromTo(det.children, { y: 24 * u, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: \"power3.out\", stagger: 0.1 }, 0.5);\n            tl.fromTo(ring, { scale: 0.6, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.4, ease: \"back.out(1.6)\" }, 1.0);\n            // Cursor to the colour swatch.\n            var t1 = 1.4, d1 = 0.8;\n            tl.to(cur, { opacity: 1, duration: 0.2 }, t1 - 0.1);\n            tl.to(cur, { x: pSw.x - 6 * u, y: pSw.y - 4 * u, duration: d1, ease: \"power2.inOut\" }, t1);\n            var tt = t1 + d1;\n            function press(t, pt) {\n              tl.to(cur, { scale: 0.82, duration: 0.09, ease: \"power2.out\" }, t);\n              tl.to(cur, { scale: 1, duration: 0.18, ease: \"back.out(2)\" }, t + 0.09);\n              tl.fromTo(tap, { x: pt.x, y: pt.y, scale: 0.4, opacity: 0.45 }, { x: pt.x, y: pt.y, scale: 1.3, opacity: 0, duration: 0.5, ease: \"power2.out\", immediateRender: false }, t + 0.04);\n            }\n            press(tt, pSw);\n            if (cp !== 0) {\n              tl.to(ring, { x: ringDx, duration: 0.3, ease: \"power3.out\" }, tt + 0.06);\n              tl.to(shape, { fill: colors[cp].hex, duration: 0.5, ease: \"power2.out\" }, tt + 0.06);\n              tl.fromTo(tsv, { rotation: 0 }, { rotation: 0, duration: 0.01 }, tt);\n              tl.to(tsv, { scale: 1.05, duration: 0.18, ease: \"power2.out\" }, tt + 0.08);\n              tl.to(tsv, { scale: 1, duration: 0.3, ease: \"power2.out\" }, tt + 0.26);\n              tl.to(rc.a, { opacity: 0, duration: 0.2 }, tt + 0.06); tl.to(rc.b, { opacity: 1, duration: 0.2 }, tt + 0.1);\n              tl.set(rc.a, { opacity: 1 }, 0); \n            } else { tl.to(rc.a, { opacity: 0, duration: 0.01 }, tt); tl.to(rc.b, { opacity: 1, duration: 0.01 }, tt); }\n            // Cursor to the size chip.\n            var t2 = tt + 0.55, d2 = 0.75;\n            tl.to(cur, { x: pChip.x - 6 * u, y: pChip.y - 4 * u, duration: d2, ease: \"power2.inOut\" }, t2);\n            var t3 = t2 + d2;\n            press(t3, pChip);\n            tl.to(chips[sp].firstChild, { opacity: 1, duration: 0.2, ease: \"power2.out\" }, t3 + 0.06);\n            tl.to(chips[sp].lastChild, { color: \"#ffffff\", duration: 0.2 }, t3 + 0.06);\n            tl.fromTo(chips[sp], { scale: 1 }, { scale: 1.08, duration: 0.12, ease: \"power2.out\" }, t3 + 0.08);\n            tl.to(chips[sp], { scale: 1, duration: 0.3, ease: \"back.out(2)\" }, t3 + 0.2);\n            tl.to(rs.a, { opacity: 0, duration: 0.2 }, t3 + 0.06); tl.to(rs.b, { opacity: 1, duration: 0.2 }, t3 + 0.1);\n            tl.to(cur, { x: \"+=\" + 90 * u, y: \"+=\" + 70 * u, opacity: 0, duration: 0.6, ease: \"power2.in\" }, t3 + 0.9);\n\n            var total = parseFloat(root.dataset.duration || \"6\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"variant-picker\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
