   "content": "<!doctype html>\n<!--\n  Release Teaser\n\n  A sixteen-second release announcement: five short statements resolve from the center outward over an\n  extreme close-up of a dark, beveled open ring, then the camera pulls back to the ring behind the\n  release lockup and the light recedes while the name holds. Silent: the host adds sound.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn-templates/release-teaser/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"release-teaser\"\n  data-composition-duration=\"16.016\"\n  data-composition-variables='[\n    { \"id\": \"brand_name\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Brand name\", \"description\": \"Name in the final release lockup.\", \"default\": \"Orvio\" },\n    { \"id\": \"release\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Release\", \"description\": \"Version suffix after the name; leave empty to hide it.\", \"default\": \"2\" },\n    { \"id\": \"tagline\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Tagline\", \"description\": \"Supporting line under the lockup.\", \"default\": \"Your next chapter starts here.\" },\n    { \"id\": \"statement_1\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Statement 1\", \"description\": \"First statement (0 to 1.7 s). Use a line break for two lines.\", \"default\": \"Start with an idea\" },\n    { \"id\": \"statement_2\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Statement 2\", \"description\": \"Second statement (1.7 to 3.5 s).\", \"default\": \"Make room\\nfor better work\" },\n    { \"id\": \"statement_3\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Statement 3\", \"description\": \"Third statement (3.5 to 5.4 s).\", \"default\": \"Bring every detail to life\" },\n    { \"id\": \"statement_4\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Statement 4\", \"description\": \"Fourth statement (5.4 to 7.4 s).\", \"default\": \"Move together.\\nGo further.\" },\n    { \"id\": \"statement_5\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Statement 5\", \"description\": \"Fifth statement (7.4 to 10.2 s), before the release reveal.\", \"default\": \"A fresh chapter.\\nNo starting over.\" },\n    { \"id\": \"accent_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent\", \"description\": \"Mark and the ring's edge lighting.\", \"default\": \"#9BC8DD\" },\n    { \"id\": \"background\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Background behind the ring.\", \"default\": \"#050709\" },\n    { \"id\": \"surface\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Surface\", \"description\": \"Base color of the ring's material.\", \"default\": \"#151C22\" },\n    { \"id\": \"foreground\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Text\", \"description\": \"Statements and the release title.\", \"default\": \"#F2F5F7\" },\n    { \"id\": \"muted\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Muted text\", \"description\": \"Tagline color.\", \"default\": \"#A4ADB5\" },\n    { \"id\": \"light_intensity\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Light intensity\", \"description\": \"Strength of the ring's edge highlights.\", \"default\": 1, \"min\": 0, \"max\": 2, \"step\": 0.05 }\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Release Teaser</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Inter:wght@500;600&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n          background: var(--rt-bg, #050709);\n          font-family: Inter, system-ui, sans-serif;\n          -webkit-font-smoothing: antialiased;\n        }\n        .rt-clip { position: absolute; inset: 0; }\n        .rt-ring-wrap { position: absolute; inset: 0; }\n        .rt-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }\n        .rt-stage { position: absolute; left: 0; top: 0; transform-origin: 0 0; overflow: hidden; }\n        .rt-statement {\n          position: absolute;\n          inset: 0;\n          display: none;\n          flex-direction: column;\n          justify-content: center;\n          align-items: center;\n          font-weight: 500;\n          line-height: 1.13;\n        }\n        .rt-line { white-space: pre; text-align: center; min-height: 1.13em; }\n        .rt-char { display: inline-block; white-space: pre; }\n        .rt-lockup {\n          position: absolute;\n          inset: 0;\n          display: none;\n          flex-direction: column;\n          align-items: center;\n          justify-content: center;\n        }\n        .rt-title-row { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }\n        .rt-mark { width: 34px; height: 34px; flex-shrink: 0; }\n        .rt-title { font-weight: 600; line-height: 1; white-space: pre; text-align: center; }\n        .rt-tagline { line-height: 1.3; white-space: pre; text-align: center; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"release-teaser\" data-duration=\"16.016\" data-fps=\"30\">\n        <div id=\"rt-clip\" class=\"rt-clip clip\" data-start=\"0\" data-duration=\"16.016\" data-track-index=\"0\">\n          <div id=\"rt-ring-wrap\" class=\"rt-ring-wrap\"><canvas id=\"rt-canvas\" class=\"rt-canvas\"></canvas></div>\n          <div id=\"rt-stage\" class=\"rt-stage\">\n            <div id=\"rt-statements\"></div>\n            <div id=\"rt-lockup\" class=\"rt-lockup\">\n              <div class=\"rt-title-row\">\n                <svg class=\"rt-mark\" viewBox=\"-240 -240 480 480\" fill=\"none\" aria-hidden=\"true\">\n                  <path id=\"rt-mark-path\" d=\"M209.23 -67.98 A220 220 0 1 1 116.58 -186.57 L71.01 -113.64 A134 134 0 1 0 127.44 -41.41 Z\" />\n                </svg>\n                <div id=\"rt-title\" class=\"rt-title\"></div>\n              </div>\n              <div id=\"rt-tagline\" class=\"rt-tagline\"></div>\n            </div>\n          </div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value.trim() ? value.trim() : fallback;\n            }\n\n            var STATEMENTS = [\n              \"Start with an idea\",\n              \"Make room\\nfor better work\",\n              \"Bring every detail to life\",\n              \"Move together.\\nGo further.\",\n              \"A fresh chapter.\\nNo starting over.\"\n            ];\n            var statements = STATEMENTS.map(function (fallback, i) {\n              return str(vars[\"statement_\" + (i + 1)], fallback);\n            });\n            var brandName = str(vars.brand_name, \"Orvio\");\n            // An explicit empty release hides the version suffix.\n            var release = typeof vars.release === \"string\" ? vars.release.trim() : \"2\";\n            var tagline = str(vars.tagline, \"Your next chapter starts here.\");\n            var theme = {\n              background: str(vars.background, \"#050709\"),\n              surface: str(vars.surface, \"#151C22\"),\n              foreground: str(vars.foreground, \"#F2F5F7\"),\n              muted: str(vars.muted, \"#A4ADB5\"),\n              accent: str(vars.accent_color, \"#9BC8DD\")\n            };\n            var lightIntensity = num(vars.light_intensity, 1, 0, 2);\n            root.style.setProperty(\"--rt-bg\", theme.background);\n\n            // The design space keeps the short side at 540 units, so a 1920×1080 frame is the\n            // original 960×540 layout and a vertical frame gets a 540-wide stage.\n            var CW = root.clientWidth || 1080;\n            var CH = root.clientHeight || 1920;\n            var S = Math.min(CW, CH) / 540;\n            var W = CW / S;\n            var H = CH / S;\n            var OX = (W - 960) / 2;\n            var OY = (H - 540) / 2;\n            var stage = document.getElementById(\"rt-stage\");\n            stage.style.width = W + \"px\";\n            stage.style.height = H + \"px\";\n            stage.style.transform = \"scale(\" + S + \")\";\n\n            // Picture clock: a doubled NTSC rate, 960 frames in 16.016 seconds.\n            var REF_FPS = 60000 / 1001;\n\n            function clamp01(v) { return Math.max(0, Math.min(1, v)); }\n            function bezier(x1, y1, x2, y2) {\n              return function (x) {\n                if (x <= 0) return 0;\n                if (x >= 1) return 1;\n                var lo = 0, hi = 1, t = x;\n                for (var k = 0; k < 30; k++) {\n                  var mt = 1 - t;\n                  var bx = 3 * mt * mt * t * x1 + 3 * mt * t * t * x2 + t * t * t;\n                  if (bx < x) lo = t; else hi = t;\n                  t = (lo + hi) / 2;\n                }\n                var m = 1 - t;\n                return 3 * m * m * t * y1 + 3 * m * t * t * y2 + t * t * t;\n              };\n            }\n            var easeCurve = bezier(0.5, 0, 0.2, 1);\n            function progress(f, a, b) { return clamp01((f - a) / (b - a)); }\n            function ease(f, a, b) { return easeCurve(progress(f, a, b)); }\n            function lerpClamp(f, a, b, from, to) { return from + (to - from) * progress(f, a, b); }\n\n            function graphemes(text) {\n              if (typeof Intl !== \"undefined\" && Intl.Segmenter) {\n                return Array.from(new Intl.Segmenter(\"en\", { granularity: \"grapheme\" }).segment(text), function (p) { return p.segment; });\n              }\n              return Array.from(text);\n            }\n            function textUnits(text) {\n              return graphemes(text).reduce(function (sum, ch) {\n                if (/\\s/.test(ch)) return sum + 0.3;\n                if (/[ilI.,'!|]/.test(ch)) return sum + 0.29;\n                if (/[MW@%]/.test(ch)) return sum + 0.98;\n                return sum + ((ch.codePointAt(0) || 0) > 0x024f ? 1.02 : 0.63);\n              }, 0);\n            }\n            // Honor explicit lines and keep long copy inside the safe area (808 of 960 units wide).\n            function fitText(text, maxSize, width) {\n              var lines = text.split(\"\\n\");\n              var widest = Math.max.apply(null, [1].concat(lines.map(textUnits)));\n              return Math.min(maxSize, width / widest, 220 / (Math.max(1, lines.length) * 1.15));\n            }\n            var safe = Math.min(1, W / 960);\n\n            // Center-out focus, with a stagger that does not depend on the copy's length.\n            function characterState(frame, end, index, count) {\n              var distance = count <= 1 ? 0 : Math.abs(index - (count - 1) / 2) / ((count - 1) / 2);\n              var delay = distance * 7;\n              var enter = ease(frame, delay, delay + 18);\n              var exit = ease(frame, end - 16 - distance * 5, end - 1 - distance * 5);\n              return { opacity: enter * (1 - exit), blur: (1 - enter) * 5 + exit * 3, y: (1 - enter) * 2 - exit * 1.5 };\n            }\n\n            // Statements: [from, to) on the picture clock.\n            var BEATS = [[0, 104], [104, 208], [208, 326], [326, 446], [446, 610]];\n            var holder = document.getElementById(\"rt-statements\");\n            var statementEls = statements.map(function (text, s) {\n              var box = document.createElement(\"div\");\n              box.className = \"rt-statement\";\n              box.id = \"rt-statement-\" + s;\n              box.setAttribute(\"role\", \"img\");\n              box.setAttribute(\"aria-label\", text);\n              box.style.fontSize = fitText(text, 48, 808 * safe) + \"px\";\n              box.style.color = theme.foreground;\n              var lines = text.split(\"\\n\").map(function (line, li) {\n                var row = document.createElement(\"div\");\n                row.className = \"rt-line\";\n                var chars = graphemes(line).map(function (ch, ci) {\n                  var span = document.createElement(\"span\");\n                  span.className = \"rt-char\";\n                  span.id = \"rt-char-\" + s + \"-\" + li + \"-\" + ci;\n                  span.textContent = ch;\n                  row.appendChild(span);\n                  return span;\n                });\n                box.appendChild(row);\n                return chars;\n              });\n              holder.appendChild(box);\n              return { box: box, lines: lines };\n            });\n\n            var lockup = document.getElementById(\"rt-lockup\");\n            var title = brandName + (release ? \" \" + release : \"\");\n            var titleEl = document.getElementById(\"rt-title\");\n            titleEl.textContent = title;\n            titleEl.style.fontSize = fitText(title, 70, 750 * safe) + \"px\";\n            titleEl.style.color = theme.foreground;\n            var taglineEl = document.getElementById(\"rt-tagline\");\n            taglineEl.textContent = tagline;\n            taglineEl.style.fontSize = fitText(tagline, 20, 740 * safe) + \"px\";\n            taglineEl.style.color = theme.muted;\n            document.getElementById(\"rt-mark-path\").setAttribute(\"fill\", theme.accent);\n\n            // ---- The dimensional ring: a 320-degree beveled annulus drawn as a projected mesh.\n            function normalize(v) {\n              var l = Math.hypot(v[0], v[1], v[2]) || 1;\n              return [v[0] / l, v[1] / l, v[2] / l];\n            }\n            function sub(a, b) { return [a[0] - b[0], a[1] - b[1], a[2] - b[2]]; }\n            function cross(a, b) { return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]; }\n            function dot(a, b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }\n            function rotate(v, rx, ry, rz) {\n              var y = v[1] * Math.cos(rx) - v[2] * Math.sin(rx);\n              var z = v[1] * Math.sin(rx) + v[2] * Math.cos(rx);\n              var x = v[0] * Math.cos(ry) + z * Math.sin(ry);\n              var depth = -v[0] * Math.sin(ry) + z * Math.cos(ry);\n              return [x * Math.cos(rz) - y * Math.sin(rz), x * Math.sin(rz) + y * Math.cos(rz), depth];\n            }\n            function rotator(rx, ry, rz) {\n              var x = rotate([1, 0, 0], rx, ry, rz), y = rotate([0, 1, 0], rx, ry, rz), z = rotate([0, 0, 1], rx, ry, rz);\n              return function (v) {\n                return [x[0] * v[0] + y[0] * v[1] + z[0] * v[2], x[1] * v[0] + y[1] * v[1] + z[1] * v[2], x[2] * v[0] + y[2] * v[1] + z[2] * v[2]];\n              };\n            }\n            function face(vertices, bevel) {\n              var c = [0, 0, 0];\n              vertices.forEach(function (p) { c[0] += p[0] / vertices.length; c[1] += p[1] / vertices.length; c[2] += p[2] / vertices.length; });\n              return { vertices: vertices, normal: normalize(cross(sub(vertices[1], vertices[0]), sub(vertices[2], vertices[0]))), center: c, bevel: bevel };\n            }\n            function createRing(count) {\n              // Counter-clockwise cross-section (radius, depth); front faces point toward +Z.\n              var profile = [[144, 32], [210, 32], [220, 22], [220, -22], [210, -32], [144, -32], [134, -22], [134, 22]];\n              function section(i) {\n                var angle = ((-18 + (i / count) * 320) * Math.PI) / 180;\n                return profile.map(function (p) { return [p[0] * Math.cos(angle), p[0] * Math.sin(angle), p[1]]; });\n              }\n              var faces = [];\n              var halfStep = ((160 / count) * Math.PI) / 180;\n              for (var i = 0; i < count; i++) {\n                var a = section(i), b = section(i + 1);\n                for (var j = 0; j < profile.length; j++) {\n                  var next = (j + 1) % profile.length;\n                  var quad = face([a[j], a[next], b[next], b[j]], j % 2 === 1);\n                  // Normals turned half a step each way shade every strip as one smooth band.\n                  quad.edgeNormals = [rotate(quad.normal, 0, 0, -halfStep), rotate(quad.normal, 0, 0, halfStep)];\n                  faces.push(quad);\n                }\n              }\n              faces.push(face(section(0).reverse(), false), face(section(count), false));\n              return faces;\n            }\n            var ring = createRing(96);\n            function project(v, scale, x, y) {\n              var p = 1100 / Math.max(300, 1100 - v[2] * scale);\n              return [x + v[0] * scale * p, y + v[1] * scale * p];\n            }\n            function ringPose(frame) {\n              var f = Math.max(0, Math.min(959, frame));\n              var travel = progress(f, 0, 610);\n              var reveal = ease(f, 602, 702);\n              return {\n                x: 480 + (1 - reveal) * (18 - travel * 26),\n                y: (-200 + travel * 100) * (1 - reveal) + 270 * reveal,\n                scale: (2.78 - travel * 0.32) * (1 - reveal) + 1.08 * reveal,\n                rx: (0.4 - travel * 0.1) * (1 - reveal) + 0.14 * reveal,\n                ry: (-0.55 + travel * 0.12) * (1 - reveal) - 0.16 * reveal,\n                rz: (-0.42 + travel * 0.22) * (1 - reveal) - 0.13 * reveal,\n                lightAngle: -0.8 + (f / 960) * 1.1,\n                opacity: ease(f, 0, 48) * (1 - ease(f, 858, 946))\n              };\n            }\n\n            var canvas = document.getElementById(\"rt-canvas\");\n            canvas.width = Math.round(CW);\n            canvas.height = Math.round(CH);\n            var ctx = canvas.getContext(\"2d\", { willReadFrequently: true });\n            function channels(color) {\n              ctx.clearRect(0, 0, 1, 1);\n              ctx.fillStyle = \"#000000\";\n              ctx.fillStyle = color;\n              ctx.fillRect(0, 0, 1, 1);\n              return Array.prototype.slice.call(ctx.getImageData(0, 0, 1, 1).data, 0, 3);\n            }\n            var accentRgb = channels(theme.accent);\n            var surfaceRgb = channels(theme.surface);\n            var ringWrap = document.getElementById(\"rt-ring-wrap\");\n\n            function drawRing(frame) {\n              var pose = ringPose(frame);\n              ringWrap.style.opacity = pose.opacity;\n              ctx.setTransform(1, 0, 0, 1, 0, 0);\n              ctx.clearRect(0, 0, canvas.width, canvas.height);\n              ctx.setTransform(S, 0, 0, S, 0, 0);\n              var turn = rotator(pose.rx, pose.ry, pose.rz);\n              var key = normalize([Math.cos(pose.lightAngle) * 0.95, 0.6, 0.3]);\n              var rim = normalize([-0.8, -0.5, 0.18]);\n              var half = normalize([key[0], key[1], key[2] + 1]);\n              var px = pose.x + OX, py = pose.y + OY;\n              var faces = ring.map(function (f) {\n                return {\n                  bevel: f.bevel,\n                  normal: turn(f.normal),\n                  edgeNormals: f.edgeNormals ? [turn(f.edgeNormals[0]), turn(f.edgeNormals[1])] : null,\n                  center: turn(f.center),\n                  vertices: f.vertices.map(turn)\n                };\n              }).sort(function (a, b) { return a.center[2] - b.center[2]; });\n              var intensity = lightIntensity * pose.opacity;\n              faces.forEach(function (f) {\n                if (dot(f.normal, normalize([-f.center[0], -f.center[1], 1100 / pose.scale - f.center[2]])) <= 0) return;\n                var shade = function (n) {\n                  var diffuse = Math.max(0, dot(n, key));\n                  var rimLight = Math.max(0, dot(n, rim));\n                  var specular = Math.pow(Math.max(0, dot(n, half)), f.bevel ? 26 : 48);\n                  var rgb = surfaceRgb.map(function (c, i) {\n                    return Math.min(255, c * 0.19 + intensity * (accentRgb[i] * (Math.pow(diffuse, 3) * 0.36 + Math.pow(rimLight, 6) * 0.16) + 180 * specular * 0.68));\n                  });\n                  return \"rgb(\" + rgb.join(\",\") + \")\";\n                };\n                var pts = f.vertices.map(function (v) { return project(v, pose.scale, px, py); });\n                ctx.beginPath();\n                ctx.moveTo(pts[0][0], pts[0][1]);\n                for (var i = 1; i < pts.length; i++) ctx.lineTo(pts[i][0], pts[i][1]);\n                ctx.closePath();\n                if (f.edgeNormals) {\n                  var g = ctx.createLinearGradient(\n                    (pts[0][0] + pts[1][0]) / 2, (pts[0][1] + pts[1][1]) / 2,\n                    (pts[2][0] + pts[3][0]) / 2, (pts[2][1] + pts[3][1]) / 2\n                  );\n                  g.addColorStop(0, shade(f.edgeNormals[0]));\n                  g.addColorStop(1, shade(f.edgeNormals[1]));\n                  ctx.fillStyle = g;\n                } else {\n                  ctx.fillStyle = shade(f.normal);\n                }\n                ctx.fill();\n                // A sub-pixel seam overlap hides hairlines between neighbouring quads.\n                ctx.strokeStyle = ctx.fillStyle;\n                ctx.lineWidth = 0.45;\n                ctx.stroke();\n              });\n            }\n\n            function drawStatement(s, frame, duration) {\n              var st = statementEls[s];\n              st.box.style.transform = \"scale(\" + lerpClamp(frame, 0, duration, 0.99, 1.025) + \")\";\n              st.lines.forEach(function (chars) {\n                chars.forEach(function (span, i) {\n                  var c = characterState(frame, duration, i, chars.length);\n                  span.style.opacity = c.opacity;\n                  span.style.filter = c.blur > 0.08 ? \"blur(\" + c.blur + \"px)\" : \"none\";\n                  span.style.transform = \"translateY(\" + c.y + \"px)\";\n                });\n              });\n            }\n\n            var shown = -2;\n            function draw(t) {\n              var frame = t * REF_FPS;\n              drawRing(frame);\n              var active = -1;\n              for (var i = 0; i < BEATS.length; i++) if (fr