   "content": "<!doctype html>\n<!--\n  Glass Code Walk\n\n  A camera that scans a frosted-glass code block top to bottom as its lines appear, then pulls back to a centred hold.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/glass-code-walk/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"glass-code-walk\"\n  data-composition-duration=\"5\"\n  data-composition-variables='[{\"id\":\"code\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Code\",\"description\":\"Source text, one line per row.\",\"default\":\"import { Scene } from \\\"./scene\\\";\\nimport { Typewriter } from \\\"./typewriter\\\";\\n\\nexport function Intro() {\\n  return (\\n    <Scene>\\n      <Typewriter text=\\\"Ship it\\\" />\\n    </Scene>\\n  );\\n}\"},{\"id\":\"title\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Title\",\"description\":\"Window title.\",\"default\":\"scene.tsx\"},{\"id\":\"width\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Width\",\"description\":\"Window width in pixels on a 1280x720 frame.\",\"default\":880,\"min\":300,\"max\":1100,\"step\":10,\"unit\":\"px\"},{\"id\":\"height\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Height\",\"description\":\"Window height in pixels on a 1280x720 frame.\",\"default\":420,\"min\":200,\"max\":700,\"step\":10,\"unit\":\"px\"},{\"id\":\"zoom\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Zoom\",\"description\":\"Camera zoom while scanning.\",\"default\":2.6,\"min\":1,\"max\":4,\"step\":0.1,\"unit\":\"x\"},{\"id\":\"font_size\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Font size\",\"description\":\"Code font size in pixels.\",\"default\":18,\"min\":10,\"max\":28,\"step\":1,\"unit\":\"px\"},{\"id\":\"stagger_frames\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Stagger\",\"description\":\"Frames the camera spends on each line (30 fps).\",\"default\":10,\"min\":1,\"max\":30,\"step\":1,\"unit\":\"frames\"},{\"id\":\"speed\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Speed\",\"description\":\"Playback speed multiplier.\",\"default\":1,\"min\":0.25,\"max\":4,\"step\":0.05,\"unit\":\"x\"}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Glass Code Walk</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: #0b0c10; font-family: \"Geist Mono\", ui-monospace, SFMono-Regular, monospace; }\n        .gw-stage { position: absolute; inset: 0; }\n        #gw-world { transform-origin: 0 0; }\n        #gw-aura { position: absolute; inset: 0; pointer-events: none; }\n        #gw-ring { position: absolute; padding: 1px; border-radius: 16px; box-sizing: border-box; background: linear-gradient(180deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 100%); box-shadow: 0 50px 120px rgba(0,0,0,0.55); }\n        #gw-glass { width: 100%; height: 100%; border-radius: 15px; backdrop-filter: blur(16px); box-shadow: inset 0 1px 0 rgba(255,255,255,0.06); display: flex; flex-direction: column; overflow: hidden; }\n        #gw-chrome { height: 40px; flex: none; box-sizing: border-box; display: flex; align-items: center; gap: 8px; padding: 0 16px; border-bottom: 1px solid rgba(255,255,255,0.06); }\n        .gw-light { width: 12px; height: 12px; border-radius: 50%; opacity: 0.6; }\n        #gw-title { flex: 1; text-align: center; color: #a1a1aa; font-size: 12px; letter-spacing: 0.02em; }\n        #gw-body { flex: 1; padding: 20px 24px; display: flex; flex-direction: column; gap: 4px; line-height: 1.55; overflow: hidden; }\n        .gw-line { white-space: pre; display: flex; color: #e4e4e7; }\n        .gw-num { width: 28px; color: #3f3f46; flex: none; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"glass-code-walk\" data-duration=\"5\" data-fps=\"30\">\n        <div id=\"gw-clip\" class=\"gw-stage clip\" data-start=\"0\" data-duration=\"5\" data-track-index=\"0\">\n<div id=\"gw-world\"><div id=\"gw-aura\"></div><div id=\"gw-ring\"><div id=\"gw-glass\"><div id=\"gw-chrome\"><span id=\"gw-lights\" style=\"display:flex;gap:8px\"><span class=\"gw-light\" style=\"background:#ff5f57\"></span><span class=\"gw-light\" style=\"background:#febc2e\"></span><span class=\"gw-light\" style=\"background:#28c840\"></span></span><div id=\"gw-title\"></div></div><div id=\"gw-body\"></div></div></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n                        // Stop-motion helpers: poses are held for `step` frames.\n            var DEFAULT_STEP = 3;\n            function qf(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step) * step; }\n            function qstep(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step); }\n            function hash01(seed) { return random(seed); }\n            function hashRange(seed, lo, hi) { return lo + hash01(seed) * (hi - lo); }\n            function paperJitter(frame, seed, o) {\n              o = o || {};\n              var amp = o.amp != null ? o.amp : 1.4, rotAmp = o.rotAmp != null ? o.rotAmp : 0.35;\n              var s = qstep(frame, o.step);\n              return { x: hashRange(seed + \":x:\" + s, -amp, amp), y: hashRange(seed + \":y:\" + s, -amp, amp), rot: hashRange(seed + \":r:\" + s, -rotAmp, rotAmp) };\n            }\n            function steppedRamp(frame, from, to, o) {\n              o = o || {};\n              var f = qf(frame, o.step);\n              if (f <= from) return 0;\n              if (f >= to) return 1;\n              var ease = o.ease || function (t) { return t; };\n              return ease((f - from) / (to - from));\n            }\n\n\n            function scaledStage(el, boost) {\n              var W = root.clientWidth, H = root.clientHeight;\n              var s = Math.min(W / 1280, H / 720) * (H > W ? (boost || 1.4) : 1);\n              el.style.position = \"absolute\"; el.style.left = \"0\"; el.style.top = \"0\";\n              el.style.width = W / s + \"px\"; el.style.height = H / s + \"px\";\n              el.style.transformOrigin = \"0 0\"; el.style.transform = \"scale(\" + s + \")\";\n              return s;\n            }\n\n            var KEYWORDS = [\"import\", \"from\", \"export\", \"function\", \"const\", \"let\", \"var\", \"return\", \"if\", \"else\", \"for\", \"while\", \"new\", \"class\", \"extends\", \"default\", \"true\", \"false\", \"null\", \"undefined\"];\n            var TOKEN_COLORS = { code: \"#e4e4e7\", comment: \"#52525b\", string: \"#86efac\", keyword: \"#c4b5fd\", number: \"#fcd34d\" };\n            // Minimal tokenizer, not a real highlighter: comments, strings, keywords, numbers.\n            function tokenizeLine(line) {\n              if (line.replace(/^\\s+/, \"\").indexOf(\"//\") === 0) return [{ text: line, kind: \"comment\" }];\n              var out = [], re = /(\"[^\"]*\"|'[^']*'|`[^`]*`|\\b\\d+\\b|\\b[A-Za-z_$][\\w$]*\\b|[^\\w\"']+)/g, m;\n              while ((m = re.exec(line)) !== null) {\n                var t = m[0], c = t.charAt(0), kind = \"code\";\n                if (c === '\"' || c === \"'\" || c === \"`\") kind = \"string\";\n                else if (/^\\d+$/.test(t)) kind = \"number\";\n                else if (/^[A-Za-z_$][\\w$]*$/.test(t) && KEYWORDS.indexOf(t) >= 0) kind = \"keyword\";\n                out.push({ text: t, kind: kind });\n              }\n              return out;\n            }\n            function buildLines(host, lines, fontSize) {\n              return lines.map(function (line, i) {\n                var el = document.createElement(\"div\");\n                el.className = \"gw-line\"; el.id = \"gw-line-\" + i;\n                var toks = tokenizeLine(line);\n                if (toks.length === 0) { el.style.height = fontSize * 0.8 + \"px\"; }\n                else {\n                  var n = document.createElement(\"span\"); n.className = \"gw-num\"; n.textContent = String(i + 1).padStart(2, \" \"); el.appendChild(n);\n                  var body = document.createElement(\"span\");\n                  toks.forEach(function (t) { var s = document.createElement(\"span\"); s.style.color = TOKEN_COLORS[t.kind]; s.textContent = t.text; body.appendChild(s); });\n                  el.appendChild(body);\n                }\n                el.style.opacity = \"0\";\n                host.appendChild(el);\n                return el;\n              });\n            }\n\n            var world = document.getElementById(\"gw-world\");\n            var sc = scaledStage(world, 1.3);\n            var SW = root.clientWidth / sc, SH = root.clientHeight / sc;\n            var code = typeof vars.code === \"string\" && vars.code.trim() ? vars.code : \"import { Scene } from \\\"./scene\\\";\\nimport { Typewriter } from \\\"./typewriter\\\";\\n\\nexport function Intro() {\\n  return (\\n    <Scene>\\n      <Typewriter text=\\\"Ship it\\\" />\\n    </Scene>\\n  );\\n}\";\n            var title = str(vars.title, \"scene.tsx\");\n            var width = num(vars.width, 880, 300, 1100), height = num(vars.height, 420, 200, 700), fontSize = num(vars.font_size, 18, 10, 28);\n            var stagger = num(vars.stagger_frames, 10, 1, 30), speed = num(vars.speed, 1, 0.25, 4);\n            var aura = bool(vars.aura, false), lights = bool(vars.traffic_lights, true);\n            var glassColor = str(vars.glass_color, \"rgba(10, 10, 10, 0.6)\");\n            document.getElementById(\"gw-title\").textContent = title;\n            document.getElementById(\"gw-lights\").style.display = lights ? \"flex\" : \"none\";\n            document.getElementById(\"gw-glass\").style.background = glassColor;\n            var ring = document.getElementById(\"gw-ring\"), body = document.getElementById(\"gw-body\");\n            ring.style.width = width + \"px\"; ring.style.height = height + \"px\";\n            ring.style.left = (SW - width) / 2 + \"px\"; ring.style.top = (SH - height) / 2 + \"px\";\n            body.style.fontSize = fontSize + \"px\";\n            var aur = document.getElementById(\"gw-aura\"); if (!aura) aur.style.display = \"none\";\n            var lines = code.split(\"\\n\"), els = buildLines(body, lines, fontSize);\n\n            var zoom = num(vars.zoom, 2.6, 1, 4);\n            var RING = 1, CHROME = 40, PAD_TOP = 20, PAD_LEFT = 24, GAP = 4, ANCHOR_X = 110, TARGET_Y = SH / 2, PULL = 24;\n            var blockLeft = (SW - width) / 2, blockTop = (SH - height) / 2, bodyTop = blockTop + RING + CHROME + PAD_TOP;\n            var centers = [], walk = bodyTop;\n            lines.forEach(function (ln) { var h = ln.trim() === \"\" ? fontSize * 0.8 : fontSize * 1.55; centers.push(walk + h / 2); walk += h + GAP; });\n            var anchorX = blockLeft + RING + PAD_LEFT;\n            var scanStagger = stagger / speed, scanEnd = (lines.length - 1) * scanStagger;\n            function draw(frame) {\n              els.forEach(function (el, i) {\n                var f = frame - Math.round((i * stagger) / speed);\n                el.style.opacity = interpolate(f, [0, 8], [0, 1], { extrapolateLeft: \"clamp\", extrapolateRight: \"clamp\" });\n                el.style.transform = \"translateY(\" + interpolate(f, [0, 8], [4, 0], { extrapolateLeft: \"clamp\", extrapolateRight: \"clamp\" }) + \"px)\";\n              });\n              var pos = interpolate(frame, [0, Math.max(scanEnd, 1e-6)], [0, lines.length - 1], { extrapolateLeft: \"clamp\", extrapolateRight: \"clamp\" });\n              var lo = Math.floor(pos), up = Math.min(lo + 1, lines.length - 1);\n              var trackedY = centers[lo] + (centers[up] - centers[lo]) * (pos - lo);\n              var pinX = ANCHOR_X - zoom * anchorX, pinY = TARGET_Y - zoom * trackedY;\n              var pull = interpolate(frame, [scanEnd, scanEnd + PULL / speed], [0, 1], { extrapolateLeft: \"clamp\", extrapolateRight: \"clamp\", easing: Easing.inOut(Easing.cubic) });\n              var scale = zoom + pull * (1 - zoom);\n              world.style.transform = \"scale(\" + sc + \") translate(\" + (1 - pull) * pinX + \"px,\" + (1 - pull) * pinY + \"px) scale(\" + scale + \")\";\n            }\n            var tl = gsap.timeline({ paused: true });\n            clockTween(tl, 150, draw);\n\n            var total = parseFloat(root.dataset.duration || \"5\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"glass-code-walk\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
