   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Portal Reveal\n\n  A landing page tears open from the centre in a glowing, colour-cycling portal and the dark theme of the same page is revealed behind it, with chromatic aberration and edge distortion along the rim. WebGL shader over two built-in pages (light and dark).\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/heygen-com/hyperframes/blob/bd6cff8157a1a0ed5075527e673cc4f321fe9123/registry/blocks/vfx-portal/vfx-portal.html\n\n  Copyright HeyGen, Inc. and the Hyperframes contributors. Licensed under the Apache License, Version\n  2.0 (the \"License\"); you may not use this file except in compliance with the License. You may obtain\n  a copy of the License at http://www.apache.org/licenses/LICENSE-2.0. Unless required by applicable\n  law or agreed to in writing, software distributed under the License is distributed on an \"AS IS\"\n  BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for\n  the specific language governing permissions and limitations under the License.\n\n  Changes by usemosio/blocks: fills the host frame; rewritten from three.js (not loaded: it only drew two flat quads) to raw WebGL2 with one full-screen shader that blends the light page over the dark one; the two pages are drawn on 2D canvases from variables (brand, headline, menu, cards) instead of being captured from live DOM with the experimental HTML-in-Canvas API, and the product name and copy are placeholders; the portal is measured from the shorter side of the frame; the camera push-through of the original has no visible effect (the quads rescale to fill the view) and is left out; the canvas is drawn at the `resolution` variable.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"vfx-portal\"\n  data-composition-duration=\"10\"\n  data-composition-variables='[{\"id\": \"brand\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Brand name\", \"description\": \"Logo text on both pages (a placeholder name).\", \"default\": \"Lumen\"},\n    {\"id\": \"title\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Headline\", \"description\": \"Use | for a line break.\", \"default\": \"Ship faster|See it live\"},\n    {\"id\": \"subtitle\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Subtitle\", \"default\": \"Ship faster with a platform that handles the hard parts. Analytics, infrastructure, and developer tools, all in one place.\"},\n    {\"id\": \"button\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Button\", \"default\": \"Get started\"},\n    {\"id\": \"nav\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Menu\", \"description\": \"Menu items separated by commas; the last one is shown as a button.\", \"default\": \"Product, Pricing, Docs, Sign In\"},\n    {\"id\": \"cards\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Cards\", \"description\": \"Up to 4 cards as \\\"Title | description\\\", separated by semicolons.\", \"default\": \"Lightning Fast | Sub-millisecond response times with edge deployment across 40+ regions worldwide.; Secure by Default | End-to-end encryption and role-based access out of the box.; Plug and Play | 200+ integrations. Connect your existing stack in minutes, not weeks.; Real-time Insights | Live dashboards, anomaly detection and recommendations.\"},\n    {\"id\": \"accent\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent\", \"description\": \"Button and icon colour on the light page.\", \"default\": \"#2563eb\"},\n    {\"id\": \"accent2\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent 2\", \"description\": \"Second accent of the dark page gradient.\", \"default\": \"#60a5fa\"},\n    {\"id\": \"glow\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Portal glow colour\", \"default\": \"#2563eb\"},\n    {\"id\": \"glow2\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Portal glow colour 2\", \"default\": \"#4a90ff\"},\n    {\"id\": \"resolution\", \"type\": \"number\", \"role\": \"quality\", \"label\": \"Resolution\", \"description\": \"Share of the frame size the shader is drawn at, then scaled up. Page text needs 0.75.\", \"default\": 0.75, \"min\": 0.25, \"max\": 1, \"step\": 0.05}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Portal Reveal</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          background: #000;\n          pointer-events: none;\n        }\n        .vpt-stage {\n          position: absolute;\n          inset: 0;\n        }\n        .vpt-canvas {\n          position: absolute;\n          inset: 0;\n          width: 100%;\n          height: 100%;\n          display: block;\n        }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"vfx-portal\" data-duration=\"10\" data-fps=\"30\">\n        <div id=\"vpt-clip\" class=\"vpt-stage clip\" data-start=\"0\" data-duration=\"10\" data-track-index=\"0\">\n          <canvas id=\"vpt-canvas\" class=\"vpt-canvas\"></canvas>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"vfx-portal\";\n            var DUR = 10;\n            var root = document.getElementById(\"root\");\n            var canvas = document.getElementById(\"vpt-canvas\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function clampNum(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function hex(value, fallback) {\n              var m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(String(value || \"\").trim());\n              if (!m) return fallback;\n              var h = m[1].length === 3 ? m[1].replace(/./g, \"$&$&\") : m[1];\n              return \"#\" + h.toLowerCase();\n            }\n            function rgb(value) {\n              var h = hex(value, \"#000000\").slice(1);\n              return [parseInt(h.slice(0, 2), 16) / 255, parseInt(h.slice(2, 4), 16) / 255, parseInt(h.slice(4, 6), 16) / 255];\n            }\n            var DEFS = [{\"id\": \"brand\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Brand name\", \"description\": \"Logo text on both pages (a placeholder name).\", \"default\": \"Lumen\"}, {\"id\": \"title\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Headline\", \"description\": \"Use | for a line break.\", \"default\": \"Ship faster|See it live\"}, {\"id\": \"subtitle\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Subtitle\", \"default\": \"Ship faster with a platform that handles the hard parts. Analytics, infrastructure, and developer tools, all in one place.\"}, {\"id\": \"button\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Button\", \"default\": \"Get started\"}, {\"id\": \"nav\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Menu\", \"description\": \"Menu items separated by commas; the last one is shown as a button.\", \"default\": \"Product, Pricing, Docs, Sign In\"}, {\"id\": \"cards\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Cards\", \"description\": \"Up to 4 cards as \\\"Title | description\\\", separated by semicolons.\", \"default\": \"Lightning Fast | Sub-millisecond response times with edge deployment across 40+ regions worldwide.; Secure by Default | End-to-end encryption and role-based access out of the box.; Plug and Play | 200+ integrations. Connect your existing stack in minutes, not weeks.; Real-time Insights | Live dashboards, anomaly detection and recommendations.\"}, {\"id\": \"accent\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent\", \"description\": \"Button and icon colour on the light page.\", \"default\": \"#2563eb\"}, {\"id\": \"accent2\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent 2\", \"description\": \"Second accent of the dark page gradient.\", \"default\": \"#60a5fa\"}, {\"id\": \"glow\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Portal glow colour\", \"default\": \"#2563eb\"}, {\"id\": \"glow2\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Portal glow colour 2\", \"default\": \"#4a90ff\"}, {\"id\": \"resolution\", \"type\": \"number\", \"role\": \"quality\", \"label\": \"Resolution\", \"description\": \"Share of the frame size the shader is drawn at, then scaled up. Page text needs 0.75.\", \"default\": 0.75, \"min\": 0.25, \"max\": 1, \"step\": 0.05}];\n            var V = {};\n            DEFS.forEach(function (d) {\n              var raw = vars[d.id];\n              if (d.type === \"number\") V[d.id] = clampNum(raw, d.default, d.min, d.max);\n              else if (d.type === \"color\") V[d.id] = hex(raw, d.default);\n              else if (d.type === \"boolean\") V[d.id] = typeof raw === \"boolean\" ? raw : raw === \"true\" ? true : raw === \"false\" ? false : d.default;\n              else V[d.id] = typeof raw === \"string\" ? raw.trim() : d.default;\n            });\n\n            var W = Math.max(2, root.clientWidth);\n            var H = Math.max(2, root.clientHeight);\n            var cw = Math.max(2, Math.round(W * V.resolution));\n            var ch = Math.max(2, Math.round(H * V.resolution));\n            root.style.background = \"#000\";\n            canvas.width = cw;\n            canvas.height = ch;\n            var SANS = \"system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif\";\n            var U = W >= H ? Math.min(W / 1920, H / 1080) : W / 1080 * 1.25;\n            function wrap(ctx, text, maxW) {\n              var words = String(text).split(/\\s+/).filter(Boolean), lines = [], line = \"\";\n              words.forEach(function (w) {\n                var next = line ? line + \" \" + w : w;\n                if (line && ctx.measureText(next).width > maxW) { lines.push(line); line = w; } else line = next;\n              });\n              if (line) lines.push(line);\n              return lines;\n            }\n            function rrect(ctx, x, y, w, h, r) { ctx.beginPath(); ctx.roundRect(x, y, w, h, r); }\n            var THEMES = {\n              light: { bg: \"#fafafa\", ink: \"#111111\", nav: \"#555555\", sub: \"#666666\", logo: [\"#111111\", \"#111111\"], btn: [V.accent, V.accent], card: \"#ffffff\", cardLine: \"#e5e7eb\", icon: \"#eff6ff\", iconInk: V.accent, cardTitle: \"#111111\", cardDesc: \"#777777\", glow: 0 },\n              dark: { bg: \"#0a0a0f\", ink: \"#f0f0f5\", nav: \"rgba(255,255,255,0.5)\", sub: \"rgba(255,255,255,0.5)\", logo: [\"#93c5fd\", \"#bfdbfe\"], btn: [V.accent, V.accent2], card: \"rgba(255,255,255,0.03)\", cardLine: \"rgba(255,255,255,0.08)\", icon: \"rgba(37,99,235,0.15)\", iconInk: \"#93c5fd\", cardTitle: \"#f0f0f5\", cardDesc: \"rgba(255,255,255,0.45)\", glow: 1 }\n            };\n            // One page (a landing page) in a light and a dark theme, laid out for any frame size.\n            function drawPage(el, th) {\n              var ctx = el.getContext(\"2d\");\n              ctx.setTransform(cw / W, 0, 0, ch / H, 0, 0);\n              ctx.fillStyle = th.bg;\n              ctx.fillRect(0, 0, W, H);\n              ctx.textBaseline = \"alphabetic\";\n              ctx.textAlign = \"left\";\n              var pad = 64 * U, portrait = W < H;\n              function grad(x0, x1, c) { var g = ctx.createLinearGradient(x0, 0, x1, 0); g.addColorStop(0, c[0]); g.addColorStop(1, c[1]); return g; }\n              // top bar\n              var ty = 28 * U + 24 * U;\n              ctx.font = \"800 \" + 24 * U + \"px \" + SANS;\n              ctx.fillStyle = grad(pad, pad + ctx.measureText(V.brand).width, th.logo);\n              ctx.fillText(V.brand, pad, ty);\n              var items = String(V.nav).split(\",\").map(function (s) { return s.trim(); }).filter(Boolean);\n              var cta = items.length > 1 ? items.pop() : \"\";\n              var x = W - pad;\n              if (cta) {\n                ctx.font = \"600 \" + 14 * U + \"px \" + SANS;\n                var bw = ctx.measureText(cta).width + 48 * U, bh = 40 * U;\n                ctx.fillStyle = grad(x - bw, x, th.btn);\n                rrect(ctx, x - bw, ty - 24 * U + 4 * U, bw, bh, 8 * U); ctx.fill();\n                ctx.fillStyle = \"#fff\"; ctx.textAlign = \"center\";\n                ctx.fillText(cta, x - bw / 2, ty - 24 * U + 4 * U + bh / 2 + 5 * U);\n                ctx.textAlign = \"left\";\n                x -= bw + 36 * U;\n              }\n              if (!portrait) {\n                ctx.font = \"500 \" + 15 * U + \"px \" + SANS;\n                ctx.fillStyle = th.nav;\n                items.slice().reverse().forEach(function (it) { var w = ctx.measureText(it).width; ctx.fillText(it, x - w, ty); x -= w + 36 * U; });\n              }\n              // cards\n              var cards = String(V.cards).split(\";\").map(function (c) { return c.split(\"|\").map(function (p) { return p.trim(); }); }).filter(function (c) { return c[0]; }).slice(0, 4);\n              var cols = portrait ? 2 : Math.max(1, cards.length), rows = Math.ceil(cards.length / cols);\n              var gap = 24 * U, cardW = (W - pad * 2 - gap * (cols - 1)) / cols;\n              ctx.font = \"400 \" + 14 * U + \"px \" + SANS;\n              var lines = cards.map(function (c) { return wrap(ctx, c[1] || \"\", cardW - 64 * U); });\n              var maxL = Math.max.apply(null, lines.map(function (l) { return l.length; }).concat([1]));\n              var cardH = 32 * U * 2 + 44 * U + 16 * U + 18 * U * 1.3 + 6 * U + maxL * 14 * U * 1.5;\n              var cardsTop = H - 56 * U - rows * cardH - (rows - 1) * gap;\n              cards.forEach(function (c, i) {\n                var cx = pad + (i % cols) * (cardW + gap), cy = cardsTop + Math.floor(i / cols) * (cardH + gap);\n                if (th.glow) { ctx.shadowColor = \"rgba(37,99,235,0.12)\"; ctx.shadowBlur = 20 * U; }\n                ctx.fillStyle = th.card; rrect(ctx, cx, cy, cardW, cardH, 16 * U); ctx.fill();\n                ctx.shadowBlur = 0; ctx.shadowColor = \"transparent\";\n                ctx.strokeStyle = th.cardLine; ctx.lineWidth = Math.max(1, U);\n                rrect(ctx, cx, cy, cardW, cardH, 16 * U); ctx.stroke();\n                ctx.fillStyle = th.icon; rrect(ctx, cx + 32 * U, cy + 32 * U, 44 * U, 44 * U, 10 * U); ctx.fill();\n                ctx.fillStyle = th.iconInk;\n                ctx.beginPath(); ctx.arc(cx + 54 * U, cy + 54 * U, 8 * U, 0, Math.PI * 2); ctx.fill();\n                var ly = cy + 32 * U + 44 * U + 16 * U + 18 * U;\n                ctx.font = \"700 \" + 18 * U + \"px \" + SANS; ctx.fillStyle = th.cardTitle;\n                ctx.fillText(c[0], cx + 32 * U, ly);\n                ctx.font = \"400 \" + 14 * U + \"px \" + SANS; ctx.fillStyle = th.cardDesc;\n                lines[i].forEach(function (l, k) { ctx.fillText(l, cx + 32 * U, ly + 6 * U + 14 * U * 1.5 * (k + 1)); });\n              });\n              // hero, centred in the space between the bar and the cards\n              var top = 28 * U + 64 * U, bottom = cardsTop - 24 * U;\n              var ts = 72 * U * (portrait ? 1.05 : 1);\n              ctx.font = \"800 \" + ts + \"px \" + SANS;\n              var tl2 = String(V.title).split(\"|\");\n              ctx.font = \"400 \" + 20 * U + \"px \" + SANS;\n              var subL = wrap(ctx, V.subtitle, Math.min(W - 2 * pad, 640 * U));\n              var heroH = tl2.length * ts * 1.05 + 24 * U + subL.length * 20 * U * 1.6 + 24 * U + 52 * U;\n              var y = top + Math.max(0, (bottom - top - heroH) / 2);\n              ctx.textAlign = \"center\";\n              ctx.font = \"800 \" + ts + \"px \" + SANS; ctx.fillStyle = th.ink;\n              tl2.forEach(function (l) { y += ts * 0.95; ctx.fillText(l.trim(), W / 2, y); y += ts * 0.1; });\n              y += 24 * U;\n              ctx.font = \"400 \" + 20 * U + \"px \" + SANS; ctx.fillStyle = th.sub;\n              subL.forEach(function (l) { y += 20 * U * 1.6; ctx.fillText(l, W / 2, y - 6 * U); });\n              y += 24 * U;\n              ctx.font = \"700 \" + 17 * U + \"px \" + SANS;\n              var bw2 = ctx.measureText(V.button).width + 80 * U, bh2 = 52 * U;\n              ctx.fillStyle = grad(W / 2 - bw2 / 2, W / 2 + bw2 / 2, th.btn);\n              rrect(ctx, W / 2 - bw2 / 2, y, bw2, bh2, 12 * U); ctx.fill();\n              ctx.fillStyle = \"#fff\"; ctx.fillText(V.button, W / 2, y + bh2 / 2 + 6 * U);\n            }\n            var pages = [0, 1].map(function () { var el = document.createElement(\"canvas\"); el.width = cw; el.height = ch; return el; });\n            drawPage(pages[0], THEMES.light);\n            drawPage(pages[1], THEMES.dark);\n            var GLOW = rgb(V.glow), GLOW2 = rgb(V.glow2);\n            // Animation state, tweened by the timeline below.\n            var S = { portalRadius: 0, energyIntensity: 0, chromaticStrength: 0, distortionStrength: 0, edgeWidth: 0.06 };\n\n            var VERTEX = [\n              \"#version 300 es\",\n              \"in vec2 aPos;\",\n              \"out vec2 v_uv;\",\n              \"void main() { v_uv = vec2(aPos.x * 0.5 + 0.5, 0.5 - aPos.y * 0.5); gl_Position = vec4(aPos, 0.0, 1.0); }\"\n            ].join(\"\\n\");\n            var FRAGMENT = `#version 300 es\nprecision highp float;\nout vec4 outColor;\nin vec2 v_uv;\nuniform sampler2D tLight;\nuniform sampler2D tDark;\nuniform float portalRadius;\nuniform vec2 portalCenter;\nuniform float edgeWidth;\nuniform vec3 glowColor;\nuniform vec3 glowColor2;\nuniform float chromaticStrength;\nuniform float distortionStrength;\nuniform float time;\nuniform float energyIntensity;\nuniform vec2 u_aspect;\n\nfloat hash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nfloat noise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = hash(i);\n  float b = hash(i + vec2(1.0, 0.0));\n  float c = hash(i + vec2(0.0, 1.0));\n  float d = hash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\nvoid main() {\n  // v_uv runs top-down; the shader works with y up\n  vec2 uv = vec2(v_uv.x, 1.0 - v_uv.y);\n  vec2 aspect = u_aspect;\n  vec2 centered = (uv - portalCenter) * aspect;\n  float dist = length(centered);\n\n  // Noise-modulated edge for organic tear look\n  float angle = atan(centered.y, centered.x);\n  float edgeNoise = noise(vec2(angle * 3.0, time * 2.0)) * 0.03 * energyIntensity;\n  float portalEdge = portalRadius + edgeNoise;\n\n  // Distortion near portal edge: warp UVs radially\n  float edgeDist = abs(dist - portalEdge);\n  float distortMask = smoothstep(edgeWidth * 1.5, 0.0, edgeDist) * distortionStrength;\n  vec2 distortDir = normalize(centered + 0.0001);\n  vec2 distortedUv = uv + distortDir * distortMask * sin(angle * 8.0 + time * 5.0);\n\n  // Chromatic aberration near portal edge\n  float chromaMask = smoothstep(edgeWidth * 2.0, 0.0, edgeDist) * chromaticStrength;\n  vec2 chromaOffset = distortDir * chromaMask;\n  float r = texture(tLight, vec2(distortedUv.x + chromaOffset.x, 1.0 - (distortedUv.y + chromaOffset.y))).r;\n  float g = texture(tLight, vec2(distortedUv.x, 1.0 - distortedUv.y)).g;\n  float b = texture(tLight, vec2(distortedUv.x - chromaOffset.x, 1.0 - (distortedUv.y - chromaOffset.y))).b;\n  vec3 lightColor = vec3(r, g, b);\n\n  // Portal mask: inside = transparent (show dark behind), outside = light\n  float mask = smoothstep(portalEdge - 0.008, portalEdge + 0.008, dist);\n\n  // Glow ring at portal edge\n  float glowInner = smoothstep(edgeWidth, 0.0, edgeDist);\n  float glowOuter = smoothstep(edgeWidth * 2.5, edgeWidth * 0.5, edgeDist);\n  float glow = glowInner * glowOuter * energyIntensity;\n\n  // Animated color cycling along the ring\n  float colorPhase = fract(angle / 6.2832 + time * 0.4);\n  vec3 ringColor = mix(glowColor, glowColor2, sin(colorPhase * 6.2832) * 0.5 + 0.5);\n\n  // Secondary energy sparks\n  float sparks = noise(vec2(angle * 12.0, time * 8.0));\n  sparks = pow(sparks, 4.0) * glowInner * energyIntensity * 2.0;\n\n  vec3 finalColor = lightColor * mask;\n  finalColor += ringColor * glow * 2.5;\n  finalColor += vec3(1.0, 0.9, 1.0) * sparks;\n\n  // When portal is large enough, alpha fades out completely\n  float alpha = mask + glow * 0.5 + sparks * 0.3;\n  alpha = clamp(alpha, 0.0, 1.0);\n\n  // The dark page sits behind: ordinary alpha blending of the front layer over it\n  vec3 dark = texture(tDark, v_uv).rgb;\n  outColor = vec4(finalColor * alpha + dark * (1.0 - alpha), 1.0);\n}\n`;\n\n            var gl = canvas.getContext(\"webgl2\", { alpha: false, antialias: false, depth: false, stencil: false, preserveDrawingBuffer: true });\n            function compile(type, source) {\n              var shader = gl.createShader(type);\n              gl.shaderSource(shader, source);\n              gl.compileShader(shader);\n              if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader) || \"shader compile failed\");\n              return shader;\n            }\n            var paint = null;\n            try {\n              if (!gl) throw new Error(\"WebGL2 is not available\");\n              var prog = gl.createProgram();\n              gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERTEX));\n              gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAGMENT));\n              gl.bindAttribLocation(prog, 0, \"aPos\");\n              gl.linkProgram(prog);\n              if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog) || \"link failed\");\n          