   "content": "<!doctype html>\n<!--\n  Neon Sign\n\n  A glass neon tube stutters alive segment by segment, buzzes off once, then holds lit with a glow on the wall. Replace the path variable with your own monoline SVG path.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/neon-sign/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"neon-sign\"\n  data-composition-duration=\"2.333\"\n  data-composition-variables='[\n    {\"id\": \"path\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Tube path\", \"description\": \"SVG path data for the tube. Each subpath (M command) flickers on its own.\", \"default\": \"M 30 132 C 52 112 74 70 70 46 C 67 28 50 30 47 52 C 44 76 42 112 40 140 C 46 116 58 100 72 100 C 86 100 84 122 86 134 C 88 144 100 144 110 132 M 110 132 C 124 124 142 110 136 98 C 130 88 112 96 112 116 C 112 138 134 146 156 130 M 156 130 C 176 110 196 66 190 46 C 186 32 170 36 168 60 C 166 90 168 126 172 136 C 176 146 188 142 196 132 M 196 132 C 216 110 232 66 226 46 C 222 32 206 36 204 60 C 202 90 204 126 208 136 C 212 146 224 142 232 132 M 232 132 C 238 116 248 100 262 100 C 278 100 280 124 268 136 C 256 146 242 136 248 118 C 252 106 268 104 290 104 M 52 170 C 120 160 210 162 296 152\"},\n    {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Tube\", \"description\": \"Tube color when lit.\", \"default\": \"#E5322D\"},\n    {\"id\": \"glow_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Glow\", \"description\": \"Color of the halo and the glow on the wall.\", \"default\": \"#E5322D\"},\n    {\"id\": \"tube_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Unlit tube\", \"description\": \"Unlit glass tube.\", \"default\": \"#2A2A2A\"},\n    {\"id\": \"core_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Core\", \"description\": \"Color of the hot core inside the tube.\", \"default\": \"#FFFFFF\"},\n    {\"id\": \"background_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Wall color.\", \"default\": \"#111111\"},\n    {\"id\": \"stroke_width\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Tube thickness\", \"description\": \"Tube thickness in path units.\", \"default\": 6, \"min\": 2, \"max\": 14, \"step\": 1},\n    {\"id\": \"fit\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Fit\", \"description\": \"Share of the frame width the sign spans.\", \"default\": 0.62, \"min\": 0.3, \"max\": 0.9, \"step\": 0.01},\n    {\"id\": \"seed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Seed\", \"description\": \"Seed for the flicker.\", \"default\": 7, \"min\": 1, \"max\": 99, \"step\": 1},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier.\", \"default\": 1, \"min\": 0.25, \"max\": 3, \"step\": 0.05}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Neon Sign</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: var(--bg); }\n        .ns-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }\n        .ns-glow { position: absolute; inset: 0; opacity: 0; }\n        .ns-svg { position: relative; overflow: visible; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"neon-sign\" data-duration=\"2.333\" data-fps=\"30\">\n        <div id=\"ns-clip\" class=\"ns-stage clip\" data-start=\"0\" data-duration=\"2.333\" data-track-index=\"0\">\n          <div class=\"ns-glow\" id=\"ns-glow\"></div>\n          <svg class=\"ns-svg\" id=\"ns-svg\"></svg>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"neon-sign\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\nfunction col(v, f) { return typeof v === \"string\" && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v.trim()) ? v.trim() : f; }\nfunction bool(v, f) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : f; }\nvar FPS = 30;\nvar DUR = parseFloat(root.dataset.duration || \"2\");\nvar TOTAL = Math.round(DUR * FPS);\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction cl(x, a, b) { return Math.min(b, Math.max(a, x)); }\n// interpolate(x, [in...], [out...], easing): clamped on both sides, easing applied per segment.\nfunction interp(x, inp, out, easing) {\n  if (x <= inp[0]) return out[0];\n  if (x >= inp[inp.length - 1]) return out[out.length - 1];\n  var i = 0;\n  while (x > inp[i + 1]) i++;\n  var t = (x - inp[i]) / (inp[i + 1] - inp[i]);\n  if (easing) t = easing(t);\n  return out[i] + (out[i + 1] - out[i]) * t;\n}\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0; if (x >= 1) return 1;\n    var t = x;\n    for (var i = 0; i < 8; i++) {\n      var cx = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t - x;\n      var d = 3 * x1 * (1 - t) * (1 - t) - 6 * x1 * t * (1 - t) + 6 * x2 * t * (1 - t) - 3 * x2 * t * t + 3 * t * t;\n      if (Math.abs(cx) < 1e-6 || Math.abs(d) < 1e-6) break;\n      t -= cx / d;\n    }\n    t = cl(t, 0, 1);\n    return 3 * y1 * t * (1 - t) * (1 - t) + 3 * y2 * t * t * (1 - t) + t * t * t;\n  };\n}\nvar E = {\n  lin: function (t) { return t; },\n  quad: function (t) { return t * t; },\n  cubic: function (t) { return t * t * t; },\n  sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); }\n};\nfunction eOut(f) { return function (t) { return 1 - f(1 - t); }; }\nfunction eInOut(f) { return function (t) { return t < 0.5 ? f(2 * t) / 2 : 1 - f(2 - 2 * t) / 2; }; }\nvar outCubic = eOut(E.cubic), outQuad = eOut(E.quad), inCubic = E.cubic, inQuad = E.quad;\nvar inOutCubic = eInOut(E.cubic), inOutQuad = eInOut(E.quad), inOutSin = eInOut(E.sin), outSin = eOut(E.sin);\n// Damped spring from 0 to 1 (rest at 1, no initial velocity), frames at 30 fps.\nfunction spring(frame, cfg) {\n  if (frame <= 0) return 0;\n  var m = cfg.mass || 1, k = cfg.stiffness, c = cfg.damping;\n  var w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m)), t = frame / FPS;\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n  }\n  if (z === 1) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  var s = w0 * Math.sqrt(z * z - 1), r1 = -z * w0 + s, r2 = -z * w0 - s;\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\n// Seeded random: same string in, same number out.\nfunction rnd(seed) {\n  var sd = String(seed), h = 1779033703 ^ sd.length;\n  for (var i = 0; i < sd.length; i++) { h = Math.imul(h ^ sd.charCodeAt(i), 3432918353); h = (h << 13) | (h >>> 19); }\n  h = Math.imul(h ^ (h >>> 16), 2246822507); h = Math.imul(h ^ (h >>> 13), 3266489909); h ^= h >>> 16;\n  var a = (h >>> 0);\n  a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a);\n  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n}\nfunction rgb(h) {\n  h = h.replace(\"#\", \"\");\n  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];\n  return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];\n}\nfunction mixc(a, b, t) {\n  var x = rgb(a), y = rgb(b);\n  return \"rgb(\" + Math.round(lerp(x[0], y[0], t)) + \",\" + Math.round(lerp(x[1], y[1], t)) + \",\" + Math.round(lerp(x[2], y[2], t)) + \")\";\n}\nfunction rgba(h, a) { var x = rgb(h); return \"rgba(\" + x[0] + \",\" + x[1] + \",\" + x[2] + \",\" + a + \")\"; }\nvar SVGNS = \"http://www.w3.org/2000/svg\";\nfunction svgEl(tag, attrs, parent) {\n  var e = document.createElementNS(SVGNS, tag);\n  for (var k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\nfunction setA(e, attrs) { for (var k in attrs) e.setAttribute(k, attrs[k]); }\n// Drive draw(frame) from the timeline; frames run 0..frames over frames/30 seconds.\nfunction drive(draw, frames) {\n  var tl = gsap.timeline({ paused: true });\n  var clock = { frame: 0 };\n  tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n  draw(0);\n  return tl;\n}\nfunction finish(tl) {\n  if (tl.duration() < DUR) tl.to({}, { duration: DUR - tl.duration() });\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[NAME] = tl;\n}\n\n\nvar glow = document.getElementById(\"ns-glow\"), svg = document.getElementById(\"ns-svg\");\nvar HELLO = \"M 30 132 C 52 112 74 70 70 46 C 67 28 50 30 47 52 C 44 76 42 112 40 140 C 46 116 58 100 72 100 C 86 100 84 122 86 134 C 88 144 100 144 110 132 M 110 132 C 124 124 142 110 136 98 C 130 88 112 96 112 116 C 112 138 134 146 156 130 M 156 130 C 176 110 196 66 190 46 C 186 32 170 36 168 60 C 166 90 168 126 172 136 C 176 146 188 142 196 132 M 196 132 C 216 110 232 66 226 46 C 222 32 206 36 204 60 C 202 90 204 126 208 136 C 212 146 224 142 232 132 M 232 132 C 238 116 248 100 262 100 C 278 100 280 124 268 136 C 256 146 242 136 248 118 C 252 106 268 104 290 104 M 52 170 C 120 160 210 162 296 152\";\nvar pathD = str(vars.path, HELLO);\nvar color = col(vars.color, \"#E5322D\"), glowC = col(vars.glow_color, \"#E5322D\"), tubeC = col(vars.tube_color, \"#2A2A2A\"), coreC = col(vars.core_color, \"#FFFFFF\"), bg = col(vars.background_color, \"#111111\");\nvar sw = num(vars.stroke_width, 6, 2, 14), fit = num(vars.fit, 0.62, 0.3, 0.9), seed = Math.round(num(vars.seed, 7, 1, 99)), speed = num(vars.speed, 1, 0, 4);\nroot.style.setProperty(\"--bg\", bg);\nvar W = root.clientWidth, H = root.clientHeight;\nvar segs = pathD.split(/(?=[Mm])/).map(function (x) { return x.trim(); }).filter(Boolean);\n// Bounding box of the whole path, measured once on a throwaway element.\nvar probe = svgEl(\"path\", { d: pathD }, svg);\nvar bb = probe.getBBox(); svg.removeChild(probe);\nvar pad = sw * 6, box = { x: bb.x - pad, y: bb.y - pad, w: bb.width + pad * 2, h: bb.height + pad * 2 };\nvar scale = Math.min((W * fit) / box.w, (H * 0.7) / box.h), drawW = box.w * scale, drawH = box.h * scale;\nsvg.setAttribute(\"width\", drawW); svg.setAttribute(\"height\", drawH);\nsvg.setAttribute(\"viewBox\", box.x + \" \" + box.y + \" \" + box.w + \" \" + box.h);\nglow.style.background = \"radial-gradient(ellipse \" + drawW * 0.75 + \"px \" + drawH * 0.85 + \"px at 50% 50%, \" + glowC + \" 0%, transparent 100%)\";\nvar defs = svgEl(\"defs\", {}, svg);\n[\"wide\", \"near\"].forEach(function (n) {\n  var f = svgEl(\"filter\", { id: \"ns-\" + n, filterUnits: \"userSpaceOnUse\", x: box.x - box.w, y: box.y - box.h, width: box.w * 3, height: box.h * 3 }, defs);\n  svgEl(\"feGaussianBlur\", { stdDeviation: n === \"wide\" ? sw * 2.2 : sw * 0.6 }, f);\n});\nvar g = svgEl(\"g\", { fill: \"none\", \"stroke-linecap\": \"round\", \"stroke-linejoin\": \"round\" }, svg);\nsegs.forEach(function (d) { svgEl(\"path\", { d: d, stroke: tubeC, \"stroke-width\": sw }, g); });\nvar lit = segs.map(function (d) {\n  var gg = svgEl(\"g\", {}, g);\n  return [\n    svgEl(\"path\", { d: d, stroke: glowC, \"stroke-width\": sw * 3, filter: \"url(#ns-wide)\" }, gg),\n    svgEl(\"path\", { d: d, stroke: color, \"stroke-width\": sw * 1.6, filter: \"url(#ns-near)\" }, gg),\n    svgEl(\"path\", { d: d, stroke: color, \"stroke-width\": sw }, gg),\n    svgEl(\"path\", { d: d, stroke: coreC, \"stroke-width\": sw * 0.36 }, gg)\n  ];\n});\nvar FIRST = 3, STEP = 3.4, STUTTER = 7;\nvar BUZZ = [[29, 0.1], [30, 0], [31, 0.55], [32, 0.2]];\nfunction level(t, i) {\n  var onset = FIRST + i * STEP + rnd(\"neon-sign-\" + seed + \"-\" + i) * 2;\n  if (t < onset) return 0;\n  if (t < onset + STUTTER) {\n    var v = rnd(\"neon-sign-\" + seed + \"-\" + i + \"-\" + Math.floor(t));\n    var ramp = (t - onset) / STUTTER;\n    return v < 0.5 - ramp * 0.3 ? 0.04 : 0.55 + 0.45 * v;\n  }\n  return 1;\n}\nvar ALPHA = [0.7, 0.9, 1, 0.9];\nfunction draw(frame) {\n  var t = frame * speed, tick = Math.floor(t), buzz = 1;\n  BUZZ.forEach(function (b) { if (b[0] === tick) buzz = b[1]; });\n  var sum = 0;\n  lit.forEach(function (layers, i) {\n    var lv = level(t, i) * buzz; sum += lv;\n    layers.forEach(function (el, k) { el.setAttribute(\"opacity\", lv > 0 ? ALPHA[k] * lv : 0); });\n  });\n  glow.style.opacity = 0.28 * (sum / Math.max(1, lit.length)) * interp(t, [32, 40], [0.85, 1]);\n}\nfinish(drive(draw, TOTAL));\n\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
