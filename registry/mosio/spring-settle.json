   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Spring Settle\n\n  Scenes leave as one group, shrinking and fading, then the stage changes color on an empty beat and the next scene's items spring in staggered from slightly oversized. Plays three scenes (A, B, C).\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/spring-settle/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"spring-settle\"\n  data-composition-duration=\"7.1\"\n  data-composition-variables='[\n  {\n    \"id\": \"enter_scale\",\n    \"type\": \"number\",\n    \"role\": \"motion\",\n    \"label\": \"Enter scale\",\n    \"description\": \"Starting scale of each item as it settles in.\",\n    \"default\": 1.24,\n    \"min\": 1,\n    \"max\": 2,\n    \"step\": 0.01\n  },\n  {\n    \"id\": \"enter_stagger\",\n    \"type\": \"number\",\n    \"role\": \"motion\",\n    \"label\": \"Enter stagger\",\n    \"description\": \"Frames between items settling in (at 30 fps).\",\n    \"default\": 3,\n    \"min\": 0,\n    \"max\": 10,\n    \"step\": 0.5\n  },\n  {\n    \"id\": \"exit_scale\",\n    \"type\": \"number\",\n    \"role\": \"motion\",\n    \"label\": \"Exit scale\",\n    \"description\": \"Scale the scene shrinks to as it leaves.\",\n    \"default\": 0.84,\n    \"min\": 0.3,\n    \"max\": 1,\n    \"step\": 0.01\n  },\n  {\n    \"id\": \"exit_frames\",\n    \"type\": \"number\",\n    \"role\": \"motion\",\n    \"label\": \"Exit frames\",\n    \"description\": \"Frames the exit lasts (at 30 fps).\",\n    \"default\": 6,\n    \"min\": 2,\n    \"max\": 20,\n    \"step\": 1\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Spring Settle</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          font-family: var(--font-display, Geist, system-ui, sans-serif);\n          pointer-events: none;\n        }\n\n        #root { background: #141318; }\n        .ssl-stage { position: absolute; inset: 0; }\n        .ssl-panel { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }\n        .ssl-in { display: flex; flex-direction: column; align-items: center; gap: 2.4cqmin; }\n        .ssl-in span { font-size: 9cqmin; font-weight: 600; letter-spacing: -0.03em; line-height: 1; color: #f2f2f2; white-space: nowrap; }\n        .ssl-bar { display: block; width: 14cqmin; height: 0.8cqmin; border-radius: 1cqmin; background: rgba(242, 242, 242, 0.55); }\n        .ssl-pa { background: #141318; }\n        .ssl-pb { background: linear-gradient(135deg, #3b3699 0%, #1e2a6b 55%, #0f4c75 100%); }\n        .ssl-pc { background: linear-gradient(135deg, #7a2f5f 0%, #3a2250 55%, #1c1b3f 100%); }\n\n        .ssl-panel { display: none; }\n        .ssl-scene { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; }\n        .ssl-in { display: flex; flex-direction: column; align-items: center; gap: 2.4cqmin; }\n        .ssl-in .ssl-t { font-size: 9cqmin; font-weight: 600; letter-spacing: -0.03em; line-height: 1; color: #f2f2f2; white-space: nowrap; }\n        .ssl-in .ssl-n { font-size: 2.8cqmin; font-weight: 400; color: rgba(242, 242, 242, 0.5); white-space: nowrap; }\n        .ssl-bar { display: block; width: 14cqmin; height: 0.5cqmin; margin-top: 1cqmin; }\n        .ssl-item { display: block; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"spring-settle\" data-duration=\"7.1\" data-fps=\"30\">\n        <div id=\"ssl-clip\" class=\"ssl-stage clip\" data-start=\"0\" data-duration=\"7.1\" data-track-index=\"0\">\n          <div id=\"ssl-a\" class=\"ssl-scene\"><div class=\"ssl-in\"><span class=\"ssl-item ssl-t\">Scene A</span><span class=\"ssl-item ssl-n\">the scene leaves as one group</span><i class=\"ssl-item ssl-bar\" style=\"background:#6c6ae8\"></i></div></div>\n          <div id=\"ssl-b\" class=\"ssl-scene\"><div class=\"ssl-in\"><span class=\"ssl-item ssl-t\">Scene B</span><span class=\"ssl-item ssl-n\">one empty beat, the stage changes color</span><i class=\"ssl-item ssl-bar\" style=\"background:#e8776c\"></i></div></div>\n          <div id=\"ssl-c\" class=\"ssl-scene\"><div class=\"ssl-in\"><span class=\"ssl-item ssl-t\">Scene C</span><span class=\"ssl-item ssl-n\">items settle in, staggered</span><i class=\"ssl-item ssl-bar\" style=\"background:#6ce8b0\"></i></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        \n        <script>\n          (function () {\n            \"use strict\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v.trim() : f; }\nfunction pick(v, list, f) { return list.indexOf(String(v)) >= 0 ? String(v) : f; }\nfunction clamp01(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction smooth(a, b, x) { var t = clamp01((x - a) / (b - a)); return t * t * (3 - 2 * t); }\n// cubic-bezier easing, solved by bisection (pure function of x)\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0;\n    if (x >= 1) return 1;\n    var lo = 0, hi = 1, t = x;\n    for (var i = 0; i < 28; i++) {\n      var cx = 3 * (1 - t) * (1 - t) * t * x1 + 3 * (1 - t) * t * t * x2 + t * t * t;\n      if (cx < x) lo = t; else hi = t;\n      t = (lo + hi) / 2;\n    }\n    return 3 * (1 - t) * (1 - t) * t * y1 + 3 * (1 - t) * t * t * y2 + t * t * t;\n  };\n}\nvar inOutEase = bez(0.42, 0, 0.58, 1);\nfunction inCubic(x) { return x * x * x; }\nfunction outCubic(x) { return 1 - Math.pow(1 - x, 3); }\nfunction inQuad(x) { return x * x; }\nfunction outQuad(x) { return 1 - (1 - x) * (1 - x); }\nfunction outBack(s) { return function (x) { return 1 + (s + 1) * Math.pow(x - 1, 3) + s * Math.pow(x - 1, 2); }; }\n// interpolate(p, inputs, outputs, ease): clamped, eased per segment (like a frame interpolate)\nfunction interp(p, xs, ys, ease) {\n  var n = xs.length;\n  if (p <= xs[0]) return ys[0];\n  if (p >= xs[n - 1]) return ys[n - 1];\n  for (var i = 1; i < n; i++) {\n    if (p <= xs[i]) {\n      var t = (p - xs[i - 1]) / (xs[i] - xs[i - 1]);\n      if (ease) t = ease(t);\n      return lerp(ys[i - 1], ys[i], t);\n    }\n  }\n  return ys[n - 1];\n}\nfunction mulberry32(a) {\n  return function () {\n    a |= 0; a = (a + 0x6d2b79f5) | 0;\n    var t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n// damped spring from 0 to 1 (zero initial velocity), t in seconds\nfunction spring(t, damping, stiffness, mass) {\n  if (t <= 0) return 0;\n  var w0 = Math.sqrt(stiffness / mass), z = damping / (2 * Math.sqrt(stiffness * mass));\n  if (Math.abs(z - 1) < 1e-4) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + (z * w0 / wd) * Math.sin(wd * t));\n  }\n  var s = Math.sqrt(z * z - 1), r1 = -w0 * (z - s), r2 = -w0 * (z + s);\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\nfunction stripIds(node) {\n  var all = node.querySelectorAll(\"[id]\");\n  for (var i = 0; i < all.length; i++) all[i].removeAttribute(\"id\");\n  node.removeAttribute(\"id\");\n  return node;\n}\nfunction drive(name, duration, frame) {\n  var st = { p: 0 };\n  frame(0);\n  var tl = gsap.timeline({ paused: true });\n  tl.to(st, { p: 1, duration: duration, ease: \"none\", onUpdate: function () { frame(st.p); } }, 0);\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[name] = tl;\n}\n\nfunction hex(c, f) {\n  c = String(c || \"\").trim().replace(\"#\", \"\");\n  if (c.length === 3) c = c.split(\"\").map(function (x) { return x + x; }).join(\"\");\n  if (!/^[0-9a-fA-F]{6}$/.test(c)) c = f || \"000000\";\n  var n = parseInt(c, 16);\n  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];\n}\nfunction palette(v, fallback) {\n  var list = String(v || fallback).split(\",\").map(function (s) { return hex(s, \"808080\"); });\n  return list.length ? list : [hex(fallback)];\n}\nfunction hash2(x, y, s) {\n  var h = Math.imul(x | 0, 374761393) + Math.imul(y | 0, 668265263) + Math.imul(s | 0, 1442695041);\n  h = Math.imul(h ^ (h >>> 13), 1274126177);\n  h ^= h >>> 16;\n  return (h >>> 0) / 4294967296;\n}\nfunction vnoise(x, y, s) {\n  var xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;\n  var u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);\n  var a = hash2(xi, yi, s), b = hash2(xi + 1, yi, s), c = hash2(xi, yi + 1, s), d = hash2(xi + 1, yi + 1, s);\n  return lerp(lerp(a, b, u), lerp(c, d, u), v);\n}\nfunction fbm(x, y, s, oct) {\n  var sum = 0, amp = 0.5, tot = 0;\n  for (var i = 0; i < oct; i++) {\n    sum += amp * vnoise(x, y, s + i * 17);\n    tot += amp; x = x * 2.03 + 11.3; y = y * 2.03 - 7.1; amp *= 0.5;\n  }\n  return sum / tot;\n}\nfunction mixc(o, a, b, t) {\n  o[0] = a[0] + (b[0] - a[0]) * t; o[1] = a[1] + (b[1] - a[1]) * t; o[2] = a[2] + (b[2] - a[2]) * t;\n}\n// ramp through a list of colours with t in 0..1\nfunction ramp(o, list, t) {\n  t = clamp01(t) * (list.length - 1);\n  var i = Math.min(list.length - 2, Math.floor(t));\n  if (list.length === 1) { o[0] = list[0][0]; o[1] = list[0][1]; o[2] = list[0][2]; return; }\n  var f = t - i; f = f * f * (3 - 2 * f);\n  mixc(o, list[i], list[i + 1], f);\n}\n// Low-resolution 2D canvas filled per pixel; fn(u, v, out) gets centred coordinates (v spans -0.5..0.5).\nfunction makeField(canvas, cell) {\n  var W = Math.max(8, Math.round(root.clientWidth / cell)), H = Math.max(8, Math.round(root.clientHeight / cell));\n  canvas.width = W; canvas.height = H;\n  var ctx = canvas.getContext(\"2d\");\n  var img = ctx.createImageData(W, H);\n  var out = [0, 0, 0];\n  return {\n    W: W, H: H,\n    paint: function (fn) {\n      var d = img.data, i = 0;\n      for (var y = 0; y < H; y++) {\n        for (var x = 0; x < W; x++) {\n          fn((x + 0.5 - W / 2) / H, (y + 0.5 - H / 2) / H, out, x, y);\n          d[i++] = out[0]; d[i++] = out[1]; d[i++] = out[2]; d[i++] = 255;\n        }\n      }\n      ctx.putImageData(img, 0, 0);\n    }\n  };\n}\n\n            var D = 7.1;\n\nvar enterScale = num(vars.enter_scale, 1.24, 1, 2), enterStagger = num(vars.enter_stagger, 3, 0, 10);\nvar exitScale = num(vars.exit_scale, 0.84, 0.3, 1), exitFrames = Math.round(num(vars.exit_frames, 6, 2, 20));\nvar SCENES = [\"#141318\", \"#1a1922\", \"#12171a\"], DWELL = 70, GAP = 1, SLOT = DWELL + GAP, TOTAL = SLOT * 3, BG_FADE = 4;\nvar scenes = [\"a\", \"b\", \"c\"].map(function (l) {\n  var el = document.getElementById(\"ssl-\" + l);\n  return { el: el, items: Array.prototype.slice.call(el.querySelectorAll(\".ssl-item\")), inner: el.querySelector(\".ssl-in\") };\n});\nvar offs = scenes.map(function (s, si) {\n  var rnd = mulberry32(900 + si);\n  return s.items.map(function (it, i) { return Math.max(0, Math.pow(i, 0.8) * enterStagger + (rnd() - 0.5) * 2); });\n});\nvar bgs = SCENES.map(function (c) { return hex(c, \"141318\"); });\nvar tmp = [0, 0, 0], stage = document.getElementById(\"ssl-clip\");\nfunction frame(p) {\n  var f = Math.min(Math.floor(p * TOTAL), TOTAL - 1), idx = Math.min(2, Math.floor(f / SLOT)), local = f - idx * SLOT;\n  var start = idx * SLOT, half = BG_FADE / 2, bg = bgs[idx];\n  if (idx > 0) { var d = f - (start - GAP / 2); if (Math.abs(d) <= half) { mixc(tmp, bgs[idx - 1], bgs[idx], (d + half) / (2 * half)); bg = tmp; } }\n  if (idx < 2) { var d2 = f - (start + DWELL + GAP / 2); if (Math.abs(d2) <= half) { mixc(tmp, bgs[idx], bgs[idx + 1], (d2 + half) / (2 * half)); bg = tmp; } }\n  stage.style.background = \"rgb(\" + Math.round(bg[0]) + \",\" + Math.round(bg[1]) + \",\" + Math.round(bg[2]) + \")\";\n  for (var s = 0; s < 3; s++) scenes[s].el.style.display = s === idx && local < DWELL ? \"flex\" : \"none\";\n  var sc = scenes[idx];\n  if (local >= DWELL) return;\n  var tExit = interp(local, [DWELL - exitFrames, DWELL], [0, 1]), eExit = Math.pow(tExit, 5);\n  sc.inner.style.scale = tExit > 0 ? 1 - (1 - exitScale) * eExit : 1;\n  sc.inner.style.opacity = tExit > 0 ? 1 - eExit : 1;\n  for (var i = 0; i < sc.items.length; i++) {\n    var te = local - offs[idx][i], sp = spring(te / 30, 30, 320, 1);\n    sc.items[i].style.scale = lerp(enterScale, 1, sp);\n    sc.items[i].style.opacity = interp(te, [0, 5], [0, 1], outQuad);\n  }\n}\n\n            drive(\"spring-settle\", D, frame);\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
