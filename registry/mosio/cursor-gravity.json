   "content": "<!doctype html>\n<!--\n  Cursor Gravity\n\n  A rounded triangular cursor tugs a button out of the screen edge with pulsed elastic resistance.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/cursor-gravity/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"cursor-gravity\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[{\"id\":\"label\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Label\",\"description\":\"Button text.\",\"default\":\"Create something\"},{\"id\":\"tension\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Tension\",\"description\":\"Strength of the elastic neck and recoil, 0 to 1.5.\",\"default\":1,\"min\":0,\"max\":1.5,\"step\":0.05},{\"id\":\"cursor_color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Cursor\",\"description\":\"Cursor and tether color.\",\"default\":\"#fffaf0\"},{\"id\":\"color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Button\",\"description\":\"Button fill color.\",\"default\":\"#fffaf0\"},{\"id\":\"text_color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Text\",\"description\":\"Button text color.\",\"default\":\"#32153c\"},{\"id\":\"background_color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Background\",\"description\":\"Backdrop color.\",\"default\":\"#a800b7\"},{\"id\":\"speed\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Speed\",\"description\":\"Playback speed multiplier.\",\"default\":1,\"min\":0.25,\"max\":3,\"step\":0.05,\"unit\":\"x\"}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Cursor Gravity</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n\n        }\n        #root { font-family: Arial, Helvetica, sans-serif; }\n        .cgr-stage { position: absolute; inset: 0; }\n        .cgr-svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n        .cgr-content { position: absolute; left: 0; top: 0; width: 300px; height: 88px; transform-origin: top left; display: flex; align-items: center; justify-content: center; gap: 20px; font-weight: 600; font-size: 23px; }\n        .cgr-label { max-width: 220px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }\n        .cgr-cursor { position: absolute; left: 0; top: 0; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"cursor-gravity\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"cgr-clip\" class=\"cgr-stage clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\">\n          <svg id=\"cgr-svg\" class=\"cgr-svg\" aria-hidden=\"true\"><path id=\"cgr-button\"></path><path id=\"cgr-tether\" fill=\"none\" stroke-linecap=\"round\"></path></svg>\n          <div id=\"cgr-content\" class=\"cgr-content\"><span id=\"cgr-label\" class=\"cgr-label\"></span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12H19M13 6L19 12L13 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div>\n          <svg id=\"cgr-cursor\" class=\"cgr-cursor\" viewBox=\"-180 -35 190 70\" role=\"img\" aria-label=\"Rounded triangular cursor\"><path id=\"cgr-cpath\"></path></svg>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n            \n\n                                     \n                                                           \n                       \n                 \n                                                        \n                   \n                       \n                 \n                     \n                           \n                 \n                     \n \n\nconst cursorGravityLength = 151;\nconst DURATION = 180;\nconst finite = (value        , fallback        ) =>\n  Number.isFinite(value) ? value : fallback;\nconst clamp = (value        ) => Math.max(0, Math.min(1, value));\nconst mix = (a        , b        , p        ) => a + (b - a) * p;\nconst progress = (frame        , start        , end        ) =>\n  clamp((frame - start) / (end - start));\nconst ease = Easing.bezier(0.65, 0, 0.35, 1);\nconst pullEase = Easing.bezier(0.12, 0.8, 0.22, 1);\n\n/** Complete transition plus a one-second hold, in frames at 30 fps. */\nfunction getCursorGravityDuration({\n  speed = 1,\n}                                    = {}) {\n  const rate = Math.max(0, finite(speed, 1));\n  return rate === 0 ? 1 : Math.max(1, Math.ceil(DURATION / rate));\n}\n\n/** A pull advances sharply, pauses under load, then recoils before the next tug. */\nfunction pullDistance(t        , strength        ) {\n  const keys = [\n    [48, 0],\n    [59, 116],\n    [64, 116],\n    [70, 116 - 30 * strength],\n    [83, 292],\n    [87, 292],\n    [94, 292 - 42 * strength],\n    [112, 772],\n  ];\n  if (t <= keys[0][0]) return 0;\n  for (let i = 1; i < keys.length; i++) {\n    const [start, a] = keys[i - 1];\n    const [end, b] = keys[i];\n    if (t <= end)\n      return mix(a, b, (b > a ? pullEase : ease)(progress(t, start, end)));\n  }\n  return 772;\n}\n\n/** Pure, resolution-aware pose. The right edge is the real composition boundary. */\nfunction getCursorGravityState(\n  frame        ,\n  {\n    width = 1280,\n    height = 720,\n    tension = 1,\n  }                                                        = {},\n) {\n  const w = Math.max(1, finite(width, 1280));\n  const h = Math.max(1, finite(height, 720));\n  const unit = Math.min(w / 1280, h / 720);\n  const t = Math.max(0, finite(frame, 0));\n  const strength = Math.max(0, Math.min(1.5, finite(tension, 1)));\n  const centerY = h * 0.5;\n  const finalLeft = w / 2 - 150 * unit;\n  const finalRight = w / 2 + 150 * unit;\n  const edgeTip = w - 24 * unit;\n  const distance = pullDistance(t, strength) / 772;\n  const extraction = distance * (edgeTip - (finalLeft - 14 * unit));\n  // The back of the button resists the first two tugs beyond the frame edge.\n  const releaseTime = progress(t, 94, 132);\n  // Closed-form damped spring stays continuous at fractional frames too.\n  const springRelease =\n    1 -\n    Math.exp(-7 * releaseTime) *\n      (Math.cos(10 * releaseTime) + 0.7 * Math.sin(10 * releaseTime));\n  const release = mix(springRelease, 1, ease(progress(t, 122, 132)));\n  const front = mix(w + 12 * unit, finalLeft, distance);\n  const right = mix(w + 312 * unit - distance * 70 * unit, finalRight, release);\n  const buttonWidth = Math.max(220 * unit, right - front);\n  const strain = clamp((buttonWidth / (300 * unit) - 1) / 1.3) * strength;\n  const wobble =\n    t < 112\n      ? 0\n      : Math.sin((t - 112) * 0.48) *\n        Math.exp(-(t - 112) * 0.14) *\n        5 *\n        unit *\n        strength *\n        (1 - progress(t, 132, 140));\n  const y = centerY + wobble;\n  const entry = ease(progress(t, 10, 39));\n  const approach = ease(progress(t, 39, 48));\n  const leave = ease(progress(t, 127, 151));\n  const holdTip = mix(w * 0.28, edgeTip - 80 * unit, entry);\n  const pullTip = edgeTip - extraction;\n  const cursorX =\n    t < 48 ? mix(holdTip, edgeTip, approach) : mix(pullTip, w * 0.25, leave);\n  const cursorY =\n    t < 39\n      ? mix(h + 110 * unit, centerY + 70 * unit, entry)\n      : t < 48\n        ? mix(centerY + 70 * unit, centerY, approach)\n        : mix(centerY, h + 110 * unit, leave);\n  // Triangle points toward the edge while pulling; turns toward its exit afterward.\n  const cursorAngle = t < 48 ? mix(-32, 0, approach) : mix(0, 115, leave);\n  const effortPulse = (\n    start        ,\n    peak        ,\n    hold        ,\n    end        ,\n  ) => ease(progress(t, start, peak)) * (1 - ease(progress(t, hold, end)));\n  const cursorEffort =\n    strength *\n    (0.8 * effortPulse(48, 58, 64, 70) +\n      effortPulse(70, 81, 87, 94) +\n      1.15 * effortPulse(94, 100, 104, 118));\n  return {\n    frame: t,\n    unit,\n    front,\n    right: front + buttonWidth,\n    buttonWidth,\n    centerY: y,\n    strain,\n    neckHeight: 88 * unit * (1 - 0.58 * strain),\n    bodyHeight: 88 * unit * (1 - 0.17 * strain),\n    cursorX,\n    cursorY,\n    cursorAngle,\n    cursorEffort,\n    attached: t >= 48 && t <= 121,\n    tetherOpacity: progress(t, 46, 49) * (1 - progress(t, 115, 122)),\n  };\n}\n\n/** The tip stays fixed; the rear bows backward as each tug builds effort. */\nfunction getGravityCursorPath(effort        ) {\n  const load = Math.max(0, Math.min(1.725, finite(effort, 0)));\n  const shoulder = -62 - 30 * load;\n  const rear = -70 - 40 * load;\n  const halfHeight = 26 - 4 * load;\n  return `M -5 -4 Q 3 0 -5 4\n    C -24 ${11.333 - load * 3} ${shoulder + 19} ${halfHeight - 7.333} ${shoulder} ${halfHeight}\n    Q ${rear} ${halfHeight + 4} ${rear} ${halfHeight - 6}\n    C ${rear} 4 ${rear - 18 * load} 8 ${rear - 18 * load} 0\n    C ${rear - 18 * load} -8 ${rear} -4 ${rear} ${-halfHeight + 6}\n    Q ${rear} ${-halfHeight - 4} ${shoulder} ${-halfHeight}\n    C ${shoulder + 19} ${-halfHeight + 7.333} -24 ${-11.333 + load * 3} -5 -4 Z`;\n}\n\n/** Rounded rectangle with a narrow leading edge: the pull deforms the surface. */\nfunction getGravityButtonPath(\n  state                                          ,\n) {\n  const { buttonWidth: w, neckHeight, bodyHeight, unit } = state;\n  const a = neckHeight / 2;\n  const b = bodyHeight / 2;\n  const r = Math.min(25 * unit, a * 0.9);\n  const backRadius = 25 * unit;\n  return `M ${r} ${-a}\n    C ${w * 0.35} ${-a} ${w * 0.35} ${-b} ${w - backRadius} ${-b}\n    Q ${w} ${-b} ${w} ${-b + backRadius}\n    L ${w} ${b - backRadius} Q ${w} ${b} ${w - backRadius} ${b}\n    C ${w * 0.35} ${b} ${w * 0.35} ${a} ${r} ${a}\n    Q 0 ${a} 0 ${a - r} L 0 ${-a + r} Q 0 ${-a} ${r} ${-a} Z`;\n}\n\n\n            var tension = num(vars.tension, 1, 0, 1.5), speed = num(vars.speed, 1, 0.25, 3);\n            var cursorColor = str(vars.cursor_color, \"#fffaf0\"), color = str(vars.color, \"#fffaf0\"), textColor = str(vars.text_color, \"#32153c\");\n            root.style.background = str(vars.background_color, \"#a800b7\");\n            var width = root.clientWidth, height = root.clientHeight;\n            var svg = document.getElementById(\"cgr-svg\");\n            svg.setAttribute(\"viewBox\", \"0 0 \" + width + \" \" + height);\n            var buttonEl = document.getElementById(\"cgr-button\"), tether = document.getElementById(\"cgr-tether\");\n            var content = document.getElementById(\"cgr-content\"), cursor = document.getElementById(\"cgr-cursor\"), cpath = document.getElementById(\"cgr-cpath\");\n            document.getElementById(\"cgr-label\").textContent = str(vars.label, \"Create something\");\n            buttonEl.setAttribute(\"fill\", color);\n            tether.setAttribute(\"stroke\", cursorColor);\n            cpath.setAttribute(\"fill\", cursorColor);\n            content.style.color = textColor;\n            function draw(frame) {\n              var t = frame * speed;\n              var state = getCursorGravityState(t, { width: width, height: height, tension: tension });\n              var unit = state.unit;\n              var contentUnit = unit * Math.min(1, state.buttonWidth / (300 * unit));\n              var contentX = state.front + state.buttonWidth - 150 * contentUnit;\n              buttonEl.setAttribute(\"d\", getGravityButtonPath(state));\n              buttonEl.setAttribute(\"transform\", \"translate(\" + state.front + \" \" + state.centerY + \")\");\n              tether.setAttribute(\"d\", \"M \" + (state.cursorX + 2 * unit) + \" \" + state.cursorY + \" Q \" + mix(state.cursorX, state.front, 0.5) + \" \" + state.centerY + \" \" + (state.front + 2 * unit) + \" \" + state.centerY);\n              tether.setAttribute(\"stroke-width\", 2 * unit);\n              tether.setAttribute(\"opacity\", state.tetherOpacity);\n              content.style.transform = \"translate(\" + (contentX - 150 * contentUnit) + \"px, \" + (state.centerY - 44 * contentUnit) + \"px) scale(\" + contentUnit + \")\";\n              cursor.setAttribute(\"width\", 190 * unit); cursor.setAttribute(\"height\", 70 * unit);\n              cursor.style.transformOrigin = 180 * unit + \"px \" + 35 * unit + \"px\";\n              cursor.style.transform = \"translate(\" + (state.cursorX - 180 * unit) + \"px, \" + (state.cursorY - 35 * unit) + \"px) rotate(\" + state.cursorAngle + \"deg)\";\n              cpath.setAttribute(\"d\", getGravityCursorPath(state.cursorEffort));\n            }\n            var tl = gsap.timeline({ paused: true });\n            clockTween(tl, 180, draw, 1);\n\n            var total = parseFloat(root.dataset.duration || \"6\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"cursor-gravity\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
