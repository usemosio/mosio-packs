   "content": "<!doctype html>\n<!--\n  Anamorphic Flare\n\n  A point of light stretches into a cinematic horizontal streak that sweeps the frame and reveals the logo behind it. The placeholder lockup is a stand-in: a host swaps in its own logo by editing the .af-logo element.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/anamorphic-flare/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"anamorphic-flare\"\n  data-composition-duration=\"2.333\"\n  data-composition-variables='[\n    {\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Wordmark\", \"description\": \"Placeholder lockup text revealed behind the streak.\", \"default\": \"studio\"},\n    {\"id\": \"tint\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Tint\", \"description\": \"Warm tint of the streak glow and ghosts.\", \"default\": \"#E5322D\"},\n    {\"id\": \"core_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Core\", \"description\": \"Color of the hot core line.\", \"default\": \"#FFFFFF\"},\n    {\"id\": \"background_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Stage color.\", \"default\": \"#111111\"},\n    {\"id\": \"ghosts\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Ghosts\", \"description\": \"Number of ghost orbs mirrored across the frame center.\", \"default\": 4, \"min\": 0, \"max\": 12, \"step\": 1},\n    {\"id\": \"y\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Streak height\", \"description\": \"Vertical position of the streak, 0 to 1.\", \"default\": 0.5, \"min\": 0, \"max\": 1, \"step\": 0.01},\n    {\"id\": \"seed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Seed\", \"description\": \"Seed for the ghost orbs.\", \"default\": 2, \"min\": 1, \"max\": 99, \"step\": 1},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier.\", \"default\": 1, \"min\": 0.25, \"max\": 3, \"step\": 0.05}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Anamorphic Flare</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        .af-lockup { display: flex; align-items: center; gap: 28px; }\n        .af-mark { width: 120px; height: 120px; border-radius: 32px; display: flex; align-items: center; justify-content: center; background: var(--mark); }\n        .af-dot { width: 36px; height: 36px; border-radius: 50%; background: var(--dot); }\n        .af-word { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Helvetica, Arial, sans-serif; font-size: 104px; font-weight: 800; letter-spacing: -0.04em; color: var(--text); white-space: nowrap; }\n        #root { background: var(--bg); }\n        .af-stage { position: absolute; inset: 0; }\n        .af-svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n        .af-svg.fx { mix-blend-mode: screen; }\n        .af-logo { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"anamorphic-flare\" data-duration=\"2.333\" data-fps=\"30\">\n        <div id=\"af-clip\" class=\"af-stage clip\" data-start=\"0\" data-duration=\"2.333\" data-track-index=\"0\">\n          <svg class=\"af-svg\" id=\"af-trailsvg\"></svg>\n          <div class=\"af-logo\" id=\"af-logo\"><div class=\"af-lockup\" id=\"af-lockup\"><div class=\"af-mark\"><div class=\"af-dot\"></div></div><span class=\"af-word\" id=\"af-word\">studio</span></div></div>\n          <svg class=\"af-svg fx\" id=\"af-fx\"></svg>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"anamorphic-flare\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\nfunction col(v, f) { return typeof v === \"string\" && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v.trim()) ? v.trim() : f; }\nfunction bool(v, f) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : f; }\nvar FPS = 30;\nvar DUR = parseFloat(root.dataset.duration || \"2\");\nvar TOTAL = Math.round(DUR * FPS);\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction cl(x, a, b) { return Math.min(b, Math.max(a, x)); }\n// interpolate(x, [in...], [out...], easing): clamped on both sides, easing applied per segment.\nfunction interp(x, inp, out, easing) {\n  if (x <= inp[0]) return out[0];\n  if (x >= inp[inp.length - 1]) return out[out.length - 1];\n  var i = 0;\n  while (x > inp[i + 1]) i++;\n  var t = (x - inp[i]) / (inp[i + 1] - inp[i]);\n  if (easing) t = easing(t);\n  return out[i] + (out[i + 1] - out[i]) * t;\n}\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0; if (x >= 1) return 1;\n    var t = x;\n    for (var i = 0; i < 8; i++) {\n      var cx = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t - x;\n      var d = 3 * x1 * (1 - t) * (1 - t) - 6 * x1 * t * (1 - t) + 6 * x2 * t * (1 - t) - 3 * x2 * t * t + 3 * t * t;\n      if (Math.abs(cx) < 1e-6 || Math.abs(d) < 1e-6) break;\n      t -= cx / d;\n    }\n    t = cl(t, 0, 1);\n    return 3 * y1 * t * (1 - t) * (1 - t) + 3 * y2 * t * t * (1 - t) + t * t * t;\n  };\n}\nvar E = {\n  lin: function (t) { return t; },\n  quad: function (t) { return t * t; },\n  cubic: function (t) { return t * t * t; },\n  sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); }\n};\nfunction eOut(f) { return function (t) { return 1 - f(1 - t); }; }\nfunction eInOut(f) { return function (t) { return t < 0.5 ? f(2 * t) / 2 : 1 - f(2 - 2 * t) / 2; }; }\nvar outCubic = eOut(E.cubic), outQuad = eOut(E.quad), inCubic = E.cubic, inQuad = E.quad;\nvar inOutCubic = eInOut(E.cubic), inOutQuad = eInOut(E.quad), inOutSin = eInOut(E.sin), outSin = eOut(E.sin);\n// Damped spring from 0 to 1 (rest at 1, no initial velocity), frames at 30 fps.\nfunction spring(frame, cfg) {\n  if (frame <= 0) return 0;\n  var m = cfg.mass || 1, k = cfg.stiffness, c = cfg.damping;\n  var w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m)), t = frame / FPS;\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n  }\n  if (z === 1) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  var s = w0 * Math.sqrt(z * z - 1), r1 = -z * w0 + s, r2 = -z * w0 - s;\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\n// Seeded random: same string in, same number out.\nfunction rnd(seed) {\n  var sd = String(seed), h = 1779033703 ^ sd.length;\n  for (var i = 0; i < sd.length; i++) { h = Math.imul(h ^ sd.charCodeAt(i), 3432918353); h = (h << 13) | (h >>> 19); }\n  h = Math.imul(h ^ (h >>> 16), 2246822507); h = Math.imul(h ^ (h >>> 13), 3266489909); h ^= h >>> 16;\n  var a = (h >>> 0);\n  a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a);\n  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n}\nfunction rgb(h) {\n  h = h.replace(\"#\", \"\");\n  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];\n  return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];\n}\nfunction mixc(a, b, t) {\n  var x = rgb(a), y = rgb(b);\n  return \"rgb(\" + Math.round(lerp(x[0], y[0], t)) + \",\" + Math.round(lerp(x[1], y[1], t)) + \",\" + Math.round(lerp(x[2], y[2], t)) + \")\";\n}\nfunction rgba(h, a) { var x = rgb(h); return \"rgba(\" + x[0] + \",\" + x[1] + \",\" + x[2] + \",\" + a + \")\"; }\nvar SVGNS = \"http://www.w3.org/2000/svg\";\nfunction svgEl(tag, attrs, parent) {\n  var e = document.createElementNS(SVGNS, tag);\n  for (var k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\nfunction setA(e, attrs) { for (var k in attrs) e.setAttribute(k, attrs[k]); }\n// Drive draw(frame) from the timeline; frames run 0..frames over frames/30 seconds.\nfunction drive(draw, frames) {\n  var tl = gsap.timeline({ paused: true });\n  var clock = { frame: 0 };\n  tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n  draw(0);\n  return tl;\n}\nfunction finish(tl) {\n  if (tl.duration() < DUR) tl.to({}, { duration: DUR - tl.duration() });\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[NAME] = tl;\n}\n\n\nvar tsvg = document.getElementById(\"af-trailsvg\"), fx = document.getElementById(\"af-fx\"), logo = document.getElementById(\"af-logo\");\nvar tint = col(vars.tint, \"#E5322D\"), coreC = col(vars.core_color, \"#FFFFFF\"), bg = col(vars.background_color, \"#111111\");\nvar ghosts = Math.round(num(vars.ghosts, 4, 0, 12)), yy = num(vars.y, 0.5, 0, 1), seed = Math.round(num(vars.seed, 2, 1, 99)), speed = num(vars.speed, 1, 0, 4);\nroot.style.setProperty(\"--bg\", bg); root.style.setProperty(\"--mark\", tint); root.style.setProperty(\"--dot\", bg); root.style.setProperty(\"--text\", coreC);\ndocument.getElementById(\"af-word\").textContent = str(vars.text, \"studio\");\nvar W = root.clientWidth, H = root.clientHeight;\ntsvg.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H); fx.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H);\nvar IGNITE = 6, CROSS_START = 4, CROSS_END = 26;\nvar cy = yy * H, cx = W / 2, coreH = Math.max(2, H * 0.004), glowH = H * 0.05;\nfunction grad(parent, id, x2, stops) {\n  var g = svgEl(x2 === null ? \"radialGradient\" : \"linearGradient\", x2 === null ? { id: id } : { id: id, x1: 0, y1: 0, x2: 1, y2: 0 }, parent);\n  stops.forEach(function (s) { svgEl(\"stop\", { offset: s[0], \"stop-color\": s[1], \"stop-opacity\": s[2] }, g); });\n}\nvar d1 = svgEl(\"defs\", {}, tsvg);\ngrad(d1, \"af-trail\", 1, [[0, tint, 0], [0.5, tint, 1], [1, tint, 0]]);\nvar resid = svgEl(\"rect\", { x: 0, y: cy - 1, width: W, height: 2, fill: \"url(#af-trail)\" }, tsvg);\nvar d2 = svgEl(\"defs\", {}, fx);\ngrad(d2, \"af-trail2\", 1, [[0, tint, 0], [0.5, tint, 1], [1, tint, 0]]);\ngrad(d2, \"af-core\", 1, [[0, coreC, 0], [0.5, coreC, 1], [1, coreC, 0]]);\ngrad(d2, \"af-bloom\", null, [[0, coreC, 1], [0.25, tint, 0.7], [1, tint, 0]]);\ngrad(d2, \"af-ghost\", null, [[0, tint, 0.15], [0.8, tint, 0.5], [1, tint, 0]]);\nvar flt = svgEl(\"filter\", { id: \"af-blur\", x: -W, y: -H, width: W * 3, height: H * 3, filterUnits: \"userSpaceOnUse\" }, d2);\nsvgEl(\"feGaussianBlur\", { stdDeviation: glowH * 0.35 }, flt);\nvar grp = svgEl(\"g\", {}, fx);\nvar glowR = svgEl(\"rect\", { y: cy - glowH / 2, height: glowH, fill: \"url(#af-trail2)\", opacity: 0.55, filter: \"url(#af-blur)\" }, grp);\nvar coreR = svgEl(\"rect\", { y: cy - coreH / 2, height: coreH, fill: \"url(#af-core)\" }, grp);\nvar bloom = svgEl(\"ellipse\", { cy: cy, rx: H * 0.16, ry: H * 0.1, fill: \"url(#af-bloom)\" }, grp);\nvar gh = [];\nfor (var i = 0; i < ghosts; i++) {\n  gh.push({ k: -1.3 + rnd(\"anamorphic-flare-\" + seed + \"-\" + i + \"-k\") * 2.2, r: H * (0.025 + 0.07 * rnd(\"anamorphic-flare-\" + seed + \"-\" + i + \"-r\")), o: 0.12 + 0.18 * rnd(\"anamorphic-flare-\" + seed + \"-\" + i + \"-o\"), dy: (rnd(\"anamorphic-flare-\" + seed + \"-\" + i + \"-y\") - 0.5) * H * 0.05 });\n  gh[i].el = svgEl(\"circle\", { fill: \"url(#af-ghost)\", opacity: gh[i].o * 2 }, grp);\n}\nvar headEase = bez(0.45, 0, 0.4, 1);\nfunction draw(frame) {\n  var t = frame * speed;\n  var head = interp(t, [CROSS_START, CROSS_END], [0.07, 1.12], headEase), hx = head * W;\n  var power = interp(t, [0, IGNITE], [0, 1], outCubic) * interp(t, [CROSS_END - 6, CROSS_END + 2], [1, 0]);\n  var streakLen = W * interp(t, [0, 12], [0.04, 1.3], outQuad);\n  var soft = W * 0.08;\n  var mask = \"linear-gradient(90deg, #000 0px, #000 \" + (hx - soft) + \"px, transparent \" + hx + \"px)\";\n  logo.style.webkitMaskImage = mask; logo.style.maskImage = mask;\n  resid.setAttribute(\"opacity\", interp(t, [CROSS_END - 2, CROSS_END + 14], [0, 0.14]));\n  grp.setAttribute(\"opacity\", power);\n  setA(glowR, { x: hx - streakLen * 0.45, width: streakLen * 0.9 });\n  setA(coreR, { x: hx - streakLen / 2, width: streakLen });\n  setA(bloom, { cx: hx });\n  gh.forEach(function (g) { setA(g.el, { cx: cx - (hx - cx) * g.k, cy: cy + g.dy, r: g.r }); });\n}\nfinish(drive(draw, TOTAL));\n\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
