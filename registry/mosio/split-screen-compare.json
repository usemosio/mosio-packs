 "files": [
  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Split Screen Compare\n\nTwo columns, Kami against Biasanya. Rows tick in on our side with a drawn check and cross out on theirs, staggered. Each row is one line of the rows variable: our text, then theirs.\n\nCategory: commerce. Length: 6 s. WebGL: no.\n\nUse when:\n- Why a small shop is better than the usual alternative: fresher, cheaper, faster, with a guarantee.\n- Any versus list of 3 to 5 points.\n\nAvoid when:\n- A before and after of one thing: use before-after-wipe.\n- Numbers to compare: use stat-trio.\n\nVariables:\n- title (string): Title, default \"Kenapa pilih kami?\"\n- ours_label (string): Our column, default \"Kami\"\n- theirs_label (string): Their column, default \"Biasanya\"\n- rows (string): Rows, default \"Bahan segar tiap hari|Stok seminggu sekali\\nTanpa pengawet buatan|Memakai pengawet\\nDikemas saat dipesan|Dikemas sehari sebelumnya\\nGaransi uang kembali|Tanpa garansi\"\n- bg_color (color): Background, default \"#ffffff\"\n- main_color (color): Main colour, default \"#2563eb\"\n- text_color (color): Text colour, default \"#0a0a0a\"\n- muted_color (color): Muted colour, default \"#8a8a8a\"\n- tint_color (color): Their column tint, default \"#f4f4f2\"\n- font_family (string): Font, default \"Geist\"\n- transparent (boolean): Transparent, default false\n\nSource: Mosio original. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Split Screen Compare\n\n  Two columns, Kami against Biasanya. Rows tick in on our side with a drawn check and cross out on theirs, staggered. Each row is one line of the rows variable: our text, then theirs.\n\n  An original usemosio/blocks block (MIT, see LICENSE).\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"split-screen-compare\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[\n  {\n    \"id\": \"title\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Title\",\n    \"description\": \"Line above the columns. Empty hides it.\",\n    \"default\": \"Kenapa pilih kami?\"\n  },\n  {\n    \"id\": \"ours_label\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Our column\",\n    \"description\": \"Heading of our side.\",\n    \"default\": \"Kami\"\n  },\n  {\n    \"id\": \"theirs_label\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Their column\",\n    \"description\": \"Heading of the other side.\",\n    \"default\": \"Biasanya\"\n  },\n  {\n    \"id\": \"rows\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Rows\",\n    \"description\": \"One per line, up to 6: our text|their text. With no | the same text is used on both sides.\",\n    \"default\": \"Bahan segar tiap hari|Stok seminggu sekali\\nTanpa pengawet buatan|Memakai pengawet\\nDikemas saat dipesan|Dikemas sehari sebelumnya\\nGaransi uang kembali|Tanpa garansi\"\n  },\n  {\n    \"id\": \"bg_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Background\",\n    \"description\": \"Background.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"main_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Main colour\",\n    \"description\": \"Checks and the outline of our column: the one accent.\",\n    \"default\": \"#2563eb\"\n  },\n  {\n    \"id\": \"text_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Text colour\",\n    \"description\": \"Our text and the title.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"muted_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Muted colour\",\n    \"description\": \"Their text and crosses.\",\n    \"default\": \"#8a8a8a\"\n  },\n  {\n    \"id\": \"tint_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Their column tint\",\n    \"description\": \"Background of their column.\",\n    \"default\": \"#f4f4f2\"\n  },\n  {\n    \"id\": \"font_family\",\n    \"type\": \"string\",\n    \"role\": \"style\",\n    \"label\": \"Font\",\n    \"description\": \"Google Fonts family name; Geist is loaded, others only if the host loads them.\",\n    \"default\": \"Geist\"\n  },\n  {\n    \"id\": \"transparent\",\n    \"type\": \"boolean\",\n    \"role\": \"style\",\n    \"label\": \"Transparent\",\n    \"description\": \"Leave the background clear so the block sits over your own scene.\",\n    \"default\": false\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Split Screen Compare</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute; inset: 0; overflow: hidden; container-type: size; pointer-events: none;\n          -webkit-font-smoothing: antialiased;\n          background: var(--ssc-bg); color: var(--ssc-text); font-family: var(--ssc-font);\n        }\n        #root * { box-sizing: border-box; }\n        .ssc-stage { position: absolute; inset: 0; --u: calc(100cqmin / 1080); }\n\n        .ssc-title { position: absolute; left: 0; right: 0; text-align: center; font-weight: 600; letter-spacing: -0.04em; white-space: nowrap; }\n        .ssc-col { position: absolute; display: flex; flex-direction: column; border-radius: calc(var(--u) * 44); }\n        .ssc-ours { background: var(--ssc-bg); border: calc(var(--u) * 4) solid var(--ssc-main); }\n        .ssc-theirs { background: var(--ssc-tint); }\n        .ssc-head { font-weight: 600; letter-spacing: -0.03em; text-align: center; border-bottom: 1px solid rgba(10,10,10,0.1); white-space: nowrap; }\n        .ssc-ours .ssc-head { color: var(--ssc-main); } .ssc-theirs .ssc-head { color: var(--ssc-muted); }\n        .ssc-rows { flex: 1; display: flex; flex-direction: column; min-height: 0; }\n        .ssc-row { flex: 1; display: flex; align-items: center; min-height: 0; border-top: 1px solid rgba(10,10,10,0.07); }\n        .ssc-row:first-child { border-top: 0; }\n        .ssc-ic { flex: none; }\n        .ssc-ic svg { width: 100%; height: 100%; display: block; overflow: visible; }\n        .ssc-t { font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }\n        .ssc-theirs .ssc-t { color: var(--ssc-muted); font-weight: 500; text-decoration: line-through; text-decoration-color: transparent; text-decoration-thickness: calc(var(--u) * 3); }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"split-screen-compare\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"ssc-clip\" class=\"ssc-stage clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\">\n          <div class=\"ssc-title\" id=\"ssc-title\"></div>\n          <div class=\"ssc-col ssc-ours\" id=\"ssc-ours\"><div class=\"ssc-head\" id=\"ssc-oh\"></div><div class=\"ssc-rows\" id=\"ssc-or\"></div></div>\n          <div class=\"ssc-col ssc-theirs\" id=\"ssc-theirs\"><div class=\"ssc-head\" id=\"ssc-th\"></div><div class=\"ssc-rows\" id=\"ssc-tr\"></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() || {} : {};\n            function num(v, d, a, b) { var n = Number(v); return Number.isFinite(n) ? Math.min(b, Math.max(a, n)) : d; }\n            function str(v, d) { return typeof v === \"string\" && v.trim() ? v : d; }\n            function colr(v, d) { return typeof v === \"string\" && v.trim() && window.CSS && CSS.supports(\"color\", v.trim()) ? v.trim() : d; }\n            function bool(v, d) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : d; }\n            function el(tag, cls, parent, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; if (parent) parent.appendChild(e); return e; }\n            function esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\"); }\n            function lines(v, d) { var s = typeof v === \"string\" && v.trim() ? v : d; return s.split(/\\r?\\n/).map(function (l) { return l.trim(); }).filter(Boolean); }\n            function dots(n) { return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"); }\n            function ease(n, a, b) { return Math.min(1, Math.max(0, (n - a) / (b - a))); }\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920, U = Math.min(W, H) / 1080, PORTRAIT = H > W;\n            var PAL = [[\"bg\", \"bg_color\", \"#ffffff\"], [\"main\", \"main_color\", \"#2563eb\"], [\"text\", \"text_color\", \"#0a0a0a\"], [\"muted\", \"muted_color\", \"#8a8a8a\"], [\"tint\", \"tint_color\", \"#f4f4f2\"]];\n            PAL.forEach(function (c) { root.style.setProperty(\"--ssc-\" + c[0], colr(vars[c[1]], c[2])); });\n            root.style.setProperty(\"--ssc-font\", '\"' + str(vars.font_family, \"Geist\") + '\", Geist, system-ui, sans-serif');\n            if (bool(vars.transparent, false)) root.style.background = \"transparent\";\n\n\n            var rows = lines(vars.rows, \"Bahan segar tiap hari|Stok seminggu sekali\\nTanpa pengawet buatan|Memakai pengawet\\nDikemas saat dipesan|Dikemas sehari sebelumnya\\nGaransi uang kembali|Tanpa garansi\").slice(0, 6).map(function (l) { var a = l.split(\"|\"); return [a[0].trim(), (a[1] || a[0]).trim()]; });\n            var n = rows.length, tt = typeof vars.title === \"string\" ? vars.title.trim() : \"Kenapa pilih kami?\";\n            var te = document.getElementById(\"ssc-title\"); te.textContent = tt;\n            te.style.top = (PORTRAIT ? 140 : 52) * U + \"px\"; te.style.fontSize = (PORTRAIT ? 80 : 64) * U + \"px\";\n            var top = (tt ? (PORTRAIT ? 300 : 170) : (PORTRAIT ? 160 : 60)) * U, bot = (PORTRAIT ? 140 : 60) * U, gap = (PORTRAIT ? 24 : 40) * U, mx = (PORTRAIT ? 48 : 200) * U;\n            var hh = (PORTRAIT ? 120 : 100) * U, avail = H - top - bot, ch = Math.min(avail, hh + n * (PORTRAIT ? 250 : 190) * U); top += (avail - ch) / 2;\n            var cw = (W - 2 * mx - gap) / 2;\n            var oc = document.getElementById(\"ssc-ours\"), tc = document.getElementById(\"ssc-theirs\");\n            [[oc, mx], [tc, mx + cw + gap]].forEach(function (c) { c[0].style.left = c[1] + \"px\"; c[0].style.top = top + \"px\"; c[0].style.width = cw + \"px\"; c[0].style.height = ch + \"px\"; });\n            var hs = (PORTRAIT ? 52 : 46) * U, ic = (PORTRAIT ? 58 : 60) * U, ts = (PORTRAIT ? 39 : 44) * U, px = (PORTRAIT ? 24 : 36) * U;\n            var oh = document.getElementById(\"ssc-oh\"), th = document.getElementById(\"ssc-th\");\n            oh.textContent = str(vars.ours_label, \"Kami\"); th.textContent = str(vars.theirs_label, \"Biasanya\");\n            [oh, th].forEach(function (h) { h.style.fontSize = hs + \"px\"; h.style.height = hh + \"px\"; h.style.lineHeight = hh + \"px\"; });\n            var tick = '<svg viewBox=\"0 0 40 40\"><circle cx=\"20\" cy=\"20\" r=\"19\" fill=\"var(--ssc-main)\" class=\"ssc-bg\"/><path d=\"M11 21 L18 28 L30 13\" fill=\"none\" stroke=\"#fff\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" pathLength=\"1\" stroke-dasharray=\"1\" stroke-dashoffset=\"1\" class=\"ssc-d\"/></svg>';\n            var cross = '<svg viewBox=\"0 0 40 40\"><circle cx=\"20\" cy=\"20\" r=\"18\" fill=\"none\" stroke=\"var(--ssc-muted)\" stroke-width=\"2.5\" class=\"ssc-bg\"/><path d=\"M13 13 L27 27\" stroke=\"var(--ssc-muted)\" stroke-width=\"4\" stroke-linecap=\"round\" pathLength=\"1\" stroke-dasharray=\"1\" stroke-dashoffset=\"1\" class=\"ssc-d\"/><path d=\"M27 13 L13 27\" stroke=\"var(--ssc-muted)\" stroke-width=\"4\" stroke-linecap=\"round\" pathLength=\"1\" stroke-dasharray=\"1\" stroke-dashoffset=\"1\" class=\"ssc-d\"/></svg>';\n            var or = document.getElementById(\"ssc-or\"), tr = document.getElementById(\"ssc-tr\"), tl = gsap.timeline({ paused: true });\n            tl.fromTo(oc, { opacity: 0, x: -60 * U }, { opacity: 1, x: 0, duration: 0.7, ease: \"expo.out\" }, 0.1);\n            tl.fromTo(tc, { opacity: 0, x: 60 * U }, { opacity: 1, x: 0, duration: 0.7, ease: \"expo.out\" }, 0.1);\n            tl.fromTo(\"#ssc-title\", { opacity: 0, y: -20 * U }, { opacity: 1, y: 0, duration: 0.5, ease: \"power3.out\" }, 0.1);\n            rows.forEach(function (r, i) {\n              var a = el(\"div\", \"ssc-row\", or), b = el(\"div\", \"ssc-row\", tr);\n              a.style.padding = b.style.padding = \"0 \" + px + \"px\"; a.style.gap = b.style.gap = px * 0.7 + \"px\";\n              var ia = el(\"span\", \"ssc-ic\", a, tick), ta = el(\"span\", \"ssc-t\", a, esc(r[0]));\n              var ib = el(\"span\", \"ssc-ic\", b, cross), tb = el(\"span\", \"ssc-t\", b, esc(r[1]));\n              [ia, ib].forEach(function (x) { x.style.width = x.style.height = ic + \"px\"; }); ta.style.fontSize = tb.style.fontSize = ts + \"px\";\n              var t0 = 1.0 + i * 0.6;\n              tl.fromTo(ia, { scale: 0 }, { scale: 1, duration: 0.35, ease: \"back.out(1.7)\" }, t0);\n              tl.fromTo(ia.querySelector(\".ssc-d\"), { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.3, ease: \"power2.out\" }, t0 + 0.12);\n              tl.fromTo(ta, { opacity: 0, x: 18 * U }, { opacity: 1, x: 0, duration: 0.4, ease: \"power3.out\" }, t0 + 0.05);\n              tl.fromTo(ib, { scale: 0 }, { scale: 1, duration: 0.3, ease: \"back.out(1.5)\" }, t0 + 0.22);\n              ib.querySelectorAll(\".ssc-d\").forEach(function (d, k) { tl.fromTo(d, { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.2, ease: \"power2.out\" }, t0 + 0.36 + k * 0.12); });\n              tl.fromTo(tb, { opacity: 0, x: 18 * U }, { opacity: 1, x: 0, duration: 0.4, ease: \"power3.out\" }, t0 + 0.25);\n              tl.to(tb, { textDecorationColor: \"#8a8a8a\", duration: 0.3, ease: \"power1.out\" }, t0 + 0.55);\n            });\n\n            var total = parseFloat(root.dataset.duration || \"6\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"split-screen-compare\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
