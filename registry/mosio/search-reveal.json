 SVGNS = \"http://www.w3.org/2000/svg\";\nfunction svgEl(tag, attrs, parent) {\n  var e = document.createElementNS(SVGNS, tag);\n  for (var k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\nfunction setA(e, attrs) { for (var k in attrs) e.setAttribute(k, attrs[k]); }\n// Drive draw(frame) from the timeline; frames run 0..frames over frames/30 seconds.\nfunction drive(draw, frames) {\n  var tl = gsap.timeline({ paused: true });\n  var clock = { frame: 0 };\n  tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n  draw(0);\n  return tl;\n}\nfunction finish(tl) {\n  if (tl.duration() < DUR) tl.to({}, { duration: DUR - tl.duration() });\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[NAME] = tl;\n}\n\n\nvar scene = document.getElementById(\"sr-scene\");\nvar text = typeof vars.text === \"string\" && vars.text.length ? vars.text : \"studio\";\nvar fieldW = num(vars.field_width, 464, 320, 640), fontSizeV = num(vars.font_size, 34, 18, 54), fpc = num(vars.frames_per_character, 4, 1, 12), speed = num(vars.speed, 1, 0, 4);\nvar showPanel = bool(vars.show_panel, true), showGuides = bool(vars.show_guides, true);\nvar color = col(vars.color, \"#26232b\"), fieldC = col(vars.field_color, \"#ffffff\"), ringC = col(vars.ring_color, \"#cbc5cf\"), panelC = col(vars.panel_color, \"#a800b7\"), accentC = col(vars.accent_color, \"#e8f99a\"), bg = col(vars.background_color, \"#f5f1f5\");\nroot.style.setProperty(\"--bg\", bg);\nvar W = root.clientWidth, H = root.clientHeight;\nvar scale = Math.min(W / 1280, H / 720);\nscene.style.transform = \"scale(\" + scale + \")\";\nvar letters = typeof Intl !== \"undefined\" && Intl.Segmenter ? Array.from(new Intl.Segmenter(\"en\", { granularity: \"grapheme\" }).segment(text), function (x) { return x.segment; }) : Array.from(text);\nvar END = Math.max(90, 54 + letters.length * fpc + 10);\nvar total = Math.ceil((END + 18) / Math.max(0.01, speed));\nvar curve = bez(0.22, 1, 0.36, 1);\nfunction tween(f, a, b, from, to) { return interp(f, [a, b], [from === undefined ? 0 : from, to === undefined ? 1 : to], curve); }\nfunction cross(parent, x, y, s) { return svgEl(\"path\", { d: \"M \" + (x - s) + \" \" + y + \" H \" + (x + s) + \" M \" + x + \" \" + (y - s) + \" V \" + (y + s) }, parent); }\n// Construction circles.\nvar circSvg = svgEl(\"svg\", { class: \"sr-svg\", width: 1280, height: 720, viewBox: \"-640 -360 1280 720\", style: \"left:0;top:0\" }, scene);\nvar circG = svgEl(\"g\", { fill: \"none\", stroke: ringC, \"stroke-width\": 1 }, circSvg);\nvar circles = [-1, 1].map(function (side) {\n  var g = svgEl(\"g\", {}, circG);\n  var c = svgEl(\"circle\", { cy: 0 }, g);\n  var crs = showGuides ? [-1, 1].map(function (edge) { return { edge: edge, el: cross(g, 0, 0, 6) }; }) : [];\n  return { side: side, c: c, crs: crs };\n});\n// Field group: tilted anchor with panel, guides and the search pill.\nvar anchor = document.createElement(\"div\"); anchor.className = \"sr-anchor\"; scene.appendChild(anchor);\nvar panel = document.createElement(\"div\"); panel.className = \"sr-panel\"; panel.style.background = panelC; if (showPanel) anchor.appendChild(panel);\nvar psvg = svgEl(\"svg\", { width: 844, height: 374, viewBox: \"0 0 844 374\", style: \"position:absolute;left:50%;top:50%\" }, panel);\nvar g1 = svgEl(\"g\", { fill: \"none\", stroke: fieldC }, psvg);\nfor (var i = 0; i < 30; i++) svgEl(\"ellipse\", { rx: 82 + i * 3, ry: 118, transform: \"rotate(\" + i * 6 + \")\", \"stroke-width\": 1.4, opacity: 0.35 + i / 70 }, g1);\nvar g2 = svgEl(\"g\", { fill: accentC }, psvg);\nfor (i = 0; i < 10; i++) svgEl(\"ellipse\", { cy: -41, rx: 19, ry: 48, transform: \"rotate(\" + i * 36 + \")\" }, g2);\nvar g3 = svgEl(\"g\", { fill: \"none\", stroke: accentC, \"stroke-width\": 22 }, psvg);\nsvgEl(\"path\", { d: \"M -68 -115 V 80 M -122 -60 L -14 26 M -125 18 L -12 -61\" }, g3);\nsvgEl(\"circle\", { cx: 103, cy: -35, r: 54 }, g3);\nvar gsvg = svgEl(\"svg\", { class: \"sr-svg\", width: 1280, height: 720, viewBox: \"-640 -360 1280 720\", style: \"left:-640px;top:-360px\" }, anchor);\nif (!showGuides) gsvg.style.display = \"none\";\nvar gr = svgEl(\"g\", { fill: \"none\", stroke: ringC, \"stroke-width\": 1 }, gsvg), guidePath = svgEl(\"path\", {}, gr);\nvar gk = svgEl(\"g\", { fill: \"none\", stroke: color, \"stroke-width\": 1.5 }, gsvg);\nvar gc1 = svgEl(\"path\", {}, gk), gc2 = svgEl(\"path\", {}, gk);\nvar field = document.createElement(\"div\"); field.className = \"sr-field\"; field.style.background = fieldC; field.style.color = color;\nvar typed = document.createElement(\"div\"); typed.className = \"sr-typed\";\nvar typedText = document.createElement(\"span\"), caret = document.createElement(\"span\"); caret.className = \"sr-caret\"; caret.style.background = color;\ntyped.appendChild(typedText); typed.appendChild(caret); field.appendChild(typed);\nvar icon = svgEl(\"svg\", { class: \"sr-icon\", width: 28, height: 28, viewBox: \"0 0 28 28\", fill: \"none\", stroke: ringC, \"stroke-width\": 1.5, \"stroke-linecap\": \"round\" }, field);\nsvgEl(\"circle\", { cx: 11.5, cy: 11.5, r: 7.5 }, icon); svgEl(\"path\", { d: \"m17 17 7 7\" }, icon);\nanchor.appendChild(field);\nfunction crossD(x, y, s) { return \"M \" + (x - s) + \" \" + y + \" H \" + (x + s) + \" M \" + x + \" \" + (y - s) + \" V \" + (y + s); }\nfunction draw(frame) {\n  var t = frame * speed;\n  var typedCount = cl(Math.floor((t - 54) / fpc), 0, letters.length);\n  var reveal = showPanel ? tween(t, 56, 90) : 0;\n  var fw = tween(t, 26, 48, 130, fieldW), fh = tween(t, 26, 46, 24, 80);\n  var panelW = fw + (Math.max(774, fieldW + 170) - fw) * reveal, panelH = fh + (374 - fh) * reveal;\n  var circR = tween(t, 0, 26, 250, 410), circO = tween(t, 0, 26, 62, 185);\n  var iconO = tween(t, 34, 46), tilt = tween(t, 26, 47, -4, 0);\n  var fitted = Math.min(fontSizeV, (fw - 120) / Math.max(1, letters.