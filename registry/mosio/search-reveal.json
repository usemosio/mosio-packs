\"min\": 320, \"max\": 640, \"step\": 2, \"unit\": \"px\"},\n    {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Maximum typed text size.\", \"default\": 34, \"min\": 18, \"max\": 54, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"frames_per_character\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Frames per character\", \"description\": \"Typing pace.\", \"default\": 4, \"min\": 1, \"max\": 12, \"step\": 1},\n    {\"id\": \"show_panel\", \"type\": \"boolean\", \"role\": \"style\", \"label\": \"Graphic panel\", \"description\": \"Reveal the abstract graphic panel behind the field.\", \"default\": true},\n    {\"id\": \"show_guides\", \"type\": \"boolean\", \"role\": \"style\", \"label\": \"Guides\", \"description\": \"Show construction guides and crosses.\", \"default\": true},\n    {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Text\", \"description\": \"Typed text and guide cross color.\", \"default\": \"#26232b\"},\n    {\"id\": \"field_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Field\", \"description\": \"Search field color.\", \"default\": \"#ffffff\"},\n    {\"id\": \"ring_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Rings\", \"description\": \"Construction circle and icon color.\", \"default\": \"#cbc5cf\"},\n    {\"id\": \"panel_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Panel\", \"description\": \"Graphic panel color.\", \"default\": \"#a800b7\"},\n    {\"id\": \"accent_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Accent\", \"description\": \"Panel accent shapes color.\", \"default\": \"#e8f99a\"},\n    {\"id\": \"background_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Background\", \"description\": \"Background color.\", \"default\": \"#f5f1f5\"},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier.\", \"default\": 1, \"min\": 0.25, \"max\": 3, \"step\": 0.05}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Search Reveal</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: var(--bg); }\n        .sr-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }\n        .sr-scene { position: relative; width: 1280px; height: 720px; flex-shrink: 0; }\n        .sr-anchor { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }\n        .sr-svg { position: absolute; overflow: visible; }\n        .sr-panel { position: absolute; overflow: hidden; }\n        .sr-field { position: absolute; border-radius: 999px; display: flex; align-items: center; justify-content: center; overflow: hidden; font-family: Arial, Helvetica, sans-serif; font-weight: 400; box-shadow: 0 3px 12px #26232b08, inset 0 0 0 1px #26232b0a; }\n        .sr-typed { display: flex; align-items: center; justify-content: center; overflow: hidden; white-space: pre; }\n        .sr-caret { width: 1.5px; margin-left: 2px; flex-shrink: 0; }\n        .sr-icon { position: absolute; right: 24px; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"search-reveal\" data-duration=\"3.6\" data-fps=\"30\">\n        <div id=\"sr-clip\" class=\"sr-stage clip\" data-start=\"0\" data-duration=\"3.6\" data-track-index=\"0\">\n          <div class=\"sr-scene\" id=\"sr-scene\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"search-reveal\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\nfunction col(v, f) { return typeof v === \"string\" && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v.trim()) ? v.trim() : f; }\nfunction bool(v, f) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : f; }\nvar FPS = 30;\nvar DUR = parseFloat(root.dataset.duration || \"2\");\nvar TOTAL = Math.round(DUR * FPS);\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction cl(x, a, b) { return Math.min(b, Math.max(a, x)); }\n// interpolate(x, [in...], [out...], easing): clamped on both sides, easing applied per segment.\nfunction interp(x, inp, out, easing) {\n  if (x <= inp[0]) return out[0];\n  if (x >= inp[inp.length - 1]) return out[out.length - 1];\n  var i = 0;\n  while (x > inp[i + 1]) i++;\n  var t = (x - inp[i]) / (inp[i + 1] - inp[i]);\n  if (easing) t = easing(t);\n  return out[i] + (out[i + 1] - out[i]) * t;\n}\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0; if (x >= 1) return 1;\n    var t = x;\n    for (var i = 0; i < 8; i++) {\n      var cx = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t - x;\n      var d = 3 * x1 * (1 - t) * (1 - t) - 6 * x1 * t * (1 - t) + 6 * x2 * t * (1 - t) - 3 * x2 * t * t + 3 * t * t;\n      if (Math.abs(cx) < 1e-6 || Math.abs(d) < 1e-6) break;\n      t -= cx / d;\n    }\n    t = cl(t, 0, 1);\n    return 3 * y1 * t * (1 - t) * (1 - t) + 3 * y2 * t * t * (1 - t) + t * t * t;\n  };\n}\nvar E = {\n  lin: function (t) { return t; },\n  quad: function (t) { return t * t; },\n  cubic: function (t) { return t * t * t; },\n  sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); }\n};\nfunction eOut(f) { return function (t) { return 1 - f(1 - t); }; }\nfunction eInOut(f) { return function (t) { return t <