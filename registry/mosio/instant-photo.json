   "content": "<!doctype html>\n<!--\n  Instant Photo\n\n  An instant-photo frame with a handwritten caption. The photo is a built-in live placeholder (a drifting sunrise gradient); layer your own video or image over the photo window to use it.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/polaroid/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"instant-photo\"\n  data-composition-duration=\"5\"\n  data-composition-variables='[{\"id\":\"caption\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Caption\",\"description\":\"Handwritten caption under the photo.\",\"default\":\"first light\"},{\"id\":\"caption_at\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Caption starts\",\"description\":\"Frame (30 fps) where the handwriting begins.\",\"default\":0,\"min\":0,\"max\":60,\"step\":1,\"unit\":\"frames\"},{\"id\":\"width\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Card width\",\"description\":\"Card width in pixels on a 1280x720 frame (scaled to the actual frame).\",\"default\":652,\"min\":320,\"max\":900,\"step\":4,\"unit\":\"px\"},{\"id\":\"caption_size\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Caption size\",\"description\":\"Caption size in pixels at 652 px card width.\",\"default\":36,\"min\":20,\"max\":56,\"step\":1,\"unit\":\"px\"},{\"id\":\"frame_color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Frame\",\"description\":\"Paper colour of the card.\",\"default\":\"#fdfcf8\"},{\"id\":\"caption_color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Ink\",\"description\":\"Caption colour.\",\"default\":\"#26242c\"},{\"id\":\"step\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Frames per pose\",\"description\":\"How many frames each handwriting pose is held (30 fps).\",\"default\":3,\"min\":1,\"max\":6,\"step\":1,\"unit\":\"frames\"}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Instant Photo</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&amp;family=Geist+Mono:wght@400;500&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { font-family: Caveat, cursive; }\n        .pl-stage { position: absolute; inset: 0; }\n        #pl-scene { display: flex; align-items: center; justify-content: center; }\n        #pl-card { box-sizing: border-box; border-radius: 4px; box-shadow: 0 8px 20px rgba(38,36,44,0.18), 0 2px 5px rgba(38,36,44,0.12); flex: none; }\n        #pl-media { position: relative; margin: 0 auto; background: #100f14; overflow: hidden; }\n        #pl-sun { position: absolute; top: 0; bottom: 0; left: -10%; right: -10%; background: linear-gradient(115deg, #2b3a67 0%, #6f7f35 45%, #b8642a 100%); }\n        #pl-cap { position: relative; display: flex; align-items: center; justify-content: center; }\n        .pl-text { display: inline-block; line-height: 1.15; font-weight: 600; white-space: pre-wrap; }\n        .pl-ch { display: inline-block; white-space: pre; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"instant-photo\" data-duration=\"5\" data-fps=\"30\">\n        <div id=\"pl-clip\" class=\"pl-stage clip\" data-start=\"0\" data-duration=\"5\" data-track-index=\"0\">\n<div id=\"pl-scene\"><div id=\"pl-card\"><div id=\"pl-media\" class=\"pl-media\"><div id=\"pl-sun\"></div></div><div id=\"pl-cap\"><span id=\"pl-text\" class=\"pl-text\"></span></div></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n                        // Stop-motion helpers: poses are held for `step` frames.\n            var DEFAULT_STEP = 3;\n            function qf(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step) * step; }\n            function qstep(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step); }\n            function hash01(seed) { return random(seed); }\n            function hashRange(seed, lo, hi) { return lo + hash01(seed) * (hi - lo); }\n            function paperJitter(frame, seed, o) {\n              o = o || {};\n              var amp = o.amp != null ? o.amp : 1.4, rotAmp = o.rotAmp != null ? o.rotAmp : 0.35;\n              var s = qstep(frame, o.step);\n              return { x: hashRange(seed + \":x:\" + s, -amp, amp), y: hashRange(seed + \":y:\" + s, -amp, amp), rot: hashRange(seed + \":r:\" + s, -rotAmp, rotAmp) };\n            }\n            function steppedRamp(frame, from, to, o) {\n              o = o || {};\n              var f = qf(frame, o.step);\n              if (f <= from) return 0;\n              if (f >= to) return 1;\n              var ease = o.ease || function (t) { return t; };\n              return ease((f - from) / (to - from));\n            }\n\n\n            // Scale a 1280x720 design to the frame (bigger on a tall frame).\n            function scaledStage(el, boost) {\n              var W = root.clientWidth, H = root.clientHeight;\n              var s = Math.min(W / 1280, H / 720) * (H > W ? (boost || 1.4) : 1);\n              el.style.position = \"absolute\"; el.style.left = \"0\"; el.style.top = \"0\";\n              el.style.width = W / s + \"px\"; el.style.height = H / s + \"px\";\n              el.style.transformOrigin = \"0 0\"; el.style.transform = \"scale(\" + s + \")\";\n              return s;\n            }\n\n            var scene = document.getElementById(\"pl-scene\");\n            scaledStage(scene);\n            var caption = typeof vars.caption === \"string\" ? vars.caption : \"first light\";\n            var captionAt = Math.round(num(vars.caption_at, 0, 0, 60));\n            var width = num(vars.width, 652, 320, 900), step = Math.round(num(vars.step, 3, 1, 6));\n            var k = width / 652;\n            var pad = 16 * k, mw = 620 * k, mh = 349 * k, ch = 62 * k;\n            var card = document.getElementById(\"pl-card\"), media = document.getElementById(\"pl-media\"), cap = document.getElementById(\"pl-cap\");\n            card.style.width = width + \"px\"; card.style.height = pad + mh + ch + \"px\";\n            card.style.background = str(vars.frame_color, \"#fdfcf8\"); card.style.paddingTop = pad + \"px\";\n            media.style.width = mw + \"px\"; media.style.height = mh + \"px\";\n            cap.style.height = ch + \"px\";\n            var text = document.getElementById(\"pl-text\");\n            text.style.fontSize = num(vars.caption_size, 36, 20, 56) * k + \"px\";\n            text.style.color = str(vars.caption_color, \"#26242c\");\n            var chars = Array.from(caption).map(function (c, i) {\n              var s = document.createElement(\"span\");\n              s.className = \"pl-ch\"; s.textContent = c; s.style.opacity = \"0\";\n              text.appendChild(s);\n              return { el: s, rot: hashRange(\"hw:\" + caption + \":\" + i + \":r\", -3.2, 3.2), dy: hashRange(\"hw:\" + caption + \":\" + i + \":y\", -1.8, 1.8) };\n            });\n            var sun = document.getElementById(\"pl-sun\");\n            var perStep = 1.4;\n            function draw(frame) {\n              // The photo keeps playing on the real clock: drift left 0 to 40 px and zoom 1 to 1.08 over 120 frames.\n              var f = Math.min(frame, 120) / 120;\n              sun.style.transform = \"translateX(\" + (-40 * f * k) + \"px) scale(\" + (1 + 0.08 * f) + \")\";\n              // Handwriting in held poses.\n              var steps = Math.max(0, qstep(Math.max(0, qf(frame, step) - captionAt), step));\n              var shown = Math.floor(steps * perStep), fresh = shown - Math.ceil(perStep);\n              chars.forEach(function (c, i) {\n                var vis = i < shown;\n                c.el.style.opacity = vis ? \"1\" : \"0\";\n                c.el.style.transform = vis ? \"translate(0,\" + c.dy + \"px) rotate(\" + c.rot + \"deg) scale(\" + (i >= fresh ? 1.06 : 1) + \")\" : \"none\";\n              });\n            }\n            var tl = gsap.timeline({ paused: true });\n            clockTween(tl, 150, draw);\n\n            var total = parseFloat(root.dataset.duration || \"5\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"instant-photo\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
