   "content": "<!doctype html>\n<!--\n  Live Code Compilation\n\n  Split screen: code is typed on the left and the button on the right snaps to match on the exact frame each property finishes. On a tall frame the split stacks (code on top, preview below).\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/live-code-compilation/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"live-code-compilation\"\n  data-composition-duration=\"8.667\"\n  data-composition-variables='[{\"id\":\"accent_color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Accent\",\"description\":\"Colour of the caret and the property names.\",\"default\":\"#3b82f6\"},{\"id\":\"speed\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Speed\",\"description\":\"Playback speed multiplier.\",\"default\":1,\"min\":0.25,\"max\":4,\"step\":0.05,\"unit\":\"x\"}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Live Code Compilation</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;600&amp;family=Geist+Mono:wght@400;500&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: #070708; font-family: Geist, system-ui, sans-serif; color: #e4e4e7; }\n        .lc-stage { position: absolute; inset: 0; }\n        #lc-world { overflow: hidden; display: flex; }\n        #lc-glow { position: absolute; inset: 0; background: radial-gradient(ellipse at 20% 30%, rgba(59,130,246,0.08), transparent 60%), radial-gradient(ellipse at 80% 70%, rgba(168,85,247,0.06), transparent 60%); }\n        .lc-pane { flex: 1; display: flex; align-items: center; justify-content: center; position: relative; min-width: 0; min-height: 0; }\n        #lc-left { padding: 48px; box-sizing: border-box; }\n        #lc-ring { width: 100%; max-width: 560px; position: relative; border-radius: 14px; padding: 1px; box-sizing: border-box; background: linear-gradient(180deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.02) 50%, rgba(255,255,255,0.06) 100%); box-shadow: 0 30px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,0,0,0.4); }\n        #lc-win { border-radius: 13px; background: rgba(12,12,14,0.85); backdrop-filter: blur(20px); overflow: hidden; }\n        #lc-bar { height: 38px; display: flex; align-items: center; padding: 0 16px; border-bottom: 1px solid rgba(255,255,255,0.06); gap: 8px; box-sizing: border-box; }\n        .lc-d { width: 11px; height: 11px; border-radius: 6px; opacity: 0.6; }\n        #lc-file { margin-left: 12px; font-size: 12px; color: rgba(255,255,255,0.45); font-family: \"Geist Mono\", ui-monospace, monospace; }\n        #lc-code { padding: 20px 22px; font-family: \"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; line-height: 1.65; min-height: 360px; box-sizing: border-box; box-shadow: inset 0 1px 0 rgba(255,255,255,0.04); }\n        .lc-row { display: flex; white-space: pre; }\n        .lc-n { width: 28px; color: rgba(255,255,255,0.2); flex: none; }\n        .lc-caret { display: inline-block; width: 8px; height: 16px; margin-left: 1px; vertical-align: text-bottom; }\n        #lc-right { background: repeating-conic-gradient(rgba(255,255,255,0.018) 0deg 90deg, transparent 90deg 180deg) 0 0 / 28px 28px; }\n        #lc-label { position: absolute; top: 24px; left: 24px; display: flex; align-items: center; gap: 8px; }\n        #lc-led { width: 8px; height: 8px; border-radius: 4px; background: #22c55e; box-shadow: 0 0 8px #22c55e; }\n        #lc-lt { font-size: 11px; font-family: \"Geist Mono\", ui-monospace, monospace; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.08em; }\n        #lc-btn { font-size: 18px; font-family: Geist, system-ui, sans-serif; cursor: pointer; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"live-code-compilation\" data-duration=\"8.667\" data-fps=\"30\">\n        <div id=\"lc-clip\" class=\"lc-stage clip\" data-start=\"0\" data-duration=\"8.667\" data-track-index=\"0\">\n<div id=\"lc-world\"><div id=\"lc-glow\"></div><div id=\"lc-left\" class=\"lc-pane\"><div id=\"lc-ring\"><div id=\"lc-win\"><div id=\"lc-bar\"><span class=\"lc-d\" style=\"background:#ff5f57\"></span><span class=\"lc-d\" style=\"background:#febc2e\"></span><span class=\"lc-d\" style=\"background:#28c840\"></span><span id=\"lc-file\">Button.tsx</span></div><div id=\"lc-code\"></div></div></div></div><div id=\"lc-right\" class=\"lc-pane\"><div id=\"lc-label\"><span id=\"lc-led\"></span><span id=\"lc-lt\">Preview · HMR</span></div><button id=\"lc-btn\" type=\"button\"></button></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n                        // Stop-motion helpers: poses are held for `step` frames.\n            var DEFAULT_STEP = 3;\n            function qf(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step) * step; }\n            function qstep(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step); }\n            function hash01(seed) { return random(seed); }\n            function hashRange(seed, lo, hi) { return lo + hash01(seed) * (hi - lo); }\n            function paperJitter(frame, seed, o) {\n              o = o || {};\n              var amp = o.amp != null ? o.amp : 1.4, rotAmp = o.rotAmp != null ? o.rotAmp : 0.35;\n              var s = qstep(frame, o.step);\n              return { x: hashRange(seed + \":x:\" + s, -amp, amp), y: hashRange(seed + \":y:\" + s, -amp, amp), rot: hashRange(seed + \":r:\" + s, -rotAmp, rotAmp) };\n            }\n            function steppedRamp(frame, from, to, o) {\n              o = o || {};\n              var f = qf(frame, o.step);\n              if (f <= from) return 0;\n              if (f >= to) return 1;\n              var ease = o.ease || function (t) { return t; };\n              return ease((f - from) / (to - from));\n            }\n\n\n            function scaledStage(el, boost) {\n              var W = root.clientWidth, H = root.clientHeight;\n              var s = Math.min(W / 1280, H / 720) * (H > W ? (boost || 1.4) : 1);\n              el.style.position = \"absolute\"; el.style.left = \"0\"; el.style.top = \"0\";\n              el.style.width = W / s + \"px\"; el.style.height = H / s + \"px\";\n              el.style.transformOrigin = \"0 0\"; el.style.transform = \"scale(\" + s + \")\";\n              return s;\n            }\n\n            var world = document.getElementById(\"lc-world\");\n            var sc = scaledStage(world, 1.5);\n            var tall = root.clientHeight > root.clientWidth;\n            world.style.flexDirection = tall ? \"column\" : \"row\";\n            if (tall) document.getElementById(\"lc-right\").style.borderTop = \"1px solid rgba(255,255,255,0.05)\"; else document.getElementById(\"lc-right\").style.borderLeft = \"1px solid rgba(255,255,255,0.05)\";\n            var accent = str(vars.accent_color, \"#3b82f6\"), speed = num(vars.speed, 1, 0.25, 4);\n            var codeEl = document.getElementById(\"lc-code\"), btn = document.getElementById(\"lc-btn\");\n            var EVENTS = [\n              { code: \"export function Button() {\\n  return (\\n    <button\", ui: {} },\n              { code: \"\\n      style={{\", ui: {} },\n              { code: '\\n        background: \"#3b82f6\",', ui: { background: \"#3b82f6\" } },\n              { code: '\\n        color: \"white\",', ui: { color: \"white\" } },\n              { code: '\\n        padding: \"12px 28px\",', ui: { padding: \"12px 28px\" } },\n              { code: '\\n        borderRadius: \"999px\",', ui: { borderRadius: \"999px\" } },\n              { code: \"\\n        fontWeight: 600,\", ui: { fontWeight: 600 } },\n              { code: \"\\n      }}\\n    >\\n      Ship it\\n    </button>\\n  );\\n}\", ui: { label: \"Ship it\" } }\n            ];\n            var CPF = 1.6, DWELL = 5, cursor = 8;\n            var TL = EVENTS.map(function (ev) { var st = cursor, en = st + Math.ceil(ev.code.length / CPF); cursor = en + DWELL; return { code: ev.code, ui: ev.ui, start: st, end: en }; });\n            var TL_END = TL[TL.length - 1].end;\n            function esc(t) { return t.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\n            // Very small tokenizer: keywords, strings, property names, punctuation, numbers.\n            function highlight(line) {\n              var out = \"\", last = 0, re = /(\\bexport\\b|\\bfunction\\b|\\breturn\\b)|(\"[^\"]*\")|(\\b[a-zA-Z_][a-zA-Z0-9_]*)(?=:)|(\\{|\\}|\\(|\\)|<|>|\\/)|([0-9]+)/g, m;\n              function span(c, t) { return '<span style=\"color:' + c + '\">' + esc(t) + \"</span>\"; }\n              while ((m = re.exec(line)) !== null) {\n                if (m.index > last) out += span(\"#e4e4e7\", line.slice(last, m.index));\n                if (m[1]) out += span(\"#c084fc\", m[1]); else if (m[2]) out += span(\"#86efac\", m[2]); else if (m[3]) out += span(accent, m[3]);\n                else if (m[4]) out += span(\"#71717a\", m[4]); else if (m[5]) out += span(\"#fbbf24\", m[5]);\n                last = re.lastIndex;\n              }\n              if (last < line.length) out += span(\"#e4e4e7\", line.slice(last));\n              return out;\n            }\n            function draw(f0) {\n              var frame = f0 * speed, visible = \"\", ui = {};\n              for (var i = 0; i < TL.length; i++) {\n                var t = TL[i];\n                if (frame < t.start) break;\n                var typed = Math.min(t.code.length, Math.floor((frame - t.start) * CPF));\n                visible += t.code.slice(0, typed);\n                if (frame >= t.end) for (var k in t.ui) ui[k] = t.ui[k];\n              }\n              var lines = visible.split(\"\\n\"), caret = frame < TL_END && Math.floor(frame / 12) % 2 === 0, html = \"\";\n              lines.forEach(function (line, i) {\n                var toks = highlight(line) || \"<span> </span>\";\n                if (i === lines.length - 1 && caret) toks += '<span class=\"lc-caret\" style=\"background:' + accent + '\"></span>';\n                html += '<div class=\"lc-row\"><span class=\"lc-n\">' + (i + 1) + \"</span><span>\" + toks + \"</span></div>\";\n              });\n              codeEl.innerHTML = html;\n              btn.textContent = ui.label || \"Button\";\n              btn.style.background = ui.background || \"rgba(255,255,255,0.06)\";\n              btn.style.color = ui.color || \"rgba(255,255,255,0.4)\";\n              btn.style.padding = ui.padding || \"10px 20px\";\n              btn.style.borderRadius = ui.borderRadius || \"4px\";\n              btn.style.fontWeight = ui.fontWeight || 400;\n              btn.style.border = ui.background ? \"none\" : \"1px dashed rgba(255,255,255,0.15)\";\n              btn.style.boxShadow = ui.background ? \"0 10px 30px \" + ui.background + \"55, 0 0 0 1px rgba(255,255,255,0.08)\" : \"none\";\n            }\n            var tl = gsap.timeline({ paused: true });\n            clockTween(tl, 260, draw);\n\n            var total = parseFloat(root.dataset.duration || \"8.667\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"live-code-compilation\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
