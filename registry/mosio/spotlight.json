   "content": "<!doctype html>\n<!--\n  Spotlight\n\n  A soft stage spotlight searches the dark, overshoots, lands on the logo, and the house lights come up. The placeholder lockup is a stand-in: a host swaps in its own logo by editing the .sp-logo element.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/spotlight/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"spotlight\"\n  data-composition-duration=\"2.667\"\n  data-composition-variables='[\n    {\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Wordmark\", \"description\": \"Placeholder lockup text the beam lands on.\", \"default\": \"studio\"},\n    {\"id\": \"beam_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Beam\", \"description\": \"Color of the light cone and floor pool, and of the placeholder lockup.\", \"default\": \"#FFFFFF\"},\n    {\"id\": \"stage_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Stage\", \"description\": \"Dark stage behind everything.\", \"default\": \"#111111\"},\n    {\"id\": \"dim\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Dim\", \"description\": \"Brightness of the unlit lockup, 0 to 1.\", \"default\": 0.16, \"min\": 0, \"max\": 0.6, \"step\": 0.01},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier.\", \"default\": 1, \"min\": 0.25, \"max\": 3, \"step\": 0.05}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Spotlight</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        .sp-lockup { display: flex; align-items: center; gap: 28px; }\n        .sp-mark { width: 120px; height: 120px; border-radius: 32px; display: flex; align-items: center; justify-content: center; background: var(--mark); }\n        .sp-dot { width: 36px; height: 36px; border-radius: 50%; background: var(--dot); }\n        .sp-word { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Helvetica, Arial, sans-serif; font-size: 104px; font-weight: 800; letter-spacing: -0.04em; color: var(--text); white-space: nowrap; }\n        #root { background: var(--stage); }\n        .sp-stage { position: absolute; inset: 0; }\n        .sp-house { position: absolute; inset: 0; opacity: 0; }\n        .sp-svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n        .sp-logo { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"spotlight\" data-duration=\"2.667\" data-fps=\"30\">\n        <div id=\"sp-clip\" class=\"sp-stage clip\" data-start=\"0\" data-duration=\"2.667\" data-track-index=\"0\">\n          <div class=\"sp-house\" id=\"sp-house\"></div>\n          <svg class=\"sp-svg\" id=\"sp-svg\"></svg>\n          <div class=\"sp-logo\" id=\"sp-logo\"><div class=\"sp-lockup\" id=\"sp-lockup\"><div class=\"sp-mark\"><div class=\"sp-dot\"></div></div><span class=\"sp-word\" id=\"sp-word\">studio</span></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"spotlight\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\nfunction col(v, f) { return typeof v === \"string\" && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v.trim()) ? v.trim() : f; }\nfunction bool(v, f) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : f; }\nvar FPS = 30;\nvar DUR = parseFloat(root.dataset.duration || \"2\");\nvar TOTAL = Math.round(DUR * FPS);\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction cl(x, a, b) { return Math.min(b, Math.max(a, x)); }\n// interpolate(x, [in...], [out...], easing): clamped on both sides, easing applied per segment.\nfunction interp(x, inp, out, easing) {\n  if (x <= inp[0]) return out[0];\n  if (x >= inp[inp.length - 1]) return out[out.length - 1];\n  var i = 0;\n  while (x > inp[i + 1]) i++;\n  var t = (x - inp[i]) / (inp[i + 1] - inp[i]);\n  if (easing) t = easing(t);\n  return out[i] + (out[i + 1] - out[i]) * t;\n}\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0; if (x >= 1) return 1;\n    var t = x;\n    for (var i = 0; i < 8; i++) {\n      var cx = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t - x;\n      var d = 3 * x1 * (1 - t) * (1 - t) - 6 * x1 * t * (1 - t) + 6 * x2 * t * (1 - t) - 3 * x2 * t * t + 3 * t * t;\n      if (Math.abs(cx) < 1e-6 || Math.abs(d) < 1e-6) break;\n      t -= cx / d;\n    }\n    t = cl(t, 0, 1);\n    return 3 * y1 * t * (1 - t) * (1 - t) + 3 * y2 * t * t * (1 - t) + t * t * t;\n  };\n}\nvar E = {\n  lin: function (t) { return t; },\n  quad: function (t) { return t * t; },\n  cubic: function (t) { return t * t * t; },\n  sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); }\n};\nfunction eOut(f) { return function (t) { return 1 - f(1 - t); }; }\nfunction eInOut(f) { return function (t) { return t < 0.5 ? f(2 * t) / 2 : 1 - f(2 - 2 * t) / 2; }; }\nvar outCubic = eOut(E.cubic), outQuad = eOut(E.quad), inCubic = E.cubic, inQuad = E.quad;\nvar inOutCubic = eInOut(E.cubic), inOutQuad = eInOut(E.quad), inOutSin = eInOut(E.sin), outSin = eOut(E.sin);\n// Damped spring from 0 to 1 (rest at 1, no initial velocity), frames at 30 fps.\nfunction spring(frame, cfg) {\n  if (frame <= 0) return 0;\n  var m = cfg.mass || 1, k = cfg.stiffness, c = cfg.damping;\n  var w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m)), t = frame / FPS;\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n  }\n  if (z === 1) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  var s = w0 * Math.sqrt(z * z - 1), r1 = -z * w0 + s, r2 = -z * w0 - s;\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\n// Seeded random: same string in, same number out.\nfunction rnd(seed) {\n  var sd = String(seed), h = 1779033703 ^ sd.length;\n  for (var i = 0; i < sd.length; i++) { h = Math.imul(h ^ sd.charCodeAt(i), 3432918353); h = (h << 13) | (h >>> 19); }\n  h = Math.imul(h ^ (h >>> 16), 2246822507); h = Math.imul(h ^ (h >>> 13), 3266489909); h ^= h >>> 16;\n  var a = (h >>> 0);\n  a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a);\n  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n}\nfunction rgb(h) {\n  h = h.replace(\"#\", \"\");\n  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];\n  return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];\n}\nfunction mixc(a, b, t) {\n  var x = rgb(a), y = rgb(b);\n  return \"rgb(\" + Math.round(lerp(x[0], y[0], t)) + \",\" + Math.round(lerp(x[1], y[1], t)) + \",\" + Math.round(lerp(x[2], y[2], t)) + \")\";\n}\nfunction rgba(h, a) { var x = rgb(h); return \"rgba(\" + x[0] + \",\" + x[1] + \",\" + x[2] + \",\" + a + \")\"; }\nvar SVGNS = \"http://www.w3.org/2000/svg\";\nfunction svgEl(tag, attrs, parent) {\n  var e = document.createElementNS(SVGNS, tag);\n  for (var k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\nfunction setA(e, attrs) { for (var k in attrs) e.setAttribute(k, attrs[k]); }\n// Drive draw(frame) from the timeline; frames run 0..frames over frames/30 seconds.\nfunction drive(draw, frames) {\n  var tl = gsap.timeline({ paused: true });\n  var clock = { frame: 0 };\n  tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n  draw(0);\n  return tl;\n}\nfunction finish(tl) {\n  if (tl.duration() < DUR) tl.to({}, { duration: DUR - tl.duration() });\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[NAME] = tl;\n}\n\n\nvar house = document.getElementById(\"sp-house\"), svg = document.getElementById(\"sp-svg\"), logo = document.getElementById(\"sp-logo\");\nvar beamC = col(vars.beam_color, \"#FFFFFF\"), stageC = col(vars.stage_color, \"#111111\");\nvar dim = num(vars.dim, 0.16, 0, 0.6), speed = num(vars.speed, 1, 0, 4);\nroot.style.setProperty(\"--stage\", stageC); root.style.setProperty(\"--mark\", beamC); root.style.setProperty(\"--dot\", stageC); root.style.setProperty(\"--text\", beamC);\ndocument.getElementById(\"sp-word\").textContent = str(vars.text, \"studio\");\nhouse.style.background = \"radial-gradient(ellipse 80% 70% at 50% 40%, \" + beamC + \" 0%, transparent 70%)\";\nvar W = root.clientWidth, H = root.clientHeight;\nsvg.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H);\nvar SEARCH = 12, SWING = 26, HOUSE = 38;\nvar apexX = W / 2, apexY = -H * 0.12, floorY = H * 0.8, spread = W * 0.27, apexHalf = W * 0.012;\nvar defs = svgEl(\"defs\", {}, svg);\nvar bg = svgEl(\"linearGradient\", { id: \"sp-beam\", gradientUnits: \"userSpaceOnUse\", x1: 0, y1: apexY, x2: 0, y2: floorY }, defs);\n[[0, 0.55], [0.6, 0.2], [1, 0.12]].forEach(function (s) { svgEl(\"stop\", { offset: s[0], \"stop-color\": beamC, \"stop-opacity\": s[1] }, bg); });\nvar pg = svgEl(\"radialGradient\", { id: \"sp-pool\" }, defs);\n[[0, 0.45], [0.6, 0.14], [1, 0]].forEach(function (s) { svgEl(\"stop\", { offset: s[0], \"stop-color\": beamC, \"stop-opacity\": s[1] }, pg); });\nvar flt = svgEl(\"filter\", { id: \"sp-soft\", x: -W, y: -H, width: W * 3, height: H * 3, filterUnits: \"userSpaceOnUse\" }, defs);\nsvgEl(\"feGaussianBlur\", { stdDeviation: W * 0.012 }, flt);\nvar grp = svgEl(\"g\", {}, svg);\nvar pool = svgEl(\"ellipse\", { cy: floorY, rx: spread * 1.25, ry: H * 0.07, fill: \"url(#sp-pool)\" }, grp);\nvar beam = svgEl(\"polygon\", { fill: \"url(#sp-beam)\", filter: \"url(#sp-soft)\" }, grp);\nfunction draw(frame) {\n  var t = frame * speed, target;\n  if (t < SEARCH) target = interp(t, [0, SEARCH], [0.14, 0.27], inOutSin);\n  else if (t < SWING) target = interp(t, [SEARCH, SWING], [0.27, 0.74], inOutCubic);\n  else target = 0.74 + (0.5 - 0.74) * spring(t - SWING, { damping: 11, stiffness: 120, mass: 0.8 });\n  var tx = target * W;\n  var beamOn = interp(t, [0, 5], [0, 1], outQuad);\n  var hs = interp(t, [HOUSE, HOUSE + 12], [0, 1], inOutSin);\n  var coverage = Math.max(0, 1 - Math.abs(target - 0.5) / 0.3);\n  var lit = Math.max(dim, dim + (1 - dim) * inOutQuad(Math.min(1, coverage)) * beamOn);\n  var brightness = t >= SWING + 10 ? Math.max(lit, Math.min(1, lit + hs)) : lit;\n  house.style.opacity = 0.09 * hs;\n  grp.setAttribute(\"opacity\", beamOn * (1 - 0.35 * hs));\n  pool.setAttribute(\"cx\", tx);\n  beam.setAttribute(\"points\", [apexX - apexHalf, apexY, apexX + apexHalf, apexY, tx + spread, floorY, tx - spread, floorY].reduce(function (a, v, i) { return a + (i % 2 ? \",\" : i ? \" \" : \"\") + v.toFixed(2); }, \"\"));\n  logo.style.filter = \"brightness(\" + brightness + \")\";\n}\nfinish(drive(draw, TOTAL));\n\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
