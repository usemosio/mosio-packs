 "files": [
  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Product Grid Reveal\n\nA mosaic of 6 or 9 product tiles, each with a name and a price, flips in with a stagger. One tile then scales up as the highlight and gets a Terlaris badge while the rest dim. Tiles show a drawn placeholder or your own images.\n\nCategory: commerce. Length: 5 s. WebGL: no.\n\nUse when:\n- Showing a range of products at once, then pointing at the best seller.\n- A weekly menu, a catalogue page, a new-arrivals teaser.\n\nAvoid when:\n- One product with a big price: use price-drop.\n- A priced list read line by line: use menu-price-board.\n\nVariables:\n- title (string): Title, default \"Kue basah favorit\"\n- products (string): Products, default \"Kue lapis|Rp3.000\\nKlepon|Rp2.500\\nDadar gulung|Rp3.500\\nLemper ayam|Rp4.000\\nBika ambon|Rp6.000\\nOnde-onde|Rp2.500\\nSerabi|Rp3.000\\nCenil|Rp2.500\\nLupis|Rp3.500\"\n- highlight (number, 0-9): Highlight, default 5\n- badge (string): Badge, default \"Terlaris\"\n- images (string): Images, default \"\"\n- bg_color (color): Background, default \"#ffffff\"\n- main_color (color): Main colour, default \"#2563eb\"\n- text_color (color): Text colour, default \"#0a0a0a\"\n- muted_color (color): Muted colour, default \"#737373\"\n- tile_color (color): Tile colour, default \"#f4f4f2\"\n- font_family (string): Font, default \"Geist\"\n- transparent (boolean): Transparent, default false\n\nSource: Mosio original. Licence: MIT. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Product Grid Reveal\n\n  A mosaic of 6 or 9 product tiles, each with a name and a price, flips in with a stagger. One tile then scales up as the highlight and gets a Terlaris badge while the rest dim. Tiles show a drawn placeholder or your own images.\n\n  An original usemosio/blocks block (MIT, see LICENSE).\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"product-grid-reveal\"\n  data-composition-duration=\"5\"\n  data-composition-variables='[\n  {\n    \"id\": \"title\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Title\",\n    \"description\": \"Line above the grid. Leave empty to hide it.\",\n    \"default\": \"Kue basah favorit\"\n  },\n  {\n    \"id\": \"products\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Products\",\n    \"description\": \"One per line, Name|Price. 6 or fewer lines make a 6-tile grid, more make 9.\",\n    \"default\": \"Kue lapis|Rp3.000\\nKlepon|Rp2.500\\nDadar gulung|Rp3.500\\nLemper ayam|Rp4.000\\nBika ambon|Rp6.000\\nOnde-onde|Rp2.500\\nSerabi|Rp3.000\\nCenil|Rp2.500\\nLupis|Rp3.500\"\n  },\n  {\n    \"id\": \"highlight\",\n    \"type\": \"number\",\n    \"role\": \"content\",\n    \"label\": \"Highlight\",\n    \"description\": \"Which tile (1 = first) scales up. 0 for none.\",\n    \"default\": 5,\n    \"min\": 0,\n    \"max\": 9,\n    \"step\": 1\n  },\n  {\n    \"id\": \"badge\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Badge\",\n    \"description\": \"Text on the highlighted tile.\",\n    \"default\": \"Terlaris\"\n  },\n  {\n    \"id\": \"images\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Images\",\n    \"description\": \"Optional image URLs, one per line in tile order. Empty tiles stay drawn.\",\n    \"default\": \"\"\n  },\n  {\n    \"id\": \"bg_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Background\",\n    \"description\": \"Background.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"main_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Main colour\",\n    \"description\": \"Badge and highlight outline: the one accent.\",\n    \"default\": \"#2563eb\"\n  },\n  {\n    \"id\": \"text_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Text colour\",\n    \"description\": \"Tile names and title.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"muted_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Muted colour\",\n    \"description\": \"Prices.\",\n    \"default\": \"#737373\"\n  },\n  {\n    \"id\": \"tile_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Tile colour\",\n    \"description\": \"Tile background.\",\n    \"default\": \"#f4f4f2\"\n  },\n  {\n    \"id\": \"font_family\",\n    \"type\": \"string\",\n    \"role\": \"style\",\n    \"label\": \"Font\",\n    \"description\": \"Google Fonts family name; Geist is loaded, others only if the host loads them.\",\n    \"default\": \"Geist\"\n  },\n  {\n    \"id\": \"transparent\",\n    \"type\": \"boolean\",\n    \"role\": \"style\",\n    \"label\": \"Transparent\",\n    \"description\": \"Leave the background clear so the block sits over your own scene.\",\n    \"default\": false\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Product Grid Reveal</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute; inset: 0; overflow: hidden; container-type: size; pointer-events: none;\n          -webkit-font-smoothing: antialiased;\n          background: var(--pgr-bg); color: var(--pgr-text); font-family: var(--pgr-font);\n        }\n        #root * { box-sizing: border-box; }\n        .pgr-stage { position: absolute; inset: 0; --u: calc(100cqmin / 1080); }\n\n        .pgr-title { position: absolute; left: 0; right: 0; text-align: center; font-weight: 600; letter-spacing: -0.04em; white-space: nowrap; }\n        .pgr-grid { position: absolute; display: grid; perspective: calc(var(--u) * 1800); }\n        .pgr-tile { position: relative; display: flex; flex-direction: column; min-height: 0; border-radius: calc(var(--u) * 28); background: var(--pgr-tile); padding: calc(var(--u) * 14); gap: calc(var(--u) * 10); outline: 0 solid var(--pgr-main); backface-visibility: hidden; }\n        .pgr-art { flex: 1; min-height: 0; border-radius: calc(var(--u) * 18); display: flex; align-items: center; justify-content: center; background-size: cover; background-position: center; }\n        .pgr-art svg { width: 56%; height: 56%; }\n        .pgr-meta { display: flex; flex-direction: column; gap: calc(var(--u) * 2); padding: 0 calc(var(--u) * 8) calc(var(--u) * 6); }\n        .pgr-name { font-weight: 600; letter-spacing: -0.02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n        .pgr-price { font-weight: 500; color: var(--pgr-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }\n        .pgr-badge { position: absolute; left: calc(var(--u) * 24); top: calc(var(--u) * 24); padding: calc(var(--u) * 8) calc(var(--u) * 22); border-radius: calc(var(--u) * 60); background: var(--pgr-main); color: #fff; font-weight: 600; font-size: calc(var(--u) * 28); white-space: nowrap; opacity: 0; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"product-grid-reveal\" data-duration=\"5\" data-fps=\"30\">\n        <div id=\"pgr-clip\" class=\"pgr-stage clip\" data-start=\"0\" data-duration=\"5\" data-track-index=\"0\">\n          <div class=\"pgr-title\" id=\"pgr-title\"></div>\n          <div class=\"pgr-grid\" id=\"pgr-grid\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() || {} : {};\n            function num(v, d, a, b) { var n = Number(v); return Number.isFinite(n) ? Math.min(b, Math.max(a, n)) : d; }\n            function str(v, d) { return typeof v === \"string\" && v.trim() ? v : d; }\n            function colr(v, d) { return typeof v === \"string\" && v.trim() && window.CSS && CSS.supports(\"color\", v.trim()) ? v.trim() : d; }\n            function bool(v, d) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : d; }\n            function el(tag, cls, parent, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; if (parent) parent.appendChild(e); return e; }\n            function esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\"); }\n            function lines(v, d) { var s = typeof v === \"string\" && v.trim() ? v : d; return s.split(/\\r?\\n/).map(function (l) { return l.trim(); }).filter(Boolean); }\n            function dots(n) { return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"); }\n            function ease(n, a, b) { return Math.min(1, Math.max(0, (n - a) / (b - a))); }\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920, U = Math.min(W, H) / 1080, PORTRAIT = H > W;\n            var PAL = [[\"bg\", \"bg_color\", \"#ffffff\"], [\"main\", \"main_color\", \"#2563eb\"], [\"text\", \"text_color\", \"#0a0a0a\"], [\"muted\", \"muted_color\", \"#737373\"], [\"tile\", \"tile_color\", \"#f4f4f2\"]];\n            PAL.forEach(function (c) { root.style.setProperty(\"--pgr-\" + c[0], colr(vars[c[1]], c[2])); });\n            root.style.setProperty(\"--pgr-font\", '\"' + str(vars.font_family, \"Geist\") + '\", Geist, system-ui, sans-serif');\n            if (bool(vars.transparent, false)) root.style.background = \"transparent\";\n\n\n            var items = lines(vars.products, \"\").map(function (l) { var a = l.split(\"|\"); return { name: (a[0] || \"\").trim(), price: (a[1] || \"\").trim() }; });\n            var n = items.length > 6 ? 9 : 6; items = items.slice(0, n);\n            var imgs = String(vars.images || \"\").split(/\\r?\\n/).map(function (x) { return x.trim(); });\n            var cols = n === 9 ? 3 : PORTRAIT ? 2 : 3, rows = n / cols;\n            var titleEl = document.getElementById(\"pgr-title\"), t = typeof vars.title === \"string\" ? vars.title.trim() : \"Kue basah favorit\";\n            titleEl.textContent = t;\n            var gridTop = t ? (PORTRAIT ? 300 : 190) : (PORTRAIT ? 120 : 60);\n            titleEl.style.top = 150 * U + \"px\"; titleEl.style.fontSize = 76 * U + \"px\";\n            var grid = document.getElementById(\"pgr-grid\"), mx = (PORTRAIT ? 56 : 60) * U, bot = (PORTRAIT ? 120 : 60) * U;\n            if (!PORTRAIT) {\n              titleEl.style.cssText += \"left:\" + 90 * U + \"px;right:auto;width:\" + (W * 0.34 - 90 * U) + \"px;top:0;bottom:0;display:flex;align-items:center;text-align:left;white-space:normal;font-size:\" + 92 * U + \"px;line-height:1.05\";\n              titleEl.style.fontSize = 92 * U + \"px\"; gridTop = 60;\n            }\n            grid.style.left = (PORTRAIT ? mx : W * 0.4) + \"px\"; grid.style.right = mx + \"px\"; grid.style.top = gridTop * U + \"px\"; grid.style.bottom = bot + \"px\";\n            var gp = 26 * U; grid.style.gap = gp + \"px\";\n            grid.style.gridTemplateColumns = \"repeat(\" + cols + \", 1fr)\"; grid.style.gridTemplateRows = \"repeat(\" + rows + \", 1fr)\";\n            var tones = [\"#e4e1da\", \"#dcd9d2\", \"#e9e6df\"], shapes = [\n              '<svg viewBox=\"0 0 100 100\"><circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"#fff\" opacity=\".7\"/><circle cx=\"50\" cy=\"50\" r=\"18\" fill=\"#fff\"/></svg>',\n              '<svg viewBox=\"0 0 100 100\"><rect x=\"14\" y=\"14\" width=\"72\" height=\"72\" rx=\"22\" fill=\"#fff\" opacity=\".7\"/><rect x=\"34\" y=\"34\" width=\"32\" height=\"32\" rx=\"10\" fill=\"#fff\"/></svg>',\n              '<svg viewBox=\"0 0 100 100\"><path d=\"M50 8 L92 50 L50 92 L8 50 Z\" fill=\"#fff\" opacity=\".7\"/><circle cx=\"50\" cy=\"50\" r=\"14\" fill=\"#fff\"/></svg>'];\n            var big = cols === 2 ? 1 : 0, tiles = [];\n            items.forEach(function (it, i) {\n              var tile = el(\"div\", \"pgr-tile\", grid);\n              var art = el(\"div\", \"pgr-art\", tile, imgs[i] ? \"\" : shapes[i % 3]); art.style.backgroundColor = tones[i % 3];\n              if (imgs[i]) art.style.backgroundImage = 'url(\"' + imgs[i].replace(/\"/g, \"\") + '\")';\n              var meta = el(\"div\", \"pgr-meta\", tile, '<span class=\"pgr-name\">' + esc(it.name) + '</span><span class=\"pgr-price\">' + esc(it.price) + '</span>');\n              meta.firstChild.style.fontSize = (big ? 44 : PORTRAIT ? 32 : 38) * U + \"px\"; meta.lastChild.style.fontSize = (big ? 38 : PORTRAIT ? 28 : 32) * U + \"px\";\n              tiles.push(tile);\n            });\n            var hi = Math.round(num(vars.highlight, 5, 0, 9)) - 1, badgeText = typeof vars.badge === \"string\" ? vars.badge.trim() : \"Terlaris\";\n            var badge = null;\n            if (hi >= 0 && hi < n) { badge = el(\"span\", \"pgr-badge\", tiles[hi], esc(badgeText)); if (!badgeText) badge.style.display = \"none\"; }\n            var tl = gsap.timeline({ paused: true });\n            tl.fromTo(\"#pgr-title\", { opacity: 0, x: PORTRAIT ? 0 : -30 * U, y: PORTRAIT ? -20 * U : 0 }, { opacity: 1, x: 0, y: PORTRAIT ? 0 : 0, duration: 0.5, ease: \"power3.out\" }, 0.1);\n            tiles.forEach(function (tile, i) {\n              tl.fromTo(tile, { rotationY: -90, opacity: 0, transformOrigin: \"50% 50%\" }, { rotationY: 0, opacity: 1, duration: 0.6, ease: \"power3.out\" }, 0.3 + i * 0.09);\n            });\n            if (badge) {\n              var hiT = 0.3 + (n - 1) * 0.09 + 0.6 + 0.5;\n              tiles.forEach(function (tile, i) { if (i !== hi) tl.to(tile, { opacity: 0.45, duration: 0.4, ease: \"power2.out\" }, hiT); });\n              tl.set(tiles[hi], { zIndex: 5 }, hiT);\n              tl.to(tiles[hi], { scale: 1.12, duration: 0.5, ease: \"expo.out\", outlineWidth: 4 * U }, hiT);\n              tl.fromTo(badge, { scale: 0.4, opacity: 0, y: -10 * U }, { scale: 1, opacity: 1, y: 0, duration: 0.4, ease: \"back.out(1.6)\" }, hiT + 0.3);\n            }\n\n            var total = parseFloat(root.dataset.duration || \"5\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"product-grid-reveal\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
