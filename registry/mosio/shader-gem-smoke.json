.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([0, 0, 0, 0]));\n                gl.uniform1f(u(\"u_imageAspectRatio\"), 1);\n                gl.uniform1i(u(\"u_isImage\"), 0);\n              }\n              gl.uniform1i(u(\"u_image\"), 0);\n              var timeLoc = u(\"u_time\");\n              draw = function (frame) {\n                // remocn: frame = (frame / fps) * speed * 1000 ms; Paper's u_time is that in seconds.\n                gl.uniform1f(timeLoc, (frame / 30) * speed);\n                gl.clearColor(0, 0, 0, 0);\n                gl.clear(gl.COLOR_BUFFER_BIT);\n                gl.drawArrays(gl.TRIANGLES, 0, 6);\n              };\n            } catch (err) {\n              canvas.style.display = \"none\";\n              if (window.console) console.warn(\"shader-gem-smoke:\", err.message);\n            }\n\n            var total = parseFloat(root.dataset.duration || \"5\");\n            var totalFrames = Math.round(total * 30);\n            var clock = { frame: 0 };\n            var tl = gsap.timeline({ paused: true });\n            tl.to(clock, {\n              frame: totalFrames,\n              duration: total,\n              ease: \"none\",\n              onUpdate: function () { draw(clock.frame); }\n            }, 0);\n            draw(0);\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"shader-gem-smoke\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
