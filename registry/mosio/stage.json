   "content": "<!doctype html>\n<!--\n  Stage\n\n  A long page on a perspective studio plane, with the camera travelling across it on keyframes. The plane holds a built-in placeholder page drawn in CSS; to use your own, replace the markup inside #st-page in the file (it is 1265 wide and 5000 tall, scaled to the plane).\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/stage/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"stage\"\n  data-composition-duration=\"10\"\n  data-composition-variables='[{\"id\":\"preset\",\"type\":\"enum\",\"role\":\"motion\",\"label\":\"Camera path\",\"description\":\"Camera keyframes for the move across the page.\",\"default\":\"smooth-descent\",\"options\":[{\"value\":\"smooth-descent\",\"label\":\"Smooth descent\"},{\"value\":\"site-tour\",\"label\":\"Site tour\"},{\"value\":\"hero-push\",\"label\":\"Hero push\"},{\"value\":\"section-hop\",\"label\":\"Section hop\"}]},{\"id\":\"shake\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Handheld shake\",\"description\":\"Amount of deterministic handheld motion.\",\"default\":0,\"min\":0,\"max\":1,\"step\":0.05},{\"id\":\"seed\",\"type\":\"string\",\"role\":\"motion\",\"label\":\"Shake seed\",\"description\":\"Seed for the handheld motion.\",\"default\":\"smooth-descent\"},{\"id\":\"backdrop\",\"type\":\"string\",\"role\":\"style\",\"label\":\"Backdrop\",\"description\":\"CSS background behind the plane.\",\"default\":\"linear-gradient(145deg, #17181d 0%, #09090b 72%)\"},{\"id\":\"rotate_x\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Rotate X\",\"description\":\"Tilt of the plane around the horizontal axis.\",\"default\":14,\"min\":-180,\"max\":180,\"step\":1,\"unit\":\"deg\"},{\"id\":\"rotate_y\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Rotate Y\",\"description\":\"Turn of the plane around the vertical axis.\",\"default\":-20,\"min\":-180,\"max\":180,\"step\":1,\"unit\":\"deg\"},{\"id\":\"perspective\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Perspective\",\"description\":\"Camera perspective distance.\",\"default\":900,\"min\":50,\"max\":5000,\"step\":25,\"unit\":\"px\"},{\"id\":\"scale\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Scale\",\"description\":\"Plane scale.\",\"default\":0.86,\"min\":0.1,\"max\":3,\"step\":0.01},{\"id\":\"radius\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Radius\",\"description\":\"Corner radius as a percentage of the frame width.\",\"default\":1.4,\"min\":0,\"max\":4,\"step\":0.1,\"unit\":\"%\"},{\"id\":\"reflection\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Reflection\",\"description\":\"Strength of the floor reflection.\",\"default\":0.24,\"min\":0,\"max\":1,\"step\":0.05},{\"id\":\"shadow\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Contact shadow\",\"description\":\"Strength of the contact shadow.\",\"default\":0.7,\"min\":0,\"max\":1,\"step\":0.05},{\"id\":\"light\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Studio light\",\"description\":\"Strength of the studio light overlay.\",\"default\":0.55,\"min\":0,\"max\":1,\"step\":0.05}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Stage</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: linear-gradient(145deg, #17181d 0%, #09090b 72%); font-family: Geist, system-ui, sans-serif; }\n        .st-stage { position: absolute; inset: 0; overflow: hidden; }\n        #st-reflect { position: absolute; left: 13%; top: 72%; width: 74%; height: 30%; background: linear-gradient(to bottom, rgba(188,181,255,0.32), rgba(91,81,145,0.1) 35%, transparent 76%); clip-path: polygon(7% 0, 93% 0, 78% 100%, 22% 100%); filter: blur(18px); transform-origin: center top; pointer-events: none; }\n        #st-shadow { position: absolute; left: 16%; top: 70%; width: 68%; height: 11%; border-radius: 50%; pointer-events: none; }\n        #st-persp { position: absolute; inset: 0; perspective-origin: 50% 42%; pointer-events: none; }\n        #st-plane { position: absolute; overflow: hidden; transform-style: preserve-3d; background: #f6f6fa; }\n        #st-light { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen; background: radial-gradient(ellipse at 38% 7%, rgba(255,255,255,0.2), transparent 36%), linear-gradient(115deg, rgba(255,255,255,0.08), transparent 38%, rgba(255,255,255,0.02) 68%, rgba(0,0,0,0.24)); }\n        /* placeholder page, 1265 x 5000 design px */\n        #st-page { position: absolute; left: 0; top: 0; width: 1265px; height: 5000px; transform-origin: 0 0; color: #1a1b22; background: #f6f6fa; }\n        #st-page > div { position: relative; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; }\n        #st-page i { display: block; background: #d9dae4; border-radius: 8px; }\n        .pg-nav { height: 120px; flex-direction: row !important; justify-content: space-between !important; padding: 0 80px; background: #fff; }\n        .pg-logo { width: 46px; height: 46px; border-radius: 14px; background: linear-gradient(135deg, #6366f1, #a855f7); }\n        .pg-links { display: flex; gap: 28px; } .pg-links i { width: 90px; height: 14px; } .pg-links.f { margin-top: 80px; flex-wrap: wrap; justify-content: center; }\n        .pg-btn { display: inline-block; padding: 22px 44px; border-radius: 16px; background: #1a1b22; color: #fff; font-size: 30px; font-weight: 600; } .pg-btn.sm { padding: 12px 24px; font-size: 22px; } .pg-btn.ghost { background: transparent; color: #1a1b22; border: 2px solid #c8c9d6; }\n        .pg-hero { height: 900px; background: linear-gradient(#fff, #f0f0f8); } .pg-eyebrow { font-size: 24px; letter-spacing: 0.2em; text-transform: uppercase; color: #6366f1; font-weight: 600; }\n        .pg-h1 { font-size: 104px; line-height: 1.02; font-weight: 700; letter-spacing: -0.045em; text-align: center; margin: 24px 0; } .pg-p { font-size: 30px; color: #6b6c7b; margin-bottom: 36px; } .pg-row { display: flex; gap: 20px; }\n        .pg-shot { width: 900px; height: 200px; margin-top: 50px; border-radius: 28px 28px 0 0; background: linear-gradient(135deg, #6366f1, #a855f7); } .pg-shot.big { width: 1000px; height: 480px; border-radius: 28px; margin-top: 50px; }\n        .pg-logos { height: 260px; flex-direction: row !important; gap: 70px; } .pg-logos i { width: 150px; height: 40px; }\n        .pg-feat, .pg-pricing { height: 900px; } .pg-h2 { font-size: 72px; font-weight: 700; letter-spacing: -0.04em; margin-bottom: 70px; } .pg-h2.l { color: #fff; }\n        .pg-cards { display: flex; gap: 32px; } .pg-card { width: 340px; padding: 40px; border-radius: 28px; background: #fff; border: 2px solid #e6e7ef; display: block !important; } .pg-card.hi { background: #1a1b22; color: #fff; }\n        .pg-card b { display: block; width: 70px; height: 70px; border-radius: 20px; background: linear-gradient(135deg, #6366f1, #a855f7); margin-bottom: 30px; } .pg-card h4 { font-size: 38px; margin-bottom: 18px; } .pg-card .pr { font-size: 80px; font-weight: 700; margin: 10px 0 24px; }\n        .pg-card p { height: 16px; border-radius: 8px; background: #e2e3ec; margin-top: 14px; } .pg-card.hi p { background: #3a3b48; } .pg-card p.s { width: 60%; }\n        .pg-panel { height: 800px; background: #1a1b22; } .pg-panel .pg-h2 { margin-bottom: 0; }\n        .pg-quote { height: 600px; background: #fff; } .pg-q { font-size: 84px; font-weight: 600; letter-spacing: -0.04em; } .pg-who { margin-top: 24px; font-size: 28px; color: #6b6c7b; }\n        .pg-foot { height: 520px; background: linear-gradient(135deg, #6366f1, #a855f7); } .pg-foot .pg-h2 { margin-bottom: 40px; } .pg-foot .pg-btn { background: #fff; color: #1a1b22; } .pg-foot i { background: rgba(255,255,255,0.4); }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"stage\" data-duration=\"10\" data-fps=\"30\">\n        <div id=\"st-clip\" class=\"st-stage clip\" data-start=\"0\" data-duration=\"10\" data-track-index=\"0\">\n<div id=\"st-reflect\"></div><div id=\"st-shadow\"></div><div id=\"st-persp\"><div id=\"st-plane\"><div id=\"st-page\"><div class=\"pg-nav\"><span class=\"pg-logo\"></span><span class=\"pg-links\"><i></i><i></i><i></i><i></i></span><span class=\"pg-btn sm\">Sign up</span></div>\n<div class=\"pg-hero\"><div class=\"pg-eyebrow\">Introducing</div><div class=\"pg-h1\">Your product,<br>photographed.</div><div class=\"pg-p\">A long page on a studio plane, with the camera moving across it.</div><div class=\"pg-row\"><span class=\"pg-btn\">Get started</span><span class=\"pg-btn ghost\">Learn more</span></div><div class=\"pg-shot\"></div></div>\n<div class=\"pg-logos\"><i></i><i></i><i></i><i></i><i></i></div>\n<div class=\"pg-feat\"><div class=\"pg-h2\">Everything in one place</div><div class=\"pg-cards\"><div class=\"pg-card\"><b></b><h4>Fast</h4><p></p><p class=\"s\"></p></div><div class=\"pg-card\"><b></b><h4>Simple</h4><p></p><p class=\"s\"></p></div><div class=\"pg-card\"><b></b><h4>Yours</h4><p></p><p class=\"s\"></p></div></div></div>\n<div class=\"pg-panel\"><div class=\"pg-h2 l\">See it in action</div><div class=\"pg-shot big\"></div></div>\n<div class=\"pg-pricing\"><div class=\"pg-h2\">Simple pricing</div><div class=\"pg-cards\"><div class=\"pg-card\"><h4>Starter</h4><div class=\"pr\">$9</div><p></p><p class=\"s\"></p></div><div class=\"pg-card hi\"><h4>Growth</h4><div class=\"pr\">$29</div><p></p><p class=\"s\"></p></div><div class=\"pg-card\"><h4>Scale</h4><div class=\"pr\">$79</div><p></p><p class=\"s\"></p></div></div></div>\n<div class=\"pg-quote\"><div class=\"pg-q\">\"It just works.\"</div><div class=\"pg-who\">A happy customer</div></div>\n<div class=\"pg-foot\"><div class=\"pg-h2 l\">Ready when you are</div><span class=\"pg-btn\">Get started</span><div class=\"pg-links f\"><i></i><i></i><i></i><i></i><i></i><i></i></div></div></div></div></div><div id=\"st-light\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n                        // Stop-motion helpers: poses are held for `step` frames.\n            var DEFAULT_STEP = 3;\n            function qf(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step) * step; }\n            function qstep(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step); }\n            function hash01(seed) { return random(seed); }\n            function hashRange(seed, lo, hi) { return lo + hash01(seed) * (hi - lo); }\n            function paperJitter(frame, seed, o) {\n              o = o || {};\n              var amp = o.amp != null ? o.amp : 1.4, rotAmp = o.rotAmp != null ? o.rotAmp : 0.35;\n              var s = qstep(frame, o.step);\n              return { x: hashRange(seed + \":x:\" + s, -amp, amp), y: hashRange(seed + \":y:\" + s, -amp, amp), rot: hashRange(seed + \":r:\" + s, -rotAmp, rotAmp) };\n            }\n            function steppedRamp(frame, from, to, o) {\n              o = o || {};\n              var f = qf(frame, o.step);\n              if (f <= from) return 0;\n              if (f >= to) return 1;\n              var ease = o.ease || function (t) { return t; };\n              return ease((f - from) / (to - from));\n            }\n\n\n            var W = root.clientWidth, H = root.clientHeight;\n            var P = {\n              \"smooth-descent\": [[0, 0.5, 0.035, 1.04, 0], [30, 0.5, 0.07052, 1.04, 0, \"in\"], [269, 0.5, 0.91948, 1.04, 0, \"lin\"], [299, 0.5, 0.955, 1.04, 0, \"out\"]],\n              \"site-tour\": [[0, 0.48, 0.035, 1.04, -0.35], [38, 0.48, 0.035, 1.04, -0.35], [88, 0.53, 0.28, 1.12, 0.15], [116, 0.53, 0.28, 1.12, 0.15], [174, 0.47, 0.58, 1.08, -0.2], [204, 0.47, 0.58, 1.08, -0.2], [268, 0.52, 0.955, 1.02, 0.1], [299, 0.52, 0.955, 1.02, 0.1]],\n              \"hero-push\": [[0, 0.5, 0.045, 0.94, 0], [90, 0.5, 0.045, 1.2, 0], [160, 0.5, 0.045, 1.2, 0], [299, 0.5, 0.2, 1.08, 0]],\n              \"section-hop\": [[0, 0.5, 0.04, 1.1, 0], [52, 0.5, 0.04, 1.1, 0], [92, 0.46, 0.38, 1.18, -0.3], [142, 0.46, 0.38, 1.18, -0.3], [184, 0.54, 0.72, 1.14, 0.25], [234, 0.54, 0.72, 1.14, 0.25], [278, 0.5, 0.96, 1.06, 0], [299, 0.5, 0.96, 1.06, 0]]\n            };\n            var keys = P[pick(vars.preset, Object.keys(P), \"smooth-descent\")].map(function (k) { return { at: k[0], x: k[1], y: k[2], zoom: k[3], rotate: k[4], ease: