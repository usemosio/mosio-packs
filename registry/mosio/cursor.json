: -W / 2 + \"px\", marginTop: -H / 2 + \"px\", transform: \"scale(\" + k + \")\", transformOrigin: \"50% 50%\" }, o.parent || root);\n                el.k = k;\n                return el;\n              }\n              /* box(el, layer): design-pixel position and size of el inside a layer (layout only, transforms are ignored). */\n              function box(el, lay) {\n                var x = 0, y = 0, e = el;\n                while (e && e !== lay) { x += e.offsetLeft; y += e.offsetTop; e = e.offsetParent; }\n                if (!el.offsetWidth && el.__box) return el.__box; // host hid the clip: reuse the last real layout\n                el.__box = { x: x, y: y, w: el.offsetWidth, h: el.offsetHeight, cx: x + el.offsetWidth / 2, cy: y + el.offsetHeight / 2 };\n                return el.__box;\n              }\n\n              /* ---------- cursor (remocn-ui `Cursor` + `useCursorPath`) ---------- */\n              var ARROW = \"M1 1 L1 18.5 L5.6 14.4 L8.7 21.6 L11.6 20.4 L8.5 13.2 L14.5 13.2 Z\";\n              var POINTER = \"M8 2.2 C8 1.3 8.7 0.7 9.5 0.7 C10.3 0.7 11 1.3 11 2.2 L11 9 C11 9 11.3 8.4 12.2 8.4 C13 8.4 13.4 9 13.4 9.6 C13.4 9.6 13.9 9.1 14.7 9.1 C15.5 9.1 15.9 9.7 15.9 10.3 C15.9 10.3 16.4 9.9 17.1 9.9 C17.9 9.9 18.3 10.5 18.3 11.2 L18.3 16.8 C18.3 19.8 16.3 22.3 12.8 22.3 L11.4 22.3 C9 22.3 7.9 21.2 6.6 19.2 L4 15.2 C3.5 14.4 3.7 13.4 4.5 12.9 C5.1 12.5 5.9 12.6 6.4 13.2 L8 15 Z\";\n              var CLICK_FRAMES = 16, PRESS_FRAMES = 8;\n              /* cursorAt(waypoints, f, opts): waypoints [{at, x, y, duration?, click?, press?, easing?}]; `at` is the ARRIVAL frame,\n                 the move starts `duration` (default 24) frames earlier. opts.fadeIn (frames, default 8) fades the pointer in\n                 from frame 0; opts.fadeOutAt / fadeOut fade it away. Returns {x, y, opacity, rippleOpacity, rippleScale, pressScale}. */\n              function cursorAt(wps, f, opts) {\n                opts = opts || {};\n                var dd = opts.defau