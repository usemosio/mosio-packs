   "role": "source",
   "content": "<!doctype html>\n<!--\n  Ecosystem Constellation\n\n  A central product mark orbited by integration satellites with pulsing data lines. The eight satellites are generic placeholder marks, not real brands.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/ecosystem-constellation/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"ecosystem-constellation\"\n  data-composition-duration=\"8\"\n  data-composition-variables='[{\"id\":\"satellite_count\",\"type\":\"number\",\"role\":\"content\",\"label\":\"Satellites\",\"description\":\"How many satellites orbit (3 to 8).\",\"default\":6,\"min\":3,\"max\":8,\"step\":1},{\"id\":\"center_label\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Centre label\",\"description\":\"Letter or short text on the central mark.\",\"default\":\"V\"},{\"id\":\"accent_color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Accent\",\"description\":\"Colour of the hub, glow and lines.\",\"default\":\"#a855f7\"},{\"id\":\"speed\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Speed\",\"description\":\"Playback speed multiplier.\",\"default\":1,\"min\":0.25,\"max\":4,\"step\":0.05,\"unit\":\"x\"}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Ecosystem Constellation</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;600;800&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: #09090b; font-family: Geist, system-ui, sans-serif; }\n        .ec-stage { position: absolute; inset: 0; }\n        #ec-world { overflow: hidden; }\n        #ec-svg { position: absolute; left: 0; top: 0; }\n        #ec-center { position: absolute; width: 96px; height: 96px; margin: -48px 0 0 -48px; border-radius: 24px; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 52px; letter-spacing: -0.05em; border: 1px solid rgba(255,255,255,0.15); box-sizing: border-box; }\n        .ec-sat { position: absolute; width: 56px; height: 56px; margin: -28px 0 0 -28px; border-radius: 14px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,0.12); box-sizing: border-box; }\n        .ec-sat svg { width: 28px; height: 28px; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"ecosystem-constellation\" data-duration=\"8\" data-fps=\"30\">\n        <div id=\"ec-clip\" class=\"ec-stage clip\" data-start=\"0\" data-duration=\"8\" data-track-index=\"0\">\n<div id=\"ec-world\"><svg id=\"ec-svg\"></svg><div id=\"ec-center\"></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n                        // Stop-motion helpers: poses are held for `step` frames.\n            var DEFAULT_STEP = 3;\n            function qf(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step) * step; }\n            function qstep(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step); }\n            function hash01(seed) { return random(seed); }\n            function hashRange(seed, lo, hi) { return lo + hash01(seed) * (hi - lo); }\n            function paperJitter(frame, seed, o) {\n              o = o || {};\n              var amp = o.amp != null ? o.amp : 1.4, rotAmp = o.rotAmp != null ? o.rotAmp : 0.35;\n              var s = qstep(frame, o.step);\n              return { x: hashRange(seed + \":x:\" + s, -amp, amp), y: hashRange(seed + \":y:\" + s, -amp, amp), rot: hashRange(seed + \":r:\" + s, -rotAmp, rotAmp) };\n            }\n            function steppedRamp(frame, from, to, o) {\n              o = o || {};\n              var f = qf(frame, o.step);\n              if (f <= from) return 0;\n              if (f >= to) return 1;\n              var ease = o.ease || function (t) { return t; };\n              return ease((f - from) / (to - from));\n            }\n\n\n            function scaledStage(el, boost) {\n              var W = root.clientWidth, H = root.clientHeight;\n              var s = Math.min(W / 1280, H / 720) * (H > W ? (boost || 1.4) : 1);\n              el.style.position = \"absolute\"; el.style.left = \"0\"; el.style.top = \"0\";\n              el.style.width = W / s + \"px\"; el.style.height = H / s + \"px\";\n              el.style.transformOrigin = \"0 0\"; el.style.transform = \"scale(\" + s + \")\";\n              return s;\n            }\n\n            var world = document.getElementById(\"ec-world\"), svg = document.getElementById(\"ec-svg\"), center = document.getElementById(\"ec-center\");\n            var sc = scaledStage(world, 1.5);\n            var SW = root.clientWidth / sc, SH = root.clientHeight / sc;\n            svg.setAttribute(\"width\", SW); svg.setAttribute(\"height\", SH); svg.setAttribute(\"viewBox\", \"0 0 \" + SW + \" \" + SH);\n            var accent = str(vars.accent_color, \"#a855f7\");\n            var count = Math.max(3, Math.min(8, Math.floor(num(vars.satellite_count, 6, 3, 8)))), speed = num(vars.speed, 1, 0.25, 4);\n            center.textContent = str(vars.center_label, \"V\");\n            center.style.background = \"linear-gradient(180deg, \" + accent + \" 0%, \" + accent + \"cc 100%)\";\n            center.style.boxShadow = \"0 0 60px \" + accent + \"66, inset 0 1px 0 rgba(255,255,255,0.3)\";\n            var cx = SW / 2, cy = SH / 2;\n            center.style.left = cx + \"px\"; center.style.top = cy + \"px\";\n            // Eight generic marks drawn from primitive shapes.\n            var BRANDS = [\n              { bg: \"#1f1f23\", svg: '<path fill=\"#fff\" d=\"M12 3c5 0 9 4 9 9s-4 9-9 9-9-4-9-9 4-9 9-9zm0 4a5 5 0 100 10 5 5 0 000-10z\" fill-rule=\"evenodd\"/>' },\n              { bg: \"#0a0a0a\", svg: '<path fill=\"#fff\" d=\"M12 3l9.5 17h-19z\"/>' },\n              { bg: \"#635bff\", svg: '<rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"4\" fill=\"#fff\"/>' },\n              { bg: \"#1a1d21\", svg: '<path d=\"M12 3l8 4.5v9L12 21l-8-4.5v-9z\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linejoin=\"round\"/>' },\n              { bg: \"#2f7d6d\", svg: '<circle cx=\"12\" cy=\"12\" r=\"8\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.4\"/><circle cx=\"12\" cy=\"12\" r=\"2.6\" fill=\"#fff\"/>' },\n              { bg: \"#1e1e1e\", svg: '<circle cx=\"9\" cy=\"10\" r=\"5\" fill=\"#f4a261\" opacity=\"0.9\"/><circle cx=\"15\" cy=\"10\" r=\"5\" fill=\"#2a9d8f\" opacity=\"0.9\"/><circle cx=\"12\" cy=\"15\" r=\"5\" fill=\"#e76f9a\" opacity=\"0.9\"/>' },\n              { bg: \"#1a1a1a\", svg: '<path d=\"M12 3l2.6 6.4L21 12l-6.4 2.6L12 21l-2.6-6.4L3 12l6.4-2.6z\" fill=\"#fff\"/>' },\n              { bg: \"#5865f2\", svg: '<path d=\"M4 6h16v9H13l-4 4v-4H4z\" fill=\"#fff\"/>' }\n            ];\n            var sats = [];\n            for (var i = 0; i < count; i++) {\n              var b = BRANDS[i % BRANDS.length];\n              var el = document.createElement(\"div\"); el.id = \"ec-sat-\" + i; el.className = \"ec-sat\";\n              el.style.background = \"linear-gradient(180deg, \" + b.bg + \" 0%, \" + b.bg + \"dd 100%)\";\n              el.style.boxShadow = \"0 8px 30px \" + b.bg + \"66, inset 0 1px 0 rgba(255,255,255,0.18)\";\n              el.innerHTML = '<svg viewBox=\"0 0 24 24\">' + b.svg + \"</svg>\";\n              world.appendChild(el);\n              sats.push(el);\n            }\n            var lines = sats.map(function () { return svgEl(\"line\", { x1: cx, y1: cy, x2: cx, y2: cy, stroke: accent, \"stroke-width\": 2, \"stroke-linecap\": \"round\", opacity: 0 }, svg); });\n            var glow1 = svgEl(\"circle\", { cx: cx, cy: cy, r: 70, fill: accent, opacity: 0.12 }, svg);\n            var glow2 = svgEl(\"circle\", { cx: cx, cy: cy, r: 50, fill: accent, opacity: 0.2 }, svg);\n            function draw(f0) {\n              var frame = f0 * speed;\n              var pulse = (Math.sin(frame / 12) + 1) / 2;\n              center.style.transform = \"scale(\" + (1 + pulse * 0.06) + \")\";\n              glow1.setAttribute(\"r\", 70 + pulse * 8); glow2.setAttribute(\"r\", 50 + pulse * 4);\n              var active = Math.floor(frame / 30) % count, local = frame - Math.floor(frame / 30) * 30;\n              sats.forEach(function (el, i) {\n                var sp = spring({ frame: frame - i * 4, fps: 30, config: { mass: 1.1, damping: 16, stiffness: 70 }, durationInFrames: 50 });\n                var rf = interpolate(sp, [0, 1], [1200, 1]);\n                var rX = 230 + i * 22, rY = 180 + i * 22 * 0.7;\n                var ang = (i / count) * Math.PI * 2 + frame * (0.012 - i * 0.0008);\n                var x = cx + Math.cos(ang) * rX * rf, y = cy + Math.sin(ang) * rY * rf;\n                var on = active === i, cl = { extrapolateLeft: \"clamp\", extrapolateRight: \"clamp\" };\n                var lo = on ? interpolate(local, [0, 8, 22, 30], [0.15, 0.9, 0.9, 0.15], cl) : 0.15;\n                var ss = on ? interpolate(local, [0, 8, 22, 30], [1, 1.1, 1.1, 1], cl) : 1;\n                var vis = sp > 0.02;\n                el.style.left = x + \"px\"; el.style.top = y + \"px\"; el.style.transform = \"scale(\" + ss + \")\"; el.style.opacity = vis ? 1 : 0;\n                lines[i].setAttribute(\"x2\", x); lines[i].setAttribute(\"y2\", y); lines[i].setAttribute(\"opacity\", vis ? lo : 0);\n              });\n            }\n            var tl = gsap.timeline({ paused: true });\n            clockTween(tl, 240, draw);\n\n            var total = parseFloat(root.dataset.duration || \"8\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"ecosystem-constellation\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
