   "content": "<!doctype html>\n<!--\n  Scribble Circle\n\n  A hand-drawn marker circle scribbles itself around a target in stop-motion poses.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/scribble-circle/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"scribble-circle\"\n  data-composition-duration=\"5\"\n  data-composition-variables='[{\"id\":\"plans\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Rows\",\"description\":\"JSON array of {name, price} rows shown on the card.\",\"default\":\"[{\\\"name\\\":\\\"Hobby\\\",\\\"price\\\":\\\"Free\\\"},{\\\"name\\\":\\\"Pro\\\",\\\"price\\\":\\\"$19\\\"},{\\\"name\\\":\\\"Team\\\",\\\"price\\\":\\\"$49\\\"}]\"},{\"id\":\"target\",\"type\":\"number\",\"role\":\"layout\",\"label\":\"Circled row\",\"description\":\"Index of the row whose price gets circled (0 is the first).\",\"default\":1,\"min\":0,\"max\":9,\"step\":1},{\"id\":\"laps\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Laps\",\"description\":\"How many times the pen goes around.\",\"default\":1.15,\"min\":0.5,\"max\":3,\"step\":0.05},{\"id\":\"stroke_width\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Stroke width\",\"description\":\"Width of the marker stroke.\",\"default\":14,\"min\":2,\"max\":30,\"step\":1,\"unit\":\"px\"},{\"id\":\"pressure\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Opening pressure\",\"description\":\"Stroke width at the start, as a fraction of the stroke width.\",\"default\":0.2,\"min\":0.05,\"max\":1,\"step\":0.05},{\"id\":\"grain\",\"type\":\"number\",\"role\":\"style\",\"label\":\"Grain\",\"description\":\"How rough the ink edge is.\",\"default\":1,\"min\":0,\"max\":2,\"step\":0.1},{\"id\":\"duration_steps\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Drawing poses\",\"description\":\"Number of poses the scribble takes.\",\"default\":10,\"min\":3,\"max\":30,\"step\":1},{\"id\":\"color\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Color\",\"description\":\"Marker color.\",\"default\":\"#6f7f35\"},{\"id\":\"seed\",\"type\":\"string\",\"role\":\"motion\",\"label\":\"Seed\",\"description\":\"Seed for the hand-drawn wobble.\",\"default\":\"scribble\"},{\"id\":\"step\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Frames per pose\",\"description\":\"How many frames each drawing pose is held.\",\"default\":3,\"min\":1,\"max\":6,\"step\":1,\"unit\":\"frames\"}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Scribble Circle</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;600&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n\n        }\n        #root { font-family: Geist, system-ui, sans-serif; color: #26242c; }\n        .scc-stage { position: absolute; inset: 0; }\n        .scc-card { position: relative; width: 460px; padding: 24px; box-sizing: border-box; border-radius: 18px; background: #fdfcf8; }\n        .scc-row { display: flex; align-items: center; justify-content: space-between; height: 84px; padding: 0 18px; }\n        .scc-name { font-size: 30px; font-weight: 600; }\n        .scc-price { display: inline-block; width: 76px; text-align: center; font-size: 26px; color: rgba(38,36,44,0.55); }\n        .scc-mark { position: absolute; width: 108px; height: 62px; }\n        .scc-svg { position: absolute; display: block; overflow: visible; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"scribble-circle\" data-duration=\"5\" data-fps=\"30\">\n        <div id=\"scc-clip\" class=\"scc-stage clip\" data-start=\"0\" data-duration=\"5\" data-track-index=\"0\">\n          <div id=\"scc-card\" class=\"scc-card\">\n            <div id=\"scc-mark\" class=\"scc-mark\"><svg id=\"scc-svg\" class=\"scc-svg\"><defs id=\"scc-defs\"></defs><path id=\"scc-path\" opacity=\"0.85\"></path></svg></div>\n          </div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n            \nconst DEFAULT_STEP = 3;\n\nconst qf = (frame        , step = DEFAULT_STEP)         =>\n  Math.floor(frame / step) * step;\n\nconst qstep = (frame        , step = DEFAULT_STEP)         =>\n  Math.floor(frame / step);\n\nconst hash01 = (seed        )         => {\n  let h = 2166136261;\n  for (let i = 0; i < seed.length; i++) {\n    h ^= seed.charCodeAt(i);\n    h = Math.imul(h, 16777619);\n  }\n  h = Math.imul(h ^ (h >>> 13), 2246822519);\n  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;\n};\n\nconst hashRange = (seed        , lo        , hi        )         =>\n  lo + hash01(seed) * (hi - lo);\n\n                                                           \n\nconst paperJitter = (\n  frame        ,\n  seed        ,\n  options                                                   ,\n)         => {\n  const amp = options?.amp ?? 1.4;\n  const rotAmp = options?.rotAmp ?? 0.35;\n  const s = qstep(frame, options?.step ?? DEFAULT_STEP);\n  return {\n    x: hashRange(`${seed}:x:${s}`, -amp, amp),\n    y: hashRange(`${seed}:y:${s}`, -amp, amp),\n    rot: hashRange(`${seed}:r:${s}`, -rotAmp, rotAmp),\n  };\n};\n\nconst steppedSpring = (args   \n                \n              \n                 \n                \n                                                                   \n )         =>\n  spring({\n    frame: qf(\n      Math.max(0, args.frame - (args.delay ?? 0)),\n      args.step ?? DEFAULT_STEP,\n    ),\n    fps: args.fps,\n    config: args.config,\n  });\n\nconst steppedRamp = (\n  frame        ,\n  from        ,\n  to        ,\n  options                                                  ,\n)         => {\n  const f = qf(frame, options?.step ?? DEFAULT_STEP);\n  if (f <= from) return 0;\n  if (f >= to) return 1;\n  const ease = options?.ease ?? ((t        ) => t);\n  return ease((f - from) / (to - from));\n};\n\n            \n\nconst GRAIN_RATIO = 0.5;\nconst GRAIN_FREQUENCY = 0.7;\nconst GRAIN_OCTAVES = 3;\n\n                                                  \n\n                          \n                      \n                    \n                   \n  \n\nfunction brushHalfWidth(taper            , t        )         {\n  const pressure = taper.pressure ?? 0.2;\n  const release = taper.release ?? 1;\n  return (taper.strokeWidth / 2) * (pressure + (release - pressure) * t);\n}\n\nfunction brushGrainScale(strokeWidth        , grain        )         {\n  return strokeWidth * GRAIN_RATIO * grain;\n}\n\nfunction brushReach(strokeWidth        , grain        )         {\n  return strokeWidth / 2 + brushGrainScale(strokeWidth, grain) / 2;\n}\n\nfunction brushFilterId(\n  seed        ,\n  strokeWidth        ,\n  grain        ,\n)         {\n  return `remocn-brush-${Math.floor(hash01(`${seed}:${strokeWidth}:${grain}`) * 1e9)}`;\n}\n\nfunction sampleCubic(\n  from            ,\n  c1            ,\n  c2            ,\n  to            ,\n  points = 32,\n)               {\n  const count = Math.max(2, points);\n  return Array.from({ length: count }, (_, i) => {\n    const t = i / (count - 1);\n    const u = 1 - t;\n    const a = u * u * u;\n    const b = 3 * u * u * t;\n    const c = 3 * u * t * t;\n    const d = t * t * t;\n    return {\n      x: a * from.x + b * c1.x + c * c2.x + d * to.x,\n      y: a * from.y + b * c1.y + c * c2.y + d * to.y,\n    };\n  });\n}\n\nfunction sampleLine(\n  from            ,\n  to            ,\n  points = 8,\n)               {\n  const count = Math.max(2, points);\n  return Array.from({ length: count }, (_, i) => {\n    const t = i / (count - 1);\n    return {\n      x: from.x + (to.x - from.x) * t,\n      y: from.y + (to.y - from.y) * t,\n    };\n  });\n}\n\nconst normalAt = (points              , i        )             => {\n  const before = points[i - 1] ?? points[i];\n  const after = points[i + 1] ?? points[i];\n  const tx = after.x - before.x;\n  const ty = after.y - before.y;\n  const length = Math.hypot(tx, ty) || 1;\n  return { x: -ty / length, y: tx / length };\n};\n\nconst curveSegments = (points              )         =>\n  points\n    .slice(0, -1)\n    .map((p1, i) => {\n      const p0 = points[i - 1] ?? p1;\n      const p2 = points[i + 1];\n      const p3 = points[i + 2] ?? p2;\n      return `C ${p1.x + (p2.x - p0.x) / 6} ${p1.y + (p2.y - p0.y) / 6}, ${p2.x - (p3.x - p1.x) / 6} ${p2.y - (p3.y - p1.y) / 6}, ${p2.x} ${p2.y}`;\n    })\n    .join(\" \");\n\nfunction brushRibbon(\n  spine              ,\n  options                                    ,\n)         {\n  const progress = options.progress ?? 1;\n  const drawn = Math.max(2, Math.round(progress * (spine.length - 1)) + 1);\n\n  const left               = [];\n  const right               = [];\n  for (let i = 0; i < drawn; i++) {\n    const half = brushHalfWidth(options, i / (spine.length - 1));\n    const normal = normalAt(spine, i);\n    left.push({\n      x: spine[i].x + normal.x * half,\n      y: spine[i].y + normal.y * half,\n    });\n    right.push({\n      x: spine[i].x - normal.x * half,\n      y: spine[i].y - normal.y * half,\n    });\n  }\n  const back = right.slice().reverse();\n\n  return `M ${left[0].x} ${left[0].y} ${curveSegments(left)} L ${back[0].x} ${back[0].y} ${curveSegments(back)} Z`;\n}\n\n\n            \n\nconst SAMPLES_PER_LAP = 48;\nconst NOISE = 0.035;\nconst CENTRE = 0.02;\n\n                                      \n                \n                 \n                      \n                \n                    \n                   \n                 \n                \n                  \n                    \n  \n\nfunction scribbleCircleCentre(\n  width        ,\n  height        ,\n  seed = \"scribble\",\n)             {\n  return {\n    x: width / 2 + hashRange(`${seed}:cx`, -CENTRE, CENTRE) * width,\n    y: height / 2 + hashRange(`${seed}:cy`, -CENTRE, CENTRE) * height,\n  };\n}\n\nfunction scribbleCirclePoints(args   \n                \n                 \n                \n                \n                  \n )               {\n  const laps = args.laps ?? 1.15;\n  const seed = args.seed ?? \"scribble\";\n  const points = args.points ?? SAMPLES_PER_LAP;\n\n  const count = Math.max(2, Math.ceil(laps * points));\n  const rx = args.width / 2;\n  const ry = args.height / 2;\n  const { x: cx, y: cy } = scribbleCircleCentre(args.width, args.height, seed);\n\n  return Array.from({ length: count }, (_, i) => {\n    const angle = laps * Math.PI * 2 * (i / (count - 1));\n    const scale = 1 + hashRange(`${seed}:r${i}`, -NOISE, NOISE);\n    return {\n      x: cx + rx * scale * Math.cos(angle),\n      y: cy + ry * scale * Math.sin(angle),\n    };\n  });\n}\n\nfunction scribbleCirclePath(args                        )   \n            \n                  \n                  \n                  \n  {\n  const grain = args.grain ?? 1;\n  const reach = brushReach(args.strokeWidth, grain);\n  const marginX = reach + (args.width / 2) * NOISE + args.width * CENTRE;\n  const marginY = reach + (args.height / 2) * NOISE + args.height * CENTRE;\n\n  return {\n    d: brushRibbon(scribbleCirclePoints(args), {\n      strokeWidth: args.strokeWidth,\n      pressure: args.pressure,\n      release: args.release,\n      progress: args.progress,\n    }),\n    viewBox: `${-marginX} ${-marginY} ${args.width + marginX * 2} ${args.height + marginY * 2}`,\n    marginX,\n    marginY,\n  };\n}\n\nfunction scribbleCircleProgress(\n  frame        ,\n  options                                                            ,\n)         {\n  const delay = options?.delay ?? 0;\n  const durationSteps = options?.durationSteps ?? 10;\n  const step = options?.step ?? DEFAULT_STEP;\n  return steppedRamp(frame, delay, delay + durationSteps * step, { step });\n}\n\n\n            var plans = [{ name: \"Hobby\", price: \"Free\" }, { name: \"Pro\", price: \"$19\" }, { name: \"Team\", price: \"$49\" }];\n            try {\n              var parsed = JSON.parse(str(vars.plans, \"\"));\n              if (Array.isArray(parsed) && parsed.length > 0) plans = parsed.slice(0, 10).map(function (p) { return { name: String(p.name == null ? \"\" : p.name), price: String(p.price == null ? \"\" : p.price) }; });\n            } catch (e) {}\n            var target = Math.min(plans.length - 1, Math.round(num(vars.target, 1, 0, 9)));\n            var laps = num(vars.laps, 1.15, 0.5, 3), strokeWidth = num(vars.stroke_width, 14, 2, 30), pressure = num(vars.pressure, 0.2, 0.05, 1);\n            var grain = num(vars.grain, 1, 0, 2), durationSteps = Math.round(num(vars.duration_steps, 10, 3, 30));\n            var color = str(vars.color, \"#6f7f35\"), seed = str(vars.seed, \"scribble\"), step = Math.round(num(vars.step, 3, 1, 6));\n            var card = document.getElementById(\"scc-card\"), mark = document.getElementById(\"scc-mark\");\n            plans.forEach(function (p, i) {\n              var row = document.createElement(\"div\");\n              row.id = \"scc-row-\" + i;\n              row.className = \"scc-row\";\n              row.innerHTML = '<span class=\"scc-name\"></span><span class=\"scc-price\"></span>';\n              row.firstChild.textContent = p.name;\n              row.lastChild.textContent = p.price;\n              card.insertBefore(row