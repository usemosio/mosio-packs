   "content": "<!doctype html>\n<!--\n  Tiny Planet\n\n  A seeded flat skyline bends into a tiny planet through a polar remap, then keeps turning beside a red sun.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/tiny-planet/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"tiny-planet\"\n  data-composition-duration=\"3.333\"\n  data-composition-variables='[\n    {\"id\": \"buildings\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Buildings\", \"description\": \"Buildings in the front row; the back row gets a matching count.\", \"default\": 26, \"min\": 4, \"max\": 60, \"step\": 1},\n    {\"id\": \"seed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Seed\", \"description\": \"Seed for the skyline.\", \"default\": 4, \"min\": 1, \"max\": 99, \"step\": 1},\n    {\"id\": \"spin\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Spin\", \"description\": \"Planet spin once bent, in degrees per frame at 30 fps.\", \"default\": 0.7, \"min\": -3, \"max\": 3, \"step\": 0.05},\n    {\"id\": \"sky_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Sky\", \"description\": \"Sky color.\", \"default\": \"#111111\"},\n    {\"id\": \"ground_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Ground\", \"description\": \"Ground color.\", \"default\": \"#262626\"},\n    {\"id\": \"building_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Buildings\", \"description\": \"Front-row building color.\", \"default\": \"#FFFFFF\"},\n    {\"id\": \"far_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Far buildings\", \"description\": \"Back-row building color.\", \"default\": \"#6B6B6B\"},\n    {\"id\": \"window_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Windows\", \"description\": \"Window color.\", \"default\": \"#111111\"},\n    {\"id\": \"sun_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Sun\", \"description\": \"Sun color.\", \"default\": \"#E5322D\"},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed multiplier.\", \"default\": 1, \"min\": 0.25, \"max\": 3, \"step\": 0.05}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Tiny Planet</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: var(--sky); }\n        .tp-stage { position: absolute; inset: 0; overflow: hidden; }\n        .tp-svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"tiny-planet\" data-duration=\"3.333\" data-fps=\"30\">\n        <div id=\"tp-clip\" class=\"tp-stage clip\" data-start=\"0\" data-duration=\"3.333\" data-track-index=\"0\">\n          <svg class=\"tp-svg\" id=\"tp-svg\"></svg>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var NAME = \"tiny-planet\";\n\nvar root = document.getElementById(\"root\");\nvar vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\nfunction num(v, f, min, max) { var n = Number(v); return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : f; }\nfunction str(v, f) { return typeof v === \"string\" && v.trim() ? v : f; }\nfunction col(v, f) { return typeof v === \"string\" && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v.trim()) ? v.trim() : f; }\nfunction bool(v, f) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : f; }\nvar FPS = 30;\nvar DUR = parseFloat(root.dataset.duration || \"2\");\nvar TOTAL = Math.round(DUR * FPS);\nfunction lerp(a, b, t) { return a + (b - a) * t; }\nfunction cl(x, a, b) { return Math.min(b, Math.max(a, x)); }\n// interpolate(x, [in...], [out...], easing): clamped on both sides, easing applied per segment.\nfunction interp(x, inp, out, easing) {\n  if (x <= inp[0]) return out[0];\n  if (x >= inp[inp.length - 1]) return out[out.length - 1];\n  var i = 0;\n  while (x > inp[i + 1]) i++;\n  var t = (x - inp[i]) / (inp[i + 1] - inp[i]);\n  if (easing) t = easing(t);\n  return out[i] + (out[i + 1] - out[i]) * t;\n}\nfunction bez(x1, y1, x2, y2) {\n  return function (x) {\n    if (x <= 0) return 0; if (x >= 1) return 1;\n    var t = x;\n    for (var i = 0; i < 8; i++) {\n      var cx = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t - x;\n      var d = 3 * x1 * (1 - t) * (1 - t) - 6 * x1 * t * (1 - t) + 6 * x2 * t * (1 - t) - 3 * x2 * t * t + 3 * t * t;\n      if (Math.abs(cx) < 1e-6 || Math.abs(d) < 1e-6) break;\n      t -= cx / d;\n    }\n    t = cl(t, 0, 1);\n    return 3 * y1 * t * (1 - t) * (1 - t) + 3 * y2 * t * t * (1 - t) + t * t * t;\n  };\n}\nvar E = {\n  lin: function (t) { return t; },\n  quad: function (t) { return t * t; },\n  cubic: function (t) { return t * t * t; },\n  sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); }\n};\nfunction eOut(f) { return function (t) { return 1 - f(1 - t); }; }\nfunction eInOut(f) { return function (t) { return t < 0.5 ? f(2 * t) / 2 : 1 - f(2 - 2 * t) / 2; }; }\nvar outCubic = eOut(E.cubic), outQuad = eOut(E.quad), inCubic = E.cubic, inQuad = E.quad;\nvar inOutCubic = eInOut(E.cubic), inOutQuad = eInOut(E.quad), inOutSin = eInOut(E.sin), outSin = eOut(E.sin);\n// Damped spring from 0 to 1 (rest at 1, no initial velocity), frames at 30 fps.\nfunction spring(frame, cfg) {\n  if (frame <= 0) return 0;\n  var m = cfg.mass || 1, k = cfg.stiffness, c = cfg.damping;\n  var w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m)), t = frame / FPS;\n  if (z < 1) {\n    var wd = w0 * Math.sqrt(1 - z * z);\n    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n  }\n  if (z === 1) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n  var s = w0 * Math.sqrt(z * z - 1), r1 = -z * w0 + s, r2 = -z * w0 - s;\n  return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n}\n// Seeded random: same string in, same number out.\nfunction rnd(seed) {\n  var sd = String(seed), h = 1779033703 ^ sd.length;\n  for (var i = 0; i < sd.length; i++) { h = Math.imul(h ^ sd.charCodeAt(i), 3432918353); h = (h << 13) | (h >>> 19); }\n  h = Math.imul(h ^ (h >>> 16), 2246822507); h = Math.imul(h ^ (h >>> 13), 3266489909); h ^= h >>> 16;\n  var a = (h >>> 0);\n  a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a);\n  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n}\nfunction rgb(h) {\n  h = h.replace(\"#\", \"\");\n  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];\n  return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];\n}\nfunction mixc(a, b, t) {\n  var x = rgb(a), y = rgb(b);\n  return \"rgb(\" + Math.round(lerp(x[0], y[0], t)) + \",\" + Math.round(lerp(x[1], y[1], t)) + \",\" + Math.round(lerp(x[2], y[2], t)) + \")\";\n}\nfunction rgba(h, a) { var x = rgb(h); return \"rgba(\" + x[0] + \",\" + x[1] + \",\" + x[2] + \",\" + a + \")\"; }\nvar SVGNS = \"http://www.w3.org/2000/svg\";\nfunction svgEl(tag, attrs, parent) {\n  var e = document.createElementNS(SVGNS, tag);\n  for (var k in attrs) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n}\nfunction setA(e, attrs) { for (var k in attrs) e.setAttribute(k, attrs[k]); }\n// Drive draw(frame) from the timeline; frames run 0..frames over frames/30 seconds.\nfunction drive(draw, frames) {\n  var tl = gsap.timeline({ paused: true });\n  var clock = { frame: 0 };\n  tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n  draw(0);\n  return tl;\n}\nfunction finish(tl) {\n  if (tl.duration() < DUR) tl.to({}, { duration: DUR - tl.duration() });\n  tl.seek(0);\n  window.__timelines = window.__timelines || {};\n  window.__timelines[NAME] = tl;\n}\n\n\nvar svg = document.getElementById(\"tp-svg\");\nvar buildings = Math.max(4, Math.round(num(vars.buildings, 26, 4, 60))), seed = Math.round(num(vars.seed, 4, 1, 99)), spin = num(vars.spin, 0.7, -3, 3), speed = num(vars.speed, 1, 0, 4);\nvar C = { sky: col(vars.sky_color, \"#111111\"), ground: col(vars.ground_color, \"#262626\"), near: col(vars.building_color, \"#FFFFFF\"), far: col(vars.far_color, \"#6B6B6B\"), win: col(vars.window_color, \"#111111\"), sun: col(vars.sun_color, \"#E5322D\") };\nroot.style.setProperty(\"--sky\", C.sky);\nvar W = root.clientWidth, H = root.clientHeight;\n// Sizes use a unit that stays inside tall frames; positions use the frame height.\nvar U = Math.min(H, W * 0.5625);\nsvg.setAttribute(\"viewBox\", \"0 0 \" + W + \" \" + H);\nvar BEND_START = 8, BEND_END = 40, SPIN_RAMP = 14;\nvar length = W, radius = length / (2 * Math.PI);\n// Seeded skyline: a back row and a front row of blocks along the strip.\nvar city = [];\n[1, 0].forEach(function (row) {\n  var n = row === 1 ? Math.round(buildings * 0.8) : buildings, slot = length / n;\n  for (var i = 0; i < n; i++) {\n    var key = \"tiny-planet-\" + seed + \"-\" + row + \"-\" + i;\n    var w = slot * (0.55 + rnd(key + \"-w\") * 0.4);\n    var start = i * slot + rnd(key + \"-x\") * (slot - w) + (row ? slot * 0.5 : 0);\n    var tall = rnd(key + \"-h\");\n    var h = row ? U * (0.13 + tall * 0.16) : U * (0.05 + tall * tall * 0.15);\n    var spire = rnd(key + \"-s\") < 0.18 ? U * 0.04 : 0;\n    city.push({ s0: start - length / 2, s1: start + w - length / 2, h: h, row: row, spire: spire, idx: i });\n  }\n});\nvar sunEl = svgEl(\"circle\", { fill: C.sun }, svg);\ncity.forEach(function (b) {\n  b.el = svgEl(\"path\", { fill: b.row ? C.far : C.near, stroke: b.row ? C.far : C.near }, svg);\n  b.cells = [];\n  if (!b.row && b.h >= U * 0.09) {\n    var cols = Math.max(1, Math.floor((b.s1 - b.s0) / (U * 0.03))), rows = Math.floor(b.h / (U * 0.04));\n    for (var r = 0; r < rows; r++) for (var c = 0; c < cols; c++) {\n      if (rnd(\"tiny-planet-\" + seed + \"-win-\" + b.idx + \"-\" + r + \"-\" + c) < 0.55) continue;\n      b.cells.push([b.s0 + ((b.s1 - b.s0) * (c + 0.5)) / cols, b.h - U * 0.03 - r * U * 0.04]);\n    }\n    b.win = svgEl(\"path\", { fill: C.win }, svg);\n  }\n});\nvar groundEl = svgEl(\"path\", { fill: C.ground }, svg);\nvar tallest = U * 0.33, finalScale = (U * 0.43) / (radius + tallest);\nvar bendEase = inOutCubic;\nfunction draw(frame) {\n  var t = frame * speed;\n  var bend = interp(t, [BEND_START, BEND_END], [0, 1], bendEase);\n  var spinT = Math.max(0, t - (BEND_END - SPIN_RAMP));\n  var turn = spinT < SPIN_RAMP ? (spin * spinT * spinT) / (2 * SPIN_RAMP) : spin * (spinT - SPIN_RAMP / 2);\n  var rot = (turn * Math.PI) / 180;\n  var kappa = Math.max(1e-5, bend / radius);\n  var horizon = H * 0.7;\n  var scale = 1 + (finalScale - 1) * bend;\n  var anchorY = horizon + (H / 2 - finalScale * radius - horizon) * bend;\n  // Bend: arc length s and height h onto a circle of curvature kappa whose top sits at the pivot.\n  function P(s, h) {\n    var a = kappa * s + rot * bend, rr = 1 / kappa + h;\n    return (W / 2 + Math.sin(a) * rr * scale).toFixed(1) + \",\" + (anchorY + (1 / kappa - Math.cos(a) * rr) * scale).toFixed(1);\n  }\n  var steps = 160, depth = Math.min(1 / kappa, U * 3), g = \"\";\n  for (var i = 0; i <= steps; i++) g += (i ? \"L\" : \"M\") + P(-length / 2 + (length * i) / steps, 0);\n  for (i = steps; i >= 0; i--) g += \"L\" + P(-length / 2 + (length * i) / steps, -depth);\n  groundEl.setAttribute(\"d\", g);\n  setA(sunEl, { cx: lerp(W * 0.7, W * 0.8, bend), cy: lerp(H * 0.36, H * 0.2, bend), r: U * lerp(0.12, 0.075, bend) });\n  city.forEach(function (b) {\n    var top = [];\n    for (var k = 0; k <= 4; k++) top.push(P(b.s0 + ((b.s1 - b.s0) * k) / 4, b.h));\n    var mid = (b.s0 + b.s1) / 2;\n    var spire = b.spire ? \" M\" + P(mid - 1.5, b.h) + \" L\" + P(mid, b.h + b.spire) + \" L\" + P(mid + 1.5, b.h) : \"\";\n    b.el.setAttribute(\"d\", \"M\" + P(b.s0, -2) + \" L\" + top.join(\" L\") + \" L\" + P(b.s1, -2) + \" Z\" + spire);\n    b.el.setAttribute(\"stroke-width\", b.spire ? 2 * scale : 0);\n    if (b.win) {\n      var ws = U * 0.006;\n      b.win.setAttribute(\"d\", b.cells.map(function (c) { return \"M\" + P(c[0] - ws, c[1]) + \" L\" + P(c[0] + ws, c[1]) + \" L\" + P(c[0] + ws, c[1] - ws * 2.2) + \" L\" + P(c[0] - ws, c[1] - ws * 2.2) + \" Z\"; }).join(\" \"));\n    }\n  });\n}\nfinish(drive(draw, TOTAL));\n\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
