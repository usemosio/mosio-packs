 "files": [
  {
   "path": "SCENE.md",
   "role": "instructions",
   "content": "# Handwritten Title\n\nHandwritten display text with a word-by-word highlight sweep, a seeded squiggle underline that matches the text width, and a hand-drawn boil.\n\nCategory: typography. Length: 6 s. WebGL: no.\n\nUse when:\n- A short motivational line, caption or title that should feel written by hand over footage or a dark board.\n- You want the words to light up in reading order and finish with an underline.\n\nAvoid when:\n- The text is a long paragraph: this is a one-to-two-line title.\n- You want letters written stroke by stroke: use handwrite or handwriting-text.\n\nVariables:\n- text (string): Text, default \"shine like the star you are\"\n- font_size (number, 24-260): Font size, default 120\n- ink (color): Ink, default \"#f4f2ec\"\n- underline_color (color): Underline color, default \"#ffb020\"\n- sweep (boolean): Highlight sweep, default true\n- sweep_start (number, 0-4): Sweep start, default 0.8\n- sweep_end (number, 0.2-5.5): Sweep end, default 3.2\n- underline (boolean): Underline, default true\n- wobble (number, 0-14): Squiggle wobble, default 6\n- boil (boolean): Boil, default true\n- boil_amount (number, 0-6): Boil amount, default 1.4\n- seed (number, 1-99): Seed, default 8\n\nSource: heygen-com/hyperframes. Licence: Apache-2.0. The scene file keeps the upstream notice.\n"
  },
  {
   "path": "scene.html",
   "role": "source",
   "content": "<!doctype html>\n<!--\n  Handwritten Title\n\n  Handwritten display text with a word-by-word highlight sweep, a seeded squiggle underline that matches the text width, and a hand-drawn boil.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/heygen-com/hyperframes/blob/bd6cff8157a1a0ed5075527e673cc4f321fe9123/registry/blocks/hw-title/hw-title.html\n\n  Copyright HeyGen, Inc. and the Hyperframes contributors. Licensed under the Apache License, Version\n  2.0 (the \"License\"); you may not use this file except in compliance with the License. You may obtain\n  a copy of the License at http://www.apache.org/licenses/LICENSE-2.0. Unless required by applicable\n  law or agreed to in writing, software distributed under the License is distributed on an \"AS IS\"\n  BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for\n  the specific language governing permissions and limitations under the License.\n\n  Changes by usemosio/blocks: the Caveat font file becomes the same family from Google Fonts, the stage fills the host frame (the text wraps and shrinks on a narrow frame, the underline stretches to the text width and reveals with a wipe), the family's shared helper functions are inlined, and the settings are variables. The overlay stays transparent; the demo supplies a dark plate.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"hw-title\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[\n    {\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Text\", \"description\": \"The handwritten line. It wraps on a narrow frame.\", \"default\": \"shine like the star you are\"},\n    {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Maximum text size in pixels; it shrinks on a narrow frame.\", \"default\": 120, \"min\": 24, \"max\": 260, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"ink\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Ink\", \"description\": \"Color of the text once the highlight has passed.\", \"default\": \"#f4f2ec\"},\n    {\"id\": \"underline_color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Underline color\", \"description\": \"Color of the squiggle underline.\", \"default\": \"#ffb020\"},\n    {\"id\": \"sweep\", \"type\": \"boolean\", \"role\": \"motion\", \"label\": \"Highlight sweep\", \"description\": \"Words light up one after another.\", \"default\": true},\n    {\"id\": \"sweep_start\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Sweep start\", \"description\": \"Second the highlight starts.\", \"default\": 0.8, \"min\": 0, \"max\": 4, \"step\": 0.05, \"unit\": \"s\"},\n    {\"id\": \"sweep_end\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Sweep end\", \"description\": \"Second the highlight finishes.\", \"default\": 3.2, \"min\": 0.2, \"max\": 5.5, \"step\": 0.05, \"unit\": \"s\"},\n    {\"id\": \"underline\", \"type\": \"boolean\", \"role\": \"style\", \"label\": \"Underline\", \"description\": \"Draw a squiggle under the text.\", \"default\": true},\n    {\"id\": \"wobble\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Squiggle wobble\", \"description\": \"How wavy the underline is.\", \"default\": 6, \"min\": 0, \"max\": 14, \"step\": 0.5},\n    {\"id\": \"boil\", \"type\": \"boolean\", \"role\": \"motion\", \"label\": \"Boil\", \"description\": \"Jitter the whole line a little every third frame, like a hand-drawn loop.\", \"default\": true},\n    {\"id\": \"boil_amount\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Boil amount\", \"description\": \"How far the line jitters, in pixels.\", \"default\": 1.4, \"min\": 0, \"max\": 6, \"step\": 0.1, \"unit\": \"px\"},\n    {\"id\": \"seed\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Seed\", \"description\": \"Changes the squiggle and the jitter pattern.\", \"default\": 8, \"min\": 1, \"max\": 99, \"step\": 1}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Handwritten Title</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Caveat:wght@700&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n          font-family: \"Caveat\", cursive;\n        }\n        .hwt-stage {\n          position: absolute;\n          inset: 0;\n          display: flex;\n          align-items: center;\n          justify-content: center;\n        }\n        #hwt-wrap {\n          position: relative;\n          max-width: 90cqw;\n          text-align: center;\n          margin-top: -2cqmin;\n        }\n        #hwt-line {\n          font-weight: 700;\n          line-height: 1.1;\n          text-shadow: 0 2px 18px rgba(0, 0, 0, 0.4);\n        }\n        #hwt-line .hwt-w { display: inline; }\n        #hwt-under {\n          display: block;\n          width: 100%;\n          height: 0.3em;\n          overflow: visible;\n        }\n        #hwt-under path {\n          fill: none;\n          stroke-width: 7;\n          stroke-linecap: round;\n          vector-effect: non-scaling-stroke;\n        }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"hw-title\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"hwt-clip\" class=\"hwt-stage clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\">\n          <div id=\"hwt-wrap\">\n            <div id=\"hwt-line\"></div>\n            <svg id=\"hwt-under\" viewBox=\"0 0 600 34\" preserveAspectRatio=\"none\"><path id=\"hwt-under-path\" d=\"\"></path></svg>\n          </div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value.trim() ? value : fallback;\n            }\n            function bool(value, fallback) {\n              if (value === true || value === \"true\") return true;\n              if (value === false || value === \"false\") return false;\n              return fallback;\n            }\n            function hex(value, fallback) {\n              return typeof value === \"string\" && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(value.trim()) ? value.trim() : fallback;\n            }\n            function rgba(h, a) {\n              if (h.length === 4) h = \"#\" + h[1] + h[1] + h[2] + h[2] + h[3] + h[3];\n              return \"rgba(\" + parseInt(h.slice(1, 3), 16) + \",\" + parseInt(h.slice(3, 5), 16) + \",\" + parseInt(h.slice(5, 7), 16) + \",\" + a + \")\";\n            }\n            function hash(n, seed) {\n              var x = Math.sin(n * 127.1 + (seed || 1) * 311.7) * 43758.5453;\n              return (x - Math.floor(x)) * 2 - 1;\n            }\n\n            var DUR = 6;\n            var text = str(vars.text, \"shine like the star you are\");\n            var fontSize = num(vars.font_size, 120, 24, 260);\n            var ink = hex(vars.ink, \"#f4f2ec\");\n            var accent = hex(vars.underline_color, \"#ffb020\");\n            var sweepOn = bool(vars.sweep, true);\n            var sweepStart = num(vars.sweep_start, 0.8, 0, 4);\n            var sweepEnd = Math.max(sweepStart + 0.2, num(vars.sweep_end, 3.2, 0.2, 5.5));\n            var underOn = bool(vars.underline, true);\n            var wobble = num(vars.wobble, 6, 0, 14);\n            var boilOn = bool(vars.boil, true);\n            var boilAmp = num(vars.boil_amount, 1.4, 0, 6);\n            var seed = num(vars.seed, 8, 1, 99);\n\n            var wrap = document.getElementById(\"hwt-wrap\");\n            var line = document.getElementById(\"hwt-line\");\n            var under = document.getElementById(\"hwt-under\");\n            var underPath = document.getElementById(\"hwt-under-path\");\n            // Shrink the type on a narrow frame so a long phrase wraps to at most three lines.\n            var size = Math.min(fontSize, root.clientWidth * 0.14);\n            line.style.fontSize = size + \"px\";\n            under.style.stroke = accent;\n            underPath.style.stroke = accent;\n\n            var FULL = ink, FAINT = rgba(ink, 0.32);\n            var words = [];\n            text.split(/\\s+/).forEach(function (w, i) {\n              if (i > 0) line.appendChild(document.createTextNode(\" \"));\n              var span = document.createElement(\"span\");\n              span.className = \"hwt-w\";\n              span.textContent = w;\n              span.style.color = sweepOn ? FAINT : FULL;\n              line.appendChild(span);\n              words.push(span);\n            });\n\n            // Seeded squiggle, drawn in a 600-wide box that stretches to the width of the text.\n            var segs = 7, uw = 600;\n            var d = \"M 2 \" + (16 + hash(0, seed) * 4).toFixed(1);\n            for (var i = 1; i <= segs; i++) {\n              var x = (uw / segs) * i;\n              var y = 16 + hash(i * 5 + 1, seed) * wobble;\n              var cx = x - uw / segs / 2 + hash(i * 5 + 2, seed) * 10;\n              var cy = 16 + (i % 2 ? -1 : 1) * (8 + hash(i * 5 + 3, seed) * 4);\n              d += \" Q \" + cx.toFixed(1) + \" \" + cy.toFixed(1) + \" \" + x.toFixed(1) + \" \" + y.toFixed(1);\n            }\n            underPath.setAttribute(\"d\", d);\n            if (!underOn) under.style.display = \"none\";\n\n            var IN = Math.min(0.8, Math.max(0.3, DUR * 0.08));\n            var OUT = Math.min(0.6, Math.max(0.25, DUR * 0.06));\n            var tl = gsap.timeline({ paused: true });\n            gsap.set(wrap, { opacity: 0 });\n            tl.to(wrap, { opacity: 1, duration: IN, ease: \"power2.out\" }, 0.1);\n\n            var sw = { p: 0 };\n            var fadeAt = DUR - OUT - 0.05;\n            function update() {\n              if (sweepOn) {\n                var k = sw.p * words.length;\n                for (var j = 0; j < words.length; j++) {\n                  var f = Math.max(0, Math.min(1, k - j));\n                  words[j].style.color = f >= 1 ? FULL : f <= 0 ? FAINT : mix(f);\n                }\n              }\n              if (boilOn) {\n                var step = Math.floor((tl.time() * 30) / 3);\n                gsap.set(wrap, { x: hash(step * 3, seed) * boilAmp, y: hash(step * 3 + 1, seed) * boilAmp, rotation: hash(step * 3 + 2, seed) * boilAmp * 0.22 });\n              }\n            }\n            var mix = gsap.utils.interpolate(FAINT, rgba(ink, 1));\n            if (sweepOn) tl.to(sw, { p: 1, duration: sweepEnd - sweepStart, ease: \"none\" }, sweepStart);\n            if (underOn) {\n              var uAt = sweepOn ? sweepEnd - 0.2 : 0.8;\n              tl.fromTo(under, { clipPath: \"inset(-12px 100% -12px -4px)\" }, { clipPath: \"inset(-12px -4px -12px -4px)\", duration: 0.7, ease: \"power2.inOut\", immediateRender: true }, uAt);\n            }\n            tl.eventCallback(\"onUpdate\", update);\n            tl.to(wrap, { opacity: 0, duration: OUT, ease: \"power2.in\" }, fadeAt);\n            tl.set({}, {}, DUR);\n            update();\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"hw-title\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
 "sha256": "2b918feae6fe4af03b64d11e437d8d712c5f907066cece7128fb5ba8b4820983",
