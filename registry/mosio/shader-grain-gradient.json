* (1.0 - opacity);\",\n              \"  opacity = opacity + u_colorBack.a * (1.0 - opacity);\",\n              \"  fragColor = vec4(color, opacity);\",\n              \"}\"\n            ].join(\"\\n\");\n\n            // Paper ships its 128×128 noise texture as a PNG. The same kind of texture is made here\n            // from a seeded generator: white noise per channel with Paper's value spread (about\n            // 30 % of texels near 0, 20 % near 1, the rest even), so nothing is loaded.\n            function noiseTexture() {\n              var seed = 0x2f6b9a1d;\n              function rand() {\n                seed = (seed + 0x6d2b79f5) | 0;\n                var t = Math.imul(seed ^ (seed >>> 15), 1 | seed);\n                t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n                return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n              }\n              var data = new Uint8Array(128 * 128 * 4);\n              for (var i = 0; i < data.length; i++) {\n                if (i % 4 === 3) { data[i] = 255; continue; }\n                var u = rand();\n                data[i] = Math.floor(u < 0.3 ? rand() * 16 : u < 0.5 ? 240 + rand() * 16 : 16 + rand() * 224);\n              }\n              return data;\n            }\n\n            // The canvas is drawn at `resolution` × the frame size and stretched to fill it.\n            var frameWidth = Math.max(2, root.clientWidth);\n            var frameHeight = Math.max(2, root.clientHeight);\n            var width = Math.max(2, Math.round(frameWidth * resolution));\n            var height = Math.max(2, Math.round(frameHeight * resolution));\n            canvas.width = width;\n            canvas.height = height;\n            var gl = canvas.getContext(\"webgl2\", { antialias: false, depth: false, stencil: false, preserveDrawingBuffer: true });\n\n            function compile(type, source) {\n              var s = gl.createShader(type);\n              gl.shaderSource(s, source);\n              gl.compileShader(s);\