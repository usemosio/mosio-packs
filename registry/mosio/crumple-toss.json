   "content": "<!doctype html>\n<!--\n  Crumple Toss\n\n  A card crumples into a paper wad in stop-motion poses and is tossed into a bin: the old way, thrown away.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/crumple-toss/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"crumple-toss\"\n  data-composition-duration=\"3\"\n  data-composition-variables='[{\"id\":\"card_title\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Card title\",\"description\":\"Small line on the card.\",\"default\":\"How it used to work\"},{\"id\":\"card_body\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Card text\",\"description\":\"Large line on the card.\",\"default\":\"Six steps and a wiki page\"},{\"id\":\"at\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Start frame\",\"description\":\"Frame (30 fps) where the crumple begins.\",\"default\":6,\"min\":0,\"max\":60,\"step\":1,\"unit\":\"frames\"},{\"id\":\"crumple_steps\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Crumple poses\",\"description\":\"Number of poses the crumple takes.\",\"default\":4,\"min\":1,\"max\":10,\"step\":1},{\"id\":\"toss_steps\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Toss poses\",\"description\":\"Number of poses the toss takes.\",\"default\":5,\"min\":1,\"max\":12,\"step\":1},{\"id\":\"direction\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Direction\",\"description\":\"Launch angle of the toss in degrees (negative is up and to the right).\",\"default\":-35,\"min\":-180,\"max\":180,\"step\":1,\"unit\":\"deg\"},{\"id\":\"distance\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Distance\",\"description\":\"How far the wad is thrown, at design size.\",\"default\":440,\"min\":100,\"max\":900,\"step\":5,\"unit\":\"px\"},{\"id\":\"spin\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Spin\",\"description\":\"Degrees the wad turns in flight.\",\"default\":220,\"min\":-720,\"max\":720,\"step\":5,\"unit\":\"deg\"},{\"id\":\"segments\",\"type\":\"number\",\"role\":\"layout\",\"label\":\"Segments\",\"description\":\"Number of folded wedges.\",\"default\":9,\"min\":3,\"max\":16,\"step\":1},{\"id\":\"layers\",\"type\":\"number\",\"role\":\"layout\",\"label\":\"Layers\",\"description\":\"Rings of wedges from the middle outwards.\",\"default\":2,\"min\":1,\"max\":4,\"step\":1},{\"id\":\"randomness\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Randomness\",\"description\":\"How irregular the folds are.\",\"default\":0.6,\"min\":0,\"max\":1,\"step\":0.05},{\"id\":\"crush_to\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Crush to\",\"description\":\"Size of the wad relative to the card.\",\"default\":0.34,\"min\":0.15,\"max\":0.8,\"step\":0.01},{\"id\":\"seed\",\"type\":\"string\",\"role\":\"motion\",\"label\":\"Seed\",\"description\":\"Seed for the folds.\",\"default\":\"toss\"},{\"id\":\"step\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Frames per pose\",\"description\":\"How many frames each pose is held.\",\"default\":3,\"min\":1,\"max\":6,\"step\":1,\"unit\":\"frames\"}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Crumple Toss</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;600&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n\n        }\n        #root { font-family: Geist, system-ui, sans-serif; }\n        .cts-stage { position: absolute; inset: 0; }\n        .cts-card { width: 380px; height: 220px; padding: 28px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; gap: 10px; background: #fdfcf8; border: 1px solid rgba(38,36,44,0.12); box-shadow: 0 8px 20px rgba(38,36,44,0.12); color: #26242c; }\n        .cts-card-title { font-size: 15px; color: rgba(38,36,44,0.55); }\n        .cts-card-body { font-size: 30px; font-weight: 600; line-height: 1.2; }\n        .cts-wad { position: absolute; left: 0; top: 0; width: 380px; height: 220px; }\n        .cts-piece { position: absolute; inset: 0; }\n        .cts-fill { position: absolute; inset: 0; }\n        .cts-shade { position: absolute; inset: 0; }\n        .cts-rim { position: absolute; border-radius: 50%; background: #bdb6a5; height: 30px; width: 150px; display: none; }\n        .cts-bin { position: absolute; width: 150px; height: 170px; clip-path: polygon(0% 0%, 100% 0%, 84% 100%, 16% 100%); background: #ded8ca; display: none; }\n        .cts-rib { position: absolute; top: 0; bottom: 0; width: 2px; background: rgba(38,36,44,0.09); }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"crumple-toss\" data-duration=\"3\" data-fps=\"30\">\n        <div id=\"cts-clip\" class=\"cts-stage clip\" data-start=\"0\" data-duration=\"3\" data-track-index=\"0\">\n          <div id=\"cts-group\" class=\"cts-group\">\n            <div id=\"cts-rim\" class=\"cts-rim\"></div>\n            <div id=\"cts-wad\" class=\"cts-wad\"></div>\n            <div id=\"cts-bin\" class=\"cts-bin\"><div class=\"cts-rib\" style=\"left:30%\"></div><div class=\"cts-rib\" style=\"left:50%\"></div><div class=\"cts-rib\" style=\"left:70%\"></div></div>\n          </div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n            \nconst DEFAULT_STEP = 3;\n\nconst qf = (frame        , step = DEFAULT_STEP)         =>\n  Math.floor(frame / step) * step;\n\nconst qstep = (frame        , step = DEFAULT_STEP)         =>\n  Math.floor(frame / step);\n\nconst hash01 = (seed        )         => {\n  let h = 2166136261;\n  for (let i = 0; i < seed.length; i++) {\n    h ^= seed.charCodeAt(i);\n    h = Math.imul(h, 16777619);\n  }\n  h = Math.imul(h ^ (h >>> 13), 2246822519);\n  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;\n};\n\nconst hashRange = (seed        , lo        , hi        )         =>\n  lo + hash01(seed) * (hi - lo);\n\n                                                           \n\nconst paperJitter = (\n  frame        ,\n  seed        ,\n  options                                                   ,\n)         => {\n  const amp = options?.amp ?? 1.4;\n  const rotAmp = options?.rotAmp ?? 0.35;\n  const s = qstep(frame, options?.step ?? DEFAULT_STEP);\n  return {\n    x: hashRange(`${seed}:x:${s}`, -amp, amp),\n    y: hashRange(`${seed}:y:${s}`, -amp, amp),\n    rot: hashRange(`${seed}:r:${s}`, -rotAmp, rotAmp),\n  };\n};\n\nconst steppedSpring = (args   \n                \n              \n                 \n                \n                                                                   \n )         =>\n  spring({\n    frame: qf(\n      Math.max(0, args.frame - (args.delay ?? 0)),\n      args.step ?? DEFAULT_STEP,\n    ),\n    fps: args.fps,\n    config: args.config,\n  });\n\nconst steppedRamp = (\n  frame        ,\n  from        ,\n  to        ,\n  options                                                  ,\n)         => {\n  const f = qf(frame, options?.step ?? DEFAULT_STEP);\n  if (f <= from) return 0;\n  if (f >= to) return 1;\n  const ease = options?.ease ?? ((t        ) => t);\n  return ease((f - from) / (to - from));\n};\n\n            \n\nconst GRAVITY = 0.9;\nconst FLIGHT_SHRINK = 0.5;\nconst EXIT_OPACITY = 0.4;\n\nconst FOLD_TILT = 46;\nconst WAD_REACH = 0.27;\nconst WAD_SPREAD = 0.07;\nconst ANGLE_JITTER = 0.22;\nconst SCALE_SPREAD = 0.25;\nconst DEFAULT_RANDOMNESS = 0.6;\nconst DEFAULT_LAYERS = 2;\nconst LAYER_TILT_FLOOR = 0.45;\nconst FACET_SIZE = 0.5;\nconst FACET_CAP = 0.5;\n\nconst TONE_PATTERN = [0, 1, 3, 1, 0, 2, 1, 2, 0];\n\nconst TONES = [\n  { lit: \"rgba(255,255,255,0.66)\", dark: \"rgba(255,255,255,0.18)\" },\n  { lit: \"rgba(255,255,255,0.30)\", dark: \"rgba(38,36,44,0.10)\" },\n  { lit: \"rgba(255,255,255,0.08)\", dark: \"rgba(38,36,44,0.20)\" },\n  { lit: \"rgba(38,36,44,0.06)\", dark: \"rgba(38,36,44,0.30)\" },\n];\n\nconst LIGHT_ANGLE = -55;\nconst CREASE_BLEND = 9;\n\n                                                                \n\n                           \n                      \n                \n                \n                 \n            \n            \n                  \n  \n\n                              \n                           \n                           \n             \n             \n                \n                 \n               \n                 \n  \n\n                                 \n             \n                        \n                     \n                     \n                    \n                \n                   \n                \n                \n  \n\nconst rayToEdge = (\n  angle        ,\n  halfWidth        ,\n  halfHeight        ,\n)                   => {\n  const cos = Math.cos(angle);\n  const sin = Math.sin(angle);\n  const t = Math.min(\n    halfWidth / (Math.abs(cos) || 1e-9),\n    halfHeight / (Math.abs(sin) || 1e-9),\n  );\n  return [cos * t, sin * t];\n};\n\nconst normalize = (angle        ) => {\n  const turn = Math.PI * 2;\n  return ((angle % turn) + turn) % turn;\n};\n\nconst shrinkToward = (\n  [x, y]                  ,\n  factor        ,\n)                   => [x * factor, y * factor];\n\nconst averageOf = (points                    )                   => [\n  points.reduce((sum, p) => sum + p[0], 0) / points.length,\n  points.reduce((sum, p) => sum + p[1], 0) / points.length,\n];\n\nfunction crumpleSegments(args   \n                \n                 \n                    \n                  \n                   \n                      \n                \n )                   {\n  const count = Math.max(3, Math.round(args.segments ?? 9));\n  const layers = Math.max(1, Math.round(args.layers ?? DEFAULT_LAYERS));\n  const crushTo = args.crushTo ?? 0.34;\n  const chaos = Math.min(1, Math.max(0, args.randomness ?? DEFAULT_RANDOMNESS));\n  const seed = args.seed ?? \"toss\";\n  const halfWidth = args.width / 2;\n  const halfHeight = args.height / 2;\n  const wad = Math.min(args.width, args.height) * crushTo;\n\n  const angles = Array.from(\n    { length: count },\n    (_, i) =>\n      (i / count) * Math.PI * 2 +\n      hashRange(`${seed}:ang${i}`, -ANGLE_JITTER, ANGLE_JITTER) * chaos,\n  );\n\n  const corners                     = [\n    [halfWidth, halfHeight],\n    [-halfWidth, halfHeight],\n    [-halfWidth, -halfHeight],\n    [halfWidth, -halfHeight],\n  ];\n\n  const toPercent = ([x, y]                  )                   => [\n    ((x + halfWidth) / args.width) * 100,\n    ((y + halfHeight) / args.height) * 100,\n  ];\n\n  const panels                   = [];\n\n  angles.forEach((angle, i) => {\n    const nextAngle =\n      angles[(i + 1) % count] + (i === count - 1 ? Math.PI * 2 : 0);\n    const from = rayToEdge(angle, halfWidth, halfHeight);\n    const to = rayToEdge(nextAngle, halfWidth, halfHeight);\n\n    const span = normalize(nextAngle - angle);\n    const between = corners\n      .map((corner)                             => [\n        corner,\n        normalize(Math.atan2(corner[1], corner[0]) - angle),\n      ])\n      .filter(([, spanned]) => spanned > 0 && spanned < span)\n      .sort((a, b) => a[1] - b[1])\n      .map(([corner]) => corner);\n\n    const rim                     = [from, ...between, to];\n\n    for (let layer = 0; layer < layers; layer++) {\n      const inner = layer / layers;\n      const outer = (layer + 1) / layers;\n      const depth = (layer + 1) / layers;\n      const shape                     =\n        layer === 0\n          ? [[0, 0], ...rim.map((point) => shrinkToward(point, outer))]\n          : [\n              ...rim.map((point) => shrinkToward(point, outer)),\n              ...[...rim].reverse().map((point) => shrinkToward(point, inner)),\n            ];\n\n      const centroid = averageOf(shape);\n      const extent =\n        Math.max(\n          ...shape.map((point) =>\n            Math.hypot(point[0] - centroid[0], point[1] - centroid[1]),\n          ),\n        ) || 1;\n      const key = `${seed}:${i}:${layer}`;\n\n      const reach =\n        wad *\n        (WAD_REACH * depth +\n          hashRange(`${key}:reach`, -WAD_SPREAD, WAD_SPREAD) * chaos * depth);\n      const heading = Math.atan2(centroid[1], centroid[0]);\n\n      panels.push({\n        clip: shape.map(toPercent),\n        origin: toPercent(centroid),\n        dx: Math.cos(heading) * reach - centroid[0],\n        dy: Math.sin(heading) * reach - centroid[1],\n        scale:\n          Math.min(FACET_CAP, (wad * FACET_SIZE) / extent) *\n          (1 + hashRange(`${key}:size`, -SCALE_SPREAD, SCALE_SPREAD) * chaos),\n        rotate:\n          chaos === 0\n            ? 0\n            : hashRange(`${seed}:tilt${i}`, -FOLD_TILT, FOLD_TILT) *\n              chaos *\n              (LAYER_TILT_FLOOR + (1 - LAYER_TILT_FLOOR) * depth),\n        tone: Math.min(\n          TONES.length - 1,\n          TONE_PATTERN[panels.length % TONE_PATTERN.length] +\n            Math.ceil((1 - depth) * 2),\n        ),\n        crease: 0.5 + hashRange(`${key}:crease`, -0.2, 0.2) * chaos,\n      });\n    }\n  });\n\n  return panels;\n}\n\nfunction creaseShading(\n  piece                                                    ,\n  crush        ,\n)         {\n  const tone = TONES[piece.tone];\n  const fold = piece.crease * 100;\n  const lit = Math.max(0, fold - CREASE_BLEND).toFixed(1);\n  const dark = Math.min(100, fold + CREASE_BLEND).toFixed(1);\n  const angle = (LIGHT_ANGLE - piece.rotate * crush).toFixed(1);\n  return `linear-gradient(${angle}deg, ${tone.lit} 0%, ${tone.lit} ${lit}%, ${tone.dark} ${dark}%, ${tone.dark} 100%)`;\n}\n\nfunction crumpleTossLanding(options    \n                     \n                    \n )                           {\n  const distance = options?.distance ?? 900;\n  const radians = ((options?.direction ?? -35) * Math.PI) / 180;\n  return {\n    x: distance * Math.cos(radians),\n    y: distance * Math.sin(radians) + GRAVITY * distance,\n  };\n}\n\nfunction crumpleTossPose(\n  args                                       ,\n)              {\n  const crumpleSteps = args.crumpleSteps ?? 4;\n  const tossSteps = args.tossSteps ?? 5;\n  const direction = args.direction ?? -35;\n  const distance = args.distance ?? 900;\n  const spin = args.spin ?? 220;\n  const step = args.step ?? DEFAULT_STEP;\n\n  if (args.frame < args.at) {\n    return {\n      phase: \"idle\",\n      crush: 0,\n      scale: 1,\n      rotate: 0,\n      x: 0,\n      y: 0,\n      opacity: 1,\n    };\n  }\n\n  const pose = qstep(args.frame - args.at, step);\n\n  if (pose < crumpleSteps) {\n    return {\n      phase: \"crumple\",\n      crush: (pose + 1) / crumpleSteps,\n      scale: 1,\n      rotate: 0,\n      x: 0,\n      y: 0,\n      opacity: 1,\n    };\n  }\n\n  if (pose < crumpleSteps + tossSteps) {\n    const t = (pose - crumpleSteps + 1) / tossSteps;\n    const radians = (direction * Math.PI) / 180;\n    return {\n      phase: \"toss\",\n      crush: 1,\n      scale: 1 - FLIGHT_SHRINK * t,\n      rotate: spin * t,\n      x: distance * Math.cos(radians) * t,\n      y: distance * Math.sin(radians) * t + GRAVITY * distance * t * t,\n      opacity: t === 1 ? EXIT_OPACITY : 1,\n    };\n  }\n\n  return {\n    phase: \"gone\",\n    crush: 1,\n    scale: 0,\n    rotate: 0,\n    x: 0,\n    y: 0,\n    opacity: 0,\n  };\n}\n\n\n            var W = 380, H = 220;\n            var at = num(vars.at, 6, 0, 60), crumpleSteps = Math.round(num(vars.crumple_steps, 4, 1, 10)), tossSteps = Math.round(num(vars.toss_steps, 5, 1, 12));\n            var direction = num(vars.direction, -35, -180, 180), distance = num(vars.distance, 440, 100, 900), spin = num(vars.spin, 220, -720, 720);\n            var segments = Math.round(num(vars.segments, 9, 3, 16)), layers = Math.round(num(vars.layers, 2, 1, 4)), randomness = num(vars.randomness, 0.6, 0, 1);\n            var crushTo = num(vars.crush_to, 0.34, 0.15, 0.8), seed = str(vars.seed, \"toss\"), step = Math.round(num(vars.step, 3, 1, 6));\n            var timing = { at: at, crumpleSteps: crumpleSteps, tossSteps: tossSteps, direction: direction, distance: distance, spin: spin, crushTo: crushTo, seed: seed, step: step };\n            var cardHtml = '<div class=\"cts-card\"><div class=\"cts-card-title\"></div><div class=\"cts-card-body\"></div></div>';\n            var wad = document.getElementById(\"cts-wad\");\n            var pieces = crumpleSegments({ width: W, height: H, segments: segments, layers: layers, randomness: randomness, crushTo: crushTo, seed: seed });\n            var nodes = pieces.map(function (piece, i) {\n              var el = document.createElement(\"div\");\n              el.id = \"cts-piece-\" + i;\n              el.className = \"cts-piece\";\n              el.style.clipPath = \"polygon(\" + piece.clip.map(function (p) { return p[0] + \"% \" + p[1] + \"%\"; }).join(\", \") + \")\";\n              el.style.transformOrigin = piece.origin[0] + \"% \" + piece.origin[1] + \"%\";\n              el.innerHTML = '<div class=\"cts-fill\">' + cardHtml + '</div><div class=\"cts-shade\"></div>';\n              wad.appendChild(el);\n              return { el: el, shade: el.lastChild, piece: piece };\n            });\n            var title = str(vars.card_title, \"How it used to work\"), body = str(vars.card_body, \"Six steps and a wiki page\");\n            Array.prototype.forEach.call(wad.querySelectorAll(\".cts-card-title\"), function (e) { e.textContent = title; });\n            Array.prototype.forEach.call(wad.querySelectorAll(\".cts-card-body\"), function (e) { e.textContent = body; });\n\n            var landing = crumpleTossLanding({ direction: direction, distance: distance });\n            var binLeft = W / 2 + landing.x - 75, binTop = H / 2 + landing.y;\n            var rim = document.getElementById(\"cts-rim\"), bin = document.getElementById(\"cts-bin\");\n            var gx = Math.min(0, binLeft), gw = Math.max(W, binLeft + 150) - gx, gh = Math.max(H, binTop + 170);\n            rim.style.left = binLeft - gx + \"px\"; rim.style.top = binTop - 15 + \"px\";\n            bin.style.left = binLeft - gx + \"px\"; bin.style.top = binTop + \"px\";\n            wad.style.left = -gx + \"px\";\n            var group = document.getElementById(\"cts-group\");\n            fit(group, gw, gh, 0.9);\n            function draw(frame) {\n              var pose = crumpleTossPose(Object.assign({ frame: frame }, timing));\n              var binOut = pose.crush >= 1;\n              rim.style.display = binOut ? \"block\" : \"none\";\n              bin.style.display = binOut ? \"block\" : \"none\";\n              if (pose.phase === \"gone\") { wad.style.display = \"none\"; return; }\n              wad.style.display = \"block\";\n              var c = pose.crush;\n              wad.style.opacity = pose.opacity;\n              wad.style.transformOrigin = \"50% 50%\";\n              wad.style.transform = \"translate(\" + pose.x + \"px, \" + pose.y + \"px) rotate(\" + pose.rotate + \"deg) scale(\" + pose.scale + \")\";\n              nodes.forEach(function (n) {\n                var p = n.piece;\n                n.el.style.transform = \"translate(\" + p.dx * c + \"px, \" + p.dy * c + \"px) rotate(\" + p.rotate * c + \"deg) scale(\" + (1 + (p.scale - 1) * c) + \")\";\n                n.el.style.filter = c > 0 ? \"drop-shadow(0 0 \" + 0.6 * c + \"px rgba(38,36,44,0.55))\" : \"none\";\n                n.shade.style.background = creaseShading(p, c);\n                n.shade.style.opacity = c;\n              });\n            }\n            var tl = gsap.timeline({ paused: true });\n            clockTween(tl, 90, draw, 1);\n\n            var total = parseFloat(root.dataset.duration || \"3\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"crumple-toss\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
