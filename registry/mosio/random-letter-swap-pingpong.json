   "content": "<!doctype html>\n<!--\n  Random Letter Swap Ping-Pong\n\n  Letters swap out in a random order and, after a hold, swap back in another random-feeling wave (ping-pong).\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/danielpetho/fancy/blob/f9f62c61207b2dd3210476dd98af3c9a5be24094/src/fancy/components/text/random-letter-swap-pingpong-anim.tsx\n\n  MIT License\n\n  Copyright (c) 2024 Daniel Petho\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"random-letter-swap-pingpong\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[\n    {\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Text\", \"description\": \"Word or short phrase whose letters swap.\", \"default\": \"Letter swap\"},\n    {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Maximum text size in pixels. Longer text shrinks to fit the frame.\", \"default\": 150, \"min\": 24, \"max\": 400, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Color\", \"description\": \"Text color.\", \"default\": \"#111111\"},\n    {\"id\": \"font_weight\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Font weight\", \"description\": \"Weight of the text.\", \"default\": \"700\", \"options\": [{\"value\": \"400\", \"label\": \"Regular\"}, {\"value\": \"500\", \"label\": \"Medium\"}, {\"value\": \"600\", \"label\": \"Semibold\"}, {\"value\": \"700\", \"label\": \"Bold\"}, {\"value\": \"800\", \"label\": \"Extra bold\"}]},\n    {\"id\": \"reverse\", \"type\": \"boolean\", \"role\": \"motion\", \"label\": \"Reverse\", \"description\": \"On: letters leave downward and the copy arrives from above. Off: the other way round.\", \"default\": true},\n    {\"id\": \"stagger\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Stagger\", \"description\": \"Seconds between neighbouring letters.\", \"default\": 0.02, \"min\": 0, \"max\": 0.3, \"step\": 0.005, \"unit\": \"s\"},\n    {\"id\": \"spring_duration\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Spring duration\", \"description\": \"Perceived duration of each letter&#39;s spring.\", \"default\": 0.8, \"min\": 0.2, \"max\": 2, \"step\": 0.05, \"unit\": \"s\"},\n    {\"id\": \"bounce\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Bounce\", \"description\": \"Spring bounce: 0 settles smoothly, higher overshoots.\", \"default\": 0.25, \"min\": 0, \"max\": 0.8, \"step\": 0.05},\n    {\"id\": \"swaps\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Cycles\", \"description\": \"How many swap-and-back cycles play.\", \"default\": 2, \"min\": 1, \"max\": 8, \"step\": 1},\n    {\"id\": \"first_swap\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"First swap\", \"description\": \"Seconds before the first wave.\", \"default\": 0.4, \"min\": 0, \"max\": 4, \"step\": 0.05, \"unit\": \"s\"},\n    {\"id\": \"interval\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Interval\", \"description\": \"Seconds from the start of one wave to the next.\", \"default\": 2.2, \"min\": 0.6, \"max\": 5, \"step\": 0.1, \"unit\": \"s\"},\n    {\"id\": \"hold\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Hold\", \"description\": \"Seconds the swapped state holds before the wave runs back.\", \"default\": 1.0, \"min\": 0.2, \"max\": 4, \"step\": 0.1, \"unit\": \"s\"}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Random Letter Swap Ping-Pong</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n        #root { color: #111111; font-family: Geist, system-ui, sans-serif; }\n        .ls-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }\n        .ls-line { display: flex; justify-content: center; align-items: center; overflow: hidden; line-height: 1.2; padding: 0.06em 0 0.14em; }\n        .ls-ch { position: relative; display: flex; white-space: pre; }\n        .ls-a { position: relative; display: block; }\n        .ls-b { position: absolute; left: 0; top: 0; display: block; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"random-letter-swap-pingpong\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"ls-clip\" class=\"ls-stage clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\">\n          <div id=\"ls-line\" class=\"ls-line\" role=\"img\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/CustomEase.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n\n            var DEFS = [{\"id\": \"text\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Text\", \"description\": \"Word or short phrase whose letters swap.\", \"default\": \"Letter swap\"}, {\"id\": \"font_size\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Font size\", \"description\": \"Maximum text size in pixels. Longer text shrinks to fit the frame.\", \"default\": 150, \"min\": 24, \"max\": 400, \"step\": 1, \"unit\": \"px\"}, {\"id\": \"color\", \"type\": \"color\", \"role\": \"style\", \"label\": \"Color\", \"description\": \"Text color.\", \"default\": \"#111111\"}, {\"id\": \"font_weight\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Font weight\", \"description\": \"Weight of the text.\", \"default\": \"700\", \"options\": [{\"value\": \"400\", \"label\": \"Regular\"}, {\"value\": \"500\", \"label\": \"Medium\"}, {\"value\": \"600\", \"label\": \"Semibold\"}, {\"value\": \"700\", \"label\": \"Bold\"}, {\"value\": \"800\", \"label\": \"Extra bold\"}]}, {\"id\": \"reverse\", \"type\": \"boolean\", \"role\": \"motion\", \"label\": \"Reverse\", \"description\": \"On: letters leave downward and the copy arrives from above. Off: the other way round.\", \"default\": true}, {\"id\": \"stagger\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Stagger\", \"description\": \"Seconds between neighbouring letters.\", \"default\": 0.02, \"min\": 0, \"max\": 0.3, \"step\": 0.005, \"unit\": \"s\"}, {\"id\": \"spring_duration\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Spring duration\", \"description\": \"Perceived duration of each letter's spring.\", \"default\": 0.8, \"min\": 0.2, \"max\": 2, \"step\": 0.05, \"unit\": \"s\"}, {\"id\": \"bounce\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Bounce\", \"description\": \"Spring bounce: 0 settles smoothly, higher overshoots.\", \"default\": 0.25, \"min\": 0, \"max\": 0.8, \"step\": 0.05}, {\"id\": \"swaps\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Cycles\", \"description\": \"How many swap-and-back cycles play.\", \"default\": 2, \"min\": 1, \"max\": 8, \"step\": 1}, {\"id\": \"first_swap\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"First swap\", \"description\": \"Seconds before the first wave.\", \"default\": 0.4, \"min\": 0, \"max\": 4, \"step\": 0.05, \"unit\": \"s\"}, {\"id\": \"interval\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Interval\", \"description\": \"Seconds from the start of one wave to the next.\", \"default\": 2.2, \"min\": 0.6, \"max\": 5, \"step\": 0.1, \"unit\": \"s\"}, {\"id\": \"hold\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Hold\", \"description\": \"Seconds the swapped state holds before the wave runs back.\", \"default\": 1.0, \"min\": 0.2, \"max\": 4, \"step\": 0.1, \"unit\": \"s\"}];\n            var root = document.getElementById(\"root\");\n            var raw = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() : {};\n            var D = parseFloat(root.dataset.duration || \"6\");\n            function V(id) {\n              var d = null;\n              for (var i = 0; i < DEFS.length; i++) if (DEFS[i].id === id) d = DEFS[i];\n              var v = raw[id];\n              if (v === undefined || v === null || (v === \"\" && d.type !== \"string\")) return d.default;\n              if (d.type === \"number\") { var n = Number(v); return Number.isFinite(n) ? Math.min(d.max, Math.max(d.min, n)) : d.default; }\n              if (d.type === \"boolean\") return v === true || v === \"true\";\n              if (d.type === \"enum\") { for (var j = 0; j < d.options.length; j++) if (String(d.options[j].value) === String(v)) return d.options[j].value; return d.default; }\n              if (d.type === \"string\") return typeof v === \"string\" ? v : d.default;\n              return typeof v === \"string\" && v ? v : d.default;\n            }\n            function mulberry32(a) { return function () { a |= 0; a = (a + 0x6d2b79f5) | 0; var t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n            function hash3(a, b, c) { return mulberry32((a * 7919 + b * 104729 + c * 1299709) | 0)(); }\n            // Stagger delays in seconds: \"first\", \"last\", \"center\", \"random\" (seeded shuffle) or an index.\n            function stagger(n, from, step, seed) {\n              var out = [], i;\n              if (from === \"random\") {\n                var rng = mulberry32(seed || 7), idx = [];\n                for (i = 0; i < n; i++) idx.push(i);\n                for (i = n - 1; i > 0; i--) { var j = Math.floor(rng() * (i + 1)); var tmp = idx[i]; idx[i] = idx[j]; idx[j] = tmp; }\n                for (i = 0; i < n; i++) out[idx[i]] = i * step;\n                return out;\n              }\n              for (i = 0; i < n; i++) {\n                var k = from === \"last\" ? n - 1 - i : from === \"center\" ? Math.abs(Math.floor(n / 2) - i) : typeof from === \"number\" ? Math.abs(from - i) : i;\n                out.push(k * step);\n              }\n              return out;\n            }\n            // Damped spring from 0 to 1 (stiffness/damping/mass or duration/bounce, as Motion defines them).\n            function spring(o) {\n              var m = o.mass || 1, k, c;\n              if (o.duration !== undefined) { var w = (2 * Math.PI) / o.duration; k = w * w * m; c = 2 * (1 - (o.bounce || 0)) * Math.sqrt(k * m); }\n              else { k = o.stiffness; c = o.damping; }\n              var w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m));\n              function at(t) {\n                if (t <= 0) return 0;\n                if (Math.abs(z - 1) < 1e-6) return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n                if (z < 1) { var wd = w0 * Math.sqrt(1 - z * z); return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t)); }\n                var s = Math.sqrt(z * z - 1), r1 = -w0 * (z - s), r2 = -w0 * (z + s);\n                return 1 - (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r2 - r1);\n              }\n              var settle = 6;\n              for (var t = 0.02; t < 6; t += 0.02) {\n                var ok = true;\n                for (var u = t; u < Math.min(t + 0.3, 6); u += 0.05) if (Math.abs(1 - at(u)) > 0.002) { ok = false; break; }\n                if (ok) { settle = t; break; }\n              }\n              return { at: at, duration: settle };\n            }\n            function fitText(text) { return Array.from(text); }\n\n            var line = document.getElementById(\"ls-line\");\n            var text = V(\"text\") || \"Letter swap\";\n            line.setAttribute(\"aria-label\", text);\n            line.style.color = V(\"color\");\n            line.style.fontWeight = V(\"font_weight\");\n            line.style.fontSize = \"min(\" + V(\"font_size\") + \"px, calc(90cqw / \" + Math.max(1, fitText(text).length * 0.6).toFixed(2) + \"))\";\n            var cells = fitText(text).map(function (ch, i) {\n              var c = document.createElement(\"span\"); c.className = \"ls-ch\"; c.id = \"ls-ch-\" + i; c.setAttribute(\"aria-hidden\", \"true\");\n              c.innerHTML = '<span class=\"ls-a\"></span><span class=\"ls-b\"></span>';\n              c.children[0].textContent = ch; c.children[1].textContent = ch;\n              line.appendChild(c); return { a: c.children[0], b: c.children[1] };\n            });\n            var n = cells.length;\n            var delays = stagger(n, \"random\", V(\"stagger\"), 11);\n            var sp = spring({ duration: V(\"spring_duration\"), bounce: V(\"bounce\") });\n            var dir = V(\"reverse\") ? 1 : -1, swaps = V(\"swaps\"), first = V(\"first_swap\"), interval = V(\"interval\");\n            var hold = V(\"hold\");\n            var tl = gsap.timeline({ paused: true });\n            function place(i, p) {\n              cells[i].a.style.transform = \"translateY(\" + (dir * 100 * p).toFixed(3) + \"%)\";\n              cells[i].b.style.transform = \"translateY(\" + (-dir * 100 * (1 - p)).toFixed(3) + \"%)\";\n            }\n            function draw(t) {\n              for (var i = 0; i < n; i++) {\n                var el = t - first - delays[i], p = 0;\n                if (el >= 0) {\n                  var k = Math.min(swaps - 1, Math.floor(el / interval)), e = el - k * interval;\n                  if (e < sp.duration) p = sp.at(e); else if (e < hold) p = 1; else if (e < hold + sp.duration) p = 1 - sp.at(e - hold); else p = 0;\n                }\n                place(i, p);\n              }\n            }\n\n            var clock = { t: 0 };\n            tl.to(clock, { t: D, duration: D, ease: \"none\", onUpdate: function () { draw(clock.t); } }, 0);\n            draw(0);\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"random-letter-swap-pingpong\"] = tl;\n\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
