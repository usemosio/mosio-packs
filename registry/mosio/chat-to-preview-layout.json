   "content": "<!doctype html>\n<!--\n  Chat to Preview Layout\n\n  A two-up split where the chat panel shrinks and the preview panel expands, to show an agent building something. Both panels hold generic placeholder content. On a tall frame the split stacks vertically (chat on top).\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/chat-to-preview-layout/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"chat-to-preview-layout\"\n  data-composition-duration=\"4\"\n  data-composition-variables='[{\"id\":\"start_chat_ratio\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Start chat ratio\",\"description\":\"Share of the split the chat takes at the start.\",\"default\":0.5,\"min\":0.1,\"max\":0.9,\"step\":0.05},{\"id\":\"end_chat_ratio\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"End chat ratio\",\"description\":\"Share of the split the chat takes at the end.\",\"default\":0.25,\"min\":0.05,\"max\":0.9,\"step\":0.05},{\"id\":\"chat_title\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Chat label\",\"description\":\"Small label at the top of the chat panel.\",\"default\":\"Chat\"},{\"id\":\"messages\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Messages\",\"description\":\"Chat lines, one per line; start a line with > for the user (right, blue), otherwise it is the assistant.\",\"default\":\"> Build me a landing page\\nSure, what should it feature?\\n> Hero, pricing, footer.\\nOn it. Generating now...\"},{\"id\":\"headline\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Preview headline\",\"description\":\"Headline in the placeholder preview.\",\"default\":\"Ship faster.\"},{\"id\":\"subline\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Preview text\",\"description\":\"Supporting line in the placeholder preview.\",\"default\":\"The fastest way to launch your idea.\"},{\"id\":\"cta\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Preview button\",\"description\":\"Button label in the placeholder preview.\",\"default\":\"Get started\"},{\"id\":\"speed\",\"type\":\"number\",\"role\":\"motion\",\"label\":\"Speed\",\"description\":\"Playback speed multiplier.\",\"default\":1,\"min\":0.25,\"max\":4,\"step\":0.05,\"unit\":\"x\"}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Chat to Preview Layout</title>\n  </head>\n  <body>\n    <template>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\" />\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n\n        #root { background: #09090b; font-family: Geist, system-ui, sans-serif; }\n        .cp-stage { position: absolute; inset: 0; }\n        #cp-lay { box-sizing: border-box; padding: 32px; display: flex; gap: 16px; }\n        .cp-col { flex: none; position: relative; overflow: hidden; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); box-sizing: border-box; }\n        .cp-in { position: absolute; inset: 0; }\n        #cp-chat-in { background: #111; padding: 24px; display: flex; flex-direction: column; gap: 12px; box-sizing: border-box; }\n        .cp-lab { color: #888; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; }\n        .cp-msg { color: #fff; padding: 10px 14px; border-radius: 14px; font-size: 14px; max-width: 85%; }\n        .cp-msg.u { align-self: flex-end; background: #0ea5e9; } .cp-msg.a { align-self: flex-start; background: #262626; }\n        #cp-prev-in { background: #fff; display: flex; flex-direction: column; }\n        .cp-bar { height: 36px; background: #f4f4f5; border-bottom: 1px solid #e4e4e7; display: flex; align-items: center; gap: 6px; padding: 0 12px; flex: none; }\n        .cp-dot { width: 10px; height: 10px; border-radius: 999px; }\n        .cp-page { flex: 1; padding: 32px; display: flex; flex-direction: column; gap: 16px; }\n        .cp-h { font-size: 36px; font-weight: 700; letter-spacing: -0.03em; color: #0a0a0a; }\n        .cp-p { font-size: 16px; color: #71717a; max-width: 360px; }\n        .cp-btn { margin-top: 12px; align-self: flex-start; background: #0a0a0a; color: #fff; padding: 10px 18px; border-radius: 10px; font-size: 14px; font-weight: 600; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"chat-to-preview-layout\" data-duration=\"4\" data-fps=\"30\">\n        <div id=\"cp-clip\" class=\"cp-stage clip\" data-start=\"0\" data-duration=\"4\" data-track-index=\"0\">\n<div id=\"cp-lay\"><div id=\"cp-chat\" class=\"cp-col\"><div id=\"cp-chat-in\" class=\"cp-in\"><div id=\"cp-lab\" class=\"cp-lab\"></div></div></div><div id=\"cp-prev\" class=\"cp-col\"><div id=\"cp-prev-in\" class=\"cp-in\"><div class=\"cp-bar\"><span class=\"cp-dot\" style=\"background:#ef4444\"></span><span class=\"cp-dot\" style=\"background:#f59e0b\"></span><span class=\"cp-dot\" style=\"background:#22c55e\"></span></div><div class=\"cp-page\"><div id=\"cp-h\" class=\"cp-h\"></div><div id=\"cp-p\" class=\"cp-p\"></div><div id=\"cp-btn\" class=\"cp-btn\"></div></div></div></div></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value ? value : fallback;\n            }\n            function bool(value, fallback) {\n              return typeof value === \"boolean\" ? value : value === \"true\" ? true : value === \"false\" ? false : fallback;\n            }\n            function pick(value, options, fallback) {\n              return options.indexOf(String(value)) >= 0 ? String(value) : fallback;\n            }\n            // Frame-based helpers, written from their definitions.\n            var Easing = (function () {\n              function bezier(x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var i = 0; i < 40; i++) {\n                    var u = 1 - t;\n                    var cx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;\n                    if (Math.abs(cx - x) < 1e-6) break;\n                    if (cx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var v = 1 - t;\n                  return 3 * v * v * t * y1 + 3 * v * t * t * y2 + t * t * t;\n                };\n              }\n              return {\n                bezier: bezier,\n                linear: function (t) { return t; },\n                quad: function (t) { return t * t; },\n                cubic: function (t) { return t * t * t; },\n                sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n                poly: function (n) { return function (t) { return Math.pow(t, n); }; },\n                ease: bezier(0.42, 0, 1, 1),\n                out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n                inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; }\n              };\n            })();\n            function interpolate(input, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var left = o.extrapolateLeft || \"extend\";\n              var right = o.extrapolateRight || \"extend\";\n              var i = 1;\n              while (i < n - 1 && input > inR[i]) i++;\n              var a = inR[i - 1], b = inR[i];\n              if (input < inR[0] && left === \"clamp\") return outR[0];\n              if (input > inR[n - 1] && right === \"clamp\") return outR[n - 1];\n              var t = b === a ? 0 : (input - a) / (b - a);\n              if (o.easing) t = o.easing(t);\n              return outR[i - 1] + (outR[i] - outR[i - 1]) * t;\n            }\n            // Damped spring from rest to 1. durationInFrames stretches time so the spring has settled by then.\n            function spring(o) {\n              var c = o.config || {};\n              var mass = c.mass != null ? c.mass : 1;\n              var k = c.stiffness != null ? c.stiffness : 100;\n              var damp = c.damping != null ? c.damping : 10;\n              function at(t) {\n                var w0 = Math.sqrt(k / mass);\n                var z = damp / (2 * Math.sqrt(k * mass));\n                if (z < 1) {\n                  var wd = w0 * Math.sqrt(1 - z * z);\n                  return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + ((z * w0) / wd) * Math.sin(wd * t));\n                }\n                return 1 - Math.exp(-w0 * t) * (1 + w0 * t);\n              }\n              var t = Math.max(0, o.frame) / o.fps;\n              if (o.durationInFrames) {\n                var settle = 4, step = 1 / o.fps;\n                for (var s = settle; s > 0.05; s -= step) {\n                  if (Math.abs(1 - at(s)) > 0.001) { settle = s + step; break; }\n                  settle = s;\n                }\n                t = (Math.max(0, o.frame) / o.durationInFrames) * settle;\n                if (o.frame >= o.durationInFrames) return 1;\n              }\n              return at(t);\n            }\n            function parseColor(c) {\n              var m;\n              c = String(c).trim();\n              if ((m = /^#([0-9a-f]{3,8})$/i.exec(c))) {\n                var h = m[1];\n                if (h.length <= 4) h = h.split(\"\").map(function (x) { return x + x; }).join(\"\");\n                return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1];\n              }\n              if ((m = /^rgba?\\(([^)]+)\\)/i.exec(c))) {\n                var p = m[1].split(\",\").map(Number);\n                return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];\n              }\n              return [0, 0, 0, 1];\n            }\n            function interpolateColors(t, inR, outR) {\n              var a = parseColor(outR[0]), b = parseColor(outR[1]);\n              var u = Math.min(1, Math.max(0, (t - inR[0]) / (inR[1] - inR[0])));\n              return \"rgba(\" + [0, 1, 2].map(function (i) { return Math.round(a[i] + (b[i] - a[i]) * u); }).join(\",\") + \",\" + (a[3] + (b[3] - a[3]) * u) + \")\";\n            }\n            // Seeded 0..1 value: the same seed always gives the same number.\n            function random(seed) {\n              var s = String(seed), h = 2166136261;\n              for (var i = 0; i < s.length; i++) {\n                h ^= s.charCodeAt(i);\n                h = Math.imul(h, 16777619);\n              }\n              h = Math.imul(h ^ (h >>> 13), 2246822519);\n              h = Math.imul(h ^ (h >>> 16), 3266489917);\n              return ((h ^ (h >>> 15)) >>> 0) / 4294967296;\n            }\n            // Fit a fixed-size design stage into the frame.\n            function fit(el, w, h, fill) {\n              var s = Math.min(root.clientWidth / w, root.clientHeight / h) * (fill || 1);\n              el.style.position = \"absolute\";\n              el.style.left = \"50%\";\n              el.style.top = \"50%\";\n              el.style.width = w + \"px\";\n              el.style.height = h + \"px\";\n              el.style.transform = \"translate(-50%, -50%) scale(\" + s + \")\";\n              return s;\n            }\n            // Drive draw(frame) from the timeline so seeking always draws the same picture.\n            function clockTween(tl, totalFrames, draw, rate) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: totalFrames, duration: totalFrames / 30, ease: \"none\", onUpdate: function () { draw(clock.frame * (rate || 1)); } }, 0);\n              draw(0);\n            }\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function svgEl(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n\n                        // Stop-motion helpers: poses are held for `step` frames.\n            var DEFAULT_STEP = 3;\n            function qf(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step) * step; }\n            function qstep(frame, step) { step = step || DEFAULT_STEP; return Math.floor(frame / step); }\n            function hash01(seed) { return random(seed); }\n            function hashRange(seed, lo, hi) { return lo + hash01(seed) * (hi - lo); }\n            function paperJitter(frame, seed, o) {\n              o = o || {};\n              var amp = o.amp != null ? o.amp : 1.4, rotAmp = o.rotAmp != null ? o.rotAmp : 0.35;\n              var s = qstep(frame, o.step);\n              return { x: hashRange(seed + \":x:\" + s, -amp, amp), y: hashRange(seed + \":y:\" + s, -amp, amp), rot: hashRange(seed + \":r:\" + s, -rotAmp, rotAmp) };\n            }\n            function steppedRamp(frame, from, to, o) {\n              o = o || {};\n              var f = qf(frame, o.step);\n              if (f <= from) return 0;\n              if (f >= to) return 1;\n              var ease = o.ease || function (t) { return t; };\n              return ease((f - from) / (to - from));\n            }\n\n\n            function scaledStage(el, boost) {\n              var W = root.clientWidth, H = root.clientHeight;\n              var s = Math.min(W / 1280, H / 720) * (H > W ? (boost || 1.4) : 1);\n              el.style.position = \"absolute\"; el.style.left = \"0\"; el.style.top = \"0\";\n              el.style.width = W / s + \"px\"; el.style.height = H / s + \"px\";\n              el.style.transformOrigin = \"0 0\"; el.style.transform = \"scale(\" + s + \")\";\n              return s;\n            }\n\n            var lay = document.getElementById(\"cp-lay\");\n            var s = scaledStage(lay, 1.4);\n            var SW = root.clientWidth / s, SH = root.clientHeight / s;\n            var tall = SH > SW;\n            lay.style.flexDirection = tall ? \"column\" : \"row\";\n            var chat = document.getElementById(\"cp-chat\"), prev = document.getElementById(\"cp-prev\");\n            var chatIn = document.getElementById(\"cp-chat-in\"), prevIn = document.getElementById(\"cp-prev-in\");\n            document.getElementById(\"cp-lab\").textContent = str(vars.chat_title, \"Chat\");\n            var msgs = str(vars.messages, \"> Build me a landing page\\nSure, what should it feature?\\n> Hero, pricing, footer.\\nOn it. Generating now...\").split(\"\\n\").filter(function (l) { return l.trim(); });\n            msgs.forEach(function (l) {\n              var user = l.charAt(0) === \">\";\n              var m = document.createElement(\"div\"); m.className = \"cp-msg \" + (user ? \"u\" : \"a\");\n              m.textContent = user ? l.slice(1).trim() : l.trim();\n              chatIn.appendChild(m);\n            });\n            document.getElementById(\"cp-h\").textContent = str(vars.headline, \"Ship faster.\");\n            document.getElementById(\"cp-p\").textContent = str(vars.subline, \"The fastest way to launch your idea.\");\n            document.getElementById(\"cp-btn\").textContent = str(vars.cta, \"Get started\");\n            var startR = num(vars.start_chat_ratio, 0.5, 0.1, 0.9), endR = num(vars.end_chat_ratio, 0.25, 0.05, 0.9), speed = num(vars.speed, 1, 0.25, 4);\n            // Inner content keeps a fixed virtual size and is clipped, so text never reflows while the columns resize.\n            if (tall) { chatIn.style.minHeight = \"420px\"; prevIn.style.minHeight = \"560px\"; }\n            else { chatIn.style.minWidth = \"520px\"; prevIn.style.minWidth = \"720px\"; }\n            var SOFT_EASE = Easing.bezier(0.16, 1, 0.3, 1);\n            var totalFrames = Math.round(parseFloat(root.dataset.duration || \"4\") * 30);\n            var avail = (tall ? SH : SW) - 64 - 16;\n            function draw(frame) {\n              var f = frame * speed, a = totalFrames * 0.1, b = totalFrames * 0.7;\n              var o = { extrapolateLeft: \"clamp\", extrapolateRight: \"clamp\", easing: SOFT_EASE };\n              var ratio = interpolate(f, [a, b], [startR, endR], o);\n              var po = interpolate(f, [a, b], [0, 1], o), pt = interpolate(f, [a, b], [40, 0], o);\n              // flex-basis as a percentage of the content box, as in the source.\n              var prop = tall ? \"height\" : \"width\";\n              chat.style[prop] = ratio * 100 + \"%\"; prev.style[prop] = (1 - ratio) * 100 + \"%\";\n              chat.style[tall ? \"width\" : \"height\"] = \"auto\"; prev.style[tall ? \"width\" : \"height\"] = \"auto\";\n              prev.style.opacity = po;\n              prev.style.transform = tall ? \"translateY(\" + pt + \"px)\" : \"translateX(\" + pt + \"px)\";\n            }\n            var tl = gsap.timeline({ paused: true });\n            clockTween(tl, totalFrames, draw);\n\n            var total = parseFloat(root.dataset.duration || \"4\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"chat-to-preview-layout\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
