   "content": "<!doctype html>\n<!--\n  Scroll Menu Phone\n\n  A generic phone frame with a menu list. The list scrolls with momentum, a touch dot taps an item, and the item expands to show its price and a Tambah button, which the dot then taps and a cart count appears. Names, descriptions and prices come from one variable.\n\n  An original usemosio/blocks block (MIT, see LICENSE).\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"scroll-menu-phone\"\n  data-composition-duration=\"6\"\n  data-composition-variables='[\n  {\n    \"id\": \"title\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Shop name\",\n    \"description\": \"Header of the phone screen.\",\n    \"default\": \"Warung Sambal Rina\"\n  },\n  {\n    \"id\": \"caption\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Caption\",\n    \"description\": \"Line beside or above the phone. Empty hides it.\",\n    \"default\": \"Pesan dari meja, tanpa antre\"\n  },\n  {\n    \"id\": \"items\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Menu items\",\n    \"description\": \"One per line, Name|Description|Price. At least 5 lines work best.\",\n    \"default\": \"Nasi ayam geprek|Sambal bawang, lalapan|Rp22.000\\nNasi ayam bakar|Bumbu kecap, sambal terasi|Rp25.000\\nMie goreng jawa|Telur, sayur, kerupuk|Rp18.000\\nSoto ayam|Kuah bening, soun|Rp20.000\\nGado-gado|Bumbu kacang, lontong|Rp17.000\\nTempe mendoan|5 potong, sambal kecap|Rp10.000\\nEs teh manis|Gelas besar|Rp5.000\\nEs jeruk peras|Segar, tanpa pengawet|Rp8.000\\nKopi tubruk|Gula aren|Rp7.000\"\n  },\n  {\n    \"id\": \"tap_item\",\n    \"type\": \"number\",\n    \"role\": \"content\",\n    \"label\": \"Tapped item\",\n    \"description\": \"Which item (1 = first) is tapped and expanded.\",\n    \"default\": 6,\n    \"min\": 1,\n    \"max\": 12,\n    \"step\": 1\n  },\n  {\n    \"id\": \"button\",\n    \"type\": \"string\",\n    \"role\": \"content\",\n    \"label\": \"Button label\",\n    \"description\": \"Text on the button.\",\n    \"default\": \"Tambah\"\n  },\n  {\n    \"id\": \"bg_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Background\",\n    \"description\": \"Background.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"main_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Main colour\",\n    \"description\": \"Button and price: the one accent.\",\n    \"default\": \"#2563eb\"\n  },\n  {\n    \"id\": \"text_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Text colour\",\n    \"description\": \"Item names and caption.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"muted_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Muted colour\",\n    \"description\": \"Descriptions.\",\n    \"default\": \"#737373\"\n  },\n  {\n    \"id\": \"phone_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Phone colour\",\n    \"description\": \"Bezel.\",\n    \"default\": \"#0a0a0a\"\n  },\n  {\n    \"id\": \"screen_color\",\n    \"type\": \"color\",\n    \"role\": \"style\",\n    \"label\": \"Screen colour\",\n    \"description\": \"Phone screen.\",\n    \"default\": \"#ffffff\"\n  },\n  {\n    \"id\": \"font_family\",\n    \"type\": \"string\",\n    \"role\": \"style\",\n    \"label\": \"Font\",\n    \"description\": \"Google Fonts family name; Geist is loaded, others only if the host loads them.\",\n    \"default\": \"Geist\"\n  },\n  {\n    \"id\": \"transparent\",\n    \"type\": \"boolean\",\n    \"role\": \"style\",\n    \"label\": \"Transparent\",\n    \"description\": \"Leave the background clear so the block sits over your own scene.\",\n    \"default\": false\n  }\n]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Scroll Menu Phone</title>\n  </head>\n  <body>\n    <template>\n      <link\n        rel=\"stylesheet\"\n        href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;display=block\"\n      />\n      <style>\n        #root {\n          position: absolute; inset: 0; overflow: hidden; container-type: size; pointer-events: none;\n          -webkit-font-smoothing: antialiased;\n          background: var(--smp-bg); color: var(--smp-text); font-family: var(--smp-font);\n        }\n        #root * { box-sizing: border-box; }\n        .smp-stage { position: absolute; inset: 0; --u: calc(100cqmin / 1080); }\n\n        .smp-cap { position: absolute; font-weight: 600; letter-spacing: -0.04em; }\n        .smp-phone { position: absolute; background: var(--smp-phone); box-shadow: 0 calc(var(--u) * 30) calc(var(--u) * 70) rgba(10,10,10,0.16); }\n        .smp-screen { position: absolute; overflow: hidden; background: var(--smp-screen); color: var(--smp-text); }\n        .smp-notch { position: absolute; left: 50%; background: var(--smp-phone); z-index: 5; }\n        .smp-head { position: absolute; left: 0; right: 0; top: 0; z-index: 3; background: var(--smp-screen); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(10,10,10,0.08); }\n        .smp-head b { font-weight: 600; letter-spacing: -0.02em; white-space: nowrap; }\n        .smp-cart { display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--smp-text); color: var(--smp-screen); font-weight: 600; font-variant-numeric: tabular-nums; }\n        .smp-listbox { position: absolute; left: 0; right: 0; bottom: 0; overflow: hidden; }\n        .smp-list { position: absolute; left: 0; right: 0; top: 0; }\n        .smp-row { position: relative; border-bottom: 1px solid rgba(10,10,10,0.07); overflow: hidden; }\n        .smp-main { display: flex; align-items: center; }\n        .smp-thumb { flex: none; display: flex; align-items: center; justify-content: center; }\n        .smp-thumb svg { width: 56%; height: 56%; }\n        .smp-txt { display: flex; flex-direction: column; min-width: 0; }\n        .smp-name { font-weight: 600; letter-spacing: -0.02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n        .smp-desc { color: var(--smp-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n        .smp-exp { height: 0; overflow: hidden; display: flex; align-items: center; justify-content: space-between; }\n        .smp-price { font-weight: 600; letter-spacing: -0.03em; color: var(--smp-main); font-variant-numeric: tabular-nums; white-space: nowrap; }\n        .smp-btn { background: var(--smp-main); color: #fff; font-weight: 600; text-align: center; white-space: nowrap; }\n        .smp-touch { position: absolute; z-index: 9; left: 0; top: 0; border-radius: 50%; background: rgba(10,10,10,0.22); border: 2px solid rgba(10,10,10,0.5); }\n        .smp-ripple { position: absolute; z-index: 8; left: 0; top: 0; border-radius: 50%; border: 3px solid var(--smp-main); opacity: 0; }\n\n      </style>\n\n      <div id=\"root\" data-composition-id=\"scroll-menu-phone\" data-duration=\"6\" data-fps=\"30\">\n        <div id=\"smp-clip\" class=\"smp-stage clip\" data-start=\"0\" data-duration=\"6\" data-track-index=\"0\">\n          <div class=\"smp-cap\" id=\"smp-cap\"></div>\n          <div class=\"smp-phone\" id=\"smp-phone\">\n            <div class=\"smp-screen\" id=\"smp-screen\">\n              <div class=\"smp-head\" id=\"smp-head\"><b id=\"smp-shop\"></b><span class=\"smp-cart\" id=\"smp-cart\">0</span></div>\n              <div class=\"smp-listbox\" id=\"smp-lb\"><div class=\"smp-list\" id=\"smp-list\"></div></div>\n              <div class=\"smp-ripple\" id=\"smp-rip\"></div><div class=\"smp-touch\" id=\"smp-touch\"></div>\n            </div>\n            <div class=\"smp-notch\" id=\"smp-notch\"></div>\n          </div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars = window.__hyperframes && window.__hyperframes.getVariables ? window.__hyperframes.getVariables() || {} : {};\n            function num(v, d, a, b) { var n = Number(v); return Number.isFinite(n) ? Math.min(b, Math.max(a, n)) : d; }\n            function str(v, d) { return typeof v === \"string\" && v.trim() ? v : d; }\n            function colr(v, d) { return typeof v === \"string\" && v.trim() && window.CSS && CSS.supports(\"color\", v.trim()) ? v.trim() : d; }\n            function bool(v, d) { return v === true || v === \"true\" ? true : v === false || v === \"false\" ? false : d; }\n            function el(tag, cls, parent, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; if (parent) parent.appendChild(e); return e; }\n            function esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\"); }\n            function lines(v, d) { var s = typeof v === \"string\" && v.trim() ? v : d; return s.split(/\\r?\\n/).map(function (l) { return l.trim(); }).filter(Boolean); }\n            function dots(n) { return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\"); }\n            function ease(n, a, b) { return Math.min(1, Math.max(0, (n - a) / (b - a))); }\n            var W = root.clientWidth || 1080, H = root.clientHeight || 1920, U = Math.min(W, H) / 1080, PORTRAIT = H > W;\n            var PAL = [[\"bg\", \"bg_color\", \"#ffffff\"], [\"main\", \"main_color\", \"#2563eb\"], [\"text\", \"text_color\", \"#0a0a0a\"], [\"muted\", \"muted_color\", \"#737373\"], [\"phone\", \"phone_color\", \"#0a0a0a\"], [\"screen\", \"screen_color\", \"#ffffff\"]];\n            PAL.forEach(function (c) { root.style.setProperty(\"--smp-\" + c[0], colr(vars[c[1]], c[2])); });\n            root.style.setProperty(\"--smp-font\", '\"' + str(vars.font_family, \"Geist\") + '\", Geist, system-ui, sans-serif');\n            if (bool(vars.transparent, false)) root.style.background = \"transparent\";\n\n\n            var items = lines(vars.items, \"\").map(function (l) { var a = l.split(\"|\"); return { n: (a[0] || \"\").trim(), d: (a[1] || \"\").trim(), p: (a[2] || \"\").trim() }; });\n            if (items.length < 3) items = [{ n: \"Nasi ayam geprek\", d: \"Sambal bawang\", p: \"Rp22.000\" }, { n: \"Mie goreng\", d: \"Telur, sayur\", p: \"Rp18.000\" }, { n: \"Soto ayam\", d: \"Kuah bening\", p: \"Rp20.000\" }, { n: \"Es teh manis\", d: \"Gelas besar\", p: \"Rp5.000\" }];\n            items = items.slice(0, 12);\n            var tapI = Math.min(items.length, Math.max(1, Math.round(num(vars.tap_item, 6, 1, 12)))) - 1;\n            var btnText = str(vars.button, \"Tambah\");\n            var capText = typeof vars.caption === \"string\" ? vars.caption.trim() : \"Pesan dari meja, tanpa antre\";\n            var PH = H * (PORTRAIT ? 0.76 : 0.88), PW = PH * 0.49, pu = PW / 480;\n            function p(x) { return x * pu; }\n            var cx = PORTRAIT ? W / 2 : W * 0.66, cy = PORTRAIT ? H * 0.56 : H * 0.5;\n            var cap = document.getElementById(\"smp-cap\"); cap.textContent = capText; if (!capText) cap.style.display = \"none\";\n            if (PORTRAIT) { cap.style.cssText += \"left:0;right:0;text-align:center;top:\" + 140 * U + \"px;font-size:\" + 68 * U + \"px;white-space:nowrap\"; }\n            else { cap.style.cssText += \"left:\" + 100 * U + \"px;width:\" + (W * 0.36) + \"px;top:0;bottom:0;display:flex;align-items:center;font-size:\" + 92 * U + \"px;line-height:1.05\"; }\n            var phone = document.getElementById(\"smp-phone\"), bz = p(12);\n            phone.style.cssText += \"left:\" + (cx - PW / 2) + \"px;top:\" + (cy - PH / 2) + \"px;width:\" + PW + \"px;height:\" + PH + \"px;border-radius:\" + p(64) + \"px\";\n            var scr = document.getElementById(\"smp-screen\"), Sw = PW - 2 * bz, Sh = PH - 2 * bz;\n            scr.style.cssText += \"left:\" + bz + \"px;top:\" + bz + \"px;width:\" + Sw + \"px;height:\" + Sh + \"px;border-radius:\" + p(54) + \"px\";\n            var nt = document.getElementById(\"smp-notch\"); nt.style.cssText += \"width:\" + p(110) + \"px;height:\" + p(30) + \"px;margin-left:\" + p(-55) + \"px;top:\" + (bz + p(10)) + \"px;border-radius:\" + p(16) + \"px\";\n            var headH = p(150), head = document.getElementById(\"smp-head\");\n            head.style.height = headH + \"px\"; head.style.padding = p(46) + \"px \" + p(26) + \"px 0\"; head.style.fontSize = p(30) + \"px\";\n            document.getElementById(\"smp-shop\").textContent = str(vars.title, \"Warung Sambal Rina\");\n            var cart = document.getElementById(\"smp-cart\"); cart.style.cssText += \"width:\" + p(44) + \"px;height:\" + p(44) + \"px;font-size:\" + p(24) + \"px;opacity:0\";\n            var lb = document.getElementById(\"smp-lb\"); lb.style.top = headH + \"px\";\n            var LH = Sh - headH, RH = p(128), EXP = p(112), list = document.getElementById(\"smp-list\"), rows = [], exps = [];\n            var tones = [\"#e7e4dd\", \"#dedad2\", \"#ebe8e1\"], shp = ['<circle cx=\"50\" cy=\"50\" r=\"38\" fill=\"#fff\" opacity=\".85\"/>', '<rect x=\"14\" y=\"14\" width=\"72\" height=\"72\" rx=\"20\" fill=\"#fff\" opacity=\".85\"/>', '<path d=\"M50 10 L90 50 L50 90 L10 50 Z\" fill=\"#fff\" opacity=\".85\"/>'];\n            items.forEach(function (it, i) {\n              var row = el(\"div\", \"smp-row\", list); row.style.padding = \"0 \" + p(26) + \"px\";\n              var main = el(\"div\", \"smp-main\", row); main.style.height = RH + \"px\"; main.style.gap = p(20) + \"px\";\n              var th = el(\"div\", \"smp-thumb\", main, '<svg viewBox=\"0 0 100 100\">' + shp[i % 3] + \"</svg>\"); th.style.cssText += \"width:\" + p(88) + \"px;height:\" + p(88) + \"px;border-radius:\" + p(22) + \"px;background:\" + tones[i % 3];\n              var tx = el(\"div\", \"smp-txt\", main, '<span class=\"smp-name\">' + esc(it.n) + '</span><span class=\"smp-desc\">' + esc(it.d) + \"</span>\");\n              tx.firstChild.style.fontSize = p(30) + \"px\"; tx.lastChild.style.fontSize = p(22) + \"px\"; tx.style.gap = p(4) + \"px\";\n              var ex = el(\"div\", \"smp-exp\", row, '<span class=\"smp-price\">' + esc(it.p) + '</span><span class=\"smp-btn\">' + esc(btnText) + \"</span>\");\n              ex.firstChild.style.fontSize = p(40) + \"px\"; var bt = ex.lastChild; bt.style.cssText += \"font-size:\" + p(26) + \"px;width:\" + p(180) + \"px;line-height:\" + p(60) + \"px;border-radius:\" + p(30) + \"px\";\n              ex.style.opacity = 0; rows.push(row); exps.push(ex);\n            });\n            var rowTop = tapI * (RH + 1), total = items.length * (RH + 1) + EXP;\n            var maxScroll = Math.max(0, total - LH), target = Math.min(maxScroll, Math.max(0, rowTop - LH * 0.22));\n            var tchR = p(34), tx0 = Sw * 0.86, ty0 = Sh + tchR * 2;\n            var rowY = headH + rowTop - target, tapX = Sw * 0.62, tapY = rowY + RH / 2;\n            var btnX = Sw - p(26) - p(90), btnY = rowY + RH + EXP / 2;\n            var touch = document.getElementById(\"smp-touch\"), rip = document.getElementById(\"smp-rip\");\n            [touch, rip].forEach(function (e) { e.style.width = e.style.height = tchR * 2 + \"px\"; e.style.marginLeft = e.style.marginTop = -tchR + \"px\"; });\n            gsap.set(touch, { x: tx0, y: ty0, opacity: 0 }); gsap.set(rip, { x: tapX, y: tapY, opacity: 0 });\n            var tl = gsap.timeline({ paused: true });\n            tl.fromTo(\"#smp-phone\", { y: 120 * U, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, ease: \"expo.out\" }, 0.05);\n            tl.fromTo(\"#smp-cap\", { opacity: 0, y: 20 * U }, { opacity: 1, y: 0, duration: 0.6, ease: \"power3.out\" }, 0.3);\n            tl.to(list, { y: -target * 0.7, duration: 1.3, ease: \"power4.out\" }, 0.9);\n            tl.to(list, { y: -target, duration: 0.9, ease: \"power3.out\" }, 2.1);\n            tl.to(touch, { opacity: 1, duration: 0.2 }, 2.7);\n            tl.to(touch, { x: tapX, y: tapY, duration: 0.6, ease: \"power3.out\" }, 2.7);\n            tl.to(touch, { scale: 0.78, duration: 0.1, ease: \"power2.in\" }, 3.4);\n            tl.to(touch, { scale: 1, duration: 0.2, ease: \"power2.out\" }, 3.5);\n            tl.fromTo(rip, { scale: 0.6, opacity: 0.8 }, { scale: 2, opacity: 0, duration: 0.5, ease: \"power2.out\", immediateRender: false }, 3.4);\n            tl.to(rows[tapI], { backgroundColor: \"rgba(10,10,10,0.05)\", duration: 0.2 }, 3.45);\n            tl.to(exps[tapI], { height: EXP, duration: 0.5, ease: \"power3.out\" }, 3.6);\n            tl.to(exps[tapI], { opacity: 1, duration: 0.35, ease: \"power2.out\" }, 3.75);\n            tl.to(touch, { x: btnX, y: btnY, duration: 0.55, ease: \"power2.inOut\" }, 4.2);\n            tl.to(touch, { scale: 0.78, duration: 0.1, ease: \"power2.in\" }, 4.85);\n            tl.to(touch, { scale: 1, duration: 0.2, ease: \"power2.out\" }, 4.95);\n            tl.fromTo(rip, { x: btnX, y: btnY, scale: 0.6, opacity: 0.8 }, { scale: 1.8, opacity: 0, duration: 0.5, ease: \"power2.out\", immediateRender: false }, 4.85);\n            tl.to(exps[tapI].lastChild, { scale: 0.94, duration: 0.1, ease: \"power2.in\" }, 4.85);\n            tl.to(exps[tapI].lastChild, { scale: 1, duration: 0.25, ease: \"back.out(2)\" }, 4.95);\n            tl.fromTo(cart, { opacity: 0, scale: 0.4 }, { opacity: 1, scale: 1, duration: 0.4, ease: \"back.out(1.8)\" }, 5.0);\n            tl.to(touch, { opacity: 0, duration: 0.3 }, 5.3);\n            cart.textContent = \"1\";\n\n            var total = parseFloat(root.dataset.duration || \"6\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"scroll-menu-phone\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
