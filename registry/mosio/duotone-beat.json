   "content": "<!doctype html>\n<!--\n  Duotone Beat\n\n  A two-ink halftone portrait that swaps its ink pair on every beat, punches in on the downbeat and shows a bar indicator. A built-in head-and-shoulders silhouette stands in for the photo: a host puts its own picture in by replacing the contents of the .db-picture layer (an img with object-fit: cover works); the duotone and halftone filter is applied to that layer.\n\n  Ported to an HTML + GSAP sub-composition by usemosio/blocks from:\n  https://github.com/Remocn/remocn/blob/126221ae00ba86eb40b65731b125ff398687d3b7/registry/remocn/duotone-beat/index.tsx\n\n  MIT License\n\n  Copyright (c) 2026 Remocn\n\n  Permission is hereby granted, free of charge, to any person obtaining a copy\n  of this software and associated documentation files (the \"Software\"), to deal\n  in the Software without restriction, including without limitation the rights\n  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n  copies of the Software, and to permit persons to whom the Software is\n  furnished to do so, subject to the following conditions:\n\n  The above copyright notice and this permission notice shall be included in all\n  copies or substantial portions of the Software.\n\n  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n  SOFTWARE.\n-->\n<html\n  lang=\"en\"\n  data-composition-id=\"duotone-beat\"\n  data-composition-duration=\"4\"\n  data-composition-variables='[\n    {\"id\": \"beat_frames\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Frames per beat\", \"description\": \"Frames per beat at 30 fps (15 is 120 BPM).\", \"default\": 15, \"min\": 4, \"max\": 30, \"step\": 1, \"unit\": \"frames\"},\n    {\"id\": \"beats_per_bar\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Beats per bar\", \"description\": \"Beats per bar; the first beat of each bar gets the bigger punch-in.\", \"default\": 4, \"min\": 1, \"max\": 8, \"step\": 1},\n    {\"id\": \"punch\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Punch\", \"description\": \"Scale added on the downbeat. Off-beats get a third of it.\", \"default\": 0.07, \"min\": 0, \"max\": 0.2, \"step\": 0.01},\n    {\"id\": \"halftone\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Halftone pitch\", \"description\": \"Halftone dot pitch in pixels at 720p. 0 keeps smooth tones.\", \"default\": 8, \"min\": 0, \"max\": 20, \"step\": 1, \"unit\": \"px\"},\n    {\"id\": \"show_indicator\", \"type\": \"boolean\", \"role\": \"style\", \"label\": \"Bar indicator\", \"description\": \"Show the beat squares and BPM tag.\", \"default\": true},\n    {\"id\": \"palettes\", \"type\": \"string\", \"role\": \"style\", \"label\": \"Ink pairs\", \"description\": \"JSON list of [shadow ink, highlight ink] hex pairs, one per beat, cycled.\", \"default\": \"[[\\\"#111111\\\",\\\"#FFFFFF\\\"],[\\\"#111111\\\",\\\"#E5322D\\\"],[\\\"#E5322D\\\",\\\"#FFFFFF\\\"],[\\\"#E5322D\\\",\\\"#111111\\\"]]\"},\n    {\"id\": \"speed\", \"type\": \"number\", \"role\": \"motion\", \"label\": \"Speed\", \"description\": \"Playback speed.\", \"default\": 1, \"min\": 0.1, \"max\": 4, \"step\": 0.1}\n  ]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Duotone Beat</title>\n  </head>\n  <body>\n    <template>\n      <style>\n        #root {\n          position: absolute;\n          inset: 0;\n          overflow: hidden;\n          container-type: size;\n          pointer-events: none;\n        }\n        #root { background: #ffffff; }\n        .db-stage { position: absolute; inset: 0; overflow: hidden; }\n        .db-picture { position: absolute; inset: 0; }\n        .db-pan { position: absolute; inset: 0; background: #ffffff; transform-origin: 50% 40%; }\n        .db-pan svg, .db-pan img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n        .db-bar { position: absolute; display: flex; align-items: center; }\n        .db-sq { box-sizing: border-box; }\n        .db-bpm { font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-weight: 700; }\n      </style>\n\n      <div id=\"root\" data-composition-id=\"duotone-beat\" data-duration=\"4\" data-fps=\"30\">\n        <div id=\"db-clip\" class=\"db-stage clip\" data-start=\"0\" data-duration=\"4\" data-track-index=\"0\">\n          <svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs id=\"db-defs\"></defs></svg>\n          <div id=\"db-picture\" class=\"db-picture\"><div id=\"db-pan\" class=\"db-pan\"></div></div>\n          <div id=\"db-bar\" class=\"db-bar\"></div>\n        </div>\n\n        <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n        <script>\n          (function () {\n            \"use strict\";\n            var root = document.getElementById(\"root\");\n            var vars =\n              window.__hyperframes && window.__hyperframes.getVariables\n                ? window.__hyperframes.getVariables()\n                : {};\n            function num(value, fallback, min, max) {\n              var n = Number(value);\n              return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;\n            }\n            function str(value, fallback) {\n              return typeof value === \"string\" && value.trim() ? value : fallback;\n            }\n            function bool(value, fallback) {\n              if (typeof value === \"boolean\") return value;\n              if (value === \"true\") return true;\n              if (value === \"false\") return false;\n              return fallback;\n            }\n            var FPS = 30;\n            var W = root.clientWidth || 1080;\n            var H = root.clientHeight || 1920;\n\n            // Piecewise-linear map of x from inR to outR, optionally eased per segment and clamped.\n            function interp(x, inR, outR, o) {\n              o = o || {};\n              var n = inR.length;\n              var i = 0;\n              if (x >= inR[n - 1]) i = n - 2;\n              else if (x > inR[0]) { while (x > inR[i + 1]) i++; }\n              var t = (x - inR[i]) / (inR[i + 1] - inR[i]);\n              if (o.clamp !== false) t = Math.min(1, Math.max(0, t));\n              if (o.easing) t = o.easing(t);\n              return outR[i] + (outR[i + 1] - outR[i]) * t;\n            }\n            function clamp01(t) { return Math.min(1, Math.max(0, t)); }\n\n            // Easings with the usual names; every one maps 0..1 to 0..1.\n            var E = {\n              linear: function (t) { return t; },\n              quad: function (t) { return t * t; },\n              cubic: function (t) { return t * t * t; },\n              sin: function (t) { return 1 - Math.cos((t * Math.PI) / 2); },\n              back: function (s) { return function (t) { return t * t * ((s + 1) * t - s); }; },\n              out: function (f) { return function (t) { return 1 - f(1 - t); }; },\n              inOut: function (f) { return function (t) { return t < 0.5 ? f(t * 2) / 2 : 1 - f((1 - t) * 2) / 2; }; },\n              bezier: function (x1, y1, x2, y2) {\n                return function (x) {\n                  if (x <= 0) return 0;\n                  if (x >= 1) return 1;\n                  var lo = 0, hi = 1, t = x;\n                  for (var k = 0; k < 24; k++) {\n                    var mt = 1 - t;\n                    var bx = 3 * mt * mt * t * x1 + 3 * mt * t * t * x2 + t * t * t;\n                    if (bx < x) lo = t; else hi = t;\n                    t = (lo + hi) / 2;\n                  }\n                  var m = 1 - t;\n                  return 3 * m * m * t * y1 + 3 * m * t * t * y2 + t * t * t;\n                };\n              }\n            };\n\n            var SVGNS = \"http://www.w3.org/2000/svg\";\n            function el(tag, attrs, parent) {\n              var e = document.createElementNS(SVGNS, tag);\n              for (var k in attrs) e.setAttribute(k, attrs[k]);\n              if (parent) parent.appendChild(e);\n              return e;\n            }\n\n            var tl = gsap.timeline({ paused: true });\n            // Runs draw(frame) from the timeline so seeking to a time always draws the same picture.\n            function drive(frames, draw) {\n              var clock = { frame: 0 };\n              tl.to(clock, { frame: frames, duration: frames / FPS, ease: \"none\", onUpdate: function () { draw(clock.frame); } }, 0);\n              draw(0);\n            }\n\n            var beatFrames = num(vars.beat_frames, 15, 4, 30);\n            var beatsPerBar = Math.max(1, Math.round(num(vars.beats_per_bar, 4, 1, 8)));\n            var punch = num(vars.punch, 0.07, 0, 0.2);\n            var halftone = num(vars.halftone, 8, 0, 20);\n            var showIndicator = bool(vars.show_indicator, true);\n            var speed = num(vars.speed, 1, 0.1, 4);\n            var palettes = [[\"#111111\", \"#FFFFFF\"], [\"#111111\", \"#E5322D\"], [\"#E5322D\", \"#FFFFFF\"], [\"#E5322D\", \"#111111\"]];\n            try {\n              var parsed = JSON.parse(str(vars.palettes, \"\"));\n              if (Array.isArray(parsed) && parsed.length && parsed.every(function (p) { return Array.isArray(p) && p.length >= 2 && /^#[0-9a-f]{3}([0-9a-f]{3})?$/i.test(p[0]) && /^#[0-9a-f]{3}([0-9a-f]{3})?$/i.test(p[1]); })) palettes = parsed;\n            } catch (e) { /* keep the default ink pairs */ }\n\n            var u = Math.min(W, H) / 720;\n            function hexToRgb(hex) {\n              var h = hex.replace(\"#\", \"\").trim();\n              if (h.length === 3) h = h.split(\"\").map(function (c) { return c + c; }).join(\"\");\n              var n = parseInt(h.slice(0, 6), 16);\n              return Number.isNaN(n) ? [0, 0, 0] : [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];\n            }\n\n            // Built-in stand-in for the photo: a lit head and shoulders over a soft grey ground.\n            var pan = document.getElementById(\"db-pan\");\n            (function () {\n              var svg = el(\"svg\", { viewBox: \"0 0 \" + W + \" \" + H, \"aria-hidden\": \"true\" }, pan);\n              var defs = el(\"defs\", {}, svg);\n              var rg = el(\"radialGradient\", { id: \"db-ground\", cx: 0.5, cy: 0.4, r: 0.8 }, defs);\n              [[\"0\", \"#FFFFFF\"], [\"0.5\", \"#F2F2F2\"], [\"1\", \"#C4C4C4\"]].forEach(function (s) { el(\"stop\", { offset: s[0], \"stop-color\": s[1] }, rg); });\n              el(\"rect\", { width: W, height: H, fill: \"url(#db-ground)\" }, svg);\n              var lgS = el(\"linearGradient\", { id: \"db-skin\", x1: 0, y1: 0, x2: 1, y2: 0.2 }, defs);\n              [[\"0\", \"#121212\"], [\"0.55\", \"#3A3A3A\"], [\"1\", \"#9C9C9C\"]].forEach(function (s) { el(\"stop\", { offset: s[0], \"stop-color\": s[1] }, lgS); });\n              var lgT = el(\"linearGradient\", { id: \"db-shirt\", x1: 0, y1: 0, x2: 1, y2: 0 }, defs);\n              [[\"0\", \"#141414\"], [\"0.6\", \"#262626\"], [\"1\", \"#6A6A6A\"]].forEach(function (s) { el(\"stop\", { offset: s[0], \"stop-color\": s[1] }, lgT); });\n              var h = H, cx = W / 2;\n              function P(x, y) { return (cx + x * h) + \" \" + (y * h); }\n              var head = [\"M \" + P(0, 0.17), \"C \" + P(0.075, 0.17) + \" \" + P(0.118, 0.23) + \" \" + P(0.118, 0.32), \"C \" + P(0.118, 0.4) + \" \" + P(0.095, 0.46) + \" \" + P(0.06, 0.49),\n                \"C \" + P(0.035, 0.51) + \" \" + P(-0.035, 0.51) + \" \" + P(-0.06, 0.49), \"C \" + P(-0.095, 0.46) + \" \" + P(-0.118, 0.4) + \" \" + P(-0.118, 0.32), \"C \" + P(-0.118, 0.23) + \" \" + P(-0.075, 0.17) + \" \" + P(0, 0.17) + \" Z\"].join(\" \");\n              var hair = [\"M \" + P(-0.126, 0.34), \"C \" + P(-0.14, 0.17) + \" \" + P(-0.05, 0.125) + \" \" + P(0.02, 0.135), \"C \" + P(0.11, 0.14) + \" \" + P(0.145, 0.21) + \" \" + P(0.126, 0.32),\n                \"C \" + P(0.11, 0.245) + \" \" + P(0.06, 0.215) + \" \" + P(-0.01, 0.222), \"C \" + P(-0.07, 0.228) + \" \" + P(-0.105, 0.26) + \" \" + P(-0.126, 0.34) + \" Z\"].join(\" \");\n              var torso = [\"M \" + P(-0.07, 0.585), \"C \" + P(-0.13, 0.62) + \" \" + P(-0.3, 0.63) + \" \" + P(-0.36, 0.7), \"C \" + P(-0.41, 0.76) + \" \" + P(-0.43, 0.88) + \" \" + P(-0.44, 1.01),\n                \"L \" + P(0.44, 1.01), \"C \" + P(0.43, 0.88) + \" \" + P(0.41, 0.76) + \" \" + P(0.36, 0.7), \"C \" + P(0.3, 0.63) + \" \" + P(0.13, 0.62) + \" \" + P(0.07, 0.585) + \" Z\"].join(\" \");\n              var fig = el(\"g\", {}, svg);\n              fig.id = \"db-figure\";\n              el(\"path\", { d: \"M \" + P(-0.055, 0.45) + \" L \" + P(-0.065, 0.61) + \" L \" + P(0.065, 0.61) + \" L \" + P(0.055, 0.45) + \" Z\", fill: \"#0C0C0C\" }, fig);\n              el(\"path\", { d: torso, fill: \"url(#db-shirt)\" }, fig);\n              el(\"path\", { d: \"M \" + P(-0.075, 0.59) + \" Q \" + P(0, 0.67) + \" \" + P(0.075, 0.59), fill: \"none\", stroke: \"#7A7A7A\", \"stroke-width\": 0.012 * h }, fig);\n              el(\"ellipse\", { cx: cx - 0.12 * h, cy: 0.34 * h, rx: 0.018 * h, ry: 0.04 * h, fill: \"#161616\" }, fig);\n              el(\"ellipse\", { cx: cx + 0.12 * h, cy: 0.34 * h, rx: 0.018 * h, ry: 0.04 * h, fill: \"#8A8A8A\" }, fig);\n              el(\"path\", { d: head, fill: \"url(#db-skin)\" }, fig);\n              el(\"path\", { d: hair, fill: \"#060606\" }, fig);\n              var rim = el(\"g\", { fill: \"none\", stroke: \"#D6D6D6\", \"stroke-width\": 0.007 * h, \"stroke-linecap\": \"round\", style: \"filter: blur(\" + 0.003 * h + \"px)\" }, fig);\n              el(\"path\", { d: \"M \" + P(0.112, 0.27) + \" C \" + P(0.118, 0.36) + \" \" + P(0.105, 0.43) + \" \" + P(0.07, 0.475) }, rim);\n              el(\"path\", { d: \"M \" + P(0.14, 0.625) + \" C \" + P(0.3, 0.64) + \" \" + P(0.39, 0.72) + \" \" + P(0.42, 0.88) }, rim);\n            })();\n            var figure = document.getElementById(\"db-figure\");\n\n            // Duotone (grey, optional halftone screen, then a two-ink lookup) as one SVG filter.\n            var defs = document.getElementById(\"db-defs\");\n            var f = el(\"filter\", { id: \"db-duotone\", x: 0, y: 0, width: 1, height: 1, \"color-interpolation-filters\": \"sRGB\" }, defs);\n            el(\"feColorMatrix\", { type: \"saturate\", values: 0, result: \"gray\" }, f);\n            var pitch = halftone * u;\n            if (pitch > 0) {\n              var tile = \"data:image/svg+xml;utf8,\" + encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"' + pitch + '\" height=\"' + pitch + '\"><defs><radialGradient id=\"g\" r=\"0.71\"><stop offset=\"0\" stop-color=\"#000\"/><stop offset=\"1\" stop-color=\"#fff\"/></radialGradient></defs><rect width=\"' + pitch + '\" height=\"' + pitch + '\" fill=\"url(#g)\"/></svg>');\n              el(\"feImage\", { href: tile, x: 0, y: 0, width: pitch, height: pitch, result: \"dot\" }, f);\n              el(\"feTile\", { in: \"dot\", result: \"screen\" }, f);\n              el(\"feComposite\", { in: \"gray\", in2: \"screen\", operator: \"arithmetic\", k1: 0, k2: 8, k3: -8, k4: 1 }, f);\n            }\n            var ct = el(\"feComponentTransfer\", {}, f);\n            var funcs = [\"feFuncR\", \"feFuncG\", \"feFuncB\"].map(function (n) { return el(n, { type: \"table\", tableValues: \"0 1\" }, ct); });\n            document.getElementById(\"db-picture\").style.filter = \"url(#db-duotone)\";\n\n            var bar = document.getElementById(\"db-bar\");\n            bar.style.left = 48 * u + \"px\"; bar.style.bottom = 44 * u + \"px\"; bar.style.gap = 10 * u + \"px\";\n            var squares = [];\n            for (var i = 0; i < beatsPerBar; i++) {\n              var sq = document.createElement(\"div\");\n              sq.className = \"db-sq\"; sq.style.width = sq.style.height = 26 * u + \"px\";\n              bar.appendChild(sq); squares.push(sq);\n            }\n            var bpmEl = document.createElement(\"span\");\n            bpmEl.className = \"db-bpm\";\n            bpmEl.style.cssText = \"margin-left:\" + 10 * u + \"px;font-size:\" + 20 * u + \"px;letter-spacing:\" + 2 * u + \"px\";\n            bar.appendChild(bpmEl);\n            if (!showIndicator) bar.style.display = \"none\";\n\n            var period = Math.max(1, beatFrames);\n            var outCubic = E.out(E.cubic);\n            var lastBeat = -1;\n            function draw(frame) {\n              var t = frame * speed;\n              var beat = Math.floor(t / period), local = t - beat * period, inBar = beat % beatsPerBar;\n              var pair = palettes[beat % palettes.length];\n              if (beat !== lastBeat) {\n                lastBeat = beat;\n                var dark = hexToRgb(pair[0]), light = hexToRgb(pair[1]);\n                funcs.forEach(function (fn, c) { fn.setAttribute(\"tableValues\", dark[c] + \" \" + light[c]); });\n              }\n              var strength = inBar === 0 ? punch : punch / 3;\n              pan.style.transform = \"scale(\" + (1 + strength * Math.exp(-local / 3.2)) + \")\";\n              var rise = interp(t, [0, 12], [0.22, 0], { easing: outCubic });\n              var intro = interp(t, [0, 12], [0, 1], { easing: outCubic });\n              figure.setAttribute(\"transform\", \"translate(0 \" + rise * H + \")\");\n              squares.forEach(function (sq, i) {\n                sq.style.border = 2.5 * u + \"px solid \" + pair[0];\n                sq.style.backgroundColor = i === inBar ? pair[0] : \"transparent\";\n                sq.style.transform = \"scale(\" + (i === inBar ? 1 + 0.25 * Math.exp(-local / 3) : 1) + \")\";\n              });\n              bpmEl.style.color = pair[0]; bpmEl.style.backgroundColor = pair[1];\n              bpmEl.textContent = String(Math.round((30 * 60) / period)) + \" BPM\";\n            }\n            drive(Math.round(parseFloat(root.dataset.duration || \"4\") * FPS), draw);\n\n            var total = parseFloat(root.dataset.duration || \"4\");\n            if (tl.duration() < total) tl.to({}, { duration: total - tl.duration() });\n            tl.seek(0);\n            window.__timelines = window.__timelines || {};\n            window.__timelines[\"duotone-beat\"] = tl;\n          })();\n        </script>\n      </div>\n    </template>\n  </body>\n</html>\n"
  }
 ],
